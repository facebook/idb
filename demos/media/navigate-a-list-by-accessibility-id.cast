{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Scroll a list and open a row by accessibility identifier", "version": 2, "width": 80}
[1.0, "m", "Scroll down from the General row"]
[1.0, "o", "$ idb ui scroll down com.facebook.idb.replhost.row.general --match-key AXUniqueId\r\n"]
[1.63, "o", "[exited 0 after 0.63s]\r\n"]
[2.301, "m", "Scroll back up from com.facebook.idb.replhost.row.row-19"]
[2.301, "o", "$ idb ui scroll up com.facebook.idb.replhost.row.row-19 --match-key AXUniqueId\r\n"]
[2.99, "o", "[exited 0 after 0.69s]\r\n"]
[3.7, "m", "Find the General row by accessibility identifier"]
[3.7, "o", "$ idb ui describe com.facebook.idb.replhost.row.general --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[4.336, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":53,\"width\":362,\"x\":20,\"y\":180},\"help\":null,\"identifier\":\"com.facebook.idb.replhost.row.general\",\"label\":\"General\",\"pid\":4254,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":[\"Scrollable\",\"Button\",\"TextOperationsAvailable\"],\"type\":\"Cell\",\"value\":\"\"}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"com.facebook.idb.replhost.row.general\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.64s]\r\n"]
[5.817, "m", "Tap the General row by accessibility identifier"]
[5.817, "o", "$ idb ui tap com.facebook.idb.replhost.row.general --match-key AXUniqueId\r\n"]
[6.683, "o", "[exited 0 after 0.87s]\r\n"]
[7.047, "m", "Read the navigation bar of the page that opened"]
[7.047, "o", "$ idb ui describe General --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[7.429, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":54,\"width\":402,\"x\":0,\"y\":62},\"help\":null,\"identifier\":\"General\",\"label\":null,\"pid\":4254,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":[\"Scrollable\"],\"type\":\"NavigationBar\",\"value\":null}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"General\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.38s]\r\n"]
