{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Scroll a list and open a row by accessibility identifier", "version": 2, "width": 80}
[1.0, "m", "Scroll down from the General row"]
[1.0, "o", "$ idb ui scroll down com.facebook.idb.replhost.row.general --match-key AXUniqueId\r\n"]
[1.553, "o", "[exited 0 after 0.55s]\r\n"]
[2.259, "m", "Scroll back up from com.facebook.idb.replhost.row.row-19"]
[2.259, "o", "$ idb ui scroll up com.facebook.idb.replhost.row.row-19 --match-key AXUniqueId\r\n"]
[2.786, "o", "[exited 0 after 0.53s]\r\n"]
[3.4, "m", "Find the General row by accessibility identifier"]
[3.4, "o", "$ idb ui describe com.facebook.idb.replhost.row.general --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[4.048, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":53,\"width\":362,\"x\":20,\"y\":180},\"help\":null,\"identifier\":\"com.facebook.idb.replhost.row.general\",\"label\":\"General\",\"pid\":7753,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":[\"Button\",\"TextOperationsAvailable\",\"Scrollable\"],\"type\":\"Cell\",\"value\":\"\"}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"com.facebook.idb.replhost.row.general\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.65s]\r\n"]
[5.572, "m", "Tap the General row by accessibility identifier"]
[5.572, "o", "$ idb ui tap com.facebook.idb.replhost.row.general --match-key AXUniqueId\r\n"]
[6.33, "o", "[exited 0 after 0.76s]\r\n"]
[6.754, "m", "Read the navigation bar of the page that opened"]
[6.754, "o", "$ idb ui describe General --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[7.122, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":54,\"width\":402,\"x\":0,\"y\":62},\"help\":null,\"identifier\":\"General\",\"label\":null,\"pid\":7753,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":[\"Scrollable\"],\"type\":\"NavigationBar\",\"value\":null}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"General\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.37s]\r\n"]
