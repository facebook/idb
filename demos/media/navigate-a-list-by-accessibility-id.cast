{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Scroll a list and open a row by accessibility identifier", "version": 2, "width": 80}
[1.0, "m", "Scroll down from the General row"]
[1.0, "o", "$ idb ui scroll down com.facebook.idb.replhost.row.general --match-key AXUniqueId\r\n"]
[1.679, "o", "[exited 0 after 0.68s]\r\n"]
[2.56, "m", "Scroll back up from com.facebook.idb.replhost.row.row-19"]
[2.56, "o", "$ idb ui scroll up com.facebook.idb.replhost.row.row-19 --match-key AXUniqueId\r\n"]
[3.269, "o", "[exited 0 after 0.71s]\r\n"]
[4.067, "m", "Find the General row by accessibility identifier"]
[4.067, "o", "$ idb ui describe com.facebook.idb.replhost.row.general --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[4.589, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":53,\"width\":362,\"x\":20,\"y\":180},\"help\":null,\"identifier\":\"com.facebook.idb.replhost.row.general\",\"label\":\"General\",\"pid\":16283,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":[\"Scrollable\",\"Button\",\"TextOperationsAvailable\"],\"type\":\"Cell\",\"value\":\"\"}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"com.facebook.idb.replhost.row.general\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.52s]\r\n"]
[5.714, "m", "Tap the General row by accessibility identifier"]
[5.714, "o", "$ idb ui tap com.facebook.idb.replhost.row.general --match-key AXUniqueId\r\n"]
[6.41, "o", "[exited 0 after 0.70s]\r\n"]
[6.714, "m", "Read the navigation bar of the page that opened"]
[6.714, "o", "$ idb ui describe General --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[7.04, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":54,\"width\":402,\"x\":0,\"y\":62},\"help\":null,\"identifier\":\"General\",\"label\":null,\"pid\":16283,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":[\"Scrollable\"],\"type\":\"NavigationBar\",\"value\":null}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"General\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.33s]\r\n"]
