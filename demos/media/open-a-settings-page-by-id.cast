{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Open a Settings page by accessibility identifier", "version": 2, "width": 80}
[1.0, "m", "Find the General row by accessibility identifier"]
[1.0, "o", "$ idb ui describe com.apple.settings.general --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[1.676, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":52,\"width\":370,\"x\":16,\"y\":380.33333333333337},\"help\":null,\"identifier\":\"com.apple.settings.general\",\"label\":\"General\",\"pid\":8624,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":null,\"type\":\"Button\",\"value\":null}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"com.apple.settings.general\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.68s]\r\n"]
[3.794, "m", "Wait until the General row is available"]
[3.794, "o", "$ idb ui wait com.apple.settings.general --match-key AXUniqueId --api axbridge --timeout 30.0 --json\r\n"]
[5.237, "o", "{\"found\": true}\r\n[exited 0 after 1.44s]\r\n"]
[5.238, "m", "Tap the General row by accessibility identifier"]
[5.238, "o", "$ idb ui tap com.apple.settings.general --match-key AXUniqueId\r\n"]
[6.794, "o", "[exited 0 after 1.56s]\r\n"]
[6.795, "m", "Wait for the General page to open"]
[6.795, "o", "$ idb ui wait General --match-key AXUniqueId --api axbridge --timeout 30.0 --json\r\n"]
[9.854, "o", "{\"found\": true}\r\n[exited 0 after 3.06s]\r\n"]
[9.861, "m", "Verify that the General page opened"]
[9.861, "o", "$ idb ui describe General --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[10.492, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":54,\"width\":402,\"x\":0,\"y\":62},\"help\":null,\"identifier\":\"General\",\"label\":null,\"pid\":8624,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":null,\"type\":\"NavigationBar\",\"value\":null}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"General\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.63s]\r\n"]
