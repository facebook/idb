{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Open a Settings page by accessibility identifier", "version": 2, "width": 80}
[1.0, "m", "Find the General row by accessibility identifier"]
[1.0, "o", "$ idb ui describe com.apple.settings.general --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[1.589, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":52,\"width\":370,\"x\":16,\"y\":380.33333333333337},\"help\":null,\"identifier\":\"com.apple.settings.general\",\"label\":\"General\",\"pid\":7006,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":null,\"type\":\"Button\",\"value\":null}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"com.apple.settings.general\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.59s]\r\n"]
[2.084, "m", "Wait until the General row is available"]
[2.084, "o", "$ idb ui wait com.apple.settings.general --match-key AXUniqueId --api axbridge --timeout 30.0 --json\r\n"]
[2.72, "o", "{\"found\": true}\r\n[exited 0 after 0.64s]\r\n"]
[2.724, "m", "Tap the General row by accessibility identifier"]
[2.724, "o", "$ idb ui tap com.apple.settings.general --match-key AXUniqueId\r\n"]
[5.69, "o", "[exited 0 after 2.97s]\r\n"]
[5.704, "m", "Wait for the General page to open"]
[5.704, "o", "$ idb ui wait General --match-key AXUniqueId --api axbridge --timeout 30.0 --json\r\n"]
[7.619, "o", "{\"found\": true}\r\n[exited 0 after 1.92s]\r\n"]
[7.63, "m", "Verify that the General page opened"]
[7.63, "o", "$ idb ui describe General --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[8.57, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":54,\"width\":402,\"x\":0,\"y\":62},\"help\":null,\"identifier\":\"General\",\"label\":null,\"pid\":7006,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":null,\"type\":\"NavigationBar\",\"value\":null}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"General\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.94s]\r\n"]
