{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Open a Settings page by accessibility id", "version": 2, "width": 80}
[1.0, "m", "Find the General row from inside the simulator"]
[1.0, "o", "$ idb ui describe com.apple.settings.general --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[1.405, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":52,\"width\":370,\"x\":16,\"y\":380.33333333333337},\"help\":null,\"identifier\":\"com.apple.settings.general\",\"label\":\"General\",\"pid\":19547,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":null,\"type\":\"Button\",\"value\":null}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"com.apple.settings.general\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.40s]\r\n"]
[1.825, "m", "Wait for the row, by the id the tap will address"]
[1.825, "o", "$ idb ui wait com.apple.settings.general --match-key AXUniqueId --api axbridge --timeout 30.0 --json\r\n"]
[2.215, "o", "{\"found\": true}\r\n[exited 0 after 0.39s]\r\n"]
[2.215, "m", "Open it with a tap addressed by that id"]
[2.215, "o", "$ idb ui tap com.apple.settings.general --match-key AXUniqueId\r\n"]
[5.521, "o", "[exited 0 after 3.31s]\r\n"]
[5.524, "m", "Wait for the page the tap opened"]
[5.524, "o", "$ idb ui wait General --match-key AXUniqueId --api axbridge --timeout 30.0 --json\r\n"]
[6.47, "o", "{\"found\": true}\r\n[exited 0 after 0.95s]\r\n"]
[6.47, "m", "Read the bar of the page that opened"]
[6.47, "o", "$ idb ui describe General --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[6.979, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":54,\"width\":402,\"x\":0,\"y\":62},\"help\":null,\"identifier\":\"General\",\"label\":null,\"pid\":19547,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":null,\"type\":\"NavigationBar\",\"value\":null}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"General\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.51s]\r\n"]
