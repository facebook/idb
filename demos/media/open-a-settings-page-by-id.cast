{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Open a Settings page by accessibility id", "version": 2, "width": 80}
[1.0, "m", "Find the General row from inside the simulator"]
[1.0, "o", "$ idb ui describe com.apple.settings.general --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[1.515, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":52,\"width\":370,\"x\":16,\"y\":293.3333333333333},\"help\":null,\"identifier\":\"com.apple.settings.general\",\"label\":\"General\",\"pid\":17062,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":null,\"type\":\"Button\",\"value\":null}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"com.apple.settings.general\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.52s]\r\n"]
[1.926, "m", "Wait for the row, by the id the tap will address"]
[1.926, "o", "$ idb ui wait com.apple.settings.general --match-key AXUniqueId --api axbridge --timeout 30.0 --json\r\n"]
[2.55, "o", "{\"found\": true}\r\n[exited 0 after 0.62s]\r\n"]
[2.55, "m", "Open it with a tap addressed by that id"]
[2.55, "o", "$ idb ui tap com.apple.settings.general --match-key AXUniqueId\r\n"]
[4.685, "o", "[exited 0 after 2.14s]\r\n"]
[4.686, "m", "Wait for the page the tap opened"]
[4.686, "o", "$ idb ui wait General --match-key AXUniqueId --api axbridge --timeout 30.0 --json\r\n"]
[6.045, "o", "{\"found\": true}\r\n[exited 0 after 1.36s]\r\n"]
[6.073, "m", "Read the bar of the page that opened"]
[6.073, "o", "$ idb ui describe General --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[6.707, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":54,\"width\":402,\"x\":0,\"y\":62},\"help\":null,\"identifier\":\"General\",\"label\":null,\"pid\":17062,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":null,\"type\":\"NavigationBar\",\"value\":null}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"General\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.63s]\r\n"]
