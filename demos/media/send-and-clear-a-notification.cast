{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.726, "m", "Grant notification permission without showing a prompt"]
[0.726, "o", "$ idb approve com.apple.news notification\r\n"]
[1.552, "o", "[exited 0 after 0.83s]\r\n"]
[1.552, "m", "List notifications before delivery"]
[1.552, "o", "$ idb notification list com.apple.news\r\n"]
[2.169, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.62s]\r\n"]
[2.169, "m", "Deliver a notification while the app is not running"]
[2.169, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.416, "o", "[exited 0 after 0.25s]\r\n"]
[3.05, "m", "List notifications after delivery"]
[3.05, "o", "$ idb notification list com.apple.news\r\n"]
[3.69, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.64s]\r\n"]
[3.691, "m", "Clear the app's delivered notifications"]
[3.691, "o", "$ idb notification clear com.apple.news\r\n"]
[4.355, "o", "[exited 0 after 0.66s]\r\n"]
[4.863, "m", "List notifications after clearing them"]
[4.863, "o", "$ idb notification list com.apple.news\r\n"]
[5.339, "o", "[exited 0 after 0.48s]\r\n"]
