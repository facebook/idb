{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.525, "m", "Grant notification permission without showing a prompt"]
[0.525, "o", "$ idb approve com.apple.news notification\r\n"]
[1.136, "o", "[exited 0 after 0.61s]\r\n"]
[1.137, "m", "List notifications before delivery"]
[1.137, "o", "$ idb notification list com.apple.news\r\n"]
[1.627, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.49s]\r\n"]
[1.627, "m", "Deliver a notification while the app is not running"]
[1.627, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[1.824, "o", "[exited 0 after 0.20s]\r\n"]
[2.333, "m", "List notifications after delivery"]
[2.333, "o", "$ idb notification list com.apple.news\r\n"]
[2.838, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.51s]\r\n"]
[2.839, "m", "Clear the app's delivered notifications"]
[2.839, "o", "$ idb notification clear com.apple.news\r\n"]
[3.4, "o", "[exited 0 after 0.56s]\r\n"]
[3.854, "m", "List notifications after clearing them"]
[3.854, "o", "$ idb notification list com.apple.news\r\n"]
[4.298, "o", "[exited 0 after 0.44s]\r\n"]
[4.95, "o", ""]
