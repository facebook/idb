{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.464, "m", "Grant notification permission without showing a prompt"]
[0.464, "o", "$ idb approve com.apple.news notification\r\n"]
[0.92, "o", "[exited 0 after 0.46s]\r\n"]
[0.92, "m", "List notifications before delivery"]
[0.92, "o", "$ idb notification list com.apple.news\r\n"]
[1.363, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.44s]\r\n"]
[1.363, "m", "Deliver a notification while the app is not running"]
[1.363, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[1.531, "o", "[exited 0 after 0.17s]\r\n"]
[1.904, "m", "List notifications after delivery"]
[1.904, "o", "$ idb notification list com.apple.news\r\n"]
[2.343, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.44s]\r\n"]
[2.344, "m", "Clear the app's delivered notifications"]
[2.344, "o", "$ idb notification clear com.apple.news\r\n"]
[2.819, "o", "[exited 0 after 0.48s]\r\n"]
[3.236, "m", "List notifications after clearing them"]
[3.236, "o", "$ idb notification list com.apple.news\r\n"]
[3.592, "o", "[exited 0 after 0.36s]\r\n"]
[3.882, "o", ""]
