{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.419, "m", "Grant notification permission without showing a prompt"]
[0.419, "o", "$ idb approve com.apple.news notification\r\n"]
[0.636, "o", "[exited 0 after 0.22s]\r\n"]
[0.637, "m", "List notifications before delivery"]
[0.637, "o", "$ idb notification list com.apple.news\r\n"]
[1.205, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.57s]\r\n"]
[1.205, "m", "Deliver a notification while the app is not running"]
[1.205, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[1.401, "o", "[exited 0 after 0.20s]\r\n"]
[1.952, "m", "List notifications after delivery"]
[1.952, "o", "$ idb notification list com.apple.news\r\n"]
[2.688, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.74s]\r\n"]
[2.689, "m", "Clear the app's delivered notifications"]
[2.689, "o", "$ idb notification clear com.apple.news\r\n"]
[3.408, "o", "[exited 0 after 0.72s]\r\n"]
[3.875, "m", "List notifications after clearing them"]
[3.875, "o", "$ idb notification list com.apple.news\r\n"]
[4.302, "o", "[exited 0 after 0.43s]\r\n"]
