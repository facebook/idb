{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.742, "m", "Grant notification permission without showing a prompt"]
[0.742, "o", "$ idb approve com.apple.news notification\r\n"]
[1.48, "o", "[exited 0 after 0.74s]\r\n"]
[1.48, "m", "List notifications before delivery"]
[1.48, "o", "$ idb notification list com.apple.news\r\n"]
[2.124, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.64s]\r\n"]
[2.125, "m", "Deliver a notification while the app is not running"]
[2.125, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.458, "o", "[exited 0 after 0.33s]\r\n"]
[3.408, "m", "List notifications after delivery"]
[3.408, "o", "$ idb notification list com.apple.news\r\n"]
[4.193, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.78s]\r\n"]
[4.194, "m", "Clear the app's delivered notifications"]
[4.194, "o", "$ idb notification clear com.apple.news\r\n"]
[4.855, "o", "[exited 0 after 0.66s]\r\n"]
[5.48, "m", "List notifications after clearing them"]
[5.48, "o", "$ idb notification list com.apple.news\r\n"]
[5.968, "o", "[exited 0 after 0.49s]\r\n"]
