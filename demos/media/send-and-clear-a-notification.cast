{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.681, "m", "Grant notification permission without showing a prompt"]
[0.681, "o", "$ idb approve com.apple.news notification\r\n"]
[1.278, "o", "[exited 0 after 0.60s]\r\n"]
[1.279, "m", "List notifications before delivery"]
[1.279, "o", "$ idb notification list com.apple.news\r\n"]
[1.841, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.56s]\r\n"]
[1.842, "m", "Deliver a notification while the app is not running"]
[1.842, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.094, "o", "[exited 0 after 0.25s]\r\n"]
[2.699, "m", "List notifications after delivery"]
[2.699, "o", "$ idb notification list com.apple.news\r\n"]
[3.334, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.63s]\r\n"]
[3.334, "m", "Clear the app's delivered notifications"]
[3.334, "o", "$ idb notification clear com.apple.news\r\n"]
[3.927, "o", "[exited 0 after 0.59s]\r\n"]
[4.326, "m", "List notifications after clearing them"]
[4.326, "o", "$ idb notification list com.apple.news\r\n"]
[4.77, "o", "[exited 0 after 0.44s]\r\n"]
[5.207, "o", ""]
