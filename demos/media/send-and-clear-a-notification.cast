{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.622, "m", "Grant notification permission without showing a prompt"]
[0.622, "o", "$ idb approve com.apple.news notification\r\n"]
[1.328, "o", "[exited 0 after 0.71s]\r\n"]
[1.329, "m", "List notifications before delivery"]
[1.329, "o", "$ idb notification list com.apple.news\r\n"]
[1.898, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.57s]\r\n"]
[1.898, "m", "Deliver a notification while the app is not running"]
[1.898, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.111, "o", "[exited 0 after 0.21s]\r\n"]
[2.604, "m", "List notifications after delivery"]
[2.604, "o", "$ idb notification list com.apple.news\r\n"]
[3.093, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.49s]\r\n"]
[3.093, "m", "Clear the app's delivered notifications"]
[3.093, "o", "$ idb notification clear com.apple.news\r\n"]
[3.833, "o", "[exited 0 after 0.74s]\r\n"]
[4.332, "m", "List notifications after clearing them"]
[4.332, "o", "$ idb notification list com.apple.news\r\n"]
