{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.639, "m", "Grant notification permission without showing a prompt"]
[0.639, "o", "$ idb approve com.apple.news notification\r\n"]
[1.26, "o", "[exited 0 after 0.62s]\r\n"]
[1.26, "m", "List notifications before delivery"]
[1.26, "o", "$ idb notification list com.apple.news\r\n"]
[1.859, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.60s]\r\n"]
[1.859, "m", "Deliver a notification while the app is not running"]
[1.859, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.146, "o", "[exited 0 after 0.29s]\r\n"]
[2.758, "m", "List notifications after delivery"]
[2.758, "o", "$ idb notification list com.apple.news\r\n"]
[3.438, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.68s]\r\n"]
[3.439, "m", "Clear the app's delivered notifications"]
[3.439, "o", "$ idb notification clear com.apple.news\r\n"]
[4.061, "o", "[exited 0 after 0.62s]\r\n"]
[4.569, "m", "List notifications after clearing them"]
[4.569, "o", "$ idb notification list com.apple.news\r\n"]
[5.029, "o", "[exited 0 after 0.46s]\r\n"]
[5.675, "o", ""]
