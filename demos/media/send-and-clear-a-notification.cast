{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[2.202, "o", "[exited 0 after 1.20s]\r\n"]
[2.204, "m", "List notifications before delivery"]
[2.204, "o", "$ idb notification list com.apple.news\r\n"]
[3.261, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 1.06s]\r\n"]
[3.262, "m", "Deliver a notification while the app is not running"]
[3.262, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[3.771, "o", "[exited 0 after 0.51s]\r\n"]
[4.978, "m", "List notifications after delivery"]
[4.978, "o", "$ idb notification list com.apple.news\r\n"]
[6.338, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 1.36s]\r\n"]
[6.375, "m", "Clear the app's delivered notifications"]
[6.375, "o", "$ idb notification clear com.apple.news\r\n"]
[7.591, "o", "[exited 0 after 1.22s]\r\n"]
[8.326, "m", "List notifications after clearing them"]
[8.326, "o", "$ idb notification list com.apple.news\r\n"]
[9.077, "o", "[exited 0 after 0.75s]\r\n"]
[10.828, "o", ""]
