{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.977, "m", "Grant notification permission without showing a prompt"]
[0.977, "o", "$ idb approve com.apple.news notification\r\n"]
[1.732, "o", "[exited 0 after 0.76s]\r\n"]
[1.733, "m", "List notifications before delivery"]
[1.733, "o", "$ idb notification list com.apple.news\r\n"]
[2.445, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.71s]\r\n"]
[2.446, "m", "Deliver a notification while the app is not running"]
[2.446, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.708, "o", "[exited 0 after 0.26s]\r\n"]
[3.319, "m", "List notifications after delivery"]
[3.319, "o", "$ idb notification list com.apple.news\r\n"]
[4.042, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.72s]\r\n"]
[4.042, "m", "Clear the app's delivered notifications"]
[4.042, "o", "$ idb notification clear com.apple.news\r\n"]
[4.67, "o", "[exited 0 after 0.63s]\r\n"]
[5.226, "m", "List notifications after clearing them"]
[5.226, "o", "$ idb notification list com.apple.news\r\n"]
[5.752, "o", "[exited 0 after 0.53s]\r\n"]
