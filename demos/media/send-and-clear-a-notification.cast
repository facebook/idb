{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.641, "o", "[exited 0 after 0.64s]\r\n"]
[1.642, "m", "List notifications before delivery"]
[1.642, "o", "$ idb notification list com.apple.news\r\n"]
[2.327, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.69s]\r\n"]
[2.328, "m", "Deliver a notification while the app is not running"]
[2.328, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.59, "o", "[exited 0 after 0.26s]\r\n"]
[3.141, "m", "List notifications after delivery"]
[3.141, "o", "$ idb notification list com.apple.news\r\n"]
[3.8, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.66s]\r\n"]
[3.801, "m", "Clear the app's delivered notifications"]
[3.801, "o", "$ idb notification clear com.apple.news\r\n"]
[4.457, "o", "[exited 0 after 0.66s]\r\n"]
[5.016, "m", "List notifications after clearing them"]
[5.016, "o", "$ idb notification list com.apple.news\r\n"]
[5.55, "o", "[exited 0 after 0.53s]\r\n"]
[7.003, "o", ""]
