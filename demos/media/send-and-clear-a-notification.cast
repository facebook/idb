{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.571, "m", "Grant notification permission without showing a prompt"]
[0.571, "o", "$ idb approve com.apple.news notification\r\n"]
[1.086, "o", "[exited 0 after 0.52s]\r\n"]
[1.087, "m", "List notifications before delivery"]
[1.087, "o", "$ idb notification list com.apple.news\r\n"]
[1.569, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.48s]\r\n"]
[1.569, "m", "Deliver a notification while the app is not running"]
[1.569, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[1.791, "o", "[exited 0 after 0.22s]\r\n"]
[2.307, "m", "List notifications after delivery"]
[2.307, "o", "$ idb notification list com.apple.news\r\n"]
[2.88, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.57s]\r\n"]
[2.88, "m", "Clear the app's delivered notifications"]
[2.88, "o", "$ idb notification clear com.apple.news\r\n"]
[3.37, "o", "[exited 0 after 0.49s]\r\n"]
[3.773, "m", "List notifications after clearing them"]
[3.773, "o", "$ idb notification list com.apple.news\r\n"]
[4.165, "o", "[exited 0 after 0.39s]\r\n"]
[4.732, "o", ""]
