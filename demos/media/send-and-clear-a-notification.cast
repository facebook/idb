{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[4.115, "o", "[exited 0 after 3.12s]\r\n"]
[4.149, "m", "List notifications before delivery"]
[4.149, "o", "$ idb notification list com.apple.news\r\n"]
[9.459, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 5.31s]\r\n"]
[9.465, "m", "Deliver a notification while the app is not running"]
[9.465, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[10.69, "o", "[exited 0 after 1.22s]\r\n"]
[14.456, "m", "List notifications after delivery"]
[14.456, "o", "$ idb notification list com.apple.news\r\n"]
[16.105, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 1.65s]\r\n"]
[16.106, "m", "Clear the app's delivered notifications"]
[16.106, "o", "$ idb notification clear com.apple.news\r\n"]
[18.174, "o", "[exited 0 after 2.07s]\r\n"]
[19.36, "m", "List notifications after clearing them"]
[19.36, "o", "$ idb notification list com.apple.news\r\n"]
[20.574, "o", "[exited 0 after 1.21s]\r\n"]
