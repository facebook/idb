{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.782, "m", "Grant notification permission without showing a prompt"]
[0.782, "o", "$ idb approve com.apple.news notification\r\n"]
[1.818, "o", "[exited 0 after 1.04s]\r\n"]
[1.82, "m", "List notifications before delivery"]
[1.82, "o", "$ idb notification list com.apple.news\r\n"]
[2.323, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.50s]\r\n"]
[2.324, "m", "Deliver a notification while the app is not running"]
[2.324, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.539, "o", "[exited 0 after 0.22s]\r\n"]
[3.039, "m", "List notifications after delivery"]
[3.039, "o", "$ idb notification list com.apple.news\r\n"]
[3.815, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.78s]\r\n"]
[3.816, "m", "Clear the app's delivered notifications"]
[3.816, "o", "$ idb notification clear com.apple.news\r\n"]
[4.598, "o", "[exited 0 after 0.78s]\r\n"]
[5.166, "m", "List notifications after clearing them"]
[5.166, "o", "$ idb notification list com.apple.news\r\n"]
[5.59, "o", "[exited 0 after 0.42s]\r\n"]
[6.618, "o", ""]
