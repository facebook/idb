{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.576, "m", "Grant notification permission without showing a prompt"]
[0.576, "o", "$ idb approve com.apple.news notification\r\n"]
[1.223, "o", "[exited 0 after 0.65s]\r\n"]
[1.223, "m", "List notifications before delivery"]
[1.223, "o", "$ idb notification list com.apple.news\r\n"]
[1.777, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.55s]\r\n"]
[1.778, "m", "Deliver a notification while the app is not running"]
[1.778, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.025, "o", "[exited 0 after 0.25s]\r\n"]
[2.572, "m", "List notifications after delivery"]
[2.572, "o", "$ idb notification list com.apple.news\r\n"]
[3.201, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.63s]\r\n"]
[3.202, "m", "Clear the app's delivered notifications"]
[3.202, "o", "$ idb notification clear com.apple.news\r\n"]
[3.806, "o", "[exited 0 after 0.60s]\r\n"]
[4.283, "m", "List notifications after clearing them"]
[4.283, "o", "$ idb notification list com.apple.news\r\n"]
[4.731, "o", "[exited 0 after 0.45s]\r\n"]
[5.727, "o", ""]
