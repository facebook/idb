{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.293, "m", "Grant notification permission without showing a prompt"]
[0.293, "o", "$ idb approve com.apple.news notification\r\n"]
[0.457, "o", "[exited 0 after 0.16s]\r\n"]
[0.458, "m", "List notifications before delivery"]
[0.458, "o", "$ idb notification list com.apple.news\r\n"]
[0.825, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.37s]\r\n"]
[0.825, "m", "Deliver a notification while the app is not running"]
[0.825, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[0.989, "o", "[exited 0 after 0.16s]\r\n"]
[1.388, "m", "List notifications after delivery"]
[1.388, "o", "$ idb notification list com.apple.news\r\n"]
[1.757, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.37s]\r\n"]
[1.757, "m", "Clear the app's delivered notifications"]
[1.757, "o", "$ idb notification clear com.apple.news\r\n"]
[2.225, "o", "[exited 0 after 0.47s]\r\n"]
[2.724, "m", "List notifications after clearing them"]
[2.724, "o", "$ idb notification list com.apple.news\r\n"]
[3.136, "o", "[exited 0 after 0.41s]\r\n"]
[3.332, "o", ""]
