{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.368, "m", "Grant notification permission without showing a prompt"]
[0.368, "o", "$ idb approve com.apple.news notification\r\n"]
[0.913, "o", "[exited 0 after 0.54s]\r\n"]
[0.914, "m", "List notifications before delivery"]
[0.914, "o", "$ idb notification list com.apple.news\r\n"]
[1.295, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.38s]\r\n"]
[1.295, "m", "Deliver a notification while the app is not running"]
[1.295, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[1.445, "o", "[exited 0 after 0.15s]\r\n"]
[1.82, "m", "List notifications after delivery"]
[1.82, "o", "$ idb notification list com.apple.news\r\n"]
[2.226, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.41s]\r\n"]
[2.227, "m", "Clear the app's delivered notifications"]
[2.227, "o", "$ idb notification clear com.apple.news\r\n"]
[2.65, "o", "[exited 0 after 0.42s]\r\n"]
[3.099, "m", "List notifications after clearing them"]
[3.099, "o", "$ idb notification list com.apple.news\r\n"]
[3.497, "o", "[exited 0 after 0.40s]\r\n"]
