{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[4.025, "o", "[exited 0 after 3.03s]\r\n"]
[4.061, "m", "List notifications before delivery"]
[4.061, "o", "$ idb notification list com.apple.news\r\n"]
[8.543, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 4.48s]\r\n"]
[8.544, "m", "Deliver a notification while the app is not running"]
[8.544, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[9.682, "o", "[exited 0 after 1.14s]\r\n"]
[11.943, "m", "List notifications after delivery"]
[11.943, "o", "$ idb notification list com.apple.news\r\n"]
[13.303, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 1.36s]\r\n"]
[13.304, "m", "Clear the app's delivered notifications"]
[13.304, "o", "$ idb notification clear com.apple.news\r\n"]
[14.195, "o", "[exited 0 after 0.89s]\r\n"]
[14.9, "m", "List notifications after clearing them"]
[14.9, "o", "$ idb notification list com.apple.news\r\n"]
[15.541, "o", "[exited 0 after 0.64s]\r\n"]
[17.037, "o", ""]
