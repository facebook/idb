{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[4.226, "o", "[exited 0 after 3.23s]\r\n"]
[4.256, "m", "List notifications before delivery"]
[4.256, "o", "$ idb notification list com.apple.news\r\n"]
[5.779, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 1.52s]\r\n"]
[5.78, "m", "Deliver a notification while the app is not running"]
[5.78, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[6.709, "o", "[exited 0 after 0.93s]\r\n"]
[9.724, "m", "List notifications after delivery"]
[9.724, "o", "$ idb notification list com.apple.news\r\n"]
[10.811, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 1.09s]\r\n"]
[10.812, "m", "Clear the app's delivered notifications"]
[10.812, "o", "$ idb notification clear com.apple.news\r\n"]
[11.659, "o", "[exited 0 after 0.85s]\r\n"]
[12.868, "m", "List notifications after clearing them"]
[12.868, "o", "$ idb notification list com.apple.news\r\n"]
[13.602, "o", "[exited 0 after 0.91s]\r\n"]
