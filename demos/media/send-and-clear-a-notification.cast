{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[4.319, "o", "[exited 0 after 3.32s]\r\n"]
[4.32, "m", "List notifications before delivery"]
[4.32, "o", "$ idb notification list com.apple.news\r\n"]
[6.262, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 1.94s]\r\n"]
[6.264, "m", "Deliver a notification while the app is not running"]
[6.264, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[7.099, "o", "[exited 0 after 0.84s]\r\n"]
[11.865, "m", "List notifications after delivery"]
[11.865, "o", "$ idb notification list com.apple.news\r\n"]
[12.993, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 1.13s]\r\n"]
[12.994, "m", "Clear the app's delivered notifications"]
[12.994, "o", "$ idb notification clear com.apple.news\r\n"]
[14.194, "o", "[exited 0 after 1.20s]\r\n"]
[15.481, "m", "List notifications after clearing them"]
[15.481, "o", "$ idb notification list com.apple.news\r\n"]
[16.602, "o", "[exited 0 after 1.12s]\r\n"]
[17.527, "o", ""]
