{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.764, "m", "Grant notification permission without showing a prompt"]
[0.764, "o", "$ idb approve com.apple.news notification\r\n"]
[1.445, "o", "[exited 0 after 0.68s]\r\n"]
[1.445, "m", "List notifications before delivery"]
[1.445, "o", "$ idb notification list com.apple.news\r\n"]
[2.056, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.61s]\r\n"]
[2.057, "m", "Deliver a notification while the app is not running"]
[2.057, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.282, "o", "[exited 0 after 0.23s]\r\n"]
[2.829, "m", "List notifications after delivery"]
[2.829, "o", "$ idb notification list com.apple.news\r\n"]
[3.352, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.52s]\r\n"]
[3.352, "m", "Clear the app's delivered notifications"]
[3.352, "o", "$ idb notification clear com.apple.news\r\n"]
[3.872, "o", "[exited 0 after 0.52s]\r\n"]
[4.376, "m", "List notifications after clearing them"]
[4.376, "o", "$ idb notification list com.apple.news\r\n"]
[4.871, "o", "[exited 0 after 0.49s]\r\n"]
[6.03, "o", ""]
