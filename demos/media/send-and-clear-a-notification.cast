{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.751, "m", "Grant notification permission without showing a prompt"]
[0.751, "o", "$ idb approve com.apple.news notification\r\n"]
[1.513, "o", "[exited 0 after 0.76s]\r\n"]
[1.514, "m", "List notifications before delivery"]
[1.514, "o", "$ idb notification list com.apple.news\r\n"]
[2.053, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.54s]\r\n"]
[2.054, "m", "Deliver a notification while the app is not running"]
[2.054, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.278, "o", "[exited 0 after 0.22s]\r\n"]
[2.805, "m", "List notifications after delivery"]
[2.805, "o", "$ idb notification list com.apple.news\r\n"]
[3.374, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.57s]\r\n"]
[3.374, "m", "Clear the app's delivered notifications"]
[3.374, "o", "$ idb notification clear com.apple.news\r\n"]
[3.932, "o", "[exited 0 after 0.56s]\r\n"]
[4.337, "m", "List notifications after clearing them"]
[4.337, "o", "$ idb notification list com.apple.news\r\n"]
[4.688, "o", "[exited 0 after 0.35s]\r\n"]
