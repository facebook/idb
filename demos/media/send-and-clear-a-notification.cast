{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[3.529, "o", "[exited 0 after 2.53s]\r\n"]
[3.529, "m", "List notifications before delivery"]
[3.529, "o", "$ idb notification list com.apple.news\r\n"]
[4.81, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 1.28s]\r\n"]
[4.81, "m", "Deliver a notification while the app is not running"]
[4.81, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[5.274, "o", "[exited 0 after 0.46s]\r\n"]
[6.466, "m", "List notifications after delivery"]
[6.466, "o", "$ idb notification list com.apple.news\r\n"]
[8.294, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 1.83s]\r\n"]
[8.294, "m", "Clear the app's delivered notifications"]
[8.294, "o", "$ idb notification clear com.apple.news\r\n"]
[9.291, "o", "[exited 0 after 1.00s]\r\n"]
[9.971, "m", "List notifications after clearing them"]
[9.971, "o", "$ idb notification list com.apple.news\r\n"]
[10.524, "o", "[exited 0 after 0.55s]\r\n"]
[10.82, "o", ""]
