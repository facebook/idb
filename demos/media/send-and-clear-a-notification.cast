{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[2.148, "o", "[exited 0 after 1.15s]\r\n"]
[2.148, "m", "List notifications before delivery"]
[2.148, "o", "$ idb notification list com.apple.news\r\n"]
[2.854, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.71s]\r\n"]
[2.854, "m", "Deliver a notification while the app is not running"]
[2.854, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[3.212, "o", "[exited 0 after 0.36s]\r\n"]
[4.358, "m", "List notifications after delivery"]
[4.358, "o", "$ idb notification list com.apple.news\r\n"]
[4.978, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.62s]\r\n"]
[4.979, "m", "Clear the app's delivered notifications"]
[4.979, "o", "$ idb notification clear com.apple.news\r\n"]
[5.511, "o", "[exited 0 after 0.53s]\r\n"]
[6.017, "m", "List notifications after clearing them"]
[6.017, "o", "$ idb notification list com.apple.news\r\n"]
[6.595, "o", "[exited 0 after 0.58s]\r\n"]
[7.407, "o", ""]
