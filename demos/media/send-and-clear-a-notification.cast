{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.299, "m", "Grant notification permission without showing a prompt"]
[0.299, "o", "$ idb approve com.apple.news notification\r\n"]
[0.463, "o", "[exited 0 after 0.16s]\r\n"]
[0.464, "m", "List notifications before delivery"]
[0.464, "o", "$ idb notification list com.apple.news\r\n"]
[0.822, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.36s]\r\n"]
[0.823, "m", "Deliver a notification while the app is not running"]
[0.823, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[0.973, "o", "[exited 0 after 0.15s]\r\n"]
[1.333, "m", "List notifications after delivery"]
[1.333, "o", "$ idb notification list com.apple.news\r\n"]
[1.699, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.37s]\r\n"]
[1.699, "m", "Clear the app's delivered notifications"]
[1.699, "o", "$ idb notification clear com.apple.news\r\n"]
[2.088, "o", "[exited 0 after 0.39s]\r\n"]
[2.458, "m", "List notifications after clearing them"]
[2.458, "o", "$ idb notification list com.apple.news\r\n"]
[2.839, "o", "[exited 0 after 0.38s]\r\n"]
[3.447, "o", ""]
