{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.284, "m", "Grant notification permission without showing a prompt"]
[0.284, "o", "$ idb approve com.apple.news notification\r\n"]
[0.444, "o", "[exited 0 after 0.16s]\r\n"]
[0.444, "m", "List notifications before delivery"]
[0.444, "o", "$ idb notification list com.apple.news\r\n"]
[0.792, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.35s]\r\n"]
[0.792, "m", "Deliver a notification while the app is not running"]
[0.792, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[0.935, "o", "[exited 0 after 0.14s]\r\n"]
[1.293, "m", "List notifications after delivery"]
[1.293, "o", "$ idb notification list com.apple.news\r\n"]
[1.655, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.36s]\r\n"]
[1.655, "m", "Clear the app's delivered notifications"]
[1.655, "o", "$ idb notification clear com.apple.news\r\n"]
[2.038, "o", "[exited 0 after 0.38s]\r\n"]
[2.395, "m", "List notifications after clearing them"]
[2.395, "o", "$ idb notification list com.apple.news\r\n"]
[2.744, "o", "[exited 0 after 0.35s]\r\n"]
[2.94, "o", ""]
