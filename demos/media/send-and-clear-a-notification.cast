{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[5.013, "o", "[exited 0 after 4.01s]\r\n"]
[5.031, "m", "List notifications before delivery"]
[5.031, "o", "$ idb notification list com.apple.news\r\n"]
[8.568, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 3.54s]\r\n"]
[8.571, "m", "Deliver a notification while the app is not running"]
[8.571, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[10.447, "o", "[exited 0 after 1.88s]\r\n"]
[12.835, "m", "List notifications after delivery"]
[12.835, "o", "$ idb notification list com.apple.news\r\n"]
[14.66, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 1.83s]\r\n"]
[14.661, "m", "Clear the app's delivered notifications"]
[14.661, "o", "$ idb notification clear com.apple.news\r\n"]
[15.9, "o", "[exited 0 after 1.24s]\r\n"]
[17.405, "m", "List notifications after clearing them"]
[17.405, "o", "$ idb notification list com.apple.news\r\n"]
[18.417, "o", "[exited 0 after 1.01s]\r\n"]
