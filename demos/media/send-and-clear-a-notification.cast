{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.785, "m", "Grant notification permission without showing a prompt"]
[0.785, "o", "$ idb approve com.apple.news notification\r\n"]
[1.457, "o", "[exited 0 after 0.67s]\r\n"]
[1.458, "m", "List notifications before delivery"]
[1.458, "o", "$ idb notification list com.apple.news\r\n"]
[2.005, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.55s]\r\n"]
[2.005, "m", "Deliver a notification while the app is not running"]
[2.005, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.267, "o", "[exited 0 after 0.26s]\r\n"]
[2.721, "m", "List notifications after delivery"]
[2.721, "o", "$ idb notification list com.apple.news\r\n"]
[3.326, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.61s]\r\n"]
[3.327, "m", "Clear the app's delivered notifications"]
[3.327, "o", "$ idb notification clear com.apple.news\r\n"]
[3.972, "o", "[exited 0 after 0.64s]\r\n"]
[4.489, "m", "List notifications after clearing them"]
[4.489, "o", "$ idb notification list com.apple.news\r\n"]
[4.99, "o", "[exited 0 after 0.50s]\r\n"]
[5.818, "o", ""]
