{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.349, "m", "Grant notification permission without showing a prompt"]
[0.349, "o", "$ idb approve com.apple.news notification\r\n"]
[0.526, "o", "[exited 0 after 0.18s]\r\n"]
[0.527, "m", "List notifications before delivery"]
[0.527, "o", "$ idb notification list com.apple.news\r\n"]
[0.919, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.39s]\r\n"]
[0.92, "m", "Deliver a notification while the app is not running"]
[0.92, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[1.103, "o", "[exited 0 after 0.18s]\r\n"]
[1.533, "m", "List notifications after delivery"]
[1.533, "o", "$ idb notification list com.apple.news\r\n"]
[1.962, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.43s]\r\n"]
[1.962, "m", "Clear the app's delivered notifications"]
[1.962, "o", "$ idb notification clear com.apple.news\r\n"]
[2.444, "o", "[exited 0 after 0.48s]\r\n"]
[2.892, "m", "List notifications after clearing them"]
[2.892, "o", "$ idb notification list com.apple.news\r\n"]
[3.274, "o", "[exited 0 after 0.38s]\r\n"]
[4.202, "o", ""]
