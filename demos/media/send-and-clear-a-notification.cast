{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.354, "m", "Grant notification permission without showing a prompt"]
[0.354, "o", "$ idb approve com.apple.news notification\r\n"]
[0.574, "o", "[exited 0 after 0.22s]\r\n"]
[0.574, "m", "List notifications before delivery"]
[0.574, "o", "$ idb notification list com.apple.news\r\n"]
[1.028, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.45s]\r\n"]
[1.029, "m", "Deliver a notification while the app is not running"]
[1.029, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[1.236, "o", "[exited 0 after 0.21s]\r\n"]
[1.683, "m", "List notifications after delivery"]
[1.683, "o", "$ idb notification list com.apple.news\r\n"]
[2.137, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.45s]\r\n"]
[2.137, "m", "Clear the app's delivered notifications"]
[2.137, "o", "$ idb notification clear com.apple.news\r\n"]
[2.665, "o", "[exited 0 after 0.53s]\r\n"]
[3.083, "m", "List notifications after clearing them"]
[3.083, "o", "$ idb notification list com.apple.news\r\n"]
[3.473, "o", "[exited 0 after 0.39s]\r\n"]
