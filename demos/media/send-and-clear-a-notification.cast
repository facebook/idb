{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Send a push notification without a permission prompt or a running app", "version": 2, "width": 80}
[0.457, "m", "Grant notification permission without showing a prompt"]
[0.457, "o", "$ idb approve com.apple.news notification\r\n"]
[1.108, "o", "[exited 0 after 0.65s]\r\n"]
[1.109, "m", "List notifications before delivery"]
[1.109, "o", "$ idb notification list com.apple.news\r\n"]
[1.572, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.46s]\r\n"]
[1.573, "m", "Deliver a notification while the app is not running"]
[1.573, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[1.746, "o", "[exited 0 after 0.17s]\r\n"]
[2.189, "m", "List notifications after delivery"]
[2.189, "o", "$ idb notification list com.apple.news\r\n"]
[2.772, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.58s]\r\n"]
[2.773, "m", "Clear the app's delivered notifications"]
[2.773, "o", "$ idb notification clear com.apple.news\r\n"]
[3.42, "o", "[exited 0 after 0.65s]\r\n"]
[3.789, "m", "List notifications after clearing them"]
[3.789, "o", "$ idb notification list com.apple.news\r\n"]
[4.125, "o", "[exited 0 after 0.34s]\r\n"]
[4.887, "o", ""]
