{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Read and navigate web content in Safari, including off-screen elements", "version": 2, "width": 80}
[1.0, "m", "Open idb's documentation in Safari"]
[1.0, "o", "$ idb open http://127.0.0.1:PORT/docs/idb/fbsimulatorcontrol\r\n"]
[10.224, "o", "[exited 0 after 9.22s]\r\n"]
[27.256, "m", "Find a single heading in the page's accessibility tree"]
[27.256, "o", "$ idb ui describe-all --api axbridge --format complete --match 'Functionality beyond Apple' --key AXLabel --key AXFrame --json\r\n"]
[31.317, "o", "{\"automation\":{\"asserted\":false,\"enabled\":true},\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[{\"children\":[],\"frame\":{\"height\":29,\"width\":356,\"x\":8,\"y\":2206},\"label\":\"Functionality beyond Apple's tools\"}],\"frame\":{\"height\":31,\"width\":386,\"x\":8,\"y\":2205},\"label\":\"Functionality beyond Apple's tools\"}],\"frames\":{\"framed\":2,\"total\":2,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":{\"filter\":\"all\",\"ignore_case\":false,\"match\":\"Functionality beyond Apple\",\"match_key\":\"AXLabel\",\"matched\":2,\"walked\":194},\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"frontmost\",\"match_key\":null,\"pid\":null,\"value\":null,\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 4.06s]\r\n"]
[32.486, "m", "Tap the address bar by accessibility identifier"]
[32.486, "o", "$ idb ui tap TabBarItemTitle --match-key AXUniqueId\r\n"]
[37.421, "o", "[exited 0 after 4.93s]\r\n"]
[38.948, "m", "Type the address of a second page"]
[38.948, "o", "$ idb ui text http://127.0.0.1:PORT/docs/idb/accessibility\r\n"]
[46.039, "o", "[exited 0 after 7.09s]\r\n"]
[49.623, "m", "Read the address bar's value back"]
[49.623, "o", "$ idb ui describe URL --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[51.705, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":48,\"width\":222,\"x\":46,\"y\":792},\"help\":null,\"identifier\":\"URL\",\"label\":\"Address\",\"pid\":7086,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":[\"IsEditing\",\"TextEntry\",\"TextOperationsAvailable\",\"Scrollable\"],\"type\":\"TextField\",\"value\":\"http:\\/\\/127.0.0.1:PORT\\/docs\\/idb\\/accessibility\"}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"URL\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 2.08s]\r\n"]
[51.706, "m", "Submit the address with a key press"]
[51.706, "o", "$ idb ui key 40\r\n"]
[54.29, "o", "[exited 0 after 2.58s]\r\n"]
[56.435, "m", "Find SimulatorFrameworkBridge on the page that loaded"]
[56.435, "o", "$ idb ui describe-all --api axbridge --format complete --match SimulatorFrameworkBridge --key AXLabel --key AXFrame --json\r\n"]
[57.909, "o", "{\"automation\":{\"asserted\":false,\"enabled\":true},\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[{\"children\":[],\"frame\":{\"height\":29,\"width\":294,\"x\":8,\"y\":2206},\"label\":\"SimulatorFrameworkBridge\"}],\"frame\":{\"height\":31,\"width\":386,\"x\":8,\"y\":2205},\"label\":\"SimulatorFrameworkBridge\"},{\"children\":[],\"frame\":{\"height\":40,\"width\":386,\"x\":8,\"y\":2255},\"label\":\"A read is served by SimulatorFrameworkBridge, which runs inside the simulator rather than beside it.\"},{\"children\":[],\"frame\":{\"height\":10,\"width\":79,\"x\":53,\"y\":2344},\"label\":\"SimulatorFrameworkBridge\"}],\"frames\":{\"framed\":4,\"total\":4,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":{\"filter\":\"all\",\"ignore_case\":false,\"match\":\"SimulatorFrameworkBridge\",\"match_key\":\"AXLabel\",\"matched\":4,\"walked\":199},\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"frontmost\",\"match_key\":null,\"pid\":null,\"value\":null,\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 1.47s]\r\n"]
