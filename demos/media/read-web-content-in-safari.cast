{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Read and navigate web content in Safari, including off-screen elements", "version": 2, "width": 80}
[1.0, "m", "Open idb's documentation in Safari"]
[1.0, "o", "$ idb open https://fbidb.io/docs/idb/fbsimulatorcontrol\r\n"]
[3.186, "o", "[exited 0 after 2.19s]\r\n"]
[12.374, "m", "Find a single heading in the page's accessibility tree"]
[12.374, "o", "$ idb ui describe-all --api axbridge --format complete --match 'Functionality beyond Apple' --key AXLabel --key AXFrame --json\r\n"]
[15.276, "o", "{\"automation\":{\"asserted\":false,\"enabled\":true},\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[{\"children\":[],\"frame\":{\"height\":60,\"width\":325,\"x\":16,\"y\":5265},\"label\":\"Functionality beyond Apple's tools\"},{\"children\":[],\"frame\":{\"height\":30,\"width\":24,\"x\":71,\"y\":5295},\"label\":\"Direct link to Functionality beyond Apple's tools\"}],\"frame\":{\"height\":61,\"width\":370,\"x\":16,\"y\":5265},\"label\":\"Functionality beyond Apple's tools Direct link to Functionality beyond Apple's tools\"}],\"frames\":{\"framed\":3,\"total\":3,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":{\"filter\":\"all\",\"ignore_case\":false,\"match\":\"Functionality beyond Apple\",\"match_key\":\"AXLabel\",\"matched\":3,\"walked\":1055},\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"frontmost\",\"match_key\":null,\"pid\":null,\"value\":null,\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 2.90s]\r\n"]
[18.341, "m", "Tap the address bar by accessibility identifier"]
[18.341, "o", "$ idb ui tap TabBarItemTitle --match-key AXUniqueId\r\n"]
[22.572, "o", "[exited 0 after 4.23s]\r\n"]
[23.318, "m", "Type the address of a second page"]
[23.318, "o", "$ idb ui text https://fbidb.io/docs/idb/accessibility\r\n"]
[23.998, "o", "[exited 0 after 0.68s]\r\n"]
[24.857, "m", "Read the address bar's value back"]
[24.857, "o", "$ idb ui describe URL --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[25.151, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":48,\"width\":222,\"x\":46,\"y\":792},\"help\":null,\"identifier\":\"URL\",\"label\":\"Address\",\"pid\":6522,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":[\"IsEditing\",\"TextEntry\",\"TextOperationsAvailable\",\"Scrollable\"],\"type\":\"TextField\",\"value\":\"https:\\/\\/fbidb.io\\/docs\\/idb\\/accessibility\"}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"URL\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.29s]\r\n"]
[25.152, "m", "Submit the address with a key press"]
[25.152, "o", "$ idb ui key 40\r\n"]
[25.387, "o", "[exited 0 after 0.24s]\r\n"]
[29.202, "m", "Find SimulatorFrameworkBridge on the page that loaded"]
[29.202, "o", "$ idb ui describe-all --api axbridge --format complete --match SimulatorFrameworkBridge --key AXLabel --key AXFrame --json\r\n"]
[32.224, "o", "{\"automation\":{\"asserted\":false,\"enabled\":true},\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"frame\":{\"height\":13,\"width\":119,\"x\":223,\"y\":1615},\"label\":\"SimulatorFrameworkBridge\"},{\"children\":[],\"frame\":{\"height\":19,\"width\":209,\"x\":155,\"y\":2409},\"label\":\"SimulatorFrameworkBridge\"},{\"children\":[],\"frame\":{\"height\":19,\"width\":209,\"x\":31,\"y\":3412},\"label\":\"SimulatorFrameworkBridge\"},{\"children\":[],\"frame\":{\"height\":19,\"width\":210,\"x\":94,\"y\":5233},\"label\":\"SimulatorFrameworkBridge\"},{\"children\":[],\"frame\":{\"height\":19,\"width\":798,\"x\":32,\"y\":5447},\"label\":\"The SimulatorFrameworkBridge guest binary was not found in the companion Resources directory\"}],\"frames\":{\"framed\":5,\"total\":5,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":{\"filter\":\"all\",\"ignore_case\":false,\"match\":\"SimulatorFrameworkBridge\",\"match_key\":\"AXLabel\",\"matched\":5,\"walked\":1209},\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"frontmost\",\"match_key\":null,\"pid\":null,\"value\":null,\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 3.02s]\r\n"]
