{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Read and navigate web content in Safari, including off-screen elements", "version": 2, "width": 80}
[1.0, "m", "Open idb's documentation in Safari"]
[1.0, "o", "$ idb open https://fbidb.io/docs/idb/fbsimulatorcontrol\r\n"]
[1.427, "o", "[exited 0 after 0.43s]\r\n"]
[9.324, "m", "Find a single heading in the page's accessibility tree"]
[9.324, "o", "$ idb ui describe-all --api axbridge --format complete --match 'Functionality beyond Apple' --key AXLabel --key AXFrame --json\r\n"]
[12.311, "o", "{\"automation\":{\"asserted\":false,\"enabled\":true},\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[{\"children\":[],\"frame\":{\"height\":60,\"width\":325,\"x\":16,\"y\":5291},\"label\":\"Functionality beyond Apple's tools\"},{\"children\":[],\"frame\":{\"height\":31,\"width\":24,\"x\":71,\"y\":5320},\"label\":\"Direct link to Functionality beyond Apple's tools\"}],\"frame\":{\"height\":61,\"width\":370,\"x\":16,\"y\":5291},\"label\":\"Functionality beyond Apple's tools Direct link to Functionality beyond Apple's tools\"}],\"frames\":{\"framed\":3,\"total\":3,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":{\"filter\":\"all\",\"ignore_case\":false,\"match\":\"Functionality beyond Apple\",\"match_key\":\"AXLabel\",\"matched\":3,\"walked\":1067},\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"frontmost\",\"match_key\":null,\"pid\":null,\"value\":null,\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 2.99s]\r\n"]
[15.448, "m", "Tap the address bar by accessibility identifier"]
[15.448, "o", "$ idb ui tap TabBarItemTitle --match-key AXUniqueId\r\n"]
[18.574, "o", "[exited 0 after 3.13s]\r\n"]
[20.006, "m", "Type the address of a second page"]
[20.006, "o", "$ idb ui text https://fbidb.io/docs/idb/accessibility\r\n"]
[21.136, "o", "[exited 0 after 1.13s]\r\n"]
[22.085, "m", "Read the address bar's value back"]
[22.085, "o", "$ idb ui describe URL --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[22.453, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":48,\"width\":222,\"x\":46,\"y\":792},\"help\":null,\"identifier\":\"URL\",\"label\":\"Address\",\"pid\":5302,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":[\"TextEntry\",\"Scrollable\",\"IsEditing\",\"TextOperationsAvailable\"],\"type\":\"TextField\",\"value\":\"https:\\/\\/fbidb.io\\/docs\\/idb\\/accessibility\"}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"URL\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.37s]\r\n"]
[22.453, "m", "Submit the address with a key press"]
[22.453, "o", "$ idb ui key 40\r\n"]
[22.74, "o", "[exited 0 after 0.29s]\r\n"]
[27.791, "m", "Find SimulatorFrameworkBridge on the page that loaded"]
[27.791, "o", "$ idb ui describe-all --api axbridge --format complete --match SimulatorFrameworkBridge --key AXLabel --key AXFrame --json\r\n"]
[31.389, "o", "{\"automation\":{\"asserted\":false,\"enabled\":true},\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"frame\":{\"height\":13,\"width\":119,\"x\":223,\"y\":1615},\"label\":\"SimulatorFrameworkBridge\"},{\"children\":[],\"frame\":{\"height\":19,\"width\":209,\"x\":155,\"y\":2649},\"label\":\"SimulatorFrameworkBridge\"},{\"children\":[],\"frame\":{\"height\":19,\"width\":209,\"x\":31,\"y\":3652},\"label\":\"SimulatorFrameworkBridge\"},{\"children\":[],\"frame\":{\"height\":8,\"width\":100,\"x\":164,\"y\":4605},\"label\":\"SimulatorFrameworkBridge (guest)\"},{\"children\":[],\"frame\":{\"height\":9,\"width\":100,\"x\":164,\"y\":4434},\"label\":\"SimulatorFrameworkBridge (guest)\"},{\"children\":[],\"frame\":{\"height\":19,\"width\":210,\"x\":94,\"y\":5685},\"label\":\"SimulatorFrameworkBridge\"},{\"children\":[],\"frame\":{\"height\":19,\"width\":798,\"x\":32,\"y\":5899},\"label\":\"The SimulatorFrameworkBridge guest binary was not found in the companion Resources directory\"}],\"frames\":{\"framed\":7,\"total\":7,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":{\"filter\":\"all\",\"ignore_case\":false,\"match\":\"SimulatorFrameworkBridge\",\"match_key\":\"AXLabel\",\"matched\":7,\"walked\":1274},\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"frontmost\",\"match_key\":null,\"pid\":null,\"value\":null,\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 3.60s]\r\n"]
