{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Read and navigate web content in Safari, including off-screen elements", "version": 2, "width": 80}
[1.0, "m", "Open idb's documentation in Safari"]
[1.0, "o", "$ idb open http://127.0.0.1:PORT/docs/idb/fbsimulatorcontrol\r\n"]
[1.517, "o", "[exited 0 after 0.52s]\r\n"]
[4.044, "m", "Find a single heading in the page's accessibility tree"]
[4.044, "o", "$ idb ui describe-all --api axbridge --format complete --match 'Functionality beyond Apple' --key AXLabel --key AXFrame --json\r\n"]
[4.33, "o", "{\"automation\":{\"asserted\":false,\"enabled\":true},\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[{\"children\":[],\"frame\":{\"height\":29,\"width\":356,\"x\":8,\"y\":2206},\"label\":\"Functionality beyond Apple's tools\"}],\"frame\":{\"height\":31,\"width\":386,\"x\":8,\"y\":2205},\"label\":\"Functionality beyond Apple's tools\"}],\"frames\":{\"framed\":2,\"total\":2,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":{\"filter\":\"all\",\"ignore_case\":false,\"match\":\"Functionality beyond Apple\",\"match_key\":\"AXLabel\",\"matched\":2,\"walked\":194},\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"frontmost\",\"match_key\":null,\"pid\":null,\"value\":null,\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.29s]\r\n"]
[5.91, "m", "Tap the address bar by accessibility identifier"]
[5.91, "o", "$ idb ui tap TabBarItemTitle --match-key AXUniqueId\r\n"]
[6.273, "o", "[exited 0 after 0.36s]\r\n"]
[7.296, "m", "Type the address of a second page"]
[7.296, "o", "$ idb ui text http://127.0.0.1:PORT/docs/idb/accessibility\r\n"]
[8.114, "o", "[exited 0 after 0.82s]\r\n"]
[9.026, "m", "Read the address bar's value back"]
[9.026, "o", "$ idb ui describe URL --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[9.258, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":48,\"width\":222,\"x\":46,\"y\":792},\"help\":null,\"identifier\":\"URL\",\"label\":\"Address\",\"pid\":7694,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":[\"TextEntry\",\"IsEditing\",\"Scrollable\",\"TextOperationsAvailable\"],\"type\":\"TextField\",\"value\":\"http:\\/\\/127.0.0.1:PORT\\/docs\\/idb\\/accessibility\"}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"URL\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.23s]\r\n"]
[9.258, "m", "Submit the address with a key press"]
[9.258, "o", "$ idb ui key 40\r\n"]
[9.446, "o", "[exited 0 after 0.19s]\r\n"]
[10.049, "m", "Find SimulatorFrameworkBridge on the page that loaded"]
[10.049, "o", "$ idb ui describe-all --api axbridge --format complete --match SimulatorFrameworkBridge --key AXLabel --key AXFrame --json\r\n"]
[10.367, "o", "{\"automation\":{\"asserted\":false,\"enabled\":true},\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[{\"children\":[],\"frame\":{\"height\":29,\"width\":294,\"x\":8,\"y\":2206},\"label\":\"SimulatorFrameworkBridge\"}],\"frame\":{\"height\":31,\"width\":386,\"x\":8,\"y\":2205},\"label\":\"SimulatorFrameworkBridge\"},{\"children\":[],\"frame\":{\"height\":40,\"width\":386,\"x\":8,\"y\":2255},\"label\":\"A read is served by SimulatorFrameworkBridge, which runs inside the simulator rather than beside it.\"},{\"children\":[],\"frame\":{\"height\":10,\"width\":79,\"x\":53,\"y\":2344},\"label\":\"SimulatorFrameworkBridge\"}],\"frames\":{\"framed\":4,\"total\":4,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":{\"filter\":\"all\",\"ignore_case\":false,\"match\":\"SimulatorFrameworkBridge\",\"match_key\":\"AXLabel\",\"matched\":4,\"walked\":199},\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"frontmost\",\"match_key\":null,\"pid\":null,\"value\":null,\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.32s]\r\n"]
