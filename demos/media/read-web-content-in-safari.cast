{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Read and navigate web content in Safari, including off-screen elements", "version": 2, "width": 80}
[1.0, "m", "Open idb's documentation in Safari"]
[1.0, "o", "$ idb open https://fbidb.io/docs/idb/fbsimulatorcontrol\r\n"]
[2.266, "o", "[exited 0 after 1.27s]\r\n"]
[15.81, "m", "Find a single heading in the page's accessibility tree"]
[15.81, "o", "$ idb ui describe-all --api axbridge --format complete --match 'Functionality beyond Apple' --key AXLabel --key AXFrame --json\r\n"]
[21.071, "o", "{\"automation\":{\"asserted\":false,\"enabled\":true},\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[{\"children\":[],\"frame\":{\"height\":60,\"width\":325,\"x\":16,\"y\":7832},\"label\":\"Functionality beyond Apple's tools\"},{\"children\":[],\"frame\":{\"height\":30,\"width\":24,\"x\":71,\"y\":7862},\"label\":\"Direct link to Functionality beyond Apple's tools\"}],\"frame\":{\"height\":61,\"width\":370,\"x\":16,\"y\":7832},\"label\":\"Functionality beyond Apple's tools Direct link to Functionality beyond Apple's tools\"}],\"frames\":{\"framed\":3,\"total\":3,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":{\"filter\":\"all\",\"ignore_case\":false,\"match\":\"Functionality beyond Apple\",\"match_key\":\"AXLabel\",\"matched\":3,\"walked\":1352},\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"frontmost\",\"match_key\":null,\"pid\":null,\"value\":null,\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 5.26s]\r\n"]
[26.801, "m", "Tap the address bar by accessibility identifier"]
[26.801, "o", "$ idb ui tap TabBarItemTitle --match-key AXUniqueId\r\n"]
[32.992, "o", "[exited 0 after 6.19s]\r\n"]
[33.707, "m", "Type the address of a second page"]
[33.707, "o", "$ idb ui text https://fbidb.io/docs/idb/accessibility\r\n"]
[35.002, "o", "[exited 0 after 1.29s]\r\n"]
[35.841, "m", "Read the address bar's value back"]
[35.841, "o", "$ idb ui describe URL --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[36.244, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":48,\"width\":222,\"x\":46,\"y\":792},\"help\":null,\"identifier\":\"URL\",\"label\":\"Address\",\"pid\":8938,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":[\"TextEntry\",\"IsEditing\",\"Scrollable\",\"TextOperationsAvailable\"],\"type\":\"TextField\",\"value\":\"https:\\/\\/fbidb.io\\/docs\\/idb\\/accessibility\"}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"URL\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.40s]\r\n"]
[36.245, "m", "Submit the address with a key press"]
[36.245, "o", "$ idb ui key 40\r\n"]
[37.171, "o", "[exited 0 after 0.93s]\r\n"]
[46.385, "m", "Find SimulatorFrameworkBridge on the page that loaded"]
[46.385, "o", "$ idb ui describe-all --api axbridge --format complete --match SimulatorFrameworkBridge --key AXLabel --key AXFrame --json\r\n"]
