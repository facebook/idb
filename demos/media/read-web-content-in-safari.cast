{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Read and navigate web content in Safari, including off-screen elements", "version": 2, "width": 80}
[1.0, "m", "Open idb's documentation in Safari"]
[1.0, "o", "$ idb open https://fbidb.io/docs/idb/fbsimulatorcontrol\r\n"]
[2.342, "o", "[exited 0 after 1.34s]\r\n"]
[12.011, "m", "Find a single heading in the page's accessibility tree"]
[12.011, "o", "$ idb ui describe-all --api axbridge --format complete --match 'Functionality beyond Apple' --key AXLabel --key AXFrame --json\r\n"]
[15.78, "o", "{\"automation\":{\"asserted\":false,\"enabled\":true},\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[{\"children\":[],\"frame\":{\"height\":60,\"width\":325,\"x\":16,\"y\":5291},\"label\":\"Functionality beyond Apple's tools\"},{\"children\":[],\"frame\":{\"height\":30,\"width\":24,\"x\":71,\"y\":5321},\"label\":\"Direct link to Functionality beyond Apple's tools\"}],\"frame\":{\"height\":61,\"width\":370,\"x\":16,\"y\":5291},\"label\":\"Functionality beyond Apple's tools Direct link to Functionality beyond Apple's tools\"}],\"frames\":{\"framed\":3,\"total\":3,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":{\"filter\":\"all\",\"ignore_case\":false,\"match\":\"Functionality beyond Apple\",\"match_key\":\"AXLabel\",\"matched\":3,\"walked\":1008},\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"frontmost\",\"match_key\":null,\"pid\":null,\"value\":null,\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 3.77s]\r\n"]
[19.438, "m", "Tap the address bar by accessibility identifier"]
[19.438, "o", "$ idb ui tap TabBarItemTitle --match-key AXUniqueId\r\n"]
[24.118, "o", "[exited 0 after 4.68s]\r\n"]
[25.008, "m", "Type the address of a second page"]
[25.008, "o", "$ idb ui text https://fbidb.io/docs/idb/accessibility\r\n"]
[27.101, "o", "[exited 0 after 2.09s]\r\n"]
[29.043, "m", "Read the address bar's value back"]
[29.043, "o", "$ idb ui describe URL --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[29.482, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":48,\"width\":222,\"x\":46,\"y\":792},\"help\":null,\"identifier\":\"URL\",\"label\":\"Address\",\"pid\":5051,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":[\"TextEntry\",\"TextOperationsAvailable\",\"IsEditing\",\"Scrollable\"],\"type\":\"TextField\",\"value\":\"https:\\/\\/fbidb.io\\/docs\\/idb\\/accessibility\"}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"URL\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.44s]\r\n"]
[29.483, "m", "Submit the address with a key press"]
[29.483, "o", "$ idb ui key 40\r\n"]
[29.864, "o", "[exited 0 after 0.38s]\r\n"]
[33.812, "m", "Find SimulatorFrameworkBridge on the page that loaded"]
[33.812, "o", "$ idb ui describe-all --api axbridge --format complete --match SimulatorFrameworkBridge --key AXLabel --key AXFrame --json\r\n"]
[36.869, "o", "{\"automation\":{\"asserted\":false,\"enabled\":true},\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[{\"children\":[],\"frame\":{\"height\":19,\"width\":209,\"x\":50,\"y\":6591},\"label\":\"SimulatorFrameworkBridge\"}],\"frame\":{\"height\":183,\"width\":338,\"x\":48,\"y\":6456},\"label\":\"Accessibility reading. The framework reads the full element hierarchy of the frontmost application without a test bundle, either through host-side translation or in-guest at XCUITest fidelity via the bundledSimulatorFrameworkBridge helper. This is described in .\"},{\"children\":[{\"children\":[],\"frame\":{\"height\":19,\"width\":209,\"x\":50,\"y\":6674},\"label\":\"SimulatorFrameworkBridge\"}],\"frame\":{\"height\":158,\"width\":338,\"x\":48,\"y\":6642},\"label\":\"In-guest state injection.SimulatorFrameworkBridge runs inside the booted Simulator and can modify state that nosimctl verb reaches, such as overwriting the contacts database or clearing the photo library.\"}],\"frames\":{\"framed\":4,\"total\":4,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":{\"filter\":\"all\",\"ignore_case\":false,\"match\":\"SimulatorFrameworkBridge\",\"match_key\":\"AXLabel\",\"matched\":4,\"walked\":1008},\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"frontmost\",\"match_key\":null,\"pid\":null,\"value\":null,\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 3.06s]\r\n"]
