{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Open a page by accessibility identifier", "version": 2, "width": 80}
[1.0, "m", "Find the General row by accessibility identifier"]
[1.0, "o", "$ idb ui describe com.facebook.idb.replhost.row.general --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[1.511, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":53,\"width\":362,\"x\":20,\"y\":180},\"help\":null,\"identifier\":\"com.facebook.idb.replhost.row.general\",\"label\":\"General\",\"pid\":8875,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":null,\"type\":\"Cell\",\"value\":\"\"}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"com.facebook.idb.replhost.row.general\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.51s]\r\n"]
[2.018, "m", "Wait until the General row is available"]
[2.018, "o", "$ idb ui wait com.facebook.idb.replhost.row.general --match-key AXUniqueId --api axbridge --timeout 30.0 --json\r\n"]
[2.81, "o", "{\"found\": true}\r\n[exited 0 after 0.79s]\r\n"]
[2.811, "m", "Tap the General row by accessibility identifier"]
[2.811, "o", "$ idb ui tap com.facebook.idb.replhost.row.general --match-key AXUniqueId\r\n"]
[4.628, "o", "[exited 0 after 1.82s]\r\n"]
[4.628, "m", "Wait for the General page to open"]
[4.628, "o", "$ idb ui wait General --match-key AXUniqueId --api axbridge --timeout 30.0 --json\r\n"]
[5.005, "o", "{\"found\": true}\r\n[exited 0 after 0.38s]\r\n"]
[5.006, "m", "Verify that the General page opened"]
[5.006, "o", "$ idb ui describe General --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[5.262, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":54,\"width\":402,\"x\":0,\"y\":62},\"help\":null,\"identifier\":\"General\",\"label\":null,\"pid\":8875,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":null,\"type\":\"NavigationBar\",\"value\":null}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"General\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.26s]\r\n"]
