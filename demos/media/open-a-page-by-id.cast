{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Open a page by accessibility identifier", "version": 2, "width": 80}
[1.0, "m", "Find the General row by accessibility identifier"]
[1.0, "o", "$ idb ui describe com.facebook.idb.replhost.row.general --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[1.506, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":53,\"width\":362,\"x\":20,\"y\":180},\"help\":null,\"identifier\":\"com.facebook.idb.replhost.row.general\",\"label\":\"General\",\"pid\":10634,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":[\"TextOperationsAvailable\",\"Button\",\"Scrollable\"],\"type\":\"Button\",\"value\":\"\"}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"com.facebook.idb.replhost.row.general\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.51s]\r\n"]
[2.319, "m", "Wait until the General row is available"]
[2.319, "o", "$ idb ui wait com.facebook.idb.replhost.row.general --match-key AXUniqueId --api axbridge --timeout 30.0 --json\r\n"]
[4.634, "o", "{\"found\": true}\r\n[exited 0 after 2.31s]\r\n"]
[4.635, "m", "Tap the General row by accessibility identifier"]
[4.635, "o", "$ idb ui tap com.facebook.idb.replhost.row.general --match-key AXUniqueId\r\n"]
[6.18, "o", "[exited 0 after 1.54s]\r\n"]
[6.186, "m", "Wait for the General page to open"]
[6.186, "o", "$ idb ui wait General --match-key AXUniqueId --api axbridge --timeout 30.0 --json\r\n"]
[10.357, "o", "{\"found\": true}\r\n[exited 0 after 4.17s]\r\n"]
[10.36, "m", "Verify that the General page opened"]
[10.36, "o", "$ idb ui describe General --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
