{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Crash an app on purpose and read its crash report", "version": 2, "width": 80}
[0.386, "m", "Schedule a crash with injected Swift"]
[0.386, "o", "$ idb-repl app --new-session 'import Foundation\r\nDispatchQueue.main.asyncAfter(deadline: .now() + 1) {\r\n  fatalError(\"Crashed on purpose by Swift that idb-repl injected\")\r\n}\r\nreturn \"ReplHost will crash in a second\"\r\n'\r\n"]
[2.434, "o", "Result:\r\nReplHost will crash in a second\r\nidb-repl: received generated interface(s):\r\n  IDBAPI\r\nidb-repl: compiling injected code for arm64-apple-ios26.5-simulator\r\n[exited 0 after 2.05s]\r\n"]
[25.522, "m", "List the app's crash reports"]
[25.522, "o", "$ idb crash list --bundle-id com.facebook.idb.replhost\r\n"]
[25.808, "o", "{\"name\": \"ReplHost-2026-10-13-115533.ips\", \"bundle_id\": \"com.facebook.idb.replhost\", \"process_name\": \"ReplHost\", \"parent_process_name\": \"launchd_sim\", \"process_identifier\": 13179, \"parent_process_identifier\": 1473, \"timestamp\": 1791892511}\r\n[exited 0 after 0.29s]\r\n"]
[25.813, "m", "Read the crash report"]
[25.813, "o", "$ idb crash show ReplHost-2026-10-13-115533.ips\r\n"]
