{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Crash an app on purpose and read its crash report", "version": 2, "width": 80}
[0.411, "m", "Schedule a crash with injected Swift"]
[0.411, "o", "$ idb-repl app --new-session 'import Foundation\r\nDispatchQueue.main.asyncAfter(deadline: .now() + 1) {\r\n  fatalError(\"Crashed on purpose by Swift that idb-repl injected\")\r\n}\r\nreturn \"ReplHost will crash in a second\"\r\n'\r\n"]
[2.5, "o", "Result:\r\nReplHost will crash in a second\r\nidb-repl: received generated interface(s):\r\n  IDBAPI\r\nidb-repl: compiling injected code for arm64-apple-ios26.5-simulator\r\n[exited 0 after 2.09s]\r\n"]
[27.749, "m", "List the app's crash reports"]
[27.749, "o", "$ idb crash list --bundle-id com.facebook.idb.replhost\r\n"]
[27.987, "o", "{\"name\": \"ReplHost-2026-10-14-085355.ips\", \"bundle_id\": \"com.facebook.idb.replhost\", \"process_name\": \"ReplHost\", \"parent_process_name\": \"launchd_sim\", \"process_identifier\": 13387, \"parent_process_identifier\": 1270, \"timestamp\": 1791968012}\r\n[exited 0 after 0.24s]\r\n"]
[27.995, "m", "Read the crash report"]
[27.995, "o", "$ idb crash show ReplHost-2026-10-14-085355.ips\r\n"]
