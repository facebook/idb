{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Crash an app on purpose and read its crash report", "version": 2, "width": 80}
[0.344, "m", "Schedule a crash with injected Swift"]
[0.344, "o", "$ idb-repl app --new-session 'import Foundation\r\nDispatchQueue.main.asyncAfter(deadline: .now() + 1) {\r\n  fatalError(\"Crashed on purpose by Swift that idb-repl injected\")\r\n}\r\nreturn \"ReplHost will crash in a second\"\r\n'\r\n"]
[1.576, "o", "Result:\r\nReplHost will crash in a second\r\nidb-repl: received generated interface(s):\r\n  IDBAPI\r\nidb-repl: compiling injected code for arm64-apple-ios26.5-simulator\r\n[exited 0 after 1.23s]\r\n"]
[22.476, "m", "List the app's crash reports"]
[22.476, "o", "$ idb crash list --bundle-id com.facebook.idb.replhost\r\n"]
[22.68, "o", "{\"name\": \"ReplHost-2026-10-05-091219.ips\", \"bundle_id\": \"com.facebook.idb.replhost\", \"process_name\": \"ReplHost\", \"parent_process_name\": \"launchd_sim\", \"process_identifier\": 22265, \"parent_process_identifier\": 9735, \"timestamp\": 1791191521}\r\n[exited 0 after 0.20s]\r\n"]
[22.685, "m", "Read the crash report"]
[22.685, "o", "$ idb crash show ReplHost-2026-10-05-091219.ips\r\n"]
