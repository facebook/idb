{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Crash an app on purpose and read its crash report", "version": 2, "width": 80}
[0.428, "m", "Schedule a crash with injected Swift"]
[0.428, "o", "$ idb-repl app --new-session 'import Foundation\r\nDispatchQueue.main.asyncAfter(deadline: .now() + 1) {\r\n  fatalError(\"Crashed on purpose by Swift that idb-repl injected\")\r\n}\r\nreturn \"ReplHost will crash in a second\"\r\n'\r\n"]
[3.006, "o", "Result:\r\nReplHost will crash in a second\r\nidb-repl: received generated interface(s):\r\n  IDBAPI\r\nidb-repl: compiling injected code for arm64-apple-ios26.5-simulator\r\n[exited 0 after 2.58s]\r\n"]
[27.182, "m", "List the app's crash reports"]
[27.182, "o", "$ idb crash list --bundle-id com.facebook.idb.replhost\r\n"]
[27.44, "o", "{\"name\": \"ReplHost-2026-10-07-075728.ips\", \"bundle_id\": \"com.facebook.idb.replhost\", \"process_name\": \"ReplHost\", \"parent_process_name\": \"launchd_sim\", \"process_identifier\": 14425, \"parent_process_identifier\": 2681, \"timestamp\": 1791359826}\r\n[exited 0 after 0.26s]\r\n"]
[27.446, "m", "Read the crash report"]
[27.446, "o", "$ idb crash show ReplHost-2026-10-07-075728.ips\r\n"]
