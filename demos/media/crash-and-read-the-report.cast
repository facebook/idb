{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Crash an app on purpose and read its crash report", "version": 2, "width": 80}
[0.384, "m", "Schedule a crash with injected Swift"]
[0.384, "o", "$ idb-repl app --new-session 'import Foundation\r\nDispatchQueue.main.asyncAfter(deadline: .now() + 1) {\r\n  fatalError(\"Crashed on purpose by Swift that idb-repl injected\")\r\n}\r\nreturn \"ReplHost will crash in a second\"\r\n'\r\n"]
[1.982, "o", "Result:\r\nReplHost will crash in a second\r\nidb-repl: received generated interface(s):\r\n  IDBAPI\r\nidb-repl: compiling injected code for arm64-apple-ios26.5-simulator\r\n[exited 0 after 1.60s]\r\n"]
[27.349, "m", "List the app's crash reports"]
[27.349, "o", "$ idb crash list --bundle-id com.facebook.idb.replhost\r\n"]
[27.637, "o", "{\"name\": \"ReplHost-2026-10-06-092420.ips\", \"bundle_id\": \"com.facebook.idb.replhost\", \"process_name\": \"ReplHost\", \"parent_process_name\": \"launchd_sim\", \"process_identifier\": 15188, \"parent_process_identifier\": 2919, \"timestamp\": 1791278637}\r\n[exited 0 after 0.29s]\r\n"]
[27.642, "m", "Read the crash report"]
[27.642, "o", "$ idb crash show ReplHost-2026-10-06-092420.ips\r\n"]
