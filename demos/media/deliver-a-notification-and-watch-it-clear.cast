{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Test notification delivery without handling a permission prompt", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[2.555, "o", "[exited 0 after 1.56s]\r\n"]
[2.555, "m", "List notifications before delivery"]
[2.555, "o", "$ idb notification list com.apple.news\r\n"]
[3.327, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.77s]\r\n"]
[3.328, "m", "Deliver a notification while the app is not running"]
[3.328, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[3.926, "o", "[exited 0 after 0.60s]\r\n"]
[4.995, "m", "List notifications after delivery"]
[4.995, "o", "$ idb notification list com.apple.news\r\n"]
[6.164, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 1.17s]\r\n"]
[6.202, "m", "Clear the app's delivered notifications"]
[6.202, "o", "$ idb notification clear com.apple.news\r\n"]
[6.923, "o", "[exited 0 after 0.72s]\r\n"]
[7.446, "m", "List notifications after clearing them"]
[7.446, "o", "$ idb notification list com.apple.news\r\n"]
