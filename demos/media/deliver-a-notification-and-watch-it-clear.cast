{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Test notification delivery without handling a permission prompt", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[3.055, "o", "[exited 0 after 2.05s]\r\n"]
[3.098, "m", "List notifications before delivery"]
[3.098, "o", "$ idb notification list com.apple.news\r\n"]
[4.9, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 1.80s]\r\n"]
[4.902, "m", "Deliver a notification while the app is not running"]
[4.902, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[5.388, "o", "[exited 0 after 0.49s]\r\n"]
[7.189, "m", "List notifications after delivery"]
[7.189, "o", "$ idb notification list com.apple.news\r\n"]
[9.026, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 1.84s]\r\n"]
[9.048, "m", "Clear the app's delivered notifications"]
[9.048, "o", "$ idb notification clear com.apple.news\r\n"]
[10.186, "o", "[exited 0 after 1.14s]\r\n"]
[13.109, "m", "List notifications after clearing them"]
[13.109, "o", "$ idb notification list com.apple.news\r\n"]
