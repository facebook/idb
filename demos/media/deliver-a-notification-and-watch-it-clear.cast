{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Test notification delivery without handling a permission prompt", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[3.435, "o", "[exited 0 after 2.44s]\r\n"]
[3.437, "m", "List notifications before delivery"]
[3.437, "o", "$ idb notification list com.apple.news\r\n"]
[5.243, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 1.81s]\r\n"]
[5.245, "m", "Deliver a notification while the app is not running"]
[5.245, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[5.681, "o", "[exited 0 after 0.44s]\r\n"]
[6.696, "m", "List notifications after delivery"]
[6.696, "o", "$ idb notification list com.apple.news\r\n"]
