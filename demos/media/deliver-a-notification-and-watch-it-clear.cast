{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Test notification delivery without handling a permission prompt", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[3.289, "o", "[exited 0 after 2.29s]\r\n"]
[3.303, "m", "List notifications before delivery"]
[3.303, "o", "$ idb notification list com.apple.news\r\n"]
[5.97, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 2.67s]\r\n"]
[5.971, "m", "Deliver a notification while the app is not running"]
[5.971, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[6.42, "o", "[exited 0 after 0.45s]\r\n"]
[8.969, "m", "List notifications after delivery"]
[8.969, "o", "$ idb notification list com.apple.news\r\n"]
[11.079, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 2.11s]\r\n"]
[11.101, "m", "Clear the app's delivered notifications"]
[11.101, "o", "$ idb notification clear com.apple.news\r\n"]
[13.643, "o", "[exited 0 after 2.54s]\r\n"]
