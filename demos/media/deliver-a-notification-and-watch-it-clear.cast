{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Test notification delivery without handling a permission prompt", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[2.299, "o", "[exited 0 after 1.30s]\r\n"]
[2.3, "m", "List notifications before delivery"]
[2.3, "o", "$ idb notification list com.apple.news\r\n"]
[3.282, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.98s]\r\n"]
[3.283, "m", "Deliver a notification while the app is not running"]
[3.283, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[3.714, "o", "[exited 0 after 0.43s]\r\n"]
[5.826, "m", "List notifications after delivery"]
[5.826, "o", "$ idb notification list com.apple.news\r\n"]
[6.569, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.74s]\r\n"]
[6.572, "m", "Clear the app's delivered notifications"]
[6.572, "o", "$ idb notification clear com.apple.news\r\n"]
[9.089, "o", "[exited 0 after 2.52s]\r\n"]
[10.184, "m", "List notifications after clearing them"]
[10.184, "o", "$ idb notification list com.apple.news\r\n"]
