{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Test notification delivery without handling a permission prompt", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[12.712, "o", "[exited 0 after 11.71s]\r\n"]
[12.731, "m", "List notifications before delivery"]
[12.731, "o", "$ idb notification list com.apple.news\r\n"]
[19.158, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 6.43s]\r\n"]
[19.315, "m", "Return to the Home Screen before delivery"]
[19.315, "o", "$ idb ui button HOME\r\n"]
[57.184, "o", "[exited 0 after 37.87s]\r\n"]
[57.185, "m", "Deliver a notification while the app is not running"]
[57.185, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[59.928, "o", "[exited 0 after 2.74s]\r\n"]
[59.928, "m", "List notifications after delivery"]
[59.928, "o", "$ idb notification list com.apple.news\r\n"]
