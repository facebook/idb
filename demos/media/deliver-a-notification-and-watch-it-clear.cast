{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Test notification delivery without handling a permission prompt", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[2.725, "o", "[exited 0 after 1.73s]\r\n"]
[2.741, "m", "List notifications before delivery"]
[2.741, "o", "$ idb notification list com.apple.news\r\n"]
[4.688, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 1.95s]\r\n"]
[4.689, "m", "Deliver a notification while the app is not running"]
[4.689, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[6.82, "o", "[exited 0 after 2.13s]\r\n"]
[9.382, "m", "List notifications after delivery"]
[9.382, "o", "$ idb notification list com.apple.news\r\n"]
[10.562, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 1.18s]\r\n"]
[10.563, "m", "Clear the app's delivered notifications"]
[10.563, "o", "$ idb notification clear com.apple.news\r\n"]
[12.256, "o", "[exited 0 after 1.69s]\r\n"]
[13.497, "m", "List notifications after clearing them"]
