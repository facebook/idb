{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Test notification delivery without handling a permission prompt", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[3.775, "o", "[exited 0 after 2.77s]\r\n"]
[3.781, "m", "List notifications before delivery"]
[3.781, "o", "$ idb notification list com.apple.news\r\n"]
[6.2, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 2.42s]\r\n"]
[6.201, "m", "Return to the Home Screen before delivery"]
[6.201, "o", "$ idb ui button HOME\r\n"]
[8.042, "o", "[exited 0 after 1.84s]\r\n"]
[8.042, "m", "Deliver a notification while the app is not running"]
[8.042, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[9.773, "o", "[exited 0 after 1.73s]\r\n"]
[14.098, "m", "Read the notification banner from inside the simulator"]
[14.098, "o", "$ idb ui describe-all --api axbridge --format complete --match ShortLook.Platter.Content.Seamless --match-key AXUniqueId --key AXLabel --key AXFrame --json\r\n"]
[14.755, "o", "{\"automation\":{\"asserted\":false,\"enabled\":true},\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[{\"children\":[],\"frame\":{\"height\":66,\"width\":386,\"x\":8,\"y\":58.66666666666666},\"identifier\":\"ShortLook.Platter.Content.Seamless.CrossFade\",\"label\":null}],\"frame\":{\"height\":66,\"width\":386,\"x\":8,\"y\":58.66666666666666},\"identifier\":\"ShortLook.Platter.Content.Seamless\",\"label\":\"now, Breaking, idb delivered this without the app running.\"}],\"frames\":{\"framed\":2,\"total\":2,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":{\"filter\":\"all\",\"ignore_case\":false,\"match\":\"ShortLook.Platter.Content.Seamless\",\"match_key\":\"AXUniqueId\",\"matched\":2,\"walked\":294},\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"frontmost\",\"match_key\":null,\"pid\":null,\"value\":null,\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.66s]\r\n"]
[14.756, "m", "List notifications after delivery"]
[14.756, "o", "$ idb notification list com.apple.news\r\n"]
[15.501, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.74s]\r\n"]
[15.535, "m", "Open the banner at its reported position"]
[15.535, "o", "$ idb ui tap 201 92 --reason 'the banner is SpringBoard'\\''s, so a marker tap cannot resolve it'\r\n"]
[17.31, "o", "[exited 0 after 1.77s]\r\n"]
[20.869, "m", "List notifications after opening the banner"]
[20.869, "o", "$ idb notification list com.apple.news\r\n"]
