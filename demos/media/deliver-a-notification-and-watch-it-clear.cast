{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Test notification delivery without handling a permission prompt", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[4.461, "o", "[exited 0 after 3.46s]\r\n"]
[4.464, "m", "List notifications before delivery"]
[4.464, "o", "$ idb notification list com.apple.news\r\n"]
[8.014, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 3.55s]\r\n"]
[8.017, "m", "Deliver a notification while the app is not running"]
[8.017, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[10.363, "o", "[exited 0 after 2.35s]\r\n"]
