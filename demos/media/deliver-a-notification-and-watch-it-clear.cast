[28.161, "m", "Read the notification banner from inside the simulator"]
[28.161, "o", "$ idb ui describe-all --api axbridge --format complete --match ShortLook.Platter.Content.Seamless --match-key AXUniqueId --key AXLabel --key AXFrame --json\r\n"]
[28.768, "o", "{\"automation\":{\"asserted\":false,\"enabled\":true},\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[{\"children\":[],\"frame\":{\"height\":66,\"width\":386,\"x\":8,\"y\":58.66666666666666},\"identifier\":\"ShortLook.Platter.Content.Seamless.CrossFade\",\"label\":null}],\"frame\":{\"height\":66,\"width\":386,\"x\":8,\"y\":58.66666666666666},\"identifier\":\"ShortLook.Platter.Content.Seamless\",\"label\":\"now, Breaking, idb delivered this without the app running.\"}],\"frames\":{\"framed\":2,\"total\":2,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":{\"filter\":\"all\",\"ignore_case\":false,\"match\":\"ShortLook.Platter.Content.Seamless\",\"match_key\":\"AXUniqueId\",\"matched\":2,\"walked\":294},\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"frontmost\",\"match_key\":null,\"pid\":null,\"value\":null,\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.61s]\r\n"]
[28.773, "m", "Open the banner at its reported position"]
[28.773, "o", "$ idb ui tap 201 92 --reason 'the banner is SpringBoard'\\''s, so a marker tap cannot resolve it'\r\n"]
[29.401, "o", "[exited 0 after 0.63s]\r\n"]
