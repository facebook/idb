{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Test notification delivery without handling a permission prompt", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[3.588, "o", "[exited 0 after 2.59s]\r\n"]
[3.589, "m", "List notifications before delivery"]
[3.589, "o", "$ idb notification list com.apple.news\r\n"]
[5.773, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 2.18s]\r\n"]
[5.809, "m", "Deliver a notification while the app is not running"]
[5.809, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[6.202, "o", "[exited 0 after 0.39s]\r\n"]
[7.22, "m", "List notifications after delivery"]
[7.22, "o", "$ idb notification list com.apple.news\r\n"]
[9.07, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 1.85s]\r\n"]
[9.071, "m", "Clear the app's delivered notifications"]
[9.071, "o", "$ idb notification clear com.apple.news\r\n"]
[10.867, "o", "[exited 0 after 1.80s]\r\n"]
[12.236, "m", "List notifications after clearing them"]
