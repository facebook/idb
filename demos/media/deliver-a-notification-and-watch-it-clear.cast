{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Test notification delivery without handling a permission prompt", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[3.367, "o", "[exited 0 after 2.37s]\r\n"]
[3.368, "m", "List notifications before delivery"]
[3.368, "o", "$ idb notification list com.apple.news\r\n"]
[5.386, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 2.02s]\r\n"]
[5.399, "m", "Deliver a notification while the app is not running"]
[5.399, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[5.848, "o", "[exited 0 after 0.45s]\r\n"]
[9.662, "m", "List notifications after delivery"]
[9.662, "o", "$ idb notification list com.apple.news\r\n"]
