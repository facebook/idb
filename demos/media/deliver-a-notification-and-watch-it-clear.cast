{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Test notification delivery without handling a permission prompt", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[3.398, "o", "[exited 0 after 2.40s]\r\n"]
[3.401, "m", "List notifications before delivery"]
[3.401, "o", "$ idb notification list com.apple.news\r\n"]
[5.421, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 2.02s]\r\n"]
[5.439, "m", "Return to the Home Screen before delivery"]
[5.439, "o", "$ idb ui button HOME\r\n"]
[14.458, "o", "[exited 0 after 9.02s]\r\n"]
[14.489, "m", "Deliver a notification while the app is not running"]
[14.489, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[18.132, "o", "[exited 0 after 3.64s]\r\n"]
[18.134, "m", "List notifications after delivery"]
[18.134, "o", "$ idb notification list com.apple.news\r\n"]
