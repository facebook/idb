{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Test notification delivery without handling a permission prompt", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[2.082, "o", "[exited 0 after 1.08s]\r\n"]
[2.082, "m", "List notifications before delivery"]
[2.082, "o", "$ idb notification list com.apple.news\r\n"]
[2.891, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.81s]\r\n"]
[2.894, "m", "Deliver a notification while the app is not running"]
[2.894, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[3.415, "o", "[exited 0 after 0.52s]\r\n"]
[5.935, "m", "List notifications after delivery"]
[5.935, "o", "$ idb notification list com.apple.news\r\n"]
[6.681, "o", "\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n\"com.apple.news\" | \"00000000-0000-0000-0000-000000000000\" | \"Breaking\" | \"\" | \"idb delivered this without the app running.\" | \"\" | TIMESTAMP\r\n[exited 0 after 0.75s]\r\n"]
[6.681, "m", "Clear the app's delivered notifications"]
[6.681, "o", "$ idb notification clear com.apple.news\r\n"]
[7.716, "o", "[exited 0 after 1.03s]\r\n"]
[8.368, "m", "List notifications after clearing them"]
[8.368, "o", "$ idb notification list com.apple.news\r\n"]
