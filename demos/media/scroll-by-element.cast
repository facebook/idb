{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Scroll a list from an element, without pixel math", "version": 2, "width": 80}
[1.0, "m", "Scroll down from the General row"]
[1.0, "o", "$ idb ui scroll down com.facebook.idb.replhost.row.general --match-key AXUniqueId\r\n"]
[2.227, "o", "[exited 0 after 1.23s]\r\n"]
[3.482, "m", "Scroll back up from com.facebook.idb.replhost.row.row-19"]
[3.482, "o", "$ idb ui scroll up com.facebook.idb.replhost.row.row-19 --match-key AXUniqueId\r\n"]
[4.596, "o", "[exited 0 after 1.11s]\r\n"]
[7.948, "o", ""]
