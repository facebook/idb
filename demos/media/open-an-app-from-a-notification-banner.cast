{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.23, "o", "[exited 0 after 0.23s]\r\n"]
[1.23, "m", "Go to the home screen"]
[1.23, "o", "$ idb ui button HOME\r\n"]
[1.42, "o", "[exited 0 after 0.19s]\r\n"]
[1.723, "m", "Check what is where the banner will appear"]
[1.723, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.149, "o", "{\"content_required\":false,\"pid\":1438,\"AXLabel\":null,\"type\":\"Group\",\"title\":null,\"help\":null,\"role\":\"AXGroup\",\"subrole\":null,\"AXValue\":null,\"role_description\":\"Group\",\"enabled\":true,\"traits\":[\"Scrollable\"],\"AXUniqueId\":null,\"frame\":{\"width\":402,\"y\":0,\"height\":874,\"x\":0},\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {402, 874}}\"}\r\n[exited 0 after 0.43s]\r\n"]
[2.149, "m", "Deliver a notification while the app is not running"]
[2.149, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.381, "o", "[exited 0 after 0.23s]\r\n"]
[3.385, "m", "Tap the banner"]
[3.385, "o", "$ idb ui tap 201 90\r\n"]
[3.72, "o", "[exited 0 after 0.34s]\r\n"]
[4.5, "m", "Clear the app's delivered notifications"]
[4.5, "o", "$ idb notification clear com.apple.news\r\n"]
[4.991, "o", "[exited 0 after 0.49s]\r\n"]
[5.609, "m", "List notifications after clearing them"]
[5.609, "o", "$ idb notification list com.apple.news\r\n"]
[6.211, "o", "[exited 0 after 0.60s]\r\n"]
[7.93, "o", ""]
