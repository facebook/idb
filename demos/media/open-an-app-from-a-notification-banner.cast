{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.272, "o", "[exited 0 after 0.27s]\r\n"]
[1.272, "m", "Go to the home screen"]
[1.272, "o", "$ idb ui button HOME\r\n"]
[1.482, "o", "[exited 0 after 0.21s]\r\n"]
[1.734, "m", "Check what is where the banner will appear"]
[1.734, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.25, "o", "{\"AXUniqueId\":null,\"traits\":[\"Scrollable\"],\"pid\":2067,\"title\":null,\"type\":\"Group\",\"subrole\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"role_description\":\"Group\",\"enabled\":true,\"help\":null,\"frame\":{\"height\":874,\"width\":401.99999999999994,\"x\":0,\"y\":0},\"content_required\":false,\"AXValue\":null,\"custom_actions\":[],\"AXLabel\":null,\"role\":\"AXGroup\"}\r\n[exited 0 after 0.52s]\r\n"]
[2.251, "m", "Deliver a notification while the app is not running"]
[2.251, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.513, "o", "[exited 0 after 0.26s]\r\n"]
[3.52, "m", "Tap the banner"]
[3.52, "o", "$ idb ui tap 201 90\r\n"]
[3.872, "o", "[exited 0 after 0.35s]\r\n"]
[5.246, "m", "Clear the app's delivered notifications"]
[5.246, "o", "$ idb notification clear com.apple.news\r\n"]
[5.82, "o", "[exited 0 after 0.57s]\r\n"]
[6.385, "m", "List notifications after clearing them"]
[6.385, "o", "$ idb notification list com.apple.news\r\n"]
[6.931, "o", "[exited 0 after 0.55s]\r\n"]
[8.603, "o", ""]
