{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.966, "m", "Grant notification permission without showing a prompt"]
[0.966, "o", "$ idb approve com.apple.news notification\r\n"]
[1.2, "o", "[exited 0 after 0.23s]\r\n"]
[1.2, "m", "Go to the home screen"]
[1.2, "o", "$ idb ui button HOME\r\n"]
[1.367, "o", "[exited 0 after 0.17s]\r\n"]
[1.615, "m", "Check what is where the banner will appear"]
[1.615, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.998, "o", "{\"custom_actions\":[],\"AXUniqueId\":null,\"type\":\"Group\",\"subrole\":null,\"help\":null,\"frame\":{\"width\":402.00000000000006,\"x\":0,\"y\":0,\"height\":874},\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"traits\":[\"Scrollable\"],\"title\":null,\"AXValue\":null,\"enabled\":true,\"content_required\":false,\"AXLabel\":null,\"pid\":2353,\"role\":\"AXGroup\",\"role_description\":\"Group\"}\r\n[exited 0 after 0.38s]\r\n"]
[1.998, "m", "Deliver a notification while the app is not running"]
[1.998, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.217, "o", "[exited 0 after 0.22s]\r\n"]
[3.219, "m", "Tap the banner"]
[3.219, "o", "$ idb ui tap 201 90\r\n"]
[3.444, "o", "[exited 0 after 0.23s]\r\n"]
[4.284, "m", "Clear the app's delivered notifications"]
[4.284, "o", "$ idb notification clear com.apple.news\r\n"]
[4.821, "o", "[exited 0 after 0.54s]\r\n"]
[5.292, "m", "List notifications after clearing them"]
[5.292, "o", "$ idb notification list com.apple.news\r\n"]
[5.685, "o", "[exited 0 after 0.39s]\r\n"]
[6.907, "o", ""]
