{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.271, "o", "[exited 0 after 0.27s]\r\n"]
[1.271, "m", "Go to the home screen"]
[1.271, "o", "$ idb ui button HOME\r\n"]
[1.471, "o", "[exited 0 after 0.20s]\r\n"]
[1.685, "m", "Check what is where the banner will appear"]
[1.685, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.127, "o", "{\"AXLabel\":null,\"content_required\":false,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"type\":\"Group\",\"subrole\":null,\"enabled\":true,\"pid\":1267,\"role\":\"AXGroup\",\"role_description\":\"Group\",\"custom_actions\":[],\"title\":null,\"frame\":{\"y\":0,\"height\":874,\"width\":402,\"x\":0},\"help\":null,\"AXValue\":null,\"AXUniqueId\":null}\r\n[exited 0 after 0.44s]\r\n"]
[2.128, "m", "Deliver a notification while the app is not running"]
[2.128, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.369, "o", "[exited 0 after 0.24s]\r\n"]
[3.38, "m", "Tap the banner"]
[3.38, "o", "$ idb ui tap 201 90\r\n"]
[3.789, "o", "[exited 0 after 0.41s]\r\n"]
[6.191, "m", "Clear the app's delivered notifications"]
[6.191, "o", "$ idb notification clear com.apple.news\r\n"]
[6.74, "o", "[exited 0 after 0.55s]\r\n"]
[7.869, "m", "List notifications after clearing them"]
[7.869, "o", "$ idb notification list com.apple.news\r\n"]
[8.654, "o", "[exited 0 after 0.78s]\r\n"]
[9.705, "o", ""]
