{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.287, "o", "[exited 0 after 0.29s]\r\n"]
[1.287, "m", "Go to the home screen"]
[1.287, "o", "$ idb ui button HOME\r\n"]
[1.475, "o", "[exited 0 after 0.19s]\r\n"]
[1.704, "m", "Check what is where the banner will appear"]
[1.704, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.256, "o", "{\"subrole\":null,\"enabled\":true,\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"role\":\"AXGroup\",\"traits\":[\"Scrollable\"],\"pid\":1327,\"custom_actions\":[],\"AXLabel\":null,\"AXValue\":null,\"title\":null,\"type\":\"Group\",\"AXUniqueId\":null,\"content_required\":false,\"frame\":{\"y\":0,\"height\":874,\"x\":0,\"width\":402},\"help\":null}\r\n[exited 0 after 0.55s]\r\n"]
[2.256, "m", "Deliver a notification while the app is not running"]
[2.256, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.507, "o", "[exited 0 after 0.25s]\r\n"]
[3.511, "m", "Tap the banner"]
[3.511, "o", "$ idb ui tap 201 90\r\n"]
[3.84, "o", "[exited 0 after 0.33s]\r\n"]
[4.879, "m", "Clear the app's delivered notifications"]
[4.879, "o", "$ idb notification clear com.apple.news\r\n"]
[5.426, "o", "[exited 0 after 0.55s]\r\n"]
[6.006, "m", "List notifications after clearing them"]
[6.006, "o", "$ idb notification list com.apple.news\r\n"]
[6.462, "o", "[exited 0 after 0.46s]\r\n"]
[7.988, "o", ""]
