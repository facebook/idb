{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.227, "o", "[exited 0 after 0.23s]\r\n"]
[1.227, "m", "Go to the home screen"]
[1.227, "o", "$ idb ui button HOME\r\n"]
[1.419, "o", "[exited 0 after 0.19s]\r\n"]
[1.673, "m", "Check what is where the banner will appear"]
[1.673, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.998, "o", "{\"role\":\"AXGroup\",\"role_description\":\"Group\",\"AXValue\":null,\"title\":null,\"AXUniqueId\":null,\"enabled\":true,\"AXLabel\":null,\"pid\":1306,\"help\":null,\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"frame\":{\"width\":402.00000000000006,\"height\":874,\"x\":0,\"y\":0},\"type\":\"Group\",\"subrole\":null,\"content_required\":false,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.33s]\r\n"]
[1.998, "m", "Deliver a notification while the app is not running"]
[1.998, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.181, "o", "[exited 0 after 0.18s]\r\n"]
[3.184, "m", "Tap the banner"]
[3.184, "o", "$ idb ui tap 201 90\r\n"]
[3.42, "o", "[exited 0 after 0.24s]\r\n"]
[4.413, "m", "Clear the app's delivered notifications"]
[4.413, "o", "$ idb notification clear com.apple.news\r\n"]
[5.078, "o", "[exited 0 after 0.67s]\r\n"]
[5.611, "m", "List notifications after clearing them"]
[5.611, "o", "$ idb notification list com.apple.news\r\n"]
[6.187, "o", "[exited 0 after 0.58s]\r\n"]
[7.5, "o", ""]
