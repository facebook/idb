{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.308, "o", "[exited 0 after 0.31s]\r\n"]
[1.309, "m", "Go to the home screen"]
[1.309, "o", "$ idb ui button HOME\r\n"]
[1.545, "o", "[exited 0 after 0.24s]\r\n"]
[2.267, "m", "Check what is where the banner will appear"]
[2.267, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.562, "o", "{\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"pid\":1330,\"role_description\":\"Group\",\"title\":null,\"frame\":{\"width\":402.00000000000006,\"y\":0,\"height\":874,\"x\":0},\"type\":\"Group\",\"enabled\":true,\"AXValue\":null,\"subrole\":null,\"role\":\"AXGroup\",\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"help\":null,\"content_required\":false,\"AXUniqueId\":null,\"custom_actions\":[]}\r\n[exited 0 after 0.29s]\r\n"]
[2.562, "m", "Deliver a notification while the app is not running"]
[2.562, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.898, "o", "[exited 0 after 0.34s]\r\n"]
[3.902, "m", "Tap the banner"]
[3.902, "o", "$ idb ui tap 201 90\r\n"]
[4.318, "o", "[exited 0 after 0.42s]\r\n"]
[6.402, "m", "Clear the app's delivered notifications"]
[6.402, "o", "$ idb notification clear com.apple.news\r\n"]
[7.008, "o", "[exited 0 after 0.61s]\r\n"]
[7.506, "m", "List notifications after clearing them"]
[7.506, "o", "$ idb notification list com.apple.news\r\n"]
[8.266, "o", "[exited 0 after 0.76s]\r\n"]
[10.133, "o", ""]
