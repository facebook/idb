{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.194, "o", "[exited 0 after 0.19s]\r\n"]
[1.194, "m", "Go to the home screen"]
[1.194, "o", "$ idb ui button HOME\r\n"]
[1.384, "o", "[exited 0 after 0.19s]\r\n"]
[1.623, "m", "Check what is where the banner will appear"]
[1.623, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.945, "o", "{\"role\":\"AXGroup\",\"frame\":{\"height\":874,\"width\":402,\"x\":0,\"y\":0},\"AXLabel\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"type\":\"Group\",\"custom_actions\":[],\"AXValue\":null,\"enabled\":true,\"help\":null,\"subrole\":null,\"title\":null,\"content_required\":false,\"pid\":4901,\"role_description\":\"Group\",\"AXUniqueId\":null,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.32s]\r\n"]
[1.946, "m", "Deliver a notification while the app is not running"]
[1.946, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.125, "o", "[exited 0 after 0.18s]\r\n"]
[3.128, "m", "Tap the banner"]
[3.128, "o", "$ idb ui tap 201 90\r\n"]
[3.339, "o", "[exited 0 after 0.21s]\r\n"]
[4.088, "m", "Clear the app's delivered notifications"]
[4.088, "o", "$ idb notification clear com.apple.news\r\n"]
[4.558, "o", "[exited 0 after 0.47s]\r\n"]
[5.067, "m", "List notifications after clearing them"]
[5.067, "o", "$ idb notification list com.apple.news\r\n"]
[5.715, "o", "[exited 0 after 0.65s]\r\n"]
[7.013, "o", ""]
