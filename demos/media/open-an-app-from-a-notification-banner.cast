{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.229, "o", "[exited 0 after 0.23s]\r\n"]
[1.229, "m", "Go to the home screen"]
[1.229, "o", "$ idb ui button HOME\r\n"]
[1.427, "o", "[exited 0 after 0.20s]\r\n"]
[1.724, "m", "Check what is where the banner will appear"]
[1.724, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.027, "o", "{\"pid\":1264,\"custom_actions\":[],\"frame\":{\"y\":0,\"x\":0,\"height\":874,\"width\":402.00000000000006},\"enabled\":true,\"role\":\"AXGroup\",\"help\":null,\"subrole\":null,\"AXLabel\":null,\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"traits\":[\"Scrollable\"],\"AXValue\":null,\"AXUniqueId\":null,\"content_required\":false,\"type\":\"Group\",\"title\":null}\r\n[exited 0 after 0.30s]\r\n"]
[2.028, "m", "Deliver a notification while the app is not running"]
[2.028, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.241, "o", "[exited 0 after 0.21s]\r\n"]
[3.247, "m", "Tap the banner"]
[3.247, "o", "$ idb ui tap 201 90\r\n"]
[3.466, "o", "[exited 0 after 0.22s]\r\n"]
[4.233, "m", "Clear the app's delivered notifications"]
[4.233, "o", "$ idb notification clear com.apple.news\r\n"]
[4.685, "o", "[exited 0 after 0.45s]\r\n"]
[5.38, "m", "List notifications after clearing them"]
[5.38, "o", "$ idb notification list com.apple.news\r\n"]
[5.801, "o", "[exited 0 after 0.42s]\r\n"]
[7.183, "o", ""]
