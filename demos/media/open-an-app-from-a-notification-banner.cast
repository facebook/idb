{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.223, "o", "[exited 0 after 0.22s]\r\n"]
[1.224, "m", "Go to the home screen"]
[1.224, "o", "$ idb ui button HOME\r\n"]
[1.433, "o", "[exited 0 after 0.21s]\r\n"]
[1.69, "m", "Check what is where the banner will appear"]
[1.69, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.252, "o", "{\"AXValue\":null,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"content_required\":false,\"help\":null,\"title\":null,\"subrole\":null,\"role\":\"AXGroup\",\"enabled\":true,\"type\":\"Group\",\"AXLabel\":null,\"pid\":6248,\"frame\":{\"width\":401.99999999999994,\"height\":874,\"x\":0,\"y\":0},\"AXUniqueId\":null,\"role_description\":\"Group\",\"custom_actions\":[]}\r\n[exited 0 after 0.56s]\r\n"]
[2.252, "m", "Deliver a notification while the app is not running"]
[2.252, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.585, "o", "[exited 0 after 0.33s]\r\n"]
[3.588, "m", "Tap the banner"]
[3.588, "o", "$ idb ui tap 201 90\r\n"]
[3.813, "o", "[exited 0 after 0.22s]\r\n"]
[6.28, "m", "Clear the app's delivered notifications"]
[6.28, "o", "$ idb notification clear com.apple.news\r\n"]
[7.294, "o", "[exited 0 after 1.01s]\r\n"]
[8.014, "m", "List notifications after clearing them"]
[8.014, "o", "$ idb notification list com.apple.news\r\n"]
[8.524, "o", "[exited 0 after 0.51s]\r\n"]
[9.352, "o", ""]
