{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.878, "m", "Grant notification permission without showing a prompt"]
[0.878, "o", "$ idb approve com.apple.news notification\r\n"]
[1.138, "o", "[exited 0 after 0.26s]\r\n"]
[1.138, "m", "Go to the home screen"]
[1.138, "o", "$ idb ui button HOME\r\n"]
[1.291, "o", "[exited 0 after 0.15s]\r\n"]
[1.516, "m", "Check what is where the banner will appear"]
[1.516, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.852, "o", "{\"custom_actions\":[],\"content_required\":false,\"AXUniqueId\":null,\"subrole\":null,\"traits\":[\"Scrollable\"],\"help\":null,\"frame\":{\"y\":0,\"width\":401.99999999999994,\"height\":874,\"x\":0},\"AXLabel\":null,\"type\":\"Group\",\"title\":null,\"enabled\":true,\"AXValue\":null,\"role\":\"AXGroup\",\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"pid\":4147}\r\n[exited 0 after 0.34s]\r\n"]
[1.852, "m", "Deliver a notification while the app is not running"]
[1.852, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.027, "o", "[exited 0 after 0.18s]\r\n"]
[3.031, "m", "Tap the banner"]
[3.031, "o", "$ idb ui tap 201 90\r\n"]
[3.253, "o", "[exited 0 after 0.22s]\r\n"]
[3.935, "m", "Clear the app's delivered notifications"]
[3.935, "o", "$ idb notification clear com.apple.news\r\n"]
[4.348, "o", "[exited 0 after 0.41s]\r\n"]
[4.771, "m", "List notifications after clearing them"]
[4.771, "o", "$ idb notification list com.apple.news\r\n"]
[5.325, "o", "[exited 0 after 0.55s]\r\n"]
[6.41, "o", ""]
