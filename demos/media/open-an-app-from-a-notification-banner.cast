{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.282, "o", "[exited 0 after 0.28s]\r\n"]
[1.282, "m", "Go to the home screen"]
[1.282, "o", "$ idb ui button HOME\r\n"]
[1.569, "o", "[exited 0 after 0.29s]\r\n"]
[1.845, "m", "Check what is where the banner will appear"]
[1.845, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.244, "o", "{\"traits\":[\"Scrollable\"],\"subrole\":null,\"content_required\":false,\"role\":\"AXGroup\",\"pid\":1303,\"type\":\"Group\",\"AXUniqueId\":null,\"help\":null,\"enabled\":true,\"custom_actions\":[],\"title\":null,\"AXLabel\":null,\"frame\":{\"x\":0,\"height\":874,\"y\":0,\"width\":401.99999999999994},\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"role_description\":\"Group\"}\r\n[exited 0 after 0.40s]\r\n"]
[2.245, "m", "Deliver a notification while the app is not running"]
[2.245, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.497, "o", "[exited 0 after 0.25s]\r\n"]
[3.501, "m", "Tap the banner"]
[3.501, "o", "$ idb ui tap 201 90\r\n"]
[4.126, "o", "[exited 0 after 0.63s]\r\n"]
[5.097, "m", "Clear the app's delivered notifications"]
[5.097, "o", "$ idb notification clear com.apple.news\r\n"]
[5.779, "o", "[exited 0 after 0.68s]\r\n"]
[6.277, "m", "List notifications after clearing them"]
[6.277, "o", "$ idb notification list com.apple.news\r\n"]
[6.786, "o", "[exited 0 after 0.51s]\r\n"]
[8.432, "o", ""]
