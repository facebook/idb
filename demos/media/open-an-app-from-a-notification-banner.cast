{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.25, "o", "[exited 0 after 0.25s]\r\n"]
[1.25, "m", "Go to the home screen"]
[1.25, "o", "$ idb ui button HOME\r\n"]
[1.445, "o", "[exited 0 after 0.19s]\r\n"]
[1.69, "m", "Check what is where the banner will appear"]
[1.69, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.015, "o", "{\"content_required\":false,\"role_description\":\"Group\",\"type\":\"Group\",\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"pid\":1273,\"traits\":[\"Scrollable\"],\"AXValue\":null,\"AXUniqueId\":null,\"custom_actions\":[],\"enabled\":true,\"AXLabel\":null,\"subrole\":null,\"role\":\"AXGroup\",\"help\":null,\"title\":null,\"frame\":{\"width\":402,\"height\":874,\"x\":0,\"y\":0}}\r\n[exited 0 after 0.33s]\r\n"]
[2.016, "m", "Deliver a notification while the app is not running"]
[2.016, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.243, "o", "[exited 0 after 0.23s]\r\n"]
[3.245, "m", "Tap the banner"]
[3.245, "o", "$ idb ui tap 201 90\r\n"]
[3.725, "o", "[exited 0 after 0.48s]\r\n"]
[4.645, "m", "Clear the app's delivered notifications"]
[4.645, "o", "$ idb notification clear com.apple.news\r\n"]
[5.324, "o", "[exited 0 after 0.68s]\r\n"]
[5.894, "m", "List notifications after clearing them"]
[5.894, "o", "$ idb notification list com.apple.news\r\n"]
[6.441, "o", "[exited 0 after 0.55s]\r\n"]
[8.18, "o", ""]
