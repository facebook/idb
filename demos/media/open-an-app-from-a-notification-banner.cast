{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.223, "o", "[exited 0 after 0.22s]\r\n"]
[1.223, "m", "Go to the home screen"]
[1.223, "o", "$ idb ui button HOME\r\n"]
[1.409, "o", "[exited 0 after 0.19s]\r\n"]
[1.727, "m", "Check what is where the banner will appear"]
[1.727, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.087, "o", "{\"AXValue\":null,\"help\":null,\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"AXLabel\":null,\"enabled\":true,\"AXUniqueId\":null,\"custom_actions\":[],\"role\":\"AXGroup\",\"subrole\":null,\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"content_required\":false,\"pid\":2823,\"frame\":{\"width\":401.99999999999994,\"height\":874,\"x\":0,\"y\":0},\"title\":null}\r\n[exited 0 after 0.36s]\r\n"]
[2.087, "m", "Deliver a notification while the app is not running"]
[2.087, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.307, "o", "[exited 0 after 0.22s]\r\n"]
[3.311, "m", "Tap the banner"]
[3.311, "o", "$ idb ui tap 201 90\r\n"]
[3.63, "o", "[exited 0 after 0.32s]\r\n"]
[4.628, "m", "Clear the app's delivered notifications"]
[4.628, "o", "$ idb notification clear com.apple.news\r\n"]
[5.205, "o", "[exited 0 after 0.58s]\r\n"]
[5.796, "m", "List notifications after clearing them"]
[5.796, "o", "$ idb notification list com.apple.news\r\n"]
[6.294, "o", "[exited 0 after 0.50s]\r\n"]
[8.033, "o", ""]
