{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.416, "o", "[exited 0 after 0.42s]\r\n"]
[1.416, "m", "Go to the home screen"]
[1.416, "o", "$ idb ui button HOME\r\n"]
[1.672, "o", "[exited 0 after 0.26s]\r\n"]
[2.429, "m", "Check what is where the banner will appear"]
[2.429, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.682, "o", "{\"AXLabel\":null,\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"enabled\":true,\"title\":null,\"help\":null,\"frame\":{\"height\":874,\"x\":0,\"y\":0,\"width\":402.00000000000006},\"custom_actions\":[],\"pid\":1309,\"role\":\"AXGroup\",\"AXUniqueId\":null,\"content_required\":false,\"traits\":[\"Scrollable\"],\"subrole\":null,\"type\":\"Group\",\"AXValue\":null}\r\n[exited 0 after 0.25s]\r\n"]
[2.682, "m", "Deliver a notification while the app is not running"]
[2.682, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.898, "o", "[exited 0 after 0.22s]\r\n"]
[3.902, "m", "Tap the banner"]
[3.902, "o", "$ idb ui tap 201 90\r\n"]
[4.396, "o", "[exited 0 after 0.49s]\r\n"]
[6.631, "m", "Clear the app's delivered notifications"]
[6.631, "o", "$ idb notification clear com.apple.news\r\n"]
[8.777, "o", "[exited 0 after 2.15s]\r\n"]
[9.701, "m", "List notifications after clearing them"]
[9.701, "o", "$ idb notification list com.apple.news\r\n"]
[10.286, "o", "[exited 0 after 0.59s]\r\n"]
[11.412, "o", ""]
