{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.272, "o", "[exited 0 after 0.27s]\r\n"]
[1.272, "m", "Go to the home screen"]
[1.272, "o", "$ idb ui button HOME\r\n"]
[1.488, "o", "[exited 0 after 0.22s]\r\n"]
[1.795, "m", "Check what is where the banner will appear"]
[1.795, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.206, "o", "{\"traits\":[\"Scrollable\"],\"AXLabel\":null,\"AXValue\":null,\"title\":null,\"subrole\":null,\"content_required\":false,\"enabled\":true,\"AXUniqueId\":null,\"type\":\"Group\",\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"pid\":1619,\"custom_actions\":[],\"help\":null,\"role_description\":\"Group\",\"frame\":{\"width\":402,\"height\":874,\"y\":0,\"x\":0},\"role\":\"AXGroup\"}\r\n[exited 0 after 0.41s]\r\n"]
[2.206, "m", "Deliver a notification while the app is not running"]
[2.206, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.529, "o", "[exited 0 after 0.32s]\r\n"]
[3.534, "m", "Tap the banner"]
[3.534, "o", "$ idb ui tap 201 90\r\n"]
[3.872, "o", "[exited 0 after 0.34s]\r\n"]
[5.427, "m", "Clear the app's delivered notifications"]
[5.427, "o", "$ idb notification clear com.apple.news\r\n"]
[5.963, "o", "[exited 0 after 0.54s]\r\n"]
[6.381, "m", "List notifications after clearing them"]
[6.381, "o", "$ idb notification list com.apple.news\r\n"]
[7.329, "o", "[exited 0 after 0.95s]\r\n"]
[9.123, "o", ""]
