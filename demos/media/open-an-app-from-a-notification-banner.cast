{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.243, "o", "[exited 0 after 0.24s]\r\n"]
[1.243, "m", "Go to the home screen"]
[1.243, "o", "$ idb ui button HOME\r\n"]
[1.444, "o", "[exited 0 after 0.20s]\r\n"]
[1.703, "m", "Check what is where the banner will appear"]
[1.703, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.098, "o", "{\"traits\":[\"Scrollable\"],\"AXLabel\":null,\"type\":\"Group\",\"title\":null,\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"custom_actions\":[],\"help\":null,\"role\":\"AXGroup\",\"subrole\":null,\"pid\":1279,\"content_required\":false,\"frame\":{\"height\":874,\"x\":0,\"y\":0,\"width\":401.99999999999994},\"AXUniqueId\":null,\"enabled\":true,\"role_description\":\"Group\"}\r\n[exited 0 after 0.40s]\r\n"]
[2.098, "m", "Deliver a notification while the app is not running"]
[2.098, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.317, "o", "[exited 0 after 0.22s]\r\n"]
[3.32, "m", "Tap the banner"]
[3.32, "o", "$ idb ui tap 201 90\r\n"]
[3.707, "o", "[exited 0 after 0.39s]\r\n"]
[4.427, "m", "Clear the app's delivered notifications"]
[4.427, "o", "$ idb notification clear com.apple.news\r\n"]
[4.896, "o", "[exited 0 after 0.47s]\r\n"]
[5.42, "m", "List notifications after clearing them"]
[5.42, "o", "$ idb notification list com.apple.news\r\n"]
[5.948, "o", "[exited 0 after 0.53s]\r\n"]
[7.613, "o", ""]
