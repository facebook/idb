{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.386, "o", "[exited 0 after 0.39s]\r\n"]
[1.387, "m", "Go to the home screen"]
[1.387, "o", "$ idb ui button HOME\r\n"]
[1.622, "o", "[exited 0 after 0.24s]\r\n"]
[1.92, "m", "Check what is where the banner will appear"]
[1.92, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.286, "o", "{\"AXUniqueId\":null,\"role_description\":\"Group\",\"enabled\":true,\"traits\":[\"Scrollable\"],\"frame\":{\"y\":0,\"height\":874,\"x\":0,\"width\":402.00000000000006},\"role\":\"AXGroup\",\"help\":null,\"custom_actions\":[],\"AXLabel\":null,\"type\":\"Group\",\"subrole\":null,\"pid\":1970,\"content_required\":false,\"AXValue\":null,\"title\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\"}\r\n[exited 0 after 0.37s]\r\n"]
[2.286, "m", "Deliver a notification while the app is not running"]
[2.286, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.522, "o", "[exited 0 after 0.24s]\r\n"]
[3.526, "m", "Tap the banner"]
[3.526, "o", "$ idb ui tap 201 90\r\n"]
[3.86, "o", "[exited 0 after 0.33s]\r\n"]
[4.77, "m", "Clear the app's delivered notifications"]
[4.77, "o", "$ idb notification clear com.apple.news\r\n"]
[5.34, "o", "[exited 0 after 0.57s]\r\n"]
[5.968, "m", "List notifications after clearing them"]
[5.968, "o", "$ idb notification list com.apple.news\r\n"]
[6.384, "o", "[exited 0 after 0.42s]\r\n"]
[8.028, "o", ""]
