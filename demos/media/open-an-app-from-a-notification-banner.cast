{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.239, "o", "[exited 0 after 0.24s]\r\n"]
[1.24, "m", "Go to the home screen"]
[1.24, "o", "$ idb ui button HOME\r\n"]
[1.442, "o", "[exited 0 after 0.20s]\r\n"]
[1.685, "m", "Check what is where the banner will appear"]
[1.685, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.068, "o", "{\"frame\":{\"y\":0,\"width\":401.99999999999994,\"x\":0,\"height\":874},\"role\":\"AXGroup\",\"traits\":[\"Scrollable\"],\"custom_actions\":[],\"content_required\":false,\"AXUniqueId\":null,\"type\":\"Group\",\"title\":null,\"pid\":4941,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"enabled\":true,\"AXValue\":null,\"role_description\":\"Group\",\"AXLabel\":null,\"subrole\":null,\"help\":null}\r\n[exited 0 after 0.38s]\r\n"]
[2.069, "m", "Deliver a notification while the app is not running"]
[2.069, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.332, "o", "[exited 0 after 0.26s]\r\n"]
[3.335, "m", "Tap the banner"]
[3.335, "o", "$ idb ui tap 201 90\r\n"]
[3.737, "o", "[exited 0 after 0.40s]\r\n"]
[5.994, "m", "Clear the app's delivered notifications"]
[5.994, "o", "$ idb notification clear com.apple.news\r\n"]
[6.675, "o", "[exited 0 after 0.68s]\r\n"]
[7.955, "m", "List notifications after clearing them"]
[7.955, "o", "$ idb notification list com.apple.news\r\n"]
[8.797, "o", "[exited 0 after 0.84s]\r\n"]
[9.925, "o", ""]
