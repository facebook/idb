{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.22, "o", "[exited 0 after 0.22s]\r\n"]
[1.221, "m", "Go to the home screen"]
[1.221, "o", "$ idb ui button HOME\r\n"]
[1.418, "o", "[exited 0 after 0.20s]\r\n"]
[1.693, "m", "Check what is where the banner will appear"]
[1.693, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.084, "o", "{\"title\":null,\"traits\":[\"Scrollable\"],\"content_required\":false,\"AXLabel\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"AXValue\":null,\"custom_actions\":[],\"pid\":1345,\"enabled\":true,\"role_description\":\"Group\",\"AXUniqueId\":null,\"help\":null,\"type\":\"Group\",\"frame\":{\"width\":402,\"x\":0,\"y\":0,\"height\":874},\"role\":\"AXGroup\",\"subrole\":null}\r\n[exited 0 after 0.39s]\r\n"]
[2.085, "m", "Deliver a notification while the app is not running"]
[2.085, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.31, "o", "[exited 0 after 0.23s]\r\n"]
[3.315, "m", "Tap the banner"]
[3.315, "o", "$ idb ui tap 201 90\r\n"]
[4.081, "o", "[exited 0 after 0.77s]\r\n"]
[4.93, "m", "Clear the app's delivered notifications"]
[4.93, "o", "$ idb notification clear com.apple.news\r\n"]
[5.478, "o", "[exited 0 after 0.55s]\r\n"]
[6.14, "m", "List notifications after clearing them"]
[6.14, "o", "$ idb notification list com.apple.news\r\n"]
[6.621, "o", "[exited 0 after 0.48s]\r\n"]
[8.145, "o", ""]
