{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.263, "o", "[exited 0 after 0.26s]\r\n"]
[1.263, "m", "Go to the home screen"]
[1.263, "o", "$ idb ui button HOME\r\n"]
[1.517, "o", "[exited 0 after 0.25s]\r\n"]
[2.347, "m", "Check what is where the banner will appear"]
[2.347, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.692, "o", "{\"pid\":13938,\"AXUniqueId\":null,\"subrole\":null,\"enabled\":true,\"help\":null,\"frame\":{\"height\":874,\"y\":0,\"width\":401.99999999999994,\"x\":0},\"AXLabel\":null,\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"content_required\":false,\"role\":\"AXGroup\",\"role_description\":\"Group\",\"AXValue\":null,\"title\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"custom_actions\":[]}\r\n[exited 0 after 0.34s]\r\n"]
[2.693, "m", "Deliver a notification while the app is not running"]
[2.693, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[3.033, "o", "[exited 0 after 0.34s]\r\n"]
[4.036, "m", "Tap the banner"]
[4.036, "o", "$ idb ui tap 201 90\r\n"]
[4.319, "o", "[exited 0 after 0.28s]\r\n"]
[5.086, "m", "Clear the app's delivered notifications"]
[5.086, "o", "$ idb notification clear com.apple.news\r\n"]
[5.716, "o", "[exited 0 after 0.63s]\r\n"]
[6.323, "m", "List notifications after clearing them"]
[6.323, "o", "$ idb notification list com.apple.news\r\n"]
[6.99, "o", "[exited 0 after 0.67s]\r\n"]
[8.647, "o", ""]
