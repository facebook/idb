{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.294, "o", "[exited 0 after 0.29s]\r\n"]
[1.295, "m", "Go to the home screen"]
[1.295, "o", "$ idb ui button HOME\r\n"]
[1.555, "o", "[exited 0 after 0.26s]\r\n"]
[2.19, "m", "Check what is where the banner will appear"]
[2.19, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.408, "o", "{\"enabled\":true,\"subrole\":null,\"pid\":4523,\"frame\":{\"x\":0,\"width\":402,\"height\":874,\"y\":0},\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"title\":null,\"custom_actions\":[],\"type\":\"Group\",\"AXUniqueId\":null,\"AXValue\":null,\"AXLabel\":null,\"role\":\"AXGroup\",\"role_description\":\"Group\",\"traits\":[\"Scrollable\"],\"help\":null,\"content_required\":false}\r\n[exited 0 after 0.22s]\r\n"]
[2.409, "m", "Deliver a notification while the app is not running"]
[2.409, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.692, "o", "[exited 0 after 0.28s]\r\n"]
[3.696, "m", "Tap the banner"]
[3.696, "o", "$ idb ui tap 201 90\r\n"]
[3.988, "o", "[exited 0 after 0.29s]\r\n"]
[5.005, "m", "Clear the app's delivered notifications"]
[5.005, "o", "$ idb notification clear com.apple.news\r\n"]
[5.469, "o", "[exited 0 after 0.46s]\r\n"]
[6.038, "m", "List notifications after clearing them"]
[6.038, "o", "$ idb notification list com.apple.news\r\n"]
[6.478, "o", "[exited 0 after 0.44s]\r\n"]
[8.145, "o", ""]
