{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.974, "m", "Grant notification permission without showing a prompt"]
[0.974, "o", "$ idb approve com.apple.news notification\r\n"]
[1.222, "o", "[exited 0 after 0.25s]\r\n"]
[1.222, "m", "Go to the home screen"]
[1.222, "o", "$ idb ui button HOME\r\n"]
[1.398, "o", "[exited 0 after 0.18s]\r\n"]
[1.67, "m", "Check what is where the banner will appear"]
[1.67, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.989, "o", "{\"help\":null,\"title\":null,\"AXLabel\":null,\"pid\":1327,\"role\":\"AXGroup\",\"AXUniqueId\":null,\"content_required\":false,\"role_description\":\"Group\",\"AXValue\":null,\"frame\":{\"width\":402.00000000000006,\"x\":0,\"y\":0,\"height\":874},\"enabled\":true,\"type\":\"Group\",\"subrole\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"traits\":[\"Scrollable\"],\"custom_actions\":[]}\r\n[exited 0 after 0.32s]\r\n"]
[1.989, "m", "Deliver a notification while the app is not running"]
[1.989, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.346, "o", "[exited 0 after 0.36s]\r\n"]
[3.349, "m", "Tap the banner"]
[3.349, "o", "$ idb ui tap 201 90\r\n"]
[3.637, "o", "[exited 0 after 0.29s]\r\n"]
[4.282, "m", "Clear the app's delivered notifications"]
[4.282, "o", "$ idb notification clear com.apple.news\r\n"]
[4.775, "o", "[exited 0 after 0.49s]\r\n"]
[5.277, "m", "List notifications after clearing them"]
[5.277, "o", "$ idb notification list com.apple.news\r\n"]
[5.679, "o", "[exited 0 after 0.40s]\r\n"]
[6.922, "o", ""]
