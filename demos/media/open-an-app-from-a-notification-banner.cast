{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.216, "o", "[exited 0 after 0.22s]\r\n"]
[1.216, "m", "Go to the home screen"]
[1.216, "o", "$ idb ui button HOME\r\n"]
[1.427, "o", "[exited 0 after 0.21s]\r\n"]
[1.672, "m", "Check what is where the banner will appear"]
[1.672, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.054, "o", "{\"title\":null,\"content_required\":false,\"AXUniqueId\":null,\"AXLabel\":null,\"role\":\"AXGroup\",\"frame\":{\"x\":0,\"width\":402.00000000000006,\"y\":0,\"height\":874},\"AXValue\":null,\"type\":\"Group\",\"subrole\":null,\"pid\":1948,\"help\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"custom_actions\":[],\"role_description\":\"Group\",\"traits\":[\"Scrollable\"],\"enabled\":true}\r\n[exited 0 after 0.38s]\r\n"]
[2.054, "m", "Deliver a notification while the app is not running"]
[2.054, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.282, "o", "[exited 0 after 0.23s]\r\n"]
[3.286, "m", "Tap the banner"]
[3.286, "o", "$ idb ui tap 201 90\r\n"]
[3.603, "o", "[exited 0 after 0.32s]\r\n"]
[4.882, "m", "Clear the app's delivered notifications"]
[4.882, "o", "$ idb notification clear com.apple.news\r\n"]
[5.497, "o", "[exited 0 after 0.61s]\r\n"]
[5.955, "m", "List notifications after clearing them"]
[5.955, "o", "$ idb notification list com.apple.news\r\n"]
[6.449, "o", "[exited 0 after 0.49s]\r\n"]
[8.112, "o", ""]
