{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.252, "o", "[exited 0 after 0.25s]\r\n"]
[1.252, "m", "Go to the home screen"]
[1.252, "o", "$ idb ui button HOME\r\n"]
[1.481, "o", "[exited 0 after 0.23s]\r\n"]
[1.715, "m", "Check what is where the banner will appear"]
[1.715, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.526, "o", "{\"AXLabel\":null,\"subrole\":null,\"help\":null,\"frame\":{\"height\":874,\"y\":0,\"width\":402.00000000000006,\"x\":0},\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"title\":null,\"content_required\":false,\"role\":\"AXGroup\",\"AXUniqueId\":null,\"role_description\":\"Group\",\"type\":\"Group\",\"pid\":1506,\"custom_actions\":[],\"AXValue\":null,\"enabled\":true,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.81s]\r\n"]
[2.527, "m", "Deliver a notification while the app is not running"]
[2.527, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.949, "o", "[exited 0 after 0.42s]\r\n"]
[3.952, "m", "Tap the banner"]
[3.952, "o", "$ idb ui tap 201 90\r\n"]
[4.137, "o", "[exited 0 after 0.18s]\r\n"]
[4.76, "m", "Clear the app's delivered notifications"]
[4.76, "o", "$ idb notification clear com.apple.news\r\n"]
[5.183, "o", "[exited 0 after 0.42s]\r\n"]
[5.661, "m", "List notifications after clearing them"]
[5.661, "o", "$ idb notification list com.apple.news\r\n"]
[6.135, "o", "[exited 0 after 0.47s]\r\n"]
[7.393, "o", ""]
