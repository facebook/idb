{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.243, "o", "[exited 0 after 0.24s]\r\n"]
[1.243, "m", "Go to the home screen"]
[1.243, "o", "$ idb ui button HOME\r\n"]
[1.445, "o", "[exited 0 after 0.20s]\r\n"]
[1.683, "m", "Check what is where the banner will appear"]
[1.683, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.061, "o", "{\"traits\":[\"Scrollable\"],\"title\":null,\"help\":null,\"AXLabel\":null,\"role\":\"AXGroup\",\"subrole\":null,\"enabled\":true,\"AXValue\":null,\"AXUniqueId\":null,\"frame\":{\"x\":0,\"y\":0,\"height\":874,\"width\":402.00000000000006},\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"role_description\":\"Group\",\"type\":\"Group\",\"pid\":2460,\"content_required\":false,\"custom_actions\":[]}\r\n[exited 0 after 0.38s]\r\n"]
[2.061, "m", "Deliver a notification while the app is not running"]
[2.061, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.287, "o", "[exited 0 after 0.23s]\r\n"]
[3.29, "m", "Tap the banner"]
[3.29, "o", "$ idb ui tap 201 90\r\n"]
[3.711, "o", "[exited 0 after 0.42s]\r\n"]
[4.67, "m", "Clear the app's delivered notifications"]
[4.67, "o", "$ idb notification clear com.apple.news\r\n"]
[5.204, "o", "[exited 0 after 0.53s]\r\n"]
[5.826, "m", "List notifications after clearing them"]
[5.826, "o", "$ idb notification list com.apple.news\r\n"]
[6.26, "o", "[exited 0 after 0.43s]\r\n"]
[8.185, "o", ""]
