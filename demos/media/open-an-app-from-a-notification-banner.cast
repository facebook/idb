{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.235, "o", "[exited 0 after 0.24s]\r\n"]
[1.235, "m", "Go to the home screen"]
[1.235, "o", "$ idb ui button HOME\r\n"]
[1.446, "o", "[exited 0 after 0.21s]\r\n"]
[1.742, "m", "Check what is where the banner will appear"]
[1.742, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.156, "o", "{\"type\":\"Group\",\"AXUniqueId\":null,\"content_required\":false,\"pid\":14442,\"title\":null,\"AXLabel\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"help\":null,\"AXValue\":null,\"custom_actions\":[],\"role_description\":\"Group\",\"role\":\"AXGroup\",\"traits\":[\"Scrollable\"],\"enabled\":true,\"frame\":{\"y\":0,\"height\":874,\"x\":0,\"width\":402},\"subrole\":null}\r\n[exited 0 after 0.41s]\r\n"]
[2.156, "m", "Deliver a notification while the app is not running"]
[2.156, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.422, "o", "[exited 0 after 0.27s]\r\n"]
[3.424, "m", "Tap the banner"]
[3.424, "o", "$ idb ui tap 201 90\r\n"]
[3.615, "o", "[exited 0 after 0.19s]\r\n"]
[4.37, "m", "Clear the app's delivered notifications"]
[4.37, "o", "$ idb notification clear com.apple.news\r\n"]
[4.824, "o", "[exited 0 after 0.45s]\r\n"]
[5.303, "m", "List notifications after clearing them"]
[5.303, "o", "$ idb notification list com.apple.news\r\n"]
[5.796, "o", "[exited 0 after 0.49s]\r\n"]
[7.293, "o", ""]
