{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.252, "o", "[exited 0 after 0.25s]\r\n"]
[1.253, "m", "Go to the home screen"]
[1.253, "o", "$ idb ui button HOME\r\n"]
[1.473, "o", "[exited 0 after 0.22s]\r\n"]
[1.889, "m", "Check what is where the banner will appear"]
[1.889, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.172, "o", "{\"role_description\":\"Group\",\"traits\":[\"Scrollable\"],\"AXUniqueId\":null,\"frame\":{\"width\":402.00000000000006,\"y\":0,\"x\":0,\"height\":874},\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"AXValue\":null,\"role\":\"AXGroup\",\"title\":null,\"content_required\":false,\"pid\":1834,\"help\":null,\"enabled\":true,\"AXLabel\":null,\"type\":\"Group\",\"custom_actions\":[],\"subrole\":null}\r\n[exited 0 after 0.28s]\r\n"]
[2.172, "m", "Deliver a notification while the app is not running"]
[2.172, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.399, "o", "[exited 0 after 0.23s]\r\n"]
[3.402, "m", "Tap the banner"]
[3.402, "o", "$ idb ui tap 201 90\r\n"]
[3.681, "o", "[exited 0 after 0.28s]\r\n"]
[4.954, "m", "Clear the app's delivered notifications"]
[4.954, "o", "$ idb notification clear com.apple.news\r\n"]
[5.537, "o", "[exited 0 after 0.58s]\r\n"]
[6.051, "m", "List notifications after clearing them"]
[6.051, "o", "$ idb notification list com.apple.news\r\n"]
[6.517, "o", "[exited 0 after 0.47s]\r\n"]
[8.0, "o", ""]
