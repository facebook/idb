{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.272, "o", "[exited 0 after 0.27s]\r\n"]
[1.273, "m", "Go to the home screen"]
[1.273, "o", "$ idb ui button HOME\r\n"]
[1.454, "o", "[exited 0 after 0.18s]\r\n"]
[1.743, "m", "Check what is where the banner will appear"]
[1.743, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.166, "o", "{\"AXLabel\":null,\"role\":\"AXGroup\",\"role_description\":\"Group\",\"type\":\"Group\",\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"enabled\":true,\"AXUniqueId\":null,\"pid\":2685,\"traits\":[\"Scrollable\"],\"help\":null,\"custom_actions\":[],\"title\":null,\"AXValue\":null,\"subrole\":null,\"content_required\":false,\"frame\":{\"height\":874,\"y\":0,\"width\":402,\"x\":0}}\r\n[exited 0 after 0.42s]\r\n"]
[2.166, "m", "Deliver a notification while the app is not running"]
[2.166, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.425, "o", "[exited 0 after 0.26s]\r\n"]
[3.429, "m", "Tap the banner"]
[3.429, "o", "$ idb ui tap 201 90\r\n"]
[3.702, "o", "[exited 0 after 0.27s]\r\n"]
[4.599, "m", "Clear the app's delivered notifications"]
[4.599, "o", "$ idb notification clear com.apple.news\r\n"]
[5.107, "o", "[exited 0 after 0.51s]\r\n"]
[5.663, "m", "List notifications after clearing them"]
[5.663, "o", "$ idb notification list com.apple.news\r\n"]
[6.169, "o", "[exited 0 after 0.51s]\r\n"]
[8.158, "o", ""]
