{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.221, "o", "[exited 0 after 0.22s]\r\n"]
[1.221, "m", "Go to the home screen"]
[1.221, "o", "$ idb ui button HOME\r\n"]
[1.407, "o", "[exited 0 after 0.19s]\r\n"]
[1.721, "m", "Check what is where the banner will appear"]
[1.721, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.09, "o", "{\"help\":null,\"role_description\":\"Group\",\"enabled\":true,\"traits\":[\"Scrollable\"],\"AXValue\":null,\"AXUniqueId\":null,\"pid\":1303,\"subrole\":null,\"content_required\":false,\"custom_actions\":[],\"type\":\"Group\",\"role\":\"AXGroup\",\"AXLabel\":null,\"title\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"frame\":{\"x\":0,\"width\":402,\"height\":874,\"y\":0}}\r\n[exited 0 after 0.37s]\r\n"]
[2.091, "m", "Deliver a notification while the app is not running"]
[2.091, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.328, "o", "[exited 0 after 0.24s]\r\n"]
[3.341, "m", "Tap the banner"]
[3.341, "o", "$ idb ui tap 201 90\r\n"]
[3.681, "o", "[exited 0 after 0.34s]\r\n"]
[4.512, "m", "Clear the app's delivered notifications"]
[4.512, "o", "$ idb notification clear com.apple.news\r\n"]
[5.025, "o", "[exited 0 after 0.51s]\r\n"]
[5.58, "m", "List notifications after clearing them"]
[5.58, "o", "$ idb notification list com.apple.news\r\n"]
[5.991, "o", "[exited 0 after 0.41s]\r\n"]
[7.163, "o", ""]
