{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.3, "o", "[exited 0 after 0.30s]\r\n"]
[1.3, "m", "Go to the home screen"]
[1.3, "o", "$ idb ui button HOME\r\n"]
[1.497, "o", "[exited 0 after 0.20s]\r\n"]
[1.734, "m", "Check what is where the banner will appear"]
[1.734, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.254, "o", "{\"type\":\"Group\",\"AXUniqueId\":null,\"content_required\":false,\"role_description\":\"Group\",\"AXValue\":null,\"role\":\"AXGroup\",\"custom_actions\":[],\"title\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"enabled\":true,\"frame\":{\"y\":0,\"x\":0,\"width\":402,\"height\":874},\"help\":null,\"subrole\":null,\"AXLabel\":null,\"pid\":1318,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.52s]\r\n"]
[2.255, "m", "Deliver a notification while the app is not running"]
[2.255, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.712, "o", "[exited 0 after 0.46s]\r\n"]
[3.716, "m", "Tap the banner"]
[3.716, "o", "$ idb ui tap 201 90\r\n"]
[3.931, "o", "[exited 0 after 0.22s]\r\n"]
[5.07, "m", "Clear the app's delivered notifications"]
[5.07, "o", "$ idb notification clear com.apple.news\r\n"]
[5.705, "o", "[exited 0 after 0.64s]\r\n"]
[6.3, "m", "List notifications after clearing them"]
[6.3, "o", "$ idb notification list com.apple.news\r\n"]
[6.834, "o", "[exited 0 after 0.53s]\r\n"]
[9.013, "o", ""]
