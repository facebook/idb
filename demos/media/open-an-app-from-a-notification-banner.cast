{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.948, "m", "Grant notification permission without showing a prompt"]
[0.948, "o", "$ idb approve com.apple.news notification\r\n"]
[1.172, "o", "[exited 0 after 0.22s]\r\n"]
[1.172, "m", "Go to the home screen"]
[1.172, "o", "$ idb ui button HOME\r\n"]
[1.339, "o", "[exited 0 after 0.17s]\r\n"]
[1.542, "m", "Check what is where the banner will appear"]
[1.542, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.938, "o", "{\"content_required\":false,\"help\":null,\"pid\":2597,\"AXUniqueId\":null,\"AXLabel\":null,\"role_description\":\"Group\",\"enabled\":true,\"AXValue\":null,\"custom_actions\":[],\"traits\":[\"Scrollable\"],\"subrole\":null,\"role\":\"AXGroup\",\"title\":null,\"frame\":{\"y\":0,\"width\":402,\"x\":0,\"height\":874},\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"type\":\"Group\"}\r\n[exited 0 after 0.40s]\r\n"]
[1.939, "m", "Deliver a notification while the app is not running"]
[1.939, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.149, "o", "[exited 0 after 0.21s]\r\n"]
[3.152, "m", "Tap the banner"]
[3.152, "o", "$ idb ui tap 201 90\r\n"]
[3.474, "o", "[exited 0 after 0.32s]\r\n"]
[4.068, "m", "Clear the app's delivered notifications"]
[4.068, "o", "$ idb notification clear com.apple.news\r\n"]
[4.498, "o", "[exited 0 after 0.43s]\r\n"]
[4.906, "m", "List notifications after clearing them"]
[4.906, "o", "$ idb notification list com.apple.news\r\n"]
[5.356, "o", "[exited 0 after 0.45s]\r\n"]
[6.29, "o", ""]
