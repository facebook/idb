{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.271, "o", "[exited 0 after 0.27s]\r\n"]
[1.272, "m", "Go to the home screen"]
[1.272, "o", "$ idb ui button HOME\r\n"]
[1.547, "o", "[exited 0 after 0.28s]\r\n"]
[2.672, "m", "Check what is where the banner will appear"]
[2.672, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.932, "o", "{\"subrole\":null,\"content_required\":false,\"AXValue\":null,\"frame\":{\"height\":874,\"y\":0,\"width\":402,\"x\":0},\"AXLabel\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"traits\":[\"Scrollable\"],\"custom_actions\":[],\"title\":null,\"role_description\":\"Group\",\"role\":\"AXGroup\",\"AXUniqueId\":null,\"pid\":2940,\"type\":\"Group\",\"help\":null,\"enabled\":true}\r\n[exited 0 after 0.26s]\r\n"]
[2.932, "m", "Deliver a notification while the app is not running"]
[2.932, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[3.171, "o", "[exited 0 after 0.24s]\r\n"]
[4.176, "m", "Tap the banner"]
[4.176, "o", "$ idb ui tap 201 90\r\n"]
[4.462, "o", "[exited 0 after 0.29s]\r\n"]
[5.343, "m", "Clear the app's delivered notifications"]
[5.343, "o", "$ idb notification clear com.apple.news\r\n"]
[5.856, "o", "[exited 0 after 0.51s]\r\n"]
[6.357, "m", "List notifications after clearing them"]
[6.357, "o", "$ idb notification list com.apple.news\r\n"]
[6.853, "o", "[exited 0 after 0.50s]\r\n"]
[8.2, "o", ""]
