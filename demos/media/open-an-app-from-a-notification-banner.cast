{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.967, "m", "Grant notification permission without showing a prompt"]
[0.967, "o", "$ idb approve com.apple.news notification\r\n"]
[1.156, "o", "[exited 0 after 0.19s]\r\n"]
[1.157, "m", "Go to the home screen"]
[1.157, "o", "$ idb ui button HOME\r\n"]
[1.345, "o", "[exited 0 after 0.19s]\r\n"]
[1.605, "m", "Check what is where the banner will appear"]
[1.605, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.998, "o", "{\"content_required\":false,\"pid\":2066,\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"custom_actions\":[],\"type\":\"Group\",\"AXValue\":null,\"frame\":{\"y\":0,\"width\":401.99999999999994,\"height\":874,\"x\":0},\"AXUniqueId\":null,\"subrole\":null,\"traits\":[\"Scrollable\"],\"help\":null,\"title\":null,\"AXLabel\":null,\"enabled\":true,\"role\":\"AXGroup\"}\r\n[exited 0 after 0.39s]\r\n"]
[1.998, "m", "Deliver a notification while the app is not running"]
[1.998, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.233, "o", "[exited 0 after 0.23s]\r\n"]
[3.235, "m", "Tap the banner"]
[3.235, "o", "$ idb ui tap 201 90\r\n"]
[3.441, "o", "[exited 0 after 0.21s]\r\n"]
[4.124, "m", "Clear the app's delivered notifications"]
[4.124, "o", "$ idb notification clear com.apple.news\r\n"]
[4.5, "o", "[exited 0 after 0.38s]\r\n"]
[4.965, "m", "List notifications after clearing them"]
[4.965, "o", "$ idb notification list com.apple.news\r\n"]
[5.464, "o", "[exited 0 after 0.50s]\r\n"]
[7.083, "o", ""]
