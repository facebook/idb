{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.293, "o", "[exited 0 after 0.29s]\r\n"]
[1.294, "m", "Go to the home screen"]
[1.294, "o", "$ idb ui button HOME\r\n"]
[1.496, "o", "[exited 0 after 0.20s]\r\n"]
[1.743, "m", "Check what is where the banner will appear"]
[1.743, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.166, "o", "{\"AXValue\":null,\"AXUniqueId\":null,\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"enabled\":true,\"content_required\":false,\"AXLabel\":null,\"frame\":{\"width\":402.00000000000006,\"y\":0,\"x\":0,\"height\":874},\"help\":null,\"subrole\":null,\"traits\":[\"Scrollable\"],\"role\":\"AXGroup\",\"title\":null,\"role_description\":\"Group\",\"type\":\"Group\",\"pid\":5070}\r\n[exited 0 after 0.42s]\r\n"]
[2.166, "m", "Deliver a notification while the app is not running"]
[2.166, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.44, "o", "[exited 0 after 0.27s]\r\n"]
[3.444, "m", "Tap the banner"]
[3.444, "o", "$ idb ui tap 201 90\r\n"]
[3.704, "o", "[exited 0 after 0.26s]\r\n"]
[4.504, "m", "Clear the app's delivered notifications"]
[4.504, "o", "$ idb notification clear com.apple.news\r\n"]
[4.99, "o", "[exited 0 after 0.49s]\r\n"]
[5.551, "m", "List notifications after clearing them"]
[5.551, "o", "$ idb notification list com.apple.news\r\n"]
[5.965, "o", "[exited 0 after 0.41s]\r\n"]
[7.28, "o", ""]
