{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.274, "o", "[exited 0 after 0.27s]\r\n"]
[1.274, "m", "Go to the home screen"]
[1.274, "o", "$ idb ui button HOME\r\n"]
[1.451, "o", "[exited 0 after 0.18s]\r\n"]
[1.682, "m", "Check what is where the banner will appear"]
[1.682, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.073, "o", "{\"traits\":[\"Scrollable\"],\"custom_actions\":[],\"role\":\"AXGroup\",\"subrole\":null,\"title\":null,\"role_description\":\"Group\",\"content_required\":false,\"AXUniqueId\":null,\"frame\":{\"x\":0,\"y\":0,\"height\":874,\"width\":401.99999999999994},\"pid\":1313,\"enabled\":true,\"AXLabel\":null,\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"type\":\"Group\",\"help\":null}\r\n[exited 0 after 0.39s]\r\n"]
[2.073, "m", "Deliver a notification while the app is not running"]
[2.073, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.345, "o", "[exited 0 after 0.27s]\r\n"]
[3.347, "m", "Tap the banner"]
[3.347, "o", "$ idb ui tap 201 90\r\n"]
[4.004, "o", "[exited 0 after 0.66s]\r\n"]
[5.022, "m", "Clear the app's delivered notifications"]
[5.022, "o", "$ idb notification clear com.apple.news\r\n"]
[5.605, "o", "[exited 0 after 0.58s]\r\n"]
[6.061, "m", "List notifications after clearing them"]
[6.061, "o", "$ idb notification list com.apple.news\r\n"]
[7.011, "o", "[exited 0 after 0.95s]\r\n"]
[8.263, "o", ""]
