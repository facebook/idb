{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.246, "o", "[exited 0 after 0.25s]\r\n"]
[1.246, "m", "Go to the home screen"]
[1.246, "o", "$ idb ui button HOME\r\n"]
[1.45, "o", "[exited 0 after 0.20s]\r\n"]
[1.68, "m", "Check what is where the banner will appear"]
[1.68, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.03, "o", "{\"AXUniqueId\":null,\"enabled\":true,\"role_description\":\"Group\",\"title\":null,\"custom_actions\":[],\"traits\":[\"Scrollable\"],\"pid\":1367,\"subrole\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"AXValue\":null,\"role\":\"AXGroup\",\"help\":null,\"type\":\"Group\",\"content_required\":false,\"AXLabel\":null,\"frame\":{\"height\":874,\"y\":0,\"x\":0,\"width\":401.99999999999994}}\r\n[exited 0 after 0.35s]\r\n"]
[2.03, "m", "Deliver a notification while the app is not running"]
[2.03, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.221, "o", "[exited 0 after 0.19s]\r\n"]
[3.225, "m", "Tap the banner"]
[3.225, "o", "$ idb ui tap 201 90\r\n"]
[3.474, "o", "[exited 0 after 0.25s]\r\n"]
[4.107, "m", "Clear the app's delivered notifications"]
[4.107, "o", "$ idb notification clear com.apple.news\r\n"]
[4.595, "o", "[exited 0 after 0.49s]\r\n"]
[5.169, "m", "List notifications after clearing them"]
[5.169, "o", "$ idb notification list com.apple.news\r\n"]
[5.639, "o", "[exited 0 after 0.47s]\r\n"]
[7.257, "o", ""]
