{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.297, "o", "[exited 0 after 0.30s]\r\n"]
[1.298, "m", "Go to the home screen"]
[1.298, "o", "$ idb ui button HOME\r\n"]
[1.533, "o", "[exited 0 after 0.24s]\r\n"]
[2.368, "m", "Check what is where the banner will appear"]
[2.368, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.775, "o", "{\"AXValue\":null,\"custom_actions\":[],\"role\":\"AXGroup\",\"subrole\":null,\"title\":null,\"content_required\":false,\"AXLabel\":null,\"help\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"enabled\":true,\"type\":\"Group\",\"pid\":1331,\"role_description\":\"Group\",\"traits\":[\"Scrollable\"],\"AXUniqueId\":null,\"frame\":{\"x\":0,\"height\":874,\"y\":0,\"width\":402}}\r\n[exited 0 after 0.41s]\r\n"]
[2.776, "m", "Deliver a notification while the app is not running"]
[2.776, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[3.091, "o", "[exited 0 after 0.31s]\r\n"]
[4.094, "m", "Tap the banner"]
[4.094, "o", "$ idb ui tap 201 90\r\n"]
[4.352, "o", "[exited 0 after 0.26s]\r\n"]
[5.707, "m", "Clear the app's delivered notifications"]
[5.707, "o", "$ idb notification clear com.apple.news\r\n"]
[6.388, "o", "[exited 0 after 0.68s]\r\n"]
[6.899, "m", "List notifications after clearing them"]
[6.899, "o", "$ idb notification list com.apple.news\r\n"]
[7.413, "o", "[exited 0 after 0.51s]\r\n"]
[9.378, "o", ""]
