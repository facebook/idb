{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.299, "o", "[exited 0 after 0.30s]\r\n"]
[1.3, "m", "Go to the home screen"]
[1.3, "o", "$ idb ui button HOME\r\n"]
[1.584, "o", "[exited 0 after 0.28s]\r\n"]
[1.967, "m", "Check what is where the banner will appear"]
[1.967, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.542, "o", "{\"role\":\"AXGroup\",\"enabled\":true,\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"traits\":[\"Scrollable\"],\"frame\":{\"x\":0,\"width\":401.99999999999994,\"y\":0,\"height\":874},\"AXLabel\":null,\"type\":\"Group\",\"title\":null,\"AXValue\":null,\"AXUniqueId\":null,\"role_description\":\"Group\",\"content_required\":false,\"help\":null,\"subrole\":null,\"pid\":1309}\r\n[exited 0 after 0.57s]\r\n"]
[2.543, "m", "Deliver a notification while the app is not running"]
[2.543, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.88, "o", "[exited 0 after 0.34s]\r\n"]
[3.882, "m", "Tap the banner"]
[3.882, "o", "$ idb ui tap 201 90\r\n"]
[4.299, "o", "[exited 0 after 0.42s]\r\n"]
[5.938, "m", "Clear the app's delivered notifications"]
[5.938, "o", "$ idb notification clear com.apple.news\r\n"]
[6.721, "o", "[exited 0 after 0.78s]\r\n"]
[7.352, "m", "List notifications after clearing them"]
[7.352, "o", "$ idb notification list com.apple.news\r\n"]
[7.93, "o", "[exited 0 after 0.58s]\r\n"]
[10.252, "o", ""]
