{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.233, "o", "[exited 0 after 0.23s]\r\n"]
[1.233, "m", "Go to the home screen"]
[1.233, "o", "$ idb ui button HOME\r\n"]
[1.424, "o", "[exited 0 after 0.19s]\r\n"]
[1.666, "m", "Check what is where the banner will appear"]
[1.666, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.995, "o", "{\"content_required\":false,\"title\":null,\"AXValue\":null,\"custom_actions\":[],\"pid\":1278,\"traits\":[\"Scrollable\"],\"enabled\":true,\"role\":\"AXGroup\",\"help\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"type\":\"Group\",\"subrole\":null,\"AXUniqueId\":null,\"role_description\":\"Group\",\"frame\":{\"x\":0,\"y\":0,\"width\":402,\"height\":874},\"AXLabel\":null}\r\n[exited 0 after 0.33s]\r\n"]
[1.996, "m", "Deliver a notification while the app is not running"]
[1.996, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.214, "o", "[exited 0 after 0.22s]\r\n"]
[3.216, "m", "Tap the banner"]
[3.216, "o", "$ idb ui tap 201 90\r\n"]
[3.405, "o", "[exited 0 after 0.19s]\r\n"]
[4.08, "m", "Clear the app's delivered notifications"]
[4.08, "o", "$ idb notification clear com.apple.news\r\n"]
[4.493, "o", "[exited 0 after 0.41s]\r\n"]
[4.918, "m", "List notifications after clearing them"]
[4.918, "o", "$ idb notification list com.apple.news\r\n"]
[5.342, "o", "[exited 0 after 0.42s]\r\n"]
[6.708, "o", ""]
