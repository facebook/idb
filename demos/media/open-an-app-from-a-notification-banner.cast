{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.248, "o", "[exited 0 after 0.25s]\r\n"]
[1.248, "m", "Go to the home screen"]
[1.248, "o", "$ idb ui button HOME\r\n"]
[1.453, "o", "[exited 0 after 0.20s]\r\n"]
[1.714, "m", "Check what is where the banner will appear"]
[1.714, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.323, "o", "{\"content_required\":false,\"role_description\":\"Group\",\"frame\":{\"x\":0,\"y\":0,\"width\":402,\"height\":874},\"subrole\":null,\"enabled\":true,\"custom_actions\":[],\"type\":\"Group\",\"help\":null,\"AXUniqueId\":null,\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"traits\":[\"Scrollable\"],\"title\":null,\"AXLabel\":null,\"pid\":1625,\"role\":\"AXGroup\"}\r\n[exited 0 after 0.61s]\r\n"]
[2.323, "m", "Deliver a notification while the app is not running"]
[2.323, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.629, "o", "[exited 0 after 0.31s]\r\n"]
[3.632, "m", "Tap the banner"]
[3.632, "o", "$ idb ui tap 201 90\r\n"]
[3.95, "o", "[exited 0 after 0.32s]\r\n"]
[5.213, "m", "Clear the app's delivered notifications"]
[5.213, "o", "$ idb notification clear com.apple.news\r\n"]
[5.846, "o", "[exited 0 after 0.63s]\r\n"]
[6.446, "m", "List notifications after clearing them"]
[6.446, "o", "$ idb notification list com.apple.news\r\n"]
[7.018, "o", "[exited 0 after 0.57s]\r\n"]
[8.88, "o", ""]
