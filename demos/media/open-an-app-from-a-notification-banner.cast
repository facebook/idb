{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.272, "o", "[exited 0 after 0.27s]\r\n"]
[1.272, "m", "Go to the home screen"]
[1.272, "o", "$ idb ui button HOME\r\n"]
[1.504, "o", "[exited 0 after 0.23s]\r\n"]
[1.82, "m", "Check what is where the banner will appear"]
[1.82, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.26, "o", "{\"AXValue\":null,\"pid\":1305,\"enabled\":true,\"title\":null,\"AXUniqueId\":null,\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"content_required\":false,\"AXLabel\":null,\"help\":null,\"role_description\":\"Group\",\"frame\":{\"width\":401.99999999999994,\"y\":0,\"x\":0,\"height\":874},\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"subrole\":null,\"role\":\"AXGroup\"}\r\n[exited 0 after 0.44s]\r\n"]
[2.261, "m", "Deliver a notification while the app is not running"]
[2.261, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.536, "o", "[exited 0 after 0.28s]\r\n"]
[3.54, "m", "Tap the banner"]
[3.54, "o", "$ idb ui tap 201 90\r\n"]
[4.067, "o", "[exited 0 after 0.53s]\r\n"]
[5.384, "m", "Clear the app's delivered notifications"]
[5.384, "o", "$ idb notification clear com.apple.news\r\n"]
[6.006, "o", "[exited 0 after 0.62s]\r\n"]
[6.555, "m", "List notifications after clearing them"]
[6.555, "o", "$ idb notification list com.apple.news\r\n"]
[7.029, "o", "[exited 0 after 0.47s]\r\n"]
[9.303, "o", ""]
