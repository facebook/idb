{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.323, "o", "[exited 0 after 0.32s]\r\n"]
[1.324, "m", "Go to the home screen"]
[1.324, "o", "$ idb ui button HOME\r\n"]
[1.524, "o", "[exited 0 after 0.20s]\r\n"]
[1.791, "m", "Check what is where the banner will appear"]
[1.791, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.207, "o", "{\"content_required\":false,\"AXLabel\":null,\"help\":null,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"enabled\":true,\"type\":\"Group\",\"AXUniqueId\":null,\"pid\":1304,\"role_description\":\"Group\",\"custom_actions\":[],\"subrole\":null,\"role\":\"AXGroup\",\"title\":null,\"AXValue\":null,\"frame\":{\"width\":402.00000000000006,\"x\":0,\"y\":0,\"height\":874}}\r\n[exited 0 after 0.42s]\r\n"]
[2.207, "m", "Deliver a notification while the app is not running"]
[2.207, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.446, "o", "[exited 0 after 0.24s]\r\n"]
[3.455, "m", "Tap the banner"]
[3.455, "o", "$ idb ui tap 201 90\r\n"]
[3.775, "o", "[exited 0 after 0.32s]\r\n"]
[5.01, "m", "Clear the app's delivered notifications"]
[5.01, "o", "$ idb notification clear com.apple.news\r\n"]
[5.644, "o", "[exited 0 after 0.63s]\r\n"]
[6.174, "m", "List notifications after clearing them"]
[6.174, "o", "$ idb notification list com.apple.news\r\n"]
[6.67, "o", "[exited 0 after 0.50s]\r\n"]
[8.217, "o", ""]
