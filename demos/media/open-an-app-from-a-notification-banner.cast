{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.332, "o", "[exited 0 after 0.33s]\r\n"]
[1.332, "m", "Go to the home screen"]
[1.332, "o", "$ idb ui button HOME\r\n"]
[1.601, "o", "[exited 0 after 0.27s]\r\n"]
[2.04, "m", "Check what is where the banner will appear"]
[2.04, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.356, "o", "{\"title\":null,\"AXLabel\":null,\"custom_actions\":[],\"AXValue\":null,\"type\":\"Group\",\"pid\":1906,\"AXUniqueId\":null,\"content_required\":false,\"subrole\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"role\":\"AXGroup\",\"enabled\":true,\"frame\":{\"y\":0,\"height\":874,\"width\":402.00000000000006,\"x\":0},\"traits\":[\"Scrollable\"],\"role_description\":\"Group\",\"help\":null}\r\n[exited 0 after 0.32s]\r\n"]
[2.356, "m", "Deliver a notification while the app is not running"]
[2.356, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.612, "o", "[exited 0 after 0.26s]\r\n"]
[3.616, "m", "Tap the banner"]
[3.616, "o", "$ idb ui tap 201 90\r\n"]
[3.941, "o", "[exited 0 after 0.33s]\r\n"]
[5.09, "m", "Clear the app's delivered notifications"]
[5.09, "o", "$ idb notification clear com.apple.news\r\n"]
[5.803, "o", "[exited 0 after 0.71s]\r\n"]
[6.292, "m", "List notifications after clearing them"]
[6.292, "o", "$ idb notification list com.apple.news\r\n"]
[6.71, "o", "[exited 0 after 0.42s]\r\n"]
[8.638, "o", ""]
