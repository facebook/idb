{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.271, "o", "[exited 0 after 0.27s]\r\n"]
[1.271, "m", "Go to the home screen"]
[1.271, "o", "$ idb ui button HOME\r\n"]
[1.477, "o", "[exited 0 after 0.21s]\r\n"]
[1.727, "m", "Check what is where the banner will appear"]
[1.727, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.092, "o", "{\"role_description\":\"Group\",\"type\":\"Group\",\"help\":null,\"AXValue\":null,\"pid\":1303,\"content_required\":false,\"AXUniqueId\":null,\"custom_actions\":[],\"subrole\":null,\"title\":null,\"frame\":{\"width\":402,\"x\":0,\"y\":0,\"height\":874},\"enabled\":true,\"traits\":[\"Scrollable\"],\"AXLabel\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"role\":\"AXGroup\"}\r\n[exited 0 after 0.36s]\r\n"]
[2.092, "m", "Deliver a notification while the app is not running"]
[2.092, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.324, "o", "[exited 0 after 0.23s]\r\n"]
[3.328, "m", "Tap the banner"]
[3.328, "o", "$ idb ui tap 201 90\r\n"]
[3.882, "o", "[exited 0 after 0.55s]\r\n"]
[5.125, "m", "Clear the app's delivered notifications"]
[5.125, "o", "$ idb notification clear com.apple.news\r\n"]
[5.938, "o", "[exited 0 after 0.81s]\r\n"]
[6.39, "m", "List notifications after clearing them"]
[6.39, "o", "$ idb notification list com.apple.news\r\n"]
[7.105, "o", "[exited 0 after 0.72s]\r\n"]
[8.933, "o", ""]
