{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.286, "o", "[exited 0 after 0.29s]\r\n"]
[1.286, "m", "Go to the home screen"]
[1.286, "o", "$ idb ui button HOME\r\n"]
[1.523, "o", "[exited 0 after 0.24s]\r\n"]
[1.779, "m", "Check what is where the banner will appear"]
[1.779, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.181, "o", "{\"AXLabel\":null,\"frame\":{\"x\":0,\"width\":402.00000000000006,\"y\":0,\"height\":874},\"pid\":1312,\"AXValue\":null,\"custom_actions\":[],\"enabled\":true,\"content_required\":false,\"title\":null,\"subrole\":null,\"role\":\"AXGroup\",\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"AXUniqueId\":null,\"help\":null,\"role_description\":\"Group\"}\r\n[exited 0 after 0.40s]\r\n"]
[2.181, "m", "Deliver a notification while the app is not running"]
[2.181, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.448, "o", "[exited 0 after 0.27s]\r\n"]
[3.452, "m", "Tap the banner"]
[3.452, "o", "$ idb ui tap 201 90\r\n"]
[4.107, "o", "[exited 0 after 0.66s]\r\n"]
[9.862, "m", "Clear the app's delivered notifications"]
[9.862, "o", "$ idb notification clear com.apple.news\r\n"]
[10.71, "o", "[exited 0 after 0.85s]\r\n"]
[11.242, "m", "List notifications after clearing them"]
[11.242, "o", "$ idb notification list com.apple.news\r\n"]
[11.71, "o", "[exited 0 after 0.47s]\r\n"]
[12.785, "o", ""]
