{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.465, "o", "[exited 0 after 0.47s]\r\n"]
[1.466, "m", "Go to the home screen"]
[1.466, "o", "$ idb ui button HOME\r\n"]
[1.701, "o", "[exited 0 after 0.24s]\r\n"]
[1.964, "m", "Check what is where the banner will appear"]
[1.964, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.299, "o", "{\"pid\":2128,\"frame\":{\"height\":874,\"x\":0,\"y\":0,\"width\":402.00000000000006},\"AXUniqueId\":null,\"AXValue\":null,\"type\":\"Group\",\"help\":null,\"custom_actions\":[],\"AXLabel\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"subrole\":null,\"role\":\"AXGroup\",\"traits\":[\"Scrollable\"],\"role_description\":\"Group\",\"enabled\":true,\"title\":null,\"content_required\":false}\r\n[exited 0 after 0.33s]\r\n"]
[2.3, "m", "Deliver a notification while the app is not running"]
[2.3, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.496, "o", "[exited 0 after 0.20s]\r\n"]
[3.501, "m", "Tap the banner"]
[3.501, "o", "$ idb ui tap 201 90\r\n"]
[3.722, "o", "[exited 0 after 0.22s]\r\n"]
[4.617, "m", "Clear the app's delivered notifications"]
[4.617, "o", "$ idb notification clear com.apple.news\r\n"]
[5.09, "o", "[exited 0 after 0.47s]\r\n"]
[5.55, "m", "List notifications after clearing them"]
[5.55, "o", "$ idb notification list com.apple.news\r\n"]
[6.029, "o", "[exited 0 after 0.48s]\r\n"]
[7.28, "o", ""]
