{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.284, "o", "[exited 0 after 0.28s]\r\n"]
[1.284, "m", "Go to the home screen"]
[1.284, "o", "$ idb ui button HOME\r\n"]
[1.471, "o", "[exited 0 after 0.19s]\r\n"]
[1.736, "m", "Check what is where the banner will appear"]
[1.736, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.142, "o", "{\"AXLabel\":null,\"type\":\"Group\",\"subrole\":null,\"pid\":1332,\"help\":null,\"AXValue\":null,\"role_description\":\"Group\",\"role\":\"AXGroup\",\"enabled\":true,\"title\":null,\"AXUniqueId\":null,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"frame\":{\"width\":402.00000000000006,\"x\":0,\"y\":0,\"height\":874},\"custom_actions\":[],\"content_required\":false}\r\n[exited 0 after 0.41s]\r\n"]
[2.142, "m", "Deliver a notification while the app is not running"]
[2.142, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.482, "o", "[exited 0 after 0.34s]\r\n"]
[3.485, "m", "Tap the banner"]
[3.485, "o", "$ idb ui tap 201 90\r\n"]
[3.673, "o", "[exited 0 after 0.19s]\r\n"]
[4.837, "m", "Clear the app's delivered notifications"]
[4.837, "o", "$ idb notification clear com.apple.news\r\n"]
[5.323, "o", "[exited 0 after 0.49s]\r\n"]
[5.866, "m", "List notifications after clearing them"]
[5.866, "o", "$ idb notification list com.apple.news\r\n"]
[6.331, "o", "[exited 0 after 0.47s]\r\n"]
[7.693, "o", ""]
