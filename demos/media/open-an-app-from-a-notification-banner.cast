{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.988, "m", "Grant notification permission without showing a prompt"]
[0.988, "o", "$ idb approve com.apple.news notification\r\n"]
[1.184, "o", "[exited 0 after 0.20s]\r\n"]
[1.184, "m", "Go to the home screen"]
[1.184, "o", "$ idb ui button HOME\r\n"]
[1.367, "o", "[exited 0 after 0.18s]\r\n"]
[1.598, "m", "Check what is where the banner will appear"]
[1.598, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.054, "o", "{\"pid\":1337,\"role_description\":\"Group\",\"AXValue\":null,\"enabled\":true,\"title\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"subrole\":null,\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"frame\":{\"x\":0,\"width\":402,\"height\":874,\"y\":0},\"custom_actions\":[],\"role\":\"AXGroup\",\"AXLabel\":null,\"AXUniqueId\":null,\"help\":null,\"content_required\":false}\r\n[exited 0 after 0.46s]\r\n"]
[2.055, "m", "Deliver a notification while the app is not running"]
[2.055, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.326, "o", "[exited 0 after 0.27s]\r\n"]
[3.329, "m", "Tap the banner"]
[3.329, "o", "$ idb ui tap 201 90\r\n"]
[3.503, "o", "[exited 0 after 0.17s]\r\n"]
[4.112, "m", "Clear the app's delivered notifications"]
[4.112, "o", "$ idb notification clear com.apple.news\r\n"]
[4.514, "o", "[exited 0 after 0.40s]\r\n"]
[4.956, "m", "List notifications after clearing them"]
[4.956, "o", "$ idb notification list com.apple.news\r\n"]
[5.529, "o", "[exited 0 after 0.57s]\r\n"]
[6.775, "o", ""]
