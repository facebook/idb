{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.224, "o", "[exited 0 after 0.22s]\r\n"]
[1.225, "m", "Go to the home screen"]
[1.225, "o", "$ idb ui button HOME\r\n"]
[1.401, "o", "[exited 0 after 0.18s]\r\n"]
[1.654, "m", "Check what is where the banner will appear"]
[1.654, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.033, "o", "{\"frame\":{\"height\":874,\"x\":0,\"width\":401.99999999999994,\"y\":0},\"AXValue\":null,\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"type\":\"Group\",\"AXLabel\":null,\"pid\":1902,\"role_description\":\"Group\",\"traits\":[\"Scrollable\"],\"help\":null,\"title\":null,\"AXUniqueId\":null,\"subrole\":null,\"enabled\":true,\"role\":\"AXGroup\",\"content_required\":false}\r\n[exited 0 after 0.38s]\r\n"]
[2.033, "m", "Deliver a notification while the app is not running"]
[2.033, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.209, "o", "[exited 0 after 0.18s]\r\n"]
[3.211, "m", "Tap the banner"]
[3.211, "o", "$ idb ui tap 201 90\r\n"]
[3.458, "o", "[exited 0 after 0.25s]\r\n"]
[4.308, "m", "Clear the app's delivered notifications"]
[4.308, "o", "$ idb notification clear com.apple.news\r\n"]
[4.802, "o", "[exited 0 after 0.49s]\r\n"]
[5.382, "m", "List notifications after clearing them"]
[5.382, "o", "$ idb notification list com.apple.news\r\n"]
[5.787, "o", "[exited 0 after 0.41s]\r\n"]
[7.49, "o", ""]
