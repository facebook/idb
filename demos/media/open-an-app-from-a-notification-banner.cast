{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.187, "o", "[exited 0 after 0.19s]\r\n"]
[1.187, "m", "Go to the home screen"]
[1.187, "o", "$ idb ui button HOME\r\n"]
[1.4, "o", "[exited 0 after 0.21s]\r\n"]
[1.615, "m", "Check what is where the banner will appear"]
[1.615, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.948, "o", "{\"AXLabel\":null,\"custom_actions\":[],\"role\":\"AXGroup\",\"frame\":{\"x\":0,\"y\":0,\"height\":874,\"width\":402},\"subrole\":null,\"content_required\":false,\"pid\":1322,\"role_description\":\"Group\",\"traits\":[\"Scrollable\"],\"help\":null,\"type\":\"Group\",\"title\":null,\"AXUniqueId\":null,\"enabled\":true,\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\"}\r\n[exited 0 after 0.33s]\r\n"]
[1.949, "m", "Deliver a notification while the app is not running"]
[1.949, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.143, "o", "[exited 0 after 0.19s]\r\n"]
[3.147, "m", "Tap the banner"]
[3.147, "o", "$ idb ui tap 201 90\r\n"]
[3.468, "o", "[exited 0 after 0.32s]\r\n"]
[4.17, "m", "Clear the app's delivered notifications"]
[4.17, "o", "$ idb notification clear com.apple.news\r\n"]
[4.763, "o", "[exited 0 after 0.59s]\r\n"]
[5.303, "m", "List notifications after clearing them"]
[5.303, "o", "$ idb notification list com.apple.news\r\n"]
[5.774, "o", "[exited 0 after 0.47s]\r\n"]
[7.142, "o", ""]
