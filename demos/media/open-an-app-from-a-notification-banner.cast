{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.269, "o", "[exited 0 after 0.27s]\r\n"]
[1.269, "m", "Go to the home screen"]
[1.269, "o", "$ idb ui button HOME\r\n"]
[1.507, "o", "[exited 0 after 0.24s]\r\n"]
[2.159, "m", "Check what is where the banner will appear"]
[2.159, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.48, "o", "{\"role\":\"AXGroup\",\"enabled\":true,\"subrole\":null,\"custom_actions\":[],\"frame\":{\"height\":874,\"y\":0,\"width\":402,\"x\":0},\"traits\":[\"Scrollable\"],\"pid\":13369,\"AXUniqueId\":null,\"content_required\":false,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"title\":null,\"type\":\"Group\",\"help\":null,\"role_description\":\"Group\",\"AXValue\":null,\"AXLabel\":null}\r\n[exited 0 after 0.32s]\r\n"]
[2.48, "m", "Deliver a notification while the app is not running"]
[2.48, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.788, "o", "[exited 0 after 0.31s]\r\n"]
[3.792, "m", "Tap the banner"]
[3.792, "o", "$ idb ui tap 201 90\r\n"]
[4.323, "o", "[exited 0 after 0.53s]\r\n"]
[5.233, "m", "Clear the app's delivered notifications"]
[5.233, "o", "$ idb notification clear com.apple.news\r\n"]
[5.838, "o", "[exited 0 after 0.61s]\r\n"]
[6.526, "m", "List notifications after clearing them"]
[6.526, "o", "$ idb notification list com.apple.news\r\n"]
[7.058, "o", "[exited 0 after 0.53s]\r\n"]
[8.872, "o", ""]
