{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.255, "o", "[exited 0 after 0.25s]\r\n"]
[1.255, "m", "Go to the home screen"]
[1.255, "o", "$ idb ui button HOME\r\n"]
[1.432, "o", "[exited 0 after 0.18s]\r\n"]
[1.718, "m", "Check what is where the banner will appear"]
[1.718, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.138, "o", "{\"AXValue\":null,\"content_required\":false,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"subrole\":null,\"help\":null,\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"enabled\":true,\"role\":\"AXGroup\",\"pid\":2881,\"AXUniqueId\":null,\"frame\":{\"width\":402.00000000000006,\"height\":874,\"x\":0,\"y\":0},\"custom_actions\":[],\"AXLabel\":null,\"role_description\":\"Group\",\"title\":null}\r\n[exited 0 after 0.42s]\r\n"]
[2.138, "m", "Deliver a notification while the app is not running"]
[2.138, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.355, "o", "[exited 0 after 0.22s]\r\n"]
[3.357, "m", "Tap the banner"]
[3.357, "o", "$ idb ui tap 201 90\r\n"]
[3.631, "o", "[exited 0 after 0.27s]\r\n"]
[4.485, "m", "Clear the app's delivered notifications"]
[4.485, "o", "$ idb notification clear com.apple.news\r\n"]
[4.901, "o", "[exited 0 after 0.42s]\r\n"]
[5.604, "m", "List notifications after clearing them"]
[5.604, "o", "$ idb notification list com.apple.news\r\n"]
[6.012, "o", "[exited 0 after 0.41s]\r\n"]
[7.322, "o", ""]
