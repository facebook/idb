{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.23, "o", "[exited 0 after 0.23s]\r\n"]
[1.23, "m", "Go to the home screen"]
[1.23, "o", "$ idb ui button HOME\r\n"]
[1.448, "o", "[exited 0 after 0.22s]\r\n"]
[1.732, "m", "Check what is where the banner will appear"]
[1.732, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.377, "o", "{\"frame\":{\"height\":874,\"x\":0,\"y\":0,\"width\":402.00000000000006},\"title\":null,\"role_description\":\"Group\",\"type\":\"Group\",\"enabled\":true,\"help\":null,\"AXValue\":null,\"role\":\"AXGroup\",\"pid\":1330,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"AXUniqueId\":null,\"custom_actions\":[],\"AXLabel\":null,\"content_required\":false,\"traits\":[\"Scrollable\"],\"subrole\":null}\r\n[exited 0 after 0.65s]\r\n"]
[2.377, "m", "Deliver a notification while the app is not running"]
[2.377, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.646, "o", "[exited 0 after 0.27s]\r\n"]
[3.652, "m", "Tap the banner"]
[3.652, "o", "$ idb ui tap 201 90\r\n"]
[3.914, "o", "[exited 0 after 0.26s]\r\n"]
[4.634, "m", "Clear the app's delivered notifications"]
[4.634, "o", "$ idb notification clear com.apple.news\r\n"]
[5.185, "o", "[exited 0 after 0.55s]\r\n"]
[5.74, "m", "List notifications after clearing them"]
[5.74, "o", "$ idb notification list com.apple.news\r\n"]
[6.387, "o", "[exited 0 after 0.65s]\r\n"]
[8.385, "o", ""]
