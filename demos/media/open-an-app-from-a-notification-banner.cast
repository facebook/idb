{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.237, "o", "[exited 0 after 0.24s]\r\n"]
[1.237, "m", "Go to the home screen"]
[1.237, "o", "$ idb ui button HOME\r\n"]
[1.44, "o", "[exited 0 after 0.20s]\r\n"]
[1.699, "m", "Check what is where the banner will appear"]
[1.699, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.161, "o", "{\"custom_actions\":[],\"help\":null,\"content_required\":false,\"role_description\":\"Group\",\"AXValue\":null,\"pid\":2485,\"title\":null,\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"role\":\"AXGroup\",\"subrole\":null,\"frame\":{\"width\":402.00000000000006,\"height\":874,\"x\":0,\"y\":0},\"enabled\":true,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"AXLabel\":null,\"AXUniqueId\":null}\r\n[exited 0 after 0.46s]\r\n"]
[2.162, "m", "Deliver a notification while the app is not running"]
[2.162, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.463, "o", "[exited 0 after 0.30s]\r\n"]
[3.467, "m", "Tap the banner"]
[3.467, "o", "$ idb ui tap 201 90\r\n"]
[4.1, "o", "[exited 0 after 0.63s]\r\n"]
[5.543, "m", "Clear the app's delivered notifications"]
[5.543, "o", "$ idb notification clear com.apple.news\r\n"]
[6.058, "o", "[exited 0 after 0.51s]\r\n"]
[6.629, "m", "List notifications after clearing them"]
[6.629, "o", "$ idb notification list com.apple.news\r\n"]
[7.737, "o", "[exited 0 after 1.11s]\r\n"]
[9.02, "o", ""]
