{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.954, "m", "Grant notification permission without showing a prompt"]
[0.954, "o", "$ idb approve com.apple.news notification\r\n"]
[1.177, "o", "[exited 0 after 0.22s]\r\n"]
[1.177, "m", "Go to the home screen"]
[1.177, "o", "$ idb ui button HOME\r\n"]
[1.352, "o", "[exited 0 after 0.17s]\r\n"]
[1.634, "m", "Check what is where the banner will appear"]
[1.634, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.979, "o", "{\"custom_actions\":[],\"AXLabel\":null,\"frame\":{\"x\":0,\"width\":402.00000000000006,\"height\":874,\"y\":0},\"role_description\":\"Group\",\"content_required\":false,\"help\":null,\"subrole\":null,\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"title\":null,\"type\":\"Group\",\"enabled\":true,\"AXValue\":null,\"pid\":9898,\"AXUniqueId\":null,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.35s]\r\n"]
[1.979, "m", "Deliver a notification while the app is not running"]
[1.979, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.177, "o", "[exited 0 after 0.20s]\r\n"]
[3.179, "m", "Tap the banner"]
[3.179, "o", "$ idb ui tap 201 90\r\n"]
[3.426, "o", "[exited 0 after 0.25s]\r\n"]
[4.064, "m", "Clear the app's delivered notifications"]
[4.064, "o", "$ idb notification clear com.apple.news\r\n"]
[4.43, "o", "[exited 0 after 0.37s]\r\n"]
[4.874, "m", "List notifications after clearing them"]
[4.874, "o", "$ idb notification list com.apple.news\r\n"]
[5.259, "o", "[exited 0 after 0.39s]\r\n"]
[6.423, "o", ""]
