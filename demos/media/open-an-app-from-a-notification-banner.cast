{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.224, "o", "[exited 0 after 0.22s]\r\n"]
[1.224, "m", "Go to the home screen"]
[1.224, "o", "$ idb ui button HOME\r\n"]
[1.397, "o", "[exited 0 after 0.17s]\r\n"]
[1.611, "m", "Check what is where the banner will appear"]
[1.611, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.013, "o", "{\"AXUniqueId\":null,\"frame\":{\"height\":874,\"y\":0,\"x\":0,\"width\":401.99999999999994},\"type\":\"Group\",\"help\":null,\"enabled\":true,\"content_required\":false,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"title\":null,\"custom_actions\":[],\"AXLabel\":null,\"pid\":1275,\"AXValue\":null,\"subrole\":null,\"role\":\"AXGroup\",\"role_description\":\"Group\"}\r\n[exited 0 after 0.40s]\r\n"]
[2.013, "m", "Deliver a notification while the app is not running"]
[2.013, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.374, "o", "[exited 0 after 0.36s]\r\n"]
[3.379, "m", "Tap the banner"]
[3.379, "o", "$ idb ui tap 201 90\r\n"]
[3.595, "o", "[exited 0 after 0.22s]\r\n"]
[4.487, "m", "Clear the app's delivered notifications"]
[4.487, "o", "$ idb notification clear com.apple.news\r\n"]
[4.96, "o", "[exited 0 after 0.47s]\r\n"]
[5.492, "m", "List notifications after clearing them"]
[5.492, "o", "$ idb notification list com.apple.news\r\n"]
[5.89, "o", "[exited 0 after 0.40s]\r\n"]
[7.235, "o", ""]
