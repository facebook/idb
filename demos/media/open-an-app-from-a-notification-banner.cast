{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.189, "o", "[exited 0 after 0.19s]\r\n"]
[1.19, "m", "Go to the home screen"]
[1.19, "o", "$ idb ui button HOME\r\n"]
[1.39, "o", "[exited 0 after 0.20s]\r\n"]
[1.634, "m", "Check what is where the banner will appear"]
[1.634, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.213, "o", "{\"AXValue\":null,\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"enabled\":true,\"frame\":{\"y\":0,\"width\":402.00000000000006,\"height\":874,\"x\":0},\"AXUniqueId\":null,\"title\":null,\"pid\":1903,\"content_required\":false,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"AXLabel\":null,\"role\":\"AXGroup\",\"role_description\":\"Group\",\"subrole\":null,\"custom_actions\":[],\"help\":null}\r\n[exited 0 after 0.58s]\r\n"]
[2.214, "m", "Deliver a notification while the app is not running"]
[2.214, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.604, "o", "[exited 0 after 0.39s]\r\n"]
[3.609, "m", "Tap the banner"]
[3.609, "o", "$ idb ui tap 201 90\r\n"]
[4.723, "o", "[exited 0 after 1.11s]\r\n"]
[6.172, "m", "Clear the app's delivered notifications"]
[6.172, "o", "$ idb notification clear com.apple.news\r\n"]
[6.733, "o", "[exited 0 after 0.56s]\r\n"]
[7.54, "m", "List notifications after clearing them"]
[7.54, "o", "$ idb notification list com.apple.news\r\n"]
[8.147, "o", "[exited 0 after 0.61s]\r\n"]
[8.94, "o", ""]
