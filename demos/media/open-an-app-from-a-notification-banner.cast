{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.282, "o", "[exited 0 after 0.28s]\r\n"]
[1.282, "m", "Go to the home screen"]
[1.282, "o", "$ idb ui button HOME\r\n"]
[1.476, "o", "[exited 0 after 0.19s]\r\n"]
[1.722, "m", "Check what is where the banner will appear"]
[1.722, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.359, "o", "{\"traits\":[\"Scrollable\"],\"title\":null,\"AXValue\":null,\"custom_actions\":[],\"AXUniqueId\":null,\"role_description\":\"Group\",\"type\":\"Group\",\"help\":null,\"content_required\":false,\"role\":\"AXGroup\",\"subrole\":null,\"pid\":1296,\"enabled\":true,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"frame\":{\"height\":874,\"width\":402,\"x\":0,\"y\":0},\"AXLabel\":null}\r\n[exited 0 after 0.64s]\r\n"]
[2.359, "m", "Deliver a notification while the app is not running"]
[2.359, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.569, "o", "[exited 0 after 0.21s]\r\n"]
[3.572, "m", "Tap the banner"]
[3.572, "o", "$ idb ui tap 201 90\r\n"]
[3.761, "o", "[exited 0 after 0.19s]\r\n"]
[4.419, "m", "Clear the app's delivered notifications"]
[4.419, "o", "$ idb notification clear com.apple.news\r\n"]
[4.836, "o", "[exited 0 after 0.42s]\r\n"]
[5.279, "m", "List notifications after clearing them"]
[5.279, "o", "$ idb notification list com.apple.news\r\n"]
[5.828, "o", "[exited 0 after 0.55s]\r\n"]
[7.188, "o", ""]
