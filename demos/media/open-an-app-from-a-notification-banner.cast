{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.333, "o", "[exited 0 after 0.33s]\r\n"]
[1.333, "m", "Go to the home screen"]
[1.333, "o", "$ idb ui button HOME\r\n"]
[1.529, "o", "[exited 0 after 0.20s]\r\n"]
[2.422, "m", "Check what is where the banner will appear"]
[2.422, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.911, "o", "{\"role_description\":\"Group\",\"subrole\":null,\"AXLabel\":null,\"help\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"frame\":{\"y\":0,\"x\":0,\"height\":874,\"width\":402},\"type\":\"Group\",\"content_required\":false,\"AXUniqueId\":null,\"AXValue\":null,\"traits\":[\"Scrollable\"],\"custom_actions\":[],\"pid\":1436,\"title\":null,\"role\":\"AXGroup\",\"enabled\":true}\r\n[exited 0 after 0.49s]\r\n"]
[2.912, "m", "Deliver a notification while the app is not running"]
[2.912, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[3.21, "o", "[exited 0 after 0.30s]\r\n"]
[4.213, "m", "Tap the banner"]
[4.213, "o", "$ idb ui tap 201 90\r\n"]
[4.45, "o", "[exited 0 after 0.24s]\r\n"]
[5.486, "m", "Clear the app's delivered notifications"]
[5.486, "o", "$ idb notification clear com.apple.news\r\n"]
[5.994, "o", "[exited 0 after 0.51s]\r\n"]
[6.589, "m", "List notifications after clearing them"]
[6.589, "o", "$ idb notification list com.apple.news\r\n"]
[6.997, "o", "[exited 0 after 0.41s]\r\n"]
[8.847, "o", ""]
