{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.244, "o", "[exited 0 after 0.24s]\r\n"]
[1.244, "m", "Go to the home screen"]
[1.244, "o", "$ idb ui button HOME\r\n"]
[1.435, "o", "[exited 0 after 0.19s]\r\n"]
[1.709, "m", "Check what is where the banner will appear"]
[1.709, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.305, "o", "{\"AXLabel\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"subrole\":null,\"AXValue\":null,\"content_required\":false,\"frame\":{\"y\":0,\"x\":0,\"width\":401.99999999999994,\"height\":874},\"title\":null,\"custom_actions\":[],\"role\":\"AXGroup\",\"help\":null,\"AXUniqueId\":null,\"traits\":[\"Scrollable\"],\"role_description\":\"Group\",\"enabled\":true,\"pid\":1325,\"type\":\"Group\"}\r\n[exited 0 after 0.60s]\r\n"]
[2.306, "m", "Deliver a notification while the app is not running"]
[2.306, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.522, "o", "[exited 0 after 0.22s]\r\n"]
[3.526, "m", "Tap the banner"]
[3.526, "o", "$ idb ui tap 201 90\r\n"]
[3.756, "o", "[exited 0 after 0.23s]\r\n"]
[5.904, "m", "Clear the app's delivered notifications"]
[5.904, "o", "$ idb notification clear com.apple.news\r\n"]
[6.931, "o", "[exited 0 after 1.03s]\r\n"]
[7.799, "m", "List notifications after clearing them"]
[7.799, "o", "$ idb notification list com.apple.news\r\n"]
[8.419, "o", "[exited 0 after 0.62s]\r\n"]
[9.303, "o", ""]
