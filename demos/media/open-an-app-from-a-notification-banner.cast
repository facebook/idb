{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.984, "m", "Grant notification permission without showing a prompt"]
[0.984, "o", "$ idb approve com.apple.news notification\r\n"]
[1.217, "o", "[exited 0 after 0.23s]\r\n"]
[1.217, "m", "Go to the home screen"]
[1.217, "o", "$ idb ui button HOME\r\n"]
[1.393, "o", "[exited 0 after 0.18s]\r\n"]
[1.631, "m", "Check what is where the banner will appear"]
[1.631, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.087, "o", "{\"custom_actions\":[],\"AXLabel\":null,\"type\":\"Group\",\"AXUniqueId\":null,\"role_description\":\"Group\",\"traits\":[\"Scrollable\"],\"AXValue\":null,\"frame\":{\"width\":401.99999999999994,\"y\":0,\"height\":874,\"x\":0},\"role\":\"AXGroup\",\"title\":null,\"pid\":4516,\"content_required\":false,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"subrole\":null,\"enabled\":true,\"help\":null}\r\n[exited 0 after 0.46s]\r\n"]
[2.088, "m", "Deliver a notification while the app is not running"]
[2.088, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.346, "o", "[exited 0 after 0.26s]\r\n"]
[3.35, "m", "Tap the banner"]
[3.35, "o", "$ idb ui tap 201 90\r\n"]
[3.526, "o", "[exited 0 after 0.18s]\r\n"]
[4.067, "m", "Clear the app's delivered notifications"]
[4.067, "o", "$ idb notification clear com.apple.news\r\n"]
[4.615, "o", "[exited 0 after 0.55s]\r\n"]
[5.055, "m", "List notifications after clearing them"]
[5.055, "o", "$ idb notification list com.apple.news\r\n"]
[5.495, "o", "[exited 0 after 0.44s]\r\n"]
[6.748, "o", ""]
