{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.281, "o", "[exited 0 after 0.28s]\r\n"]
[1.282, "m", "Go to the home screen"]
[1.282, "o", "$ idb ui button HOME\r\n"]
[1.48, "o", "[exited 0 after 0.20s]\r\n"]
[1.734, "m", "Check what is where the banner will appear"]
[1.734, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.147, "o", "{\"type\":\"Group\",\"pid\":1288,\"help\":null,\"AXUniqueId\":null,\"enabled\":true,\"content_required\":false,\"title\":null,\"AXLabel\":null,\"subrole\":null,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"AXValue\":null,\"custom_actions\":[],\"role_description\":\"Group\",\"role\":\"AXGroup\",\"frame\":{\"width\":401.99999999999994,\"height\":874,\"x\":0,\"y\":0}}\r\n[exited 0 after 0.41s]\r\n"]
[2.148, "m", "Deliver a notification while the app is not running"]
[2.148, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.437, "o", "[exited 0 after 0.29s]\r\n"]
[3.439, "m", "Tap the banner"]
[3.439, "o", "$ idb ui tap 201 90\r\n"]
[3.709, "o", "[exited 0 after 0.27s]\r\n"]
[5.002, "m", "Clear the app's delivered notifications"]
[5.002, "o", "$ idb notification clear com.apple.news\r\n"]
[5.78, "o", "[exited 0 after 0.78s]\r\n"]
[6.322, "m", "List notifications after clearing them"]
[6.322, "o", "$ idb notification list com.apple.news\r\n"]
[7.029, "o", "[exited 0 after 0.71s]\r\n"]
[8.723, "o", ""]
