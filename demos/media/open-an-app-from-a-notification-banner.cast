{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.193, "o", "[exited 0 after 0.19s]\r\n"]
[1.194, "m", "Go to the home screen"]
[1.194, "o", "$ idb ui button HOME\r\n"]
[1.375, "o", "[exited 0 after 0.18s]\r\n"]
[1.576, "m", "Check what is where the banner will appear"]
[1.576, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.044, "o", "{\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"content_required\":false,\"AXUniqueId\":null,\"role\":\"AXGroup\",\"traits\":[\"Scrollable\"],\"frame\":{\"x\":0,\"width\":401.99999999999994,\"y\":0,\"height\":874},\"type\":\"Group\",\"enabled\":true,\"pid\":1293,\"subrole\":null,\"title\":null,\"help\":null,\"AXLabel\":null,\"custom_actions\":[],\"role_description\":\"Group\"}\r\n[exited 0 after 0.47s]\r\n"]
[2.044, "m", "Deliver a notification while the app is not running"]
[2.044, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.344, "o", "[exited 0 after 0.30s]\r\n"]
[3.347, "m", "Tap the banner"]
[3.347, "o", "$ idb ui tap 201 90\r\n"]
[3.599, "o", "[exited 0 after 0.25s]\r\n"]
[4.323, "m", "Clear the app's delivered notifications"]
[4.323, "o", "$ idb notification clear com.apple.news\r\n"]
[4.815, "o", "[exited 0 after 0.49s]\r\n"]
[5.283, "m", "List notifications after clearing them"]
[5.283, "o", "$ idb notification list com.apple.news\r\n"]
[5.708, "o", "[exited 0 after 0.43s]\r\n"]
[6.938, "o", ""]
