{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.202, "o", "[exited 0 after 0.20s]\r\n"]
[1.202, "m", "Go to the home screen"]
[1.202, "o", "$ idb ui button HOME\r\n"]
[1.368, "o", "[exited 0 after 0.17s]\r\n"]
[1.578, "m", "Check what is where the banner will appear"]
[1.578, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.879, "o", "{\"help\":null,\"enabled\":true,\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"title\":null,\"content_required\":false,\"AXLabel\":null,\"AXValue\":null,\"AXUniqueId\":null,\"pid\":46692,\"frame\":{\"y\":0,\"width\":402.00000000000006,\"x\":0,\"height\":874},\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"subrole\":null,\"custom_actions\":[],\"role\":\"AXGroup\",\"role_description\":\"Group\"}\r\n[exited 0 after 0.30s]\r\n"]
[1.879, "m", "Deliver a notification while the app is not running"]
[1.879, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.052, "o", "[exited 0 after 0.17s]\r\n"]
[3.052, "m", "Tap the banner"]
[3.052, "o", "$ idb ui tap 201 90\r\n"]
[3.274, "o", "[exited 0 after 0.22s]\r\n"]
[3.916, "m", "Clear the app's delivered notifications"]
[3.916, "o", "$ idb notification clear com.apple.news\r\n"]
[4.348, "o", "[exited 0 after 0.43s]\r\n"]
[4.836, "m", "List notifications after clearing them"]
[4.836, "o", "$ idb notification list com.apple.news\r\n"]
[5.342, "o", "[exited 0 after 0.51s]\r\n"]
[6.342, "o", ""]
