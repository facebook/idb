{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.193, "o", "[exited 0 after 0.19s]\r\n"]
[1.193, "m", "Go to the home screen"]
[1.193, "o", "$ idb ui button HOME\r\n"]
[1.361, "o", "[exited 0 after 0.17s]\r\n"]
[1.608, "m", "Check what is where the banner will appear"]
[1.608, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.99, "o", "{\"role\":\"AXGroup\",\"pid\":5874,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"type\":\"Group\",\"subrole\":null,\"traits\":[\"Scrollable\"],\"role_description\":\"Group\",\"AXValue\":null,\"help\":null,\"custom_actions\":[],\"enabled\":true,\"content_required\":false,\"frame\":{\"x\":0,\"height\":874,\"y\":0,\"width\":401.99999999999994},\"title\":null,\"AXUniqueId\":null,\"AXLabel\":null}\r\n[exited 0 after 0.38s]\r\n"]
[1.991, "m", "Deliver a notification while the app is not running"]
[1.991, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.222, "o", "[exited 0 after 0.23s]\r\n"]
[3.227, "m", "Tap the banner"]
[3.227, "o", "$ idb ui tap 201 90\r\n"]
[3.783, "o", "[exited 0 after 0.56s]\r\n"]
[4.704, "m", "Clear the app's delivered notifications"]
[4.704, "o", "$ idb notification clear com.apple.news\r\n"]
[5.281, "o", "[exited 0 after 0.58s]\r\n"]
[5.717, "m", "List notifications after clearing them"]
[5.717, "o", "$ idb notification list com.apple.news\r\n"]
[6.134, "o", "[exited 0 after 0.42s]\r\n"]
[7.26, "o", ""]
