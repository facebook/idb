{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.268, "o", "[exited 0 after 0.27s]\r\n"]
[1.268, "m", "Go to the home screen"]
[1.268, "o", "$ idb ui button HOME\r\n"]
[1.507, "o", "[exited 0 after 0.24s]\r\n"]
[2.191, "m", "Check what is where the banner will appear"]
[2.191, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.465, "o", "{\"help\":null,\"AXLabel\":null,\"title\":null,\"frame\":{\"y\":0,\"height\":874,\"x\":0,\"width\":401.99999999999994},\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"AXUniqueId\":null,\"pid\":9141,\"custom_actions\":[],\"subrole\":null,\"role\":\"AXGroup\",\"content_required\":false,\"enabled\":true,\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"AXValue\":null}\r\n[exited 0 after 0.27s]\r\n"]
[2.465, "m", "Deliver a notification while the app is not running"]
[2.465, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.99, "o", "[exited 0 after 0.53s]\r\n"]
[3.994, "m", "Tap the banner"]
[3.994, "o", "$ idb ui tap 201 90\r\n"]
[4.284, "o", "[exited 0 after 0.29s]\r\n"]
[5.104, "m", "Clear the app's delivered notifications"]
[5.104, "o", "$ idb notification clear com.apple.news\r\n"]
[5.623, "o", "[exited 0 after 0.52s]\r\n"]
[6.046, "m", "List notifications after clearing them"]
[6.046, "o", "$ idb notification list com.apple.news\r\n"]
[6.442, "o", "[exited 0 after 0.40s]\r\n"]
[7.332, "o", ""]
