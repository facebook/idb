{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.261, "o", "[exited 0 after 0.26s]\r\n"]
[1.261, "m", "Go to the home screen"]
[1.261, "o", "$ idb ui button HOME\r\n"]
[1.462, "o", "[exited 0 after 0.20s]\r\n"]
[1.714, "m", "Check what is where the banner will appear"]
[1.714, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.063, "o", "{\"AXUniqueId\":null,\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"title\":null,\"enabled\":true,\"content_required\":false,\"traits\":[\"Scrollable\"],\"help\":null,\"frame\":{\"y\":0,\"height\":874,\"x\":0,\"width\":402},\"type\":\"Group\",\"role\":\"AXGroup\",\"subrole\":null,\"AXLabel\":null,\"role_description\":\"Group\",\"pid\":2374,\"AXValue\":null}\r\n[exited 0 after 0.35s]\r\n"]
[2.063, "m", "Deliver a notification while the app is not running"]
[2.063, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.268, "o", "[exited 0 after 0.21s]\r\n"]
[3.271, "m", "Tap the banner"]
[3.271, "o", "$ idb ui tap 201 90\r\n"]
[3.572, "o", "[exited 0 after 0.30s]\r\n"]
[4.622, "m", "Clear the app's delivered notifications"]
[4.622, "o", "$ idb notification clear com.apple.news\r\n"]
[5.143, "o", "[exited 0 after 0.52s]\r\n"]
[5.858, "m", "List notifications after clearing them"]
[5.858, "o", "$ idb notification list com.apple.news\r\n"]
[6.363, "o", "[exited 0 after 0.50s]\r\n"]
[7.95, "o", ""]
