{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.232, "o", "[exited 0 after 0.23s]\r\n"]
[1.233, "m", "Go to the home screen"]
[1.233, "o", "$ idb ui button HOME\r\n"]
[1.447, "o", "[exited 0 after 0.21s]\r\n"]
[1.695, "m", "Check what is where the banner will appear"]
[1.695, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.028, "o", "{\"custom_actions\":[],\"AXUniqueId\":null,\"role\":\"AXGroup\",\"enabled\":true,\"AXValue\":null,\"type\":\"Group\",\"role_description\":\"Group\",\"subrole\":null,\"AXLabel\":null,\"title\":null,\"help\":null,\"content_required\":false,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"pid\":15339,\"frame\":{\"y\":0,\"height\":874,\"x\":0,\"width\":402},\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.33s]\r\n"]
[2.028, "m", "Deliver a notification while the app is not running"]
[2.028, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.2, "o", "[exited 0 after 0.17s]\r\n"]
[3.202, "m", "Tap the banner"]
[3.202, "o", "$ idb ui tap 201 90\r\n"]
[3.528, "o", "[exited 0 after 0.33s]\r\n"]
[4.184, "m", "Clear the app's delivered notifications"]
[4.184, "o", "$ idb notification clear com.apple.news\r\n"]
[4.772, "o", "[exited 0 after 0.59s]\r\n"]
[5.322, "m", "List notifications after clearing them"]
[5.322, "o", "$ idb notification list com.apple.news\r\n"]
[5.808, "o", "[exited 0 after 0.49s]\r\n"]
[7.523, "o", ""]
