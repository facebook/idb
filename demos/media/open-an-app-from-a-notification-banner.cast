{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.28, "o", "[exited 0 after 0.28s]\r\n"]
[1.281, "m", "Go to the home screen"]
[1.281, "o", "$ idb ui button HOME\r\n"]
[1.532, "o", "[exited 0 after 0.25s]\r\n"]
[1.796, "m", "Check what is where the banner will appear"]
[1.796, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.202, "o", "{\"role\":\"AXGroup\",\"role_description\":\"Group\",\"frame\":{\"x\":0,\"width\":402,\"y\":0,\"height\":874},\"type\":\"Group\",\"pid\":1337,\"enabled\":true,\"subrole\":null,\"AXValue\":null,\"AXLabel\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"help\":null,\"title\":null,\"traits\":[\"Scrollable\"],\"content_required\":false,\"AXUniqueId\":null,\"custom_actions\":[]}\r\n[exited 0 after 0.41s]\r\n"]
[2.202, "m", "Deliver a notification while the app is not running"]
[2.202, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.472, "o", "[exited 0 after 0.27s]\r\n"]
[3.477, "m", "Tap the banner"]
[3.477, "o", "$ idb ui tap 201 90\r\n"]
[4.272, "o", "[exited 0 after 0.80s]\r\n"]
[6.929, "m", "Clear the app's delivered notifications"]
[6.929, "o", "$ idb notification clear com.apple.news\r\n"]
[7.958, "o", "[exited 0 after 1.03s]\r\n"]
[8.573, "m", "List notifications after clearing them"]
[8.573, "o", "$ idb notification list com.apple.news\r\n"]
[9.357, "o", "[exited 0 after 0.78s]\r\n"]
[10.247, "o", ""]
