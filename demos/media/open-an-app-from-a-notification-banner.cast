{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.267, "o", "[exited 0 after 0.27s]\r\n"]
[1.267, "m", "Go to the home screen"]
[1.267, "o", "$ idb ui button HOME\r\n"]
[1.507, "o", "[exited 0 after 0.24s]\r\n"]
[1.747, "m", "Check what is where the banner will appear"]
[1.747, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.163, "o", "{\"help\":null,\"AXLabel\":null,\"pid\":1359,\"role\":\"AXGroup\",\"AXUniqueId\":null,\"subrole\":null,\"custom_actions\":[],\"enabled\":true,\"content_required\":false,\"type\":\"Group\",\"frame\":{\"x\":0,\"y\":0,\"height\":874,\"width\":401.99999999999994},\"AXValue\":null,\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"title\":null,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.42s]\r\n"]
[2.163, "m", "Deliver a notification while the app is not running"]
[2.163, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.406, "o", "[exited 0 after 0.24s]\r\n"]
[3.408, "m", "Tap the banner"]
[3.408, "o", "$ idb ui tap 201 90\r\n"]
[3.714, "o", "[exited 0 after 0.31s]\r\n"]
[4.687, "m", "Clear the app's delivered notifications"]
[4.687, "o", "$ idb notification clear com.apple.news\r\n"]
[5.242, "o", "[exited 0 after 0.56s]\r\n"]
[6.093, "m", "List notifications after clearing them"]
[6.093, "o", "$ idb notification list com.apple.news\r\n"]
[6.657, "o", "[exited 0 after 0.56s]\r\n"]
[8.602, "o", ""]
