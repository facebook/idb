{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.226, "o", "[exited 0 after 0.23s]\r\n"]
[1.227, "m", "Go to the home screen"]
[1.227, "o", "$ idb ui button HOME\r\n"]
[1.405, "o", "[exited 0 after 0.18s]\r\n"]
[2.234, "m", "Check what is where the banner will appear"]
[2.234, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.5, "o", "{\"type\":\"Group\",\"AXUniqueId\":null,\"pid\":1329,\"enabled\":true,\"role_description\":\"Group\",\"custom_actions\":[],\"title\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"help\":null,\"AXLabel\":null,\"frame\":{\"height\":874,\"width\":401.99999999999994,\"x\":0,\"y\":0},\"traits\":[\"Scrollable\"],\"role\":\"AXGroup\",\"subrole\":null,\"AXValue\":null,\"content_required\":false}\r\n[exited 0 after 0.27s]\r\n"]
[2.5, "m", "Deliver a notification while the app is not running"]
[2.5, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.738, "o", "[exited 0 after 0.24s]\r\n"]
[3.74, "m", "Tap the banner"]
[3.74, "o", "$ idb ui tap 201 90\r\n"]
[3.967, "o", "[exited 0 after 0.23s]\r\n"]
[5.269, "m", "Clear the app's delivered notifications"]
[5.269, "o", "$ idb notification clear com.apple.news\r\n"]
[5.885, "o", "[exited 0 after 0.62s]\r\n"]
[6.56, "m", "List notifications after clearing them"]
[6.56, "o", "$ idb notification list com.apple.news\r\n"]
[7.35, "o", "[exited 0 after 0.79s]\r\n"]
[9.66, "o", ""]
