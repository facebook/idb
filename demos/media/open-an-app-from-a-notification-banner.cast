{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.22, "o", "[exited 0 after 0.22s]\r\n"]
[1.22, "m", "Go to the home screen"]
[1.22, "o", "$ idb ui button HOME\r\n"]
[1.402, "o", "[exited 0 after 0.18s]\r\n"]
[1.678, "m", "Check what is where the banner will appear"]
[1.678, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.323, "o", "{\"help\":null,\"AXUniqueId\":null,\"role\":\"AXGroup\",\"AXLabel\":null,\"enabled\":true,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"role_description\":\"Group\",\"pid\":1256,\"title\":null,\"frame\":{\"y\":0,\"height\":874,\"x\":0,\"width\":401.99999999999994},\"content_required\":false,\"traits\":[\"Scrollable\"],\"subrole\":null,\"custom_actions\":[],\"type\":\"Group\",\"AXValue\":null}\r\n[exited 0 after 0.64s]\r\n"]
[2.323, "m", "Deliver a notification while the app is not running"]
[2.323, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.614, "o", "[exited 0 after 0.29s]\r\n"]
[3.617, "m", "Tap the banner"]
[3.617, "o", "$ idb ui tap 201 90\r\n"]
[4.445, "o", "[exited 0 after 0.83s]\r\n"]
[7.921, "m", "Clear the app's delivered notifications"]
[7.921, "o", "$ idb notification clear com.apple.news\r\n"]
[8.778, "o", "[exited 0 after 0.86s]\r\n"]
[9.46, "m", "List notifications after clearing them"]
[9.46, "o", "$ idb notification list com.apple.news\r\n"]
[10.163, "o", "[exited 0 after 0.70s]\r\n"]
[11.125, "o", ""]
