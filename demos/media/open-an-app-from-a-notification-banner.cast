{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.289, "o", "[exited 0 after 0.29s]\r\n"]
[1.289, "m", "Go to the home screen"]
[1.289, "o", "$ idb ui button HOME\r\n"]
[1.474, "o", "[exited 0 after 0.18s]\r\n"]
[1.769, "m", "Check what is where the banner will appear"]
[1.769, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.19, "o", "{\"custom_actions\":[],\"frame\":{\"height\":874,\"x\":0,\"y\":0,\"width\":401.99999999999994},\"role\":\"AXGroup\",\"AXUniqueId\":null,\"type\":\"Group\",\"subrole\":null,\"AXValue\":null,\"traits\":[\"Scrollable\"],\"enabled\":true,\"AXLabel\":null,\"pid\":1297,\"help\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"title\":null,\"role_description\":\"Group\",\"content_required\":false}\r\n[exited 0 after 0.42s]\r\n"]
[2.19, "m", "Deliver a notification while the app is not running"]
[2.19, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.488, "o", "[exited 0 after 0.30s]\r\n"]
[3.49, "m", "Tap the banner"]
[3.49, "o", "$ idb ui tap 201 90\r\n"]
[3.848, "o", "[exited 0 after 0.36s]\r\n"]
[5.003, "m", "Clear the app's delivered notifications"]
[5.003, "o", "$ idb notification clear com.apple.news\r\n"]
[5.778, "o", "[exited 0 after 0.77s]\r\n"]
[6.373, "m", "List notifications after clearing them"]
[6.373, "o", "$ idb notification list com.apple.news\r\n"]
[6.909, "o", "[exited 0 after 0.54s]\r\n"]
[9.183, "o", ""]
