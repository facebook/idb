{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.28, "o", "[exited 0 after 0.28s]\r\n"]
[1.28, "m", "Go to the home screen"]
[1.28, "o", "$ idb ui button HOME\r\n"]
[1.507, "o", "[exited 0 after 0.23s]\r\n"]
[1.764, "m", "Check what is where the banner will appear"]
[1.764, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.167, "o", "{\"type\":\"Group\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"subrole\":null,\"frame\":{\"width\":401.99999999999994,\"y\":0,\"height\":874,\"x\":0},\"AXLabel\":null,\"enabled\":true,\"title\":null,\"pid\":1294,\"AXUniqueId\":null,\"role\":\"AXGroup\",\"role_description\":\"Group\",\"custom_actions\":[],\"traits\":[\"Scrollable\"],\"help\":null,\"AXValue\":null,\"content_required\":false}\r\n[exited 0 after 0.40s]\r\n"]
[2.168, "m", "Deliver a notification while the app is not running"]
[2.168, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.415, "o", "[exited 0 after 0.25s]\r\n"]
[3.419, "m", "Tap the banner"]
[3.419, "o", "$ idb ui tap 201 90\r\n"]
[4.275, "o", "[exited 0 after 0.86s]\r\n"]
[5.264, "m", "Clear the app's delivered notifications"]
[5.264, "o", "$ idb notification clear com.apple.news\r\n"]
[5.803, "o", "[exited 0 after 0.54s]\r\n"]
[6.304, "m", "List notifications after clearing them"]
[6.304, "o", "$ idb notification list com.apple.news\r\n"]
[7.178, "o", "[exited 0 after 0.87s]\r\n"]
[8.593, "o", ""]
