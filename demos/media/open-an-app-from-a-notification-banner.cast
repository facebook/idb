{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.335, "o", "[exited 0 after 0.33s]\r\n"]
[1.335, "m", "Go to the home screen"]
[1.335, "o", "$ idb ui button HOME\r\n"]
[1.601, "o", "[exited 0 after 0.27s]\r\n"]
[2.367, "m", "Check what is where the banner will appear"]
[2.367, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.611, "o", "{\"role\":\"AXGroup\",\"AXUniqueId\":null,\"pid\":10072,\"frame\":{\"y\":0,\"width\":402.00000000000006,\"height\":874,\"x\":0},\"traits\":[\"Scrollable\"],\"enabled\":true,\"content_required\":false,\"help\":null,\"role_description\":\"Group\",\"title\":null,\"AXValue\":null,\"type\":\"Group\",\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"custom_actions\":[],\"AXLabel\":null,\"subrole\":null}\r\n[exited 0 after 0.24s]\r\n"]
[2.612, "m", "Deliver a notification while the app is not running"]
[2.612, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.972, "o", "[exited 0 after 0.36s]\r\n"]
[3.976, "m", "Tap the banner"]
[3.976, "o", "$ idb ui tap 201 90\r\n"]
[4.291, "o", "[exited 0 after 0.32s]\r\n"]
[5.191, "m", "Clear the app's delivered notifications"]
[5.191, "o", "$ idb notification clear com.apple.news\r\n"]
[5.796, "o", "[exited 0 after 0.61s]\r\n"]
[6.414, "m", "List notifications after clearing them"]
[6.414, "o", "$ idb notification list com.apple.news\r\n"]
[6.982, "o", "[exited 0 after 0.57s]\r\n"]
[8.578, "o", ""]
