{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.261, "o", "[exited 0 after 0.26s]\r\n"]
[1.261, "m", "Go to the home screen"]
[1.261, "o", "$ idb ui button HOME\r\n"]
[1.494, "o", "[exited 0 after 0.23s]\r\n"]
[1.869, "m", "Check what is where the banner will appear"]
[1.869, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.446, "o", "{\"role_description\":\"Group\",\"AXLabel\":null,\"type\":\"Group\",\"role\":\"AXGroup\",\"subrole\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"custom_actions\":[],\"title\":null,\"AXValue\":null,\"AXUniqueId\":null,\"help\":null,\"enabled\":true,\"content_required\":false,\"traits\":[\"Scrollable\"],\"frame\":{\"y\":0,\"height\":874,\"width\":402.00000000000006,\"x\":0},\"pid\":1886}\r\n[exited 0 after 0.58s]\r\n"]
[2.447, "m", "Deliver a notification while the app is not running"]
[2.447, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.752, "o", "[exited 0 after 0.31s]\r\n"]
[3.754, "m", "Tap the banner"]
[3.754, "o", "$ idb ui tap 201 90\r\n"]
[4.005, "o", "[exited 0 after 0.25s]\r\n"]
[4.727, "m", "Clear the app's delivered notifications"]
[4.727, "o", "$ idb notification clear com.apple.news\r\n"]
[5.197, "o", "[exited 0 after 0.47s]\r\n"]
[5.691, "m", "List notifications after clearing them"]
[5.691, "o", "$ idb notification list com.apple.news\r\n"]
[6.264, "o", "[exited 0 after 0.57s]\r\n"]
[7.937, "o", ""]
