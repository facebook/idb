{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.256, "o", "[exited 0 after 0.26s]\r\n"]
[1.256, "m", "Go to the home screen"]
[1.256, "o", "$ idb ui button HOME\r\n"]
[1.511, "o", "[exited 0 after 0.25s]\r\n"]
[2.158, "m", "Check what is where the banner will appear"]
[2.158, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.369, "o", "{\"AXLabel\":null,\"role\":\"AXGroup\",\"enabled\":true,\"frame\":{\"x\":0,\"y\":0,\"height\":874,\"width\":402.00000000000006},\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"custom_actions\":[],\"subrole\":null,\"role_description\":\"Group\",\"content_required\":false,\"pid\":1346,\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"AXUniqueId\":null,\"title\":null,\"help\":null}\r\n[exited 0 after 0.21s]\r\n"]
[2.369, "m", "Deliver a notification while the app is not running"]
[2.369, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.62, "o", "[exited 0 after 0.25s]\r\n"]
[3.625, "m", "Tap the banner"]
[3.625, "o", "$ idb ui tap 201 90\r\n"]
[3.859, "o", "[exited 0 after 0.23s]\r\n"]
[5.042, "m", "Clear the app's delivered notifications"]
[5.042, "o", "$ idb notification clear com.apple.news\r\n"]
[5.628, "o", "[exited 0 after 0.59s]\r\n"]
[6.105, "m", "List notifications after clearing them"]
[6.105, "o", "$ idb notification list com.apple.news\r\n"]
[6.569, "o", "[exited 0 after 0.46s]\r\n"]
[8.61, "o", ""]
