{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.295, "o", "[exited 0 after 0.30s]\r\n"]
[1.296, "m", "Go to the home screen"]
[1.296, "o", "$ idb ui button HOME\r\n"]
[1.513, "o", "[exited 0 after 0.22s]\r\n"]
[1.735, "m", "Check what is where the banner will appear"]
[1.735, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.154, "o", "{\"pid\":2341,\"title\":null,\"help\":null,\"AXLabel\":null,\"custom_actions\":[],\"type\":\"Group\",\"AXUniqueId\":null,\"role\":\"AXGroup\",\"content_required\":false,\"role_description\":\"Group\",\"enabled\":true,\"subrole\":null,\"traits\":[\"Scrollable\"],\"frame\":{\"height\":874,\"y\":0,\"x\":0,\"width\":401.99999999999994},\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\"}\r\n[exited 0 after 0.42s]\r\n"]
[2.155, "m", "Deliver a notification while the app is not running"]
[2.155, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.473, "o", "[exited 0 after 0.32s]\r\n"]
[3.476, "m", "Tap the banner"]
[3.476, "o", "$ idb ui tap 201 90\r\n"]
[3.704, "o", "[exited 0 after 0.23s]\r\n"]
[4.35, "m", "Clear the app's delivered notifications"]
[4.35, "o", "$ idb notification clear com.apple.news\r\n"]
[4.804, "o", "[exited 0 after 0.45s]\r\n"]
[5.301, "m", "List notifications after clearing them"]
[5.301, "o", "$ idb notification list com.apple.news\r\n"]
[5.823, "o", "[exited 0 after 0.52s]\r\n"]
[7.342, "o", ""]
