{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.955, "m", "Grant notification permission without showing a prompt"]
[0.955, "o", "$ idb approve com.apple.news notification\r\n"]
[1.234, "o", "[exited 0 after 0.28s]\r\n"]
[1.234, "m", "Go to the home screen"]
[1.234, "o", "$ idb ui button HOME\r\n"]
[1.405, "o", "[exited 0 after 0.17s]\r\n"]
[1.657, "m", "Check what is where the banner will appear"]
[1.657, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.977, "o", "{\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"traits\":[\"Scrollable\"],\"AXLabel\":null,\"custom_actions\":[],\"AXUniqueId\":null,\"title\":null,\"enabled\":true,\"role\":\"AXGroup\",\"content_required\":false,\"role_description\":\"Group\",\"AXValue\":null,\"frame\":{\"x\":0,\"y\":0,\"width\":402,\"height\":874},\"help\":null,\"subrole\":null,\"pid\":1922,\"type\":\"Group\"}\r\n[exited 0 after 0.32s]\r\n"]
[1.977, "m", "Deliver a notification while the app is not running"]
[1.977, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.191, "o", "[exited 0 after 0.21s]\r\n"]
[3.194, "m", "Tap the banner"]
[3.194, "o", "$ idb ui tap 201 90\r\n"]
[3.565, "o", "[exited 0 after 0.37s]\r\n"]
[5.59, "m", "Clear the app's delivered notifications"]
[5.59, "o", "$ idb notification clear com.apple.news\r\n"]
[6.334, "o", "[exited 0 after 0.74s]\r\n"]
[7.105, "m", "List notifications after clearing them"]
[7.105, "o", "$ idb notification list com.apple.news\r\n"]
[7.647, "o", "[exited 0 after 0.54s]\r\n"]
[8.493, "o", ""]
