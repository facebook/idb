{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.272, "o", "[exited 0 after 0.27s]\r\n"]
[1.273, "m", "Go to the home screen"]
[1.273, "o", "$ idb ui button HOME\r\n"]
[1.529, "o", "[exited 0 after 0.26s]\r\n"]
[2.165, "m", "Check what is where the banner will appear"]
[2.165, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.438, "o", "{\"role\":\"AXGroup\",\"custom_actions\":[],\"AXUniqueId\":null,\"enabled\":true,\"role_description\":\"Group\",\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"AXLabel\":null,\"pid\":1941,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"title\":null,\"help\":null,\"AXValue\":null,\"frame\":{\"y\":0,\"x\":0,\"height\":874,\"width\":402.00000000000006},\"subrole\":null,\"content_required\":false}\r\n[exited 0 after 0.27s]\r\n"]
[2.439, "m", "Deliver a notification while the app is not running"]
[2.439, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.778, "o", "[exited 0 after 0.34s]\r\n"]
[3.781, "m", "Tap the banner"]
[3.781, "o", "$ idb ui tap 201 90\r\n"]
[4.098, "o", "[exited 0 after 0.32s]\r\n"]
[5.325, "m", "Clear the app's delivered notifications"]
[5.325, "o", "$ idb notification clear com.apple.news\r\n"]
[6.015, "o", "[exited 0 after 0.69s]\r\n"]
[6.649, "m", "List notifications after clearing them"]
[6.649, "o", "$ idb notification list com.apple.news\r\n"]
[7.114, "o", "[exited 0 after 0.46s]\r\n"]
[9.3, "o", ""]
