{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.327, "o", "[exited 0 after 0.33s]\r\n"]
[1.327, "m", "Go to the home screen"]
[1.327, "o", "$ idb ui button HOME\r\n"]
[1.567, "o", "[exited 0 after 0.24s]\r\n"]
[1.833, "m", "Check what is where the banner will appear"]
[1.833, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.245, "o", "{\"help\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"subrole\":null,\"AXLabel\":null,\"role\":\"AXGroup\",\"pid\":2338,\"custom_actions\":[],\"AXUniqueId\":null,\"traits\":[\"Scrollable\"],\"title\":null,\"frame\":{\"y\":0,\"height\":874,\"width\":402,\"x\":0},\"content_required\":false,\"type\":\"Group\",\"role_description\":\"Group\",\"enabled\":true,\"AXValue\":null}\r\n[exited 0 after 0.41s]\r\n"]
[2.246, "m", "Deliver a notification while the app is not running"]
[2.246, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.499, "o", "[exited 0 after 0.25s]\r\n"]
[3.505, "m", "Tap the banner"]
[3.505, "o", "$ idb ui tap 201 90\r\n"]
[3.883, "o", "[exited 0 after 0.38s]\r\n"]
[5.01, "m", "Clear the app's delivered notifications"]
[5.01, "o", "$ idb notification clear com.apple.news\r\n"]
[5.621, "o", "[exited 0 after 0.61s]\r\n"]
[6.116, "m", "List notifications after clearing them"]
[6.116, "o", "$ idb notification list com.apple.news\r\n"]
[7.023, "o", "[exited 0 after 0.91s]\r\n"]
[7.977, "o", ""]
