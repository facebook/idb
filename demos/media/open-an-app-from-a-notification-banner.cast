{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.987, "m", "Grant notification permission without showing a prompt"]
[0.987, "o", "$ idb approve com.apple.news notification\r\n"]
[1.193, "o", "[exited 0 after 0.21s]\r\n"]
[1.193, "m", "Go to the home screen"]
[1.193, "o", "$ idb ui button HOME\r\n"]
[1.377, "o", "[exited 0 after 0.18s]\r\n"]
[1.627, "m", "Check what is where the banner will appear"]
[1.627, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.957, "o", "{\"AXValue\":null,\"title\":null,\"custom_actions\":[],\"role_description\":\"Group\",\"help\":null,\"content_required\":false,\"traits\":[\"Scrollable\"],\"AXUniqueId\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"role\":\"AXGroup\",\"frame\":{\"y\":0,\"x\":0,\"width\":402,\"height\":874},\"enabled\":true,\"AXLabel\":null,\"subrole\":null,\"pid\":1946,\"type\":\"Group\"}\r\n[exited 0 after 0.33s]\r\n"]
[1.957, "m", "Deliver a notification while the app is not running"]
[1.957, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.134, "o", "[exited 0 after 0.18s]\r\n"]
[3.137, "m", "Tap the banner"]
[3.137, "o", "$ idb ui tap 201 90\r\n"]
[3.364, "o", "[exited 0 after 0.23s]\r\n"]
[3.993, "m", "Clear the app's delivered notifications"]
[3.993, "o", "$ idb notification clear com.apple.news\r\n"]
[4.448, "o", "[exited 0 after 0.45s]\r\n"]
[4.883, "m", "List notifications after clearing them"]
[4.883, "o", "$ idb notification list com.apple.news\r\n"]
[5.365, "o", "[exited 0 after 0.48s]\r\n"]
[6.48, "o", ""]
