{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.195, "o", "[exited 0 after 0.19s]\r\n"]
[1.195, "m", "Go to the home screen"]
[1.195, "o", "$ idb ui button HOME\r\n"]
[1.363, "o", "[exited 0 after 0.17s]\r\n"]
[1.619, "m", "Check what is where the banner will appear"]
[1.619, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.253, "o", "{\"enabled\":true,\"custom_actions\":[],\"title\":null,\"pid\":5888,\"AXValue\":null,\"traits\":[\"Scrollable\"],\"role\":\"AXGroup\",\"AXLabel\":null,\"help\":null,\"role_description\":\"Group\",\"type\":\"Group\",\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"frame\":{\"x\":0,\"width\":402.00000000000006,\"height\":874,\"y\":0},\"AXUniqueId\":null,\"subrole\":null,\"content_required\":false}\r\n[exited 0 after 0.63s]\r\n"]
[2.254, "m", "Deliver a notification while the app is not running"]
[2.254, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.67, "o", "[exited 0 after 0.42s]\r\n"]
[3.674, "m", "Tap the banner"]
[3.674, "o", "$ idb ui tap 201 90\r\n"]
[3.889, "o", "[exited 0 after 0.22s]\r\n"]
[4.747, "m", "Clear the app's delivered notifications"]
[4.747, "o", "$ idb notification clear com.apple.news\r\n"]
[5.19, "o", "[exited 0 after 0.44s]\r\n"]
[5.686, "m", "List notifications after clearing them"]
[5.686, "o", "$ idb notification list com.apple.news\r\n"]
[6.224, "o", "[exited 0 after 0.54s]\r\n"]
[7.418, "o", ""]
