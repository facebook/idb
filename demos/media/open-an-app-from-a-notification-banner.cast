{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.228, "o", "[exited 0 after 0.23s]\r\n"]
[1.229, "m", "Go to the home screen"]
[1.229, "o", "$ idb ui button HOME\r\n"]
[1.394, "o", "[exited 0 after 0.17s]\r\n"]
[1.634, "m", "Check what is where the banner will appear"]
[1.634, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.002, "o", "{\"subrole\":null,\"AXUniqueId\":null,\"custom_actions\":[],\"enabled\":true,\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"help\":null,\"title\":null,\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"role_description\":\"Group\",\"role\":\"AXGroup\",\"AXLabel\":null,\"frame\":{\"x\":0,\"y\":0,\"width\":401.99999999999994,\"height\":874},\"pid\":1561,\"content_required\":false}\r\n[exited 0 after 0.37s]\r\n"]
[2.003, "m", "Deliver a notification while the app is not running"]
[2.003, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.193, "o", "[exited 0 after 0.19s]\r\n"]
[3.196, "m", "Tap the banner"]
[3.196, "o", "$ idb ui tap 201 90\r\n"]
[3.431, "o", "[exited 0 after 0.24s]\r\n"]
[4.488, "m", "Clear the app's delivered notifications"]
[4.488, "o", "$ idb notification clear com.apple.news\r\n"]
[5.099, "o", "[exited 0 after 0.61s]\r\n"]
[5.647, "m", "List notifications after clearing them"]
[5.647, "o", "$ idb notification list com.apple.news\r\n"]
[6.136, "o", "[exited 0 after 0.49s]\r\n"]
[8.02, "o", ""]
