{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.883, "m", "Grant notification permission without showing a prompt"]
[0.883, "o", "$ idb approve com.apple.news notification\r\n"]
[1.296, "o", "[exited 0 after 0.41s]\r\n"]
[1.296, "m", "Go to the home screen"]
[1.296, "o", "$ idb ui button HOME\r\n"]
[1.478, "o", "[exited 0 after 0.18s]\r\n"]
[1.715, "m", "Check what is where the banner will appear"]
[1.715, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.19, "o", "{\"role_description\":\"Group\",\"subrole\":null,\"content_required\":false,\"AXLabel\":null,\"enabled\":true,\"traits\":[\"Scrollable\"],\"title\":null,\"frame\":{\"x\":0,\"y\":0,\"height\":874,\"width\":402},\"AXUniqueId\":null,\"AXValue\":null,\"pid\":1691,\"custom_actions\":[],\"help\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"type\":\"Group\",\"role\":\"AXGroup\"}\r\n[exited 0 after 0.47s]\r\n"]
[2.19, "m", "Deliver a notification while the app is not running"]
[2.19, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.443, "o", "[exited 0 after 0.25s]\r\n"]
[3.446, "m", "Tap the banner"]
[3.446, "o", "$ idb ui tap 201 90\r\n"]
[3.644, "o", "[exited 0 after 0.20s]\r\n"]
[4.736, "m", "Clear the app's delivered notifications"]
[4.736, "o", "$ idb notification clear com.apple.news\r\n"]
[5.269, "o", "[exited 0 after 0.53s]\r\n"]
[5.753, "m", "List notifications after clearing them"]
[5.753, "o", "$ idb notification list com.apple.news\r\n"]
[6.37, "o", "[exited 0 after 0.62s]\r\n"]
[7.702, "o", ""]
