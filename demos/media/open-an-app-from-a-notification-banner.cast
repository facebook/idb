{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.23, "o", "[exited 0 after 0.23s]\r\n"]
[1.23, "m", "Go to the home screen"]
[1.23, "o", "$ idb ui button HOME\r\n"]
[1.444, "o", "[exited 0 after 0.21s]\r\n"]
[1.645, "m", "Check what is where the banner will appear"]
[1.645, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.017, "o", "{\"enabled\":true,\"frame\":{\"height\":874,\"y\":0,\"x\":0,\"width\":402},\"role\":\"AXGroup\",\"title\":null,\"content_required\":false,\"AXLabel\":null,\"pid\":60832,\"AXUniqueId\":null,\"AXValue\":null,\"custom_actions\":[],\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"help\":null,\"role_description\":\"Group\",\"subrole\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\"}\r\n[exited 0 after 0.37s]\r\n"]
[2.018, "m", "Deliver a notification while the app is not running"]
[2.018, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.217, "o", "[exited 0 after 0.20s]\r\n"]
[3.22, "m", "Tap the banner"]
[3.22, "o", "$ idb ui tap 201 90\r\n"]
[3.466, "o", "[exited 0 after 0.25s]\r\n"]
[4.121, "m", "Clear the app's delivered notifications"]
[4.121, "o", "$ idb notification clear com.apple.news\r\n"]
[4.532, "o", "[exited 0 after 0.41s]\r\n"]
[5.01, "m", "List notifications after clearing them"]
[5.01, "o", "$ idb notification list com.apple.news\r\n"]
[5.453, "o", "[exited 0 after 0.44s]\r\n"]
[6.608, "o", ""]
