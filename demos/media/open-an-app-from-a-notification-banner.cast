{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.743, "m", "Grant notification permission without showing a prompt"]
[0.743, "o", "$ idb approve com.apple.news notification\r\n"]
[1.006, "o", "[exited 0 after 0.26s]\r\n"]
[1.006, "m", "Go to the home screen"]
[1.006, "o", "$ idb ui button HOME\r\n"]
[1.234, "o", "[exited 0 after 0.23s]\r\n"]
[1.484, "m", "Check what is where the banner will appear"]
[1.484, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.835, "o", "{\"frame\":{\"height\":874,\"width\":402.00000000000006,\"x\":0,\"y\":0},\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"title\":null,\"help\":null,\"subrole\":null,\"content_required\":false,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"pid\":1645,\"AXUniqueId\":null,\"AXValue\":null,\"role_description\":\"Group\",\"custom_actions\":[],\"role\":\"AXGroup\",\"type\":\"Group\",\"enabled\":true}\r\n[exited 0 after 0.35s]\r\n"]
[1.838, "m", "Deliver a notification while the app is not running"]
[1.838, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.155, "o", "[exited 0 after 0.32s]\r\n"]
[3.158, "m", "Tap the banner"]
[3.158, "o", "$ idb ui tap 201 90\r\n"]
[3.927, "o", "[exited 0 after 0.77s]\r\n"]
[4.824, "m", "Clear the app's delivered notifications"]
[4.824, "o", "$ idb notification clear com.apple.news\r\n"]
[5.333, "o", "[exited 0 after 0.51s]\r\n"]
[5.764, "m", "List notifications after clearing them"]
[5.764, "o", "$ idb notification list com.apple.news\r\n"]
[6.571, "o", "[exited 0 after 0.81s]\r\n"]
[7.522, "o", ""]
