{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.957, "m", "Grant notification permission without showing a prompt"]
[0.957, "o", "$ idb approve com.apple.news notification\r\n"]
[1.168, "o", "[exited 0 after 0.21s]\r\n"]
[1.169, "m", "Go to the home screen"]
[1.169, "o", "$ idb ui button HOME\r\n"]
[1.32, "o", "[exited 0 after 0.15s]\r\n"]
[1.563, "m", "Check what is where the banner will appear"]
[1.563, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.879, "o", "{\"title\":null,\"content_required\":false,\"pid\":1657,\"role_description\":\"Group\",\"type\":\"Group\",\"role\":\"AXGroup\",\"frame\":{\"y\":0,\"width\":402,\"height\":874,\"x\":0},\"custom_actions\":[],\"help\":null,\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"AXValue\":null,\"enabled\":true,\"AXUniqueId\":null,\"subrole\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\"}\r\n[exited 0 after 0.32s]\r\n"]
[1.879, "m", "Deliver a notification while the app is not running"]
[1.879, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.067, "o", "[exited 0 after 0.19s]\r\n"]
[3.07, "m", "Tap the banner"]
[3.07, "o", "$ idb ui tap 201 90\r\n"]
[3.317, "o", "[exited 0 after 0.25s]\r\n"]
[3.972, "m", "Clear the app's delivered notifications"]
[3.972, "o", "$ idb notification clear com.apple.news\r\n"]
[4.386, "o", "[exited 0 after 0.41s]\r\n"]
[4.92, "m", "List notifications after clearing them"]
[4.92, "o", "$ idb notification list com.apple.news\r\n"]
[5.359, "o", "[exited 0 after 0.44s]\r\n"]
[6.78, "o", ""]
