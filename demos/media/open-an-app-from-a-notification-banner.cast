{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.282, "o", "[exited 0 after 0.28s]\r\n"]
[1.282, "m", "Go to the home screen"]
[1.282, "o", "$ idb ui button HOME\r\n"]
[1.526, "o", "[exited 0 after 0.24s]\r\n"]
[1.77, "m", "Check what is where the banner will appear"]
[1.77, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.156, "o", "{\"traits\":[\"Scrollable\"],\"frame\":{\"height\":874,\"y\":0,\"width\":402.00000000000006,\"x\":0},\"title\":null,\"AXValue\":null,\"custom_actions\":[],\"subrole\":null,\"enabled\":true,\"role_description\":\"Group\",\"role\":\"AXGroup\",\"help\":null,\"AXLabel\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"AXUniqueId\":null,\"content_required\":false,\"pid\":1360,\"type\":\"Group\"}\r\n[exited 0 after 0.39s]\r\n"]
[2.156, "m", "Deliver a notification while the app is not running"]
[2.156, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.397, "o", "[exited 0 after 0.24s]\r\n"]
[3.404, "m", "Tap the banner"]
[3.404, "o", "$ idb ui tap 201 90\r\n"]
[3.644, "o", "[exited 0 after 0.24s]\r\n"]
[4.637, "m", "Clear the app's delivered notifications"]
[4.637, "o", "$ idb notification clear com.apple.news\r\n"]
[5.194, "o", "[exited 0 after 0.56s]\r\n"]
[5.916, "m", "List notifications after clearing them"]
[5.916, "o", "$ idb notification list com.apple.news\r\n"]
[6.624, "o", "[exited 0 after 0.71s]\r\n"]
[8.58, "o", ""]
