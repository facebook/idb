{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.196, "o", "[exited 0 after 0.20s]\r\n"]
[1.196, "m", "Go to the home screen"]
[1.196, "o", "$ idb ui button HOME\r\n"]
[1.363, "o", "[exited 0 after 0.17s]\r\n"]
[1.61, "m", "Check what is where the banner will appear"]
[1.61, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.023, "o", "{\"custom_actions\":[],\"content_required\":false,\"role_description\":\"Group\",\"pid\":9816,\"role\":\"AXGroup\",\"traits\":[\"Scrollable\"],\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"frame\":{\"y\":0,\"width\":401.99999999999994,\"x\":0,\"height\":874},\"AXLabel\":null,\"type\":\"Group\",\"title\":null,\"AXUniqueId\":null,\"subrole\":null,\"help\":null,\"enabled\":true}\r\n[exited 0 after 0.41s]\r\n"]
[2.023, "m", "Deliver a notification while the app is not running"]
[2.023, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.199, "o", "[exited 0 after 0.18s]\r\n"]
[3.202, "m", "Tap the banner"]
[3.202, "o", "$ idb ui tap 201 90\r\n"]
[3.752, "o", "[exited 0 after 0.55s]\r\n"]
[4.327, "m", "Clear the app's delivered notifications"]
[4.327, "o", "$ idb notification clear com.apple.news\r\n"]
[4.757, "o", "[exited 0 after 0.43s]\r\n"]
[5.233, "m", "List notifications after clearing them"]
[5.233, "o", "$ idb notification list com.apple.news\r\n"]
[5.604, "o", "[exited 0 after 0.37s]\r\n"]
[6.777, "o", ""]
