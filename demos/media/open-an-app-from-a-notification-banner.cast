{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.286, "o", "[exited 0 after 0.29s]\r\n"]
[1.286, "m", "Go to the home screen"]
[1.286, "o", "$ idb ui button HOME\r\n"]
[1.501, "o", "[exited 0 after 0.21s]\r\n"]
[1.91, "m", "Check what is where the banner will appear"]
[1.91, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.232, "o", "{\"frame\":{\"y\":0,\"width\":401.99999999999994,\"height\":874,\"x\":0},\"role_description\":\"Group\",\"content_required\":false,\"AXUniqueId\":null,\"AXValue\":null,\"subrole\":null,\"role\":\"AXGroup\",\"enabled\":true,\"pid\":9635,\"type\":\"Group\",\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"title\":null,\"help\":null,\"traits\":[\"Scrollable\"],\"AXLabel\":null}\r\n[exited 0 after 0.32s]\r\n"]
[2.232, "m", "Deliver a notification while the app is not running"]
[2.232, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.523, "o", "[exited 0 after 0.29s]\r\n"]
[3.524, "m", "Tap the banner"]
[3.524, "o", "$ idb ui tap 201 90\r\n"]
[3.851, "o", "[exited 0 after 0.33s]\r\n"]
[4.702, "m", "Clear the app's delivered notifications"]
[4.702, "o", "$ idb notification clear com.apple.news\r\n"]
[5.247, "o", "[exited 0 after 0.54s]\r\n"]
[5.888, "m", "List notifications after clearing them"]
[5.888, "o", "$ idb notification list com.apple.news\r\n"]
[6.401, "o", "[exited 0 after 0.51s]\r\n"]
[9.068, "o", ""]
