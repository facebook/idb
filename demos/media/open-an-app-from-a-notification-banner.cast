{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.994, "m", "Grant notification permission without showing a prompt"]
[0.994, "o", "$ idb approve com.apple.news notification\r\n"]
[1.208, "o", "[exited 0 after 0.21s]\r\n"]
[1.209, "m", "Go to the home screen"]
[1.209, "o", "$ idb ui button HOME\r\n"]
[1.381, "o", "[exited 0 after 0.17s]\r\n"]
[1.614, "m", "Check what is where the banner will appear"]
[1.614, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.942, "o", "{\"role\":\"AXGroup\",\"custom_actions\":[],\"AXValue\":null,\"enabled\":true,\"role_description\":\"Group\",\"frame\":{\"y\":0,\"x\":0,\"height\":874,\"width\":401.99999999999994},\"content_required\":false,\"AXLabel\":null,\"pid\":1271,\"type\":\"Group\",\"title\":null,\"traits\":[\"Scrollable\"],\"subrole\":null,\"AXUniqueId\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"help\":null}\r\n[exited 0 after 0.33s]\r\n"]
[1.943, "m", "Deliver a notification while the app is not running"]
[1.943, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.114, "o", "[exited 0 after 0.17s]\r\n"]
[3.116, "m", "Tap the banner"]
[3.116, "o", "$ idb ui tap 201 90\r\n"]
[3.312, "o", "[exited 0 after 0.20s]\r\n"]
[3.905, "m", "Clear the app's delivered notifications"]
[3.905, "o", "$ idb notification clear com.apple.news\r\n"]
[4.305, "o", "[exited 0 after 0.40s]\r\n"]
[4.704, "m", "List notifications after clearing them"]
[4.704, "o", "$ idb notification list com.apple.news\r\n"]
[5.171, "o", "[exited 0 after 0.47s]\r\n"]
[6.332, "o", ""]
