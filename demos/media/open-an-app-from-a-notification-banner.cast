{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.276, "o", "[exited 0 after 0.28s]\r\n"]
[1.276, "m", "Go to the home screen"]
[1.276, "o", "$ idb ui button HOME\r\n"]
[1.472, "o", "[exited 0 after 0.20s]\r\n"]
[1.729, "m", "Check what is where the banner will appear"]
[1.729, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.158, "o", "{\"frame\":{\"y\":0,\"width\":401.99999999999994,\"height\":874,\"x\":0},\"content_required\":false,\"subrole\":null,\"pid\":1303,\"help\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"AXValue\":null,\"AXUniqueId\":null,\"role_description\":\"Group\",\"role\":\"AXGroup\",\"type\":\"Group\",\"custom_actions\":[],\"AXLabel\":null,\"enabled\":true,\"title\":null,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.43s]\r\n"]
[2.159, "m", "Deliver a notification while the app is not running"]
[2.159, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.435, "o", "[exited 0 after 0.28s]\r\n"]
[3.437, "m", "Tap the banner"]
[3.437, "o", "$ idb ui tap 201 90\r\n"]
[3.671, "o", "[exited 0 after 0.23s]\r\n"]
[4.924, "m", "Clear the app's delivered notifications"]
[4.924, "o", "$ idb notification clear com.apple.news\r\n"]
[5.427, "o", "[exited 0 after 0.50s]\r\n"]
[5.877, "m", "List notifications after clearing them"]
[5.877, "o", "$ idb notification list com.apple.news\r\n"]
[6.426, "o", "[exited 0 after 0.55s]\r\n"]
[7.862, "o", ""]
