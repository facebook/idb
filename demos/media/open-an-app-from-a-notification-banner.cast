{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.25, "o", "[exited 0 after 0.25s]\r\n"]
[1.251, "m", "Go to the home screen"]
[1.251, "o", "$ idb ui button HOME\r\n"]
[1.445, "o", "[exited 0 after 0.19s]\r\n"]
[1.733, "m", "Check what is where the banner will appear"]
[1.733, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.155, "o", "{\"AXValue\":null,\"title\":null,\"role_description\":\"Group\",\"role\":\"AXGroup\",\"subrole\":null,\"pid\":2997,\"AXUniqueId\":null,\"enabled\":true,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"frame\":{\"y\":0,\"x\":0,\"height\":874,\"width\":402.00000000000006},\"content_required\":false,\"custom_actions\":[],\"AXLabel\":null,\"type\":\"Group\",\"help\":null}\r\n[exited 0 after 0.42s]\r\n"]
[2.156, "m", "Deliver a notification while the app is not running"]
[2.156, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.396, "o", "[exited 0 after 0.24s]\r\n"]
[3.402, "m", "Tap the banner"]
[3.402, "o", "$ idb ui tap 201 90\r\n"]
[4.093, "o", "[exited 0 after 0.69s]\r\n"]
[4.846, "m", "Clear the app's delivered notifications"]
[4.846, "o", "$ idb notification clear com.apple.news\r\n"]
[5.477, "o", "[exited 0 after 0.63s]\r\n"]
[6.048, "m", "List notifications after clearing them"]
[6.048, "o", "$ idb notification list com.apple.news\r\n"]
[6.485, "o", "[exited 0 after 0.44s]\r\n"]
[8.158, "o", ""]
