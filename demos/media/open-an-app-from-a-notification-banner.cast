{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.258, "o", "[exited 0 after 0.26s]\r\n"]
[1.259, "m", "Go to the home screen"]
[1.259, "o", "$ idb ui button HOME\r\n"]
[1.432, "o", "[exited 0 after 0.17s]\r\n"]
[1.711, "m", "Check what is where the banner will appear"]
[1.711, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.127, "o", "{\"subrole\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"type\":\"Group\",\"content_required\":false,\"AXLabel\":null,\"title\":null,\"AXValue\":null,\"help\":null,\"AXUniqueId\":null,\"custom_actions\":[],\"pid\":4939,\"traits\":[\"Scrollable\"],\"role\":\"AXGroup\",\"frame\":{\"x\":0,\"y\":0,\"height\":874,\"width\":402.00000000000006},\"enabled\":true,\"role_description\":\"Group\"}\r\n[exited 0 after 0.42s]\r\n"]
[2.127, "m", "Deliver a notification while the app is not running"]
[2.127, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.441, "o", "[exited 0 after 0.31s]\r\n"]
[3.444, "m", "Tap the banner"]
[3.444, "o", "$ idb ui tap 201 90\r\n"]
[3.704, "o", "[exited 0 after 0.26s]\r\n"]
[4.404, "m", "Clear the app's delivered notifications"]
[4.404, "o", "$ idb notification clear com.apple.news\r\n"]
[4.872, "o", "[exited 0 after 0.47s]\r\n"]
[5.336, "m", "List notifications after clearing them"]
[5.336, "o", "$ idb notification list com.apple.news\r\n"]
[5.899, "o", "[exited 0 after 0.56s]\r\n"]
[7.433, "o", ""]
