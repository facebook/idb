{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.235, "o", "[exited 0 after 0.24s]\r\n"]
[1.236, "m", "Go to the home screen"]
[1.236, "o", "$ idb ui button HOME\r\n"]
[1.425, "o", "[exited 0 after 0.19s]\r\n"]
[1.698, "m", "Check what is where the banner will appear"]
[1.698, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.028, "o", "{\"content_required\":false,\"role_description\":\"Group\",\"title\":null,\"frame\":{\"x\":0,\"width\":402,\"height\":874,\"y\":0},\"enabled\":true,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"AXValue\":null,\"custom_actions\":[],\"AXUniqueId\":null,\"AXLabel\":null,\"pid\":1938,\"help\":null,\"subrole\":null,\"type\":\"Group\",\"role\":\"AXGroup\"}\r\n[exited 0 after 0.33s]\r\n"]
[2.028, "m", "Deliver a notification while the app is not running"]
[2.028, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.284, "o", "[exited 0 after 0.26s]\r\n"]
[3.287, "m", "Tap the banner"]
[3.287, "o", "$ idb ui tap 201 90\r\n"]
[3.583, "o", "[exited 0 after 0.30s]\r\n"]
[4.532, "m", "Clear the app's delivered notifications"]
[4.532, "o", "$ idb notification clear com.apple.news\r\n"]
[4.964, "o", "[exited 0 after 0.43s]\r\n"]
[5.41, "m", "List notifications after clearing them"]
[5.41, "o", "$ idb notification list com.apple.news\r\n"]
[5.755, "o", "[exited 0 after 0.35s]\r\n"]
[7.16, "o", ""]
