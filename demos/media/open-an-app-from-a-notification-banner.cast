{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.235, "o", "[exited 0 after 0.23s]\r\n"]
[1.235, "m", "Go to the home screen"]
[1.235, "o", "$ idb ui button HOME\r\n"]
[1.4, "o", "[exited 0 after 0.17s]\r\n"]
[1.64, "m", "Check what is where the banner will appear"]
[1.64, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.142, "o", "{\"AXLabel\":null,\"custom_actions\":[],\"content_required\":false,\"enabled\":true,\"frame\":{\"width\":401.99999999999994,\"height\":874,\"x\":0,\"y\":0},\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"role\":\"AXGroup\",\"pid\":9182,\"traits\":[\"Scrollable\"],\"AXUniqueId\":null,\"title\":null,\"type\":\"Group\",\"subrole\":null,\"AXValue\":null,\"help\":null,\"role_description\":\"Group\"}\r\n[exited 0 after 0.50s]\r\n"]
[2.142, "m", "Deliver a notification while the app is not running"]
[2.142, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.555, "o", "[exited 0 after 0.41s]\r\n"]
[3.559, "m", "Tap the banner"]
[3.559, "o", "$ idb ui tap 201 90\r\n"]
[3.754, "o", "[exited 0 after 0.20s]\r\n"]
[4.526, "m", "Clear the app's delivered notifications"]
[4.526, "o", "$ idb notification clear com.apple.news\r\n"]
[4.964, "o", "[exited 0 after 0.44s]\r\n"]
[5.499, "m", "List notifications after clearing them"]
[5.499, "o", "$ idb notification list com.apple.news\r\n"]
[5.988, "o", "[exited 0 after 0.49s]\r\n"]
[7.3, "o", ""]
