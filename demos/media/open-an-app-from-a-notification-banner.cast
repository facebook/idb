{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.911, "m", "Grant notification permission without showing a prompt"]
[0.911, "o", "$ idb approve com.apple.news notification\r\n"]
[1.147, "o", "[exited 0 after 0.24s]\r\n"]
[1.147, "m", "Go to the home screen"]
[1.147, "o", "$ idb ui button HOME\r\n"]
[1.301, "o", "[exited 0 after 0.15s]\r\n"]
[1.55, "m", "Check what is where the banner will appear"]
[1.55, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.924, "o", "{\"help\":null,\"traits\":[\"Scrollable\"],\"content_required\":false,\"AXLabel\":null,\"pid\":1977,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"role\":\"AXGroup\",\"title\":null,\"subrole\":null,\"custom_actions\":[],\"role_description\":\"Group\",\"type\":\"Group\",\"AXValue\":null,\"AXUniqueId\":null,\"enabled\":true,\"frame\":{\"x\":0,\"y\":0,\"height\":874,\"width\":401.99999999999994}}\r\n[exited 0 after 0.37s]\r\n"]
[1.925, "m", "Deliver a notification while the app is not running"]
[1.925, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.129, "o", "[exited 0 after 0.20s]\r\n"]
[3.145, "m", "Tap the banner"]
[3.145, "o", "$ idb ui tap 201 90\r\n"]
[3.994, "o", "[exited 0 after 0.85s]\r\n"]
[4.705, "m", "Clear the app's delivered notifications"]
[4.705, "o", "$ idb notification clear com.apple.news\r\n"]
[5.207, "o", "[exited 0 after 0.50s]\r\n"]
[5.688, "m", "List notifications after clearing them"]
[5.688, "o", "$ idb notification list com.apple.news\r\n"]
[6.137, "o", "[exited 0 after 0.45s]\r\n"]
[7.297, "o", ""]
