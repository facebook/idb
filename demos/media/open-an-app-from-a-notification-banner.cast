{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.252, "o", "[exited 0 after 0.25s]\r\n"]
[1.253, "m", "Go to the home screen"]
[1.253, "o", "$ idb ui button HOME\r\n"]
[1.446, "o", "[exited 0 after 0.19s]\r\n"]
[1.678, "m", "Check what is where the banner will appear"]
[1.678, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.057, "o", "{\"role\":\"AXGroup\",\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"type\":\"Group\",\"enabled\":true,\"content_required\":false,\"custom_actions\":[],\"subrole\":null,\"AXUniqueId\":null,\"role_description\":\"Group\",\"AXValue\":null,\"help\":null,\"title\":null,\"pid\":1339,\"frame\":{\"height\":874,\"width\":401.99999999999994,\"y\":0,\"x\":0},\"AXLabel\":null}\r\n[exited 0 after 0.38s]\r\n"]
[2.058, "m", "Deliver a notification while the app is not running"]
[2.058, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.294, "o", "[exited 0 after 0.24s]\r\n"]
[3.297, "m", "Tap the banner"]
[3.297, "o", "$ idb ui tap 201 90\r\n"]
[3.709, "o", "[exited 0 after 0.41s]\r\n"]
[4.673, "m", "Clear the app's delivered notifications"]
[4.673, "o", "$ idb notification clear com.apple.news\r\n"]
[5.269, "o", "[exited 0 after 0.60s]\r\n"]
[6.161, "m", "List notifications after clearing them"]
[6.161, "o", "$ idb notification list com.apple.news\r\n"]
[6.802, "o", "[exited 0 after 0.64s]\r\n"]
[9.34, "o", ""]
