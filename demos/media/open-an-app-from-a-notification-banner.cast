{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.355, "o", "[exited 0 after 0.36s]\r\n"]
[1.356, "m", "Go to the home screen"]
[1.356, "o", "$ idb ui button HOME\r\n"]
[1.587, "o", "[exited 0 after 0.23s]\r\n"]
[2.215, "m", "Check what is where the banner will appear"]
[2.215, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.482, "o", "{\"role\":\"AXGroup\",\"AXUniqueId\":null,\"frame\":{\"x\":0,\"y\":0,\"width\":401.99999999999994,\"height\":874},\"AXValue\":null,\"help\":null,\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"type\":\"Group\",\"enabled\":true,\"pid\":1367,\"AXLabel\":null,\"content_required\":false,\"traits\":[\"Scrollable\"],\"title\":null,\"subrole\":null,\"role_description\":\"Group\"}\r\n[exited 0 after 0.27s]\r\n"]
[2.482, "m", "Deliver a notification while the app is not running"]
[2.482, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.803, "o", "[exited 0 after 0.32s]\r\n"]
[3.804, "m", "Tap the banner"]
[3.804, "o", "$ idb ui tap 201 90\r\n"]
[4.082, "o", "[exited 0 after 0.28s]\r\n"]
[5.166, "m", "Clear the app's delivered notifications"]
[5.166, "o", "$ idb notification clear com.apple.news\r\n"]
[5.672, "o", "[exited 0 after 0.51s]\r\n"]
[6.233, "m", "List notifications after clearing them"]
[6.233, "o", "$ idb notification list com.apple.news\r\n"]
[6.715, "o", "[exited 0 after 0.48s]\r\n"]
[8.258, "o", ""]
