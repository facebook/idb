{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.262, "o", "[exited 0 after 0.26s]\r\n"]
[1.262, "m", "Go to the home screen"]
[1.262, "o", "$ idb ui button HOME\r\n"]
[1.509, "o", "[exited 0 after 0.25s]\r\n"]
[1.918, "m", "Check what is where the banner will appear"]
[1.918, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.186, "o", "{\"type\":\"Group\",\"title\":null,\"content_required\":false,\"pid\":1513,\"role\":\"AXGroup\",\"frame\":{\"height\":874,\"y\":0,\"x\":0,\"width\":401.99999999999994},\"help\":null,\"custom_actions\":[],\"AXUniqueId\":null,\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"AXLabel\":null,\"role_description\":\"Group\",\"enabled\":true,\"subrole\":null,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.27s]\r\n"]
[2.186, "m", "Deliver a notification while the app is not running"]
[2.186, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.516, "o", "[exited 0 after 0.33s]\r\n"]
[3.517, "m", "Tap the banner"]
[3.517, "o", "$ idb ui tap 201 90\r\n"]
[3.775, "o", "[exited 0 after 0.26s]\r\n"]
[4.86, "m", "Clear the app's delivered notifications"]
[4.86, "o", "$ idb notification clear com.apple.news\r\n"]
[5.312, "o", "[exited 0 after 0.45s]\r\n"]
[5.831, "m", "List notifications after clearing them"]
[5.831, "o", "$ idb notification list com.apple.news\r\n"]
[6.343, "o", "[exited 0 after 0.51s]\r\n"]
[7.873, "o", ""]
