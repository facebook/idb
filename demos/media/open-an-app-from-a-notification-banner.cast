{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.253, "o", "[exited 0 after 0.25s]\r\n"]
[1.253, "m", "Go to the home screen"]
[1.253, "o", "$ idb ui button HOME\r\n"]
[1.441, "o", "[exited 0 after 0.19s]\r\n"]
[1.705, "m", "Check what is where the banner will appear"]
[1.705, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.14, "o", "{\"AXUniqueId\":null,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"type\":\"Group\",\"subrole\":null,\"pid\":1279,\"custom_actions\":[],\"AXLabel\":null,\"role_description\":\"Group\",\"enabled\":true,\"help\":null,\"frame\":{\"height\":874,\"width\":401.99999999999994,\"x\":0,\"y\":0},\"role\":\"AXGroup\",\"AXValue\":null,\"title\":null,\"content_required\":false}\r\n[exited 0 after 0.43s]\r\n"]
[2.141, "m", "Deliver a notification while the app is not running"]
[2.141, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.657, "o", "[exited 0 after 0.52s]\r\n"]
[3.661, "m", "Tap the banner"]
[3.661, "o", "$ idb ui tap 201 90\r\n"]
[4.328, "o", "[exited 0 after 0.67s]\r\n"]
[7.111, "m", "Clear the app's delivered notifications"]
[7.111, "o", "$ idb notification clear com.apple.news\r\n"]
[8.947, "o", "[exited 0 after 1.84s]\r\n"]
[9.908, "m", "List notifications after clearing them"]
[9.908, "o", "$ idb notification list com.apple.news\r\n"]
[10.495, "o", "[exited 0 after 0.59s]\r\n"]
[11.567, "o", ""]
