{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.223, "o", "[exited 0 after 0.22s]\r\n"]
[1.224, "m", "Go to the home screen"]
[1.224, "o", "$ idb ui button HOME\r\n"]
[1.441, "o", "[exited 0 after 0.22s]\r\n"]
[1.714, "m", "Check what is where the banner will appear"]
[1.714, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.086, "o", "{\"pid\":6624,\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"custom_actions\":[],\"traits\":[\"Scrollable\"],\"frame\":{\"y\":0,\"width\":402.00000000000006,\"x\":0,\"height\":874},\"content_required\":false,\"type\":\"Group\",\"AXUniqueId\":null,\"title\":null,\"subrole\":null,\"help\":null,\"role_description\":\"Group\",\"enabled\":true,\"AXLabel\":null,\"role\":\"AXGroup\"}\r\n[exited 0 after 0.37s]\r\n"]
[2.087, "m", "Deliver a notification while the app is not running"]
[2.087, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.393, "o", "[exited 0 after 0.31s]\r\n"]
[3.395, "m", "Tap the banner"]
[3.395, "o", "$ idb ui tap 201 90\r\n"]
[3.614, "o", "[exited 0 after 0.22s]\r\n"]
[4.272, "m", "Clear the app's delivered notifications"]
[4.272, "o", "$ idb notification clear com.apple.news\r\n"]
[4.675, "o", "[exited 0 after 0.40s]\r\n"]
[5.15, "m", "List notifications after clearing them"]
[5.15, "o", "$ idb notification list com.apple.news\r\n"]
[5.663, "o", "[exited 0 after 0.51s]\r\n"]
[6.75, "o", ""]
