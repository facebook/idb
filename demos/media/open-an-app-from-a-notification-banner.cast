{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.29, "o", "[exited 0 after 0.29s]\r\n"]
[1.29, "m", "Go to the home screen"]
[1.29, "o", "$ idb ui button HOME\r\n"]
[1.513, "o", "[exited 0 after 0.22s]\r\n"]
[1.884, "m", "Check what is where the banner will appear"]
[1.884, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.268, "o", "{\"content_required\":false,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"role_description\":\"Group\",\"subrole\":null,\"role\":\"AXGroup\",\"enabled\":true,\"type\":\"Group\",\"AXUniqueId\":null,\"help\":null,\"frame\":{\"width\":402,\"x\":0,\"y\":0,\"height\":874},\"title\":null,\"pid\":1325,\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"AXValue\":null,\"custom_actions\":[]}\r\n[exited 0 after 0.38s]\r\n"]
[2.269, "m", "Deliver a notification while the app is not running"]
[2.269, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.51, "o", "[exited 0 after 0.24s]\r\n"]
[3.514, "m", "Tap the banner"]
[3.514, "o", "$ idb ui tap 201 90\r\n"]
[3.896, "o", "[exited 0 after 0.38s]\r\n"]
[8.255, "m", "Clear the app's delivered notifications"]
[8.255, "o", "$ idb notification clear com.apple.news\r\n"]
[9.081, "o", "[exited 0 after 0.83s]\r\n"]
[9.735, "m", "List notifications after clearing them"]
[9.735, "o", "$ idb notification list com.apple.news\r\n"]
[10.215, "o", "[exited 0 after 0.48s]\r\n"]
[11.12, "o", ""]
