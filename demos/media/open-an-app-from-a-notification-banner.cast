{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.983, "m", "Grant notification permission without showing a prompt"]
[0.983, "o", "$ idb approve com.apple.news notification\r\n"]
[1.195, "o", "[exited 0 after 0.21s]\r\n"]
[1.195, "m", "Go to the home screen"]
[1.195, "o", "$ idb ui button HOME\r\n"]
[1.35, "o", "[exited 0 after 0.16s]\r\n"]
[1.601, "m", "Check what is where the banner will appear"]
[1.601, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.942, "o", "{\"help\":null,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"type\":\"Group\",\"content_required\":false,\"role_description\":\"Group\",\"title\":null,\"subrole\":null,\"pid\":3472,\"AXUniqueId\":null,\"enabled\":true,\"AXValue\":null,\"frame\":{\"height\":874,\"width\":401.99999999999994,\"y\":0,\"x\":0},\"custom_actions\":[],\"AXLabel\":null,\"role\":\"AXGroup\"}\r\n[exited 0 after 0.34s]\r\n"]
[1.942, "m", "Deliver a notification while the app is not running"]
[1.942, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.122, "o", "[exited 0 after 0.18s]\r\n"]
[3.124, "m", "Tap the banner"]
[3.124, "o", "$ idb ui tap 201 90\r\n"]
[3.356, "o", "[exited 0 after 0.23s]\r\n"]
[4.04, "m", "Clear the app's delivered notifications"]
[4.04, "o", "$ idb notification clear com.apple.news\r\n"]
[4.48, "o", "[exited 0 after 0.44s]\r\n"]
[5.042, "m", "List notifications after clearing them"]
[5.042, "o", "$ idb notification list com.apple.news\r\n"]
[5.463, "o", "[exited 0 after 0.42s]\r\n"]
[6.68, "o", ""]
