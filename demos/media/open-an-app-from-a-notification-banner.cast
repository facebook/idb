{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.25, "o", "[exited 0 after 0.25s]\r\n"]
[1.25, "m", "Go to the home screen"]
[1.25, "o", "$ idb ui button HOME\r\n"]
[1.468, "o", "[exited 0 after 0.22s]\r\n"]
[1.843, "m", "Check what is where the banner will appear"]
[1.843, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.181, "o", "{\"traits\":[\"Scrollable\"],\"role_description\":\"Group\",\"AXLabel\":null,\"custom_actions\":[],\"help\":null,\"content_required\":false,\"enabled\":true,\"pid\":1251,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"type\":\"Group\",\"title\":null,\"subrole\":null,\"AXUniqueId\":null,\"role\":\"AXGroup\",\"AXValue\":null,\"frame\":{\"width\":401.99999999999994,\"x\":0,\"y\":0,\"height\":874}}\r\n[exited 0 after 0.34s]\r\n"]
[2.181, "m", "Deliver a notification while the app is not running"]
[2.181, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.467, "o", "[exited 0 after 0.29s]\r\n"]
[3.471, "m", "Tap the banner"]
[3.471, "o", "$ idb ui tap 201 90\r\n"]
[3.768, "o", "[exited 0 after 0.30s]\r\n"]
[4.837, "m", "Clear the app's delivered notifications"]
[4.837, "o", "$ idb notification clear com.apple.news\r\n"]
[5.443, "o", "[exited 0 after 0.61s]\r\n"]
[6.185, "m", "List notifications after clearing them"]
[6.185, "o", "$ idb notification list com.apple.news\r\n"]
[6.707, "o", "[exited 0 after 0.52s]\r\n"]
[8.512, "o", ""]
