{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.221, "o", "[exited 0 after 0.22s]\r\n"]
[1.221, "m", "Go to the home screen"]
[1.221, "o", "$ idb ui button HOME\r\n"]
[1.389, "o", "[exited 0 after 0.17s]\r\n"]
[1.649, "m", "Check what is where the banner will appear"]
[1.649, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.003, "o", "{\"help\":null,\"content_required\":false,\"title\":null,\"role_description\":\"Group\",\"pid\":1338,\"traits\":[\"Scrollable\"],\"AXValue\":null,\"role\":\"AXGroup\",\"frame\":{\"width\":401.99999999999994,\"height\":874,\"x\":0,\"y\":0},\"enabled\":true,\"custom_actions\":[],\"subrole\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"AXUniqueId\":null,\"AXLabel\":null,\"type\":\"Group\"}\r\n[exited 0 after 0.35s]\r\n"]
[2.004, "m", "Deliver a notification while the app is not running"]
[2.004, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.275, "o", "[exited 0 after 0.27s]\r\n"]
[3.279, "m", "Tap the banner"]
[3.279, "o", "$ idb ui tap 201 90\r\n"]
[3.487, "o", "[exited 0 after 0.21s]\r\n"]
[4.079, "m", "Clear the app's delivered notifications"]
[4.079, "o", "$ idb notification clear com.apple.news\r\n"]
[4.459, "o", "[exited 0 after 0.38s]\r\n"]
[4.92, "m", "List notifications after clearing them"]
[4.92, "o", "$ idb notification list com.apple.news\r\n"]
[5.364, "o", "[exited 0 after 0.44s]\r\n"]
[6.638, "o", ""]
