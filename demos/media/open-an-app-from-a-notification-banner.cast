{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.988, "m", "Grant notification permission without showing a prompt"]
[0.988, "o", "$ idb approve com.apple.news notification\r\n"]
[1.28, "o", "[exited 0 after 0.29s]\r\n"]
[1.281, "m", "Go to the home screen"]
[1.281, "o", "$ idb ui button HOME\r\n"]
[1.453, "o", "[exited 0 after 0.17s]\r\n"]
[1.71, "m", "Check what is where the banner will appear"]
[1.71, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.039, "o", "{\"type\":\"Group\",\"help\":null,\"title\":null,\"enabled\":true,\"subrole\":null,\"content_required\":false,\"pid\":1877,\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"AXLabel\":null,\"frame\":{\"height\":874,\"x\":0,\"y\":0,\"width\":401.99999999999994},\"AXValue\":null,\"role_description\":\"Group\",\"AXUniqueId\":null,\"traits\":[\"Scrollable\"],\"custom_actions\":[]}\r\n[exited 0 after 0.33s]\r\n"]
[2.039, "m", "Deliver a notification while the app is not running"]
[2.039, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.257, "o", "[exited 0 after 0.22s]\r\n"]
[3.258, "m", "Tap the banner"]
[3.258, "o", "$ idb ui tap 201 90\r\n"]
[3.466, "o", "[exited 0 after 0.21s]\r\n"]
[4.31, "m", "Clear the app's delivered notifications"]
[4.31, "o", "$ idb notification clear com.apple.news\r\n"]
[4.735, "o", "[exited 0 after 0.42s]\r\n"]
[5.206, "m", "List notifications after clearing them"]
[5.206, "o", "$ idb notification list com.apple.news\r\n"]
[5.656, "o", "[exited 0 after 0.45s]\r\n"]
[6.982, "o", ""]
