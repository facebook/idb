{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.276, "o", "[exited 0 after 0.28s]\r\n"]
[1.276, "m", "Go to the home screen"]
[1.276, "o", "$ idb ui button HOME\r\n"]
[1.455, "o", "[exited 0 after 0.18s]\r\n"]
[1.709, "m", "Check what is where the banner will appear"]
[1.709, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.14, "o", "{\"enabled\":true,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"subrole\":null,\"role_description\":\"Group\",\"AXLabel\":null,\"pid\":2333,\"AXValue\":null,\"help\":null,\"content_required\":false,\"type\":\"Group\",\"title\":null,\"custom_actions\":[],\"role\":\"AXGroup\",\"frame\":{\"y\":0,\"width\":401.99999999999994,\"height\":874,\"x\":0},\"AXUniqueId\":null}\r\n[exited 0 after 0.43s]\r\n"]
[2.142, "m", "Deliver a notification while the app is not running"]
[2.142, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.468, "o", "[exited 0 after 0.33s]\r\n"]
[3.47, "m", "Tap the banner"]
[3.47, "o", "$ idb ui tap 201 90\r\n"]
[3.726, "o", "[exited 0 after 0.26s]\r\n"]
[4.629, "m", "Clear the app's delivered notifications"]
[4.629, "o", "$ idb notification clear com.apple.news\r\n"]
[5.141, "o", "[exited 0 after 0.51s]\r\n"]
[5.719, "m", "List notifications after clearing them"]
[5.719, "o", "$ idb notification list com.apple.news\r\n"]
[6.176, "o", "[exited 0 after 0.46s]\r\n"]
[7.802, "o", ""]
