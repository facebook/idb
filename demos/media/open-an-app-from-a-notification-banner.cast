{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.287, "o", "[exited 0 after 0.29s]\r\n"]
[1.288, "m", "Go to the home screen"]
[1.288, "o", "$ idb ui button HOME\r\n"]
[1.504, "o", "[exited 0 after 0.22s]\r\n"]
[1.79, "m", "Check what is where the banner will appear"]
[1.79, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.248, "o", "{\"frame\":{\"height\":874,\"y\":0,\"width\":402.00000000000006,\"x\":0},\"AXLabel\":null,\"enabled\":true,\"content_required\":false,\"type\":\"Group\",\"role_description\":\"Group\",\"title\":null,\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"subrole\":null,\"custom_actions\":[],\"role\":\"AXGroup\",\"AXUniqueId\":null,\"help\":null,\"pid\":1279,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.46s]\r\n"]
[2.248, "m", "Deliver a notification while the app is not running"]
[2.248, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.476, "o", "[exited 0 after 0.23s]\r\n"]
[3.485, "m", "Tap the banner"]
[3.485, "o", "$ idb ui tap 201 90\r\n"]
[3.799, "o", "[exited 0 after 0.31s]\r\n"]
[4.74, "m", "Clear the app's delivered notifications"]
[4.74, "o", "$ idb notification clear com.apple.news\r\n"]
[5.291, "o", "[exited 0 after 0.55s]\r\n"]
[5.785, "m", "List notifications after clearing them"]
[5.785, "o", "$ idb notification list com.apple.news\r\n"]
[6.216, "o", "[exited 0 after 0.43s]\r\n"]
[7.852, "o", ""]
