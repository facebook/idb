{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.247, "o", "[exited 0 after 0.25s]\r\n"]
[1.247, "m", "Go to the home screen"]
[1.247, "o", "$ idb ui button HOME\r\n"]
[1.438, "o", "[exited 0 after 0.19s]\r\n"]
[1.652, "m", "Check what is where the banner will appear"]
[1.652, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.022, "o", "{\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"title\":null,\"AXLabel\":null,\"type\":\"Group\",\"enabled\":true,\"role\":\"AXGroup\",\"help\":null,\"subrole\":null,\"custom_actions\":[],\"AXUniqueId\":null,\"AXValue\":null,\"frame\":{\"x\":0,\"y\":0,\"width\":401.99999999999994,\"height\":874},\"pid\":1335,\"role_description\":\"Group\",\"traits\":[\"Scrollable\"],\"content_required\":false}\r\n[exited 0 after 0.37s]\r\n"]
[2.022, "m", "Deliver a notification while the app is not running"]
[2.022, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.218, "o", "[exited 0 after 0.20s]\r\n"]
[3.222, "m", "Tap the banner"]
[3.222, "o", "$ idb ui tap 201 90\r\n"]
[3.482, "o", "[exited 0 after 0.26s]\r\n"]
[4.552, "m", "Clear the app's delivered notifications"]
[4.552, "o", "$ idb notification clear com.apple.news\r\n"]
[5.015, "o", "[exited 0 after 0.46s]\r\n"]
[5.492, "m", "List notifications after clearing them"]
[5.492, "o", "$ idb notification list com.apple.news\r\n"]
[5.937, "o", "[exited 0 after 0.44s]\r\n"]
[7.407, "o", ""]
