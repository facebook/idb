{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.211, "o", "[exited 0 after 0.21s]\r\n"]
[1.211, "m", "Go to the home screen"]
[1.211, "o", "$ idb ui button HOME\r\n"]
[1.385, "o", "[exited 0 after 0.17s]\r\n"]
[1.649, "m", "Check what is where the banner will appear"]
[1.649, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.057, "o", "{\"help\":null,\"title\":null,\"custom_actions\":[],\"role\":\"AXGroup\",\"content_required\":false,\"AXValue\":null,\"subrole\":null,\"AXUniqueId\":null,\"role_description\":\"Group\",\"type\":\"Group\",\"pid\":1804,\"frame\":{\"x\":0,\"width\":402.00000000000006,\"y\":0,\"height\":874},\"enabled\":true,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"traits\":[\"Scrollable\"],\"AXLabel\":null}\r\n[exited 0 after 0.41s]\r\n"]
[2.058, "m", "Deliver a notification while the app is not running"]
[2.058, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.383, "o", "[exited 0 after 0.33s]\r\n"]
[3.386, "m", "Tap the banner"]
[3.386, "o", "$ idb ui tap 201 90\r\n"]
[3.589, "o", "[exited 0 after 0.20s]\r\n"]
[4.33, "m", "Clear the app's delivered notifications"]
[4.33, "o", "$ idb notification clear com.apple.news\r\n"]
[4.731, "o", "[exited 0 after 0.40s]\r\n"]
[5.199, "m", "List notifications after clearing them"]
[5.199, "o", "$ idb notification list com.apple.news\r\n"]
[5.603, "o", "[exited 0 after 0.40s]\r\n"]
[6.813, "o", ""]
