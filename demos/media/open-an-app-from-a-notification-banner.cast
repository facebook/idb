{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.237, "o", "[exited 0 after 0.24s]\r\n"]
[1.237, "m", "Go to the home screen"]
[1.237, "o", "$ idb ui button HOME\r\n"]
[1.458, "o", "[exited 0 after 0.22s]\r\n"]
[1.672, "m", "Check what is where the banner will appear"]
[1.672, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.134, "o", "{\"AXLabel\":null,\"type\":\"Group\",\"role\":\"AXGroup\",\"pid\":1954,\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"frame\":{\"y\":0,\"width\":402.00000000000006,\"height\":874,\"x\":0},\"subrole\":null,\"AXValue\":null,\"traits\":[\"Scrollable\"],\"title\":null,\"role_description\":\"Group\",\"content_required\":false,\"AXUniqueId\":null,\"enabled\":true,\"help\":null}\r\n[exited 0 after 0.46s]\r\n"]
[2.135, "m", "Deliver a notification while the app is not running"]
[2.135, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.539, "o", "[exited 0 after 0.40s]\r\n"]
[3.543, "m", "Tap the banner"]
[3.543, "o", "$ idb ui tap 201 90\r\n"]
[3.947, "o", "[exited 0 after 0.40s]\r\n"]
[4.47, "m", "Clear the app's delivered notifications"]
[4.47, "o", "$ idb notification clear com.apple.news\r\n"]
[4.967, "o", "[exited 0 after 0.50s]\r\n"]
[5.518, "m", "List notifications after clearing them"]
[5.518, "o", "$ idb notification list com.apple.news\r\n"]
[6.022, "o", "[exited 0 after 0.50s]\r\n"]
[7.438, "o", ""]
