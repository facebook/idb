{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.293, "o", "[exited 0 after 0.29s]\r\n"]
[1.294, "m", "Go to the home screen"]
[1.294, "o", "$ idb ui button HOME\r\n"]
[1.523, "o", "[exited 0 after 0.23s]\r\n"]
[1.751, "m", "Check what is where the banner will appear"]
[1.751, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.121, "o", "{\"title\":null,\"AXUniqueId\":null,\"frame\":{\"width\":401.99999999999994,\"x\":0,\"height\":874,\"y\":0},\"role_description\":\"Group\",\"role\":\"AXGroup\",\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"enabled\":true,\"help\":null,\"custom_actions\":[],\"pid\":1434,\"subrole\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"content_required\":false,\"AXValue\":null}\r\n[exited 0 after 0.37s]\r\n"]
[2.122, "m", "Deliver a notification while the app is not running"]
[2.122, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.363, "o", "[exited 0 after 0.24s]\r\n"]
[3.366, "m", "Tap the banner"]
[3.366, "o", "$ idb ui tap 201 90\r\n"]
[3.686, "o", "[exited 0 after 0.32s]\r\n"]
[6.384, "m", "Clear the app's delivered notifications"]
[6.384, "o", "$ idb notification clear com.apple.news\r\n"]
[8.055, "o", "[exited 0 after 1.67s]\r\n"]
[8.995, "m", "List notifications after clearing them"]
[8.995, "o", "$ idb notification list com.apple.news\r\n"]
[9.691, "o", "[exited 0 after 0.70s]\r\n"]
[10.705, "o", ""]
