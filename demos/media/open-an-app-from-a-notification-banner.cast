{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.189, "o", "[exited 0 after 0.19s]\r\n"]
[1.189, "m", "Go to the home screen"]
[1.189, "o", "$ idb ui button HOME\r\n"]
[1.349, "o", "[exited 0 after 0.16s]\r\n"]
[1.588, "m", "Check what is where the banner will appear"]
[1.588, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.023, "o", "{\"pid\":22465,\"traits\":[\"Scrollable\"],\"AXValue\":null,\"help\":null,\"role\":\"AXGroup\",\"frame\":{\"x\":0,\"width\":402,\"height\":874,\"y\":0},\"custom_actions\":[],\"AXUniqueId\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"type\":\"Group\",\"AXLabel\":null,\"enabled\":true,\"role_description\":\"Group\",\"title\":null,\"subrole\":null,\"content_required\":false}\r\n[exited 0 after 0.43s]\r\n"]
[2.023, "m", "Deliver a notification while the app is not running"]
[2.023, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.266, "o", "[exited 0 after 0.24s]\r\n"]
[3.27, "m", "Tap the banner"]
[3.27, "o", "$ idb ui tap 201 90\r\n"]
[3.472, "o", "[exited 0 after 0.20s]\r\n"]
[3.972, "m", "Clear the app's delivered notifications"]
[3.972, "o", "$ idb notification clear com.apple.news\r\n"]
[4.465, "o", "[exited 0 after 0.49s]\r\n"]
[4.922, "m", "List notifications after clearing them"]
[4.922, "o", "$ idb notification list com.apple.news\r\n"]
[5.28, "o", "[exited 0 after 0.36s]\r\n"]
[6.385, "o", ""]
