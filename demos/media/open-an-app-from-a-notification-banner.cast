{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.26, "o", "[exited 0 after 0.26s]\r\n"]
[1.26, "m", "Go to the home screen"]
[1.26, "o", "$ idb ui button HOME\r\n"]
[1.489, "o", "[exited 0 after 0.23s]\r\n"]
[1.73, "m", "Check what is where the banner will appear"]
[1.73, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.159, "o", "{\"help\":null,\"type\":\"Group\",\"title\":null,\"AXLabel\":null,\"role_description\":\"Group\",\"AXValue\":null,\"pid\":1527,\"content_required\":false,\"role\":\"AXGroup\",\"AXUniqueId\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"traits\":[\"Scrollable\"],\"subrole\":null,\"custom_actions\":[],\"frame\":{\"width\":401.99999999999994,\"y\":0,\"height\":874,\"x\":0},\"enabled\":true}\r\n[exited 0 after 0.43s]\r\n"]
[2.16, "m", "Deliver a notification while the app is not running"]
[2.16, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.439, "o", "[exited 0 after 0.28s]\r\n"]
[3.443, "m", "Tap the banner"]
[3.443, "o", "$ idb ui tap 201 90\r\n"]
[3.778, "o", "[exited 0 after 0.34s]\r\n"]
[5.42, "m", "Clear the app's delivered notifications"]
[5.42, "o", "$ idb notification clear com.apple.news\r\n"]
[6.163, "o", "[exited 0 after 0.74s]\r\n"]
[6.824, "m", "List notifications after clearing them"]
[6.824, "o", "$ idb notification list com.apple.news\r\n"]
[7.859, "o", "[exited 0 after 1.03s]\r\n"]
[9.315, "o", ""]
