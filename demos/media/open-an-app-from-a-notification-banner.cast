{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.323, "o", "[exited 0 after 0.32s]\r\n"]
[1.323, "m", "Go to the home screen"]
[1.323, "o", "$ idb ui button HOME\r\n"]
[1.523, "o", "[exited 0 after 0.20s]\r\n"]
[1.815, "m", "Check what is where the banner will appear"]
[1.815, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.196, "o", "{\"help\":null,\"title\":null,\"role_description\":\"Group\",\"content_required\":false,\"custom_actions\":[],\"enabled\":true,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"pid\":5576,\"type\":\"Group\",\"AXUniqueId\":null,\"AXValue\":null,\"frame\":{\"width\":402.00000000000006,\"x\":0,\"y\":0,\"height\":874},\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"subrole\":null,\"role\":\"AXGroup\"}\r\n[exited 0 after 0.38s]\r\n"]
[2.197, "m", "Deliver a notification while the app is not running"]
[2.197, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.478, "o", "[exited 0 after 0.28s]\r\n"]
[3.482, "m", "Tap the banner"]
[3.482, "o", "$ idb ui tap 201 90\r\n"]
[3.681, "o", "[exited 0 after 0.20s]\r\n"]
[4.289, "m", "Clear the app's delivered notifications"]
[4.289, "o", "$ idb notification clear com.apple.news\r\n"]
[4.706, "o", "[exited 0 after 0.42s]\r\n"]
[5.154, "m", "List notifications after clearing them"]
[5.154, "o", "$ idb notification list com.apple.news\r\n"]
[5.768, "o", "[exited 0 after 0.61s]\r\n"]
[7.185, "o", ""]
