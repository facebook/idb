{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.261, "o", "[exited 0 after 0.26s]\r\n"]
[1.261, "m", "Go to the home screen"]
[1.261, "o", "$ idb ui button HOME\r\n"]
[1.486, "o", "[exited 0 after 0.23s]\r\n"]
[1.99, "m", "Check what is where the banner will appear"]
[1.99, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.221, "o", "{\"pid\":1866,\"title\":null,\"AXValue\":null,\"type\":\"Group\",\"AXLabel\":null,\"frame\":{\"x\":0,\"height\":874,\"y\":0,\"width\":402.00000000000006},\"role\":\"AXGroup\",\"enabled\":true,\"traits\":[\"Scrollable\"],\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"help\":null,\"subrole\":null,\"role_description\":\"Group\",\"content_required\":false,\"AXUniqueId\":null}\r\n[exited 0 after 0.23s]\r\n"]
[2.222, "m", "Deliver a notification while the app is not running"]
[2.222, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.435, "o", "[exited 0 after 0.21s]\r\n"]
[3.443, "m", "Tap the banner"]
[3.443, "o", "$ idb ui tap 201 90\r\n"]
[3.966, "o", "[exited 0 after 0.52s]\r\n"]
[5.022, "m", "Clear the app's delivered notifications"]
[5.022, "o", "$ idb notification clear com.apple.news\r\n"]
[5.583, "o", "[exited 0 after 0.56s]\r\n"]
[6.247, "m", "List notifications after clearing them"]
[6.247, "o", "$ idb notification list com.apple.news\r\n"]
[6.77, "o", "[exited 0 after 0.52s]\r\n"]
[8.555, "o", ""]
