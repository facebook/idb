{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.334, "o", "[exited 0 after 0.33s]\r\n"]
[1.334, "m", "Go to the home screen"]
[1.334, "o", "$ idb ui button HOME\r\n"]
[1.571, "o", "[exited 0 after 0.24s]\r\n"]
[2.238, "m", "Check what is where the banner will appear"]
[2.238, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.485, "o", "{\"AXLabel\":null,\"role_description\":\"Group\",\"frame\":{\"y\":0,\"x\":0,\"width\":402,\"height\":874},\"AXValue\":null,\"custom_actions\":[],\"pid\":1316,\"subrole\":null,\"traits\":[\"Scrollable\"],\"help\":null,\"role\":\"AXGroup\",\"content_required\":false,\"type\":\"Group\",\"AXUniqueId\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"title\":null,\"enabled\":true}\r\n[exited 0 after 0.25s]\r\n"]
[2.485, "m", "Deliver a notification while the app is not running"]
[2.485, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.766, "o", "[exited 0 after 0.28s]\r\n"]
[3.771, "m", "Tap the banner"]
[3.771, "o", "$ idb ui tap 201 90\r\n"]
[4.257, "o", "[exited 0 after 0.49s]\r\n"]
[6.2, "m", "Clear the app's delivered notifications"]
[6.2, "o", "$ idb notification clear com.apple.news\r\n"]
[6.803, "o", "[exited 0 after 0.60s]\r\n"]
[7.903, "m", "List notifications after clearing them"]
[7.903, "o", "$ idb notification list com.apple.news\r\n"]
[8.547, "o", "[exited 0 after 0.64s]\r\n"]
[9.45, "o", ""]
