{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.252, "o", "[exited 0 after 0.25s]\r\n"]
[1.253, "m", "Go to the home screen"]
[1.253, "o", "$ idb ui button HOME\r\n"]
[1.444, "o", "[exited 0 after 0.19s]\r\n"]
[1.649, "m", "Check what is where the banner will appear"]
[1.649, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.972, "o", "{\"AXValue\":null,\"subrole\":null,\"title\":null,\"AXLabel\":null,\"enabled\":true,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"role\":\"AXGroup\",\"AXUniqueId\":null,\"frame\":{\"x\":0,\"y\":0,\"height\":874,\"width\":401.99999999999994},\"type\":\"Group\",\"help\":null,\"traits\":[\"Scrollable\"],\"content_required\":false,\"role_description\":\"Group\",\"custom_actions\":[],\"pid\":3196}\r\n[exited 0 after 0.32s]\r\n"]
[1.972, "m", "Deliver a notification while the app is not running"]
[1.972, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.196, "o", "[exited 0 after 0.22s]\r\n"]
[3.199, "m", "Tap the banner"]
[3.199, "o", "$ idb ui tap 201 90\r\n"]
[3.42, "o", "[exited 0 after 0.22s]\r\n"]
[4.12, "m", "Clear the app's delivered notifications"]
[4.12, "o", "$ idb notification clear com.apple.news\r\n"]
[4.585, "o", "[exited 0 after 0.47s]\r\n"]
[5.162, "m", "List notifications after clearing them"]
[5.162, "o", "$ idb notification list com.apple.news\r\n"]
[5.586, "o", "[exited 0 after 0.42s]\r\n"]
[6.858, "o", ""]
