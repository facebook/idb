{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.245, "o", "[exited 0 after 0.24s]\r\n"]
[1.245, "m", "Go to the home screen"]
[1.245, "o", "$ idb ui button HOME\r\n"]
[1.428, "o", "[exited 0 after 0.18s]\r\n"]
[1.71, "m", "Check what is where the banner will appear"]
[1.71, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.399, "o", "{\"help\":null,\"content_required\":false,\"custom_actions\":[],\"AXUniqueId\":null,\"frame\":{\"y\":0,\"width\":402.00000000000006,\"x\":0,\"height\":874},\"subrole\":null,\"pid\":1551,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"AXLabel\":null,\"role_description\":\"Group\",\"title\":null,\"role\":\"AXGroup\",\"AXValue\":null,\"enabled\":true,\"type\":\"Group\"}\r\n[exited 0 after 0.69s]\r\n"]
[2.399, "m", "Deliver a notification while the app is not running"]
[2.399, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.627, "o", "[exited 0 after 0.23s]\r\n"]
[3.631, "m", "Tap the banner"]
[3.631, "o", "$ idb ui tap 201 90\r\n"]
[3.894, "o", "[exited 0 after 0.26s]\r\n"]
[4.833, "m", "Clear the app's delivered notifications"]
[4.833, "o", "$ idb notification clear com.apple.news\r\n"]
[5.346, "o", "[exited 0 after 0.51s]\r\n"]
[5.885, "m", "List notifications after clearing them"]
[5.885, "o", "$ idb notification list com.apple.news\r\n"]
[6.432, "o", "[exited 0 after 0.55s]\r\n"]
[8.193, "o", ""]
