{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.237, "o", "[exited 0 after 0.24s]\r\n"]
[1.237, "m", "Go to the home screen"]
[1.237, "o", "$ idb ui button HOME\r\n"]
[1.419, "o", "[exited 0 after 0.18s]\r\n"]
[1.682, "m", "Check what is where the banner will appear"]
[1.682, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.08, "o", "{\"AXLabel\":null,\"frame\":{\"x\":0,\"height\":874,\"width\":402,\"y\":0},\"subrole\":null,\"enabled\":true,\"role\":\"AXGroup\",\"AXValue\":null,\"role_description\":\"Group\",\"content_required\":false,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"type\":\"Group\",\"help\":null,\"pid\":3768,\"custom_actions\":[],\"AXUniqueId\":null,\"title\":null}\r\n[exited 0 after 0.40s]\r\n"]
[2.081, "m", "Deliver a notification while the app is not running"]
[2.081, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.323, "o", "[exited 0 after 0.24s]\r\n"]
[3.327, "m", "Tap the banner"]
[3.327, "o", "$ idb ui tap 201 90\r\n"]
[3.677, "o", "[exited 0 after 0.35s]\r\n"]
[4.571, "m", "Clear the app's delivered notifications"]
[4.571, "o", "$ idb notification clear com.apple.news\r\n"]
[5.12, "o", "[exited 0 after 0.55s]\r\n"]
[5.733, "m", "List notifications after clearing them"]
[5.733, "o", "$ idb notification list com.apple.news\r\n"]
[6.406, "o", "[exited 0 after 0.67s]\r\n"]
[8.102, "o", ""]
