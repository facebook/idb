{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.272, "o", "[exited 0 after 0.27s]\r\n"]
[1.273, "m", "Go to the home screen"]
[1.273, "o", "$ idb ui button HOME\r\n"]
[1.482, "o", "[exited 0 after 0.21s]\r\n"]
[1.736, "m", "Check what is where the banner will appear"]
[1.736, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.236, "o", "{\"content_required\":false,\"traits\":[\"Scrollable\"],\"AXUniqueId\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"help\":null,\"title\":null,\"role_description\":\"Group\",\"AXValue\":null,\"pid\":1870,\"AXLabel\":null,\"enabled\":true,\"custom_actions\":[],\"type\":\"Group\",\"role\":\"AXGroup\",\"subrole\":null,\"frame\":{\"y\":0,\"x\":0,\"height\":874,\"width\":402}}\r\n[exited 0 after 0.50s]\r\n"]
[2.236, "m", "Deliver a notification while the app is not running"]
[2.236, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.573, "o", "[exited 0 after 0.34s]\r\n"]
[3.577, "m", "Tap the banner"]
[3.577, "o", "$ idb ui tap 201 90\r\n"]
[3.872, "o", "[exited 0 after 0.30s]\r\n"]
[4.664, "m", "Clear the app's delivered notifications"]
[4.664, "o", "$ idb notification clear com.apple.news\r\n"]
[5.124, "o", "[exited 0 after 0.46s]\r\n"]
[5.616, "m", "List notifications after clearing them"]
[5.616, "o", "$ idb notification list com.apple.news\r\n"]
[6.107, "o", "[exited 0 after 0.49s]\r\n"]
[7.21, "o", ""]
