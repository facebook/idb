{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.212, "o", "[exited 0 after 0.21s]\r\n"]
[1.212, "m", "Go to the home screen"]
[1.212, "o", "$ idb ui button HOME\r\n"]
[1.385, "o", "[exited 0 after 0.17s]\r\n"]
[1.632, "m", "Check what is where the banner will appear"]
[1.632, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.98, "o", "{\"role_description\":\"Group\",\"pid\":4041,\"role\":\"AXGroup\",\"content_required\":false,\"AXUniqueId\":null,\"help\":null,\"AXValue\":null,\"subrole\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"title\":null,\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"custom_actions\":[],\"AXLabel\":null,\"enabled\":true,\"frame\":{\"width\":401.99999999999994,\"y\":0,\"x\":0,\"height\":874}}\r\n[exited 0 after 0.35s]\r\n"]
[1.98, "m", "Deliver a notification while the app is not running"]
[1.98, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.158, "o", "[exited 0 after 0.18s]\r\n"]
[3.162, "m", "Tap the banner"]
[3.162, "o", "$ idb ui tap 201 90\r\n"]
[3.366, "o", "[exited 0 after 0.20s]\r\n"]
[4.046, "m", "Clear the app's delivered notifications"]
[4.046, "o", "$ idb notification clear com.apple.news\r\n"]
[4.524, "o", "[exited 0 after 0.48s]\r\n"]
[5.102, "m", "List notifications after clearing them"]
[5.102, "o", "$ idb notification list com.apple.news\r\n"]
[5.545, "o", "[exited 0 after 0.44s]\r\n"]
[7.118, "o", ""]
