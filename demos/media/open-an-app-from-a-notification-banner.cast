{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.263, "o", "[exited 0 after 0.26s]\r\n"]
[1.264, "m", "Go to the home screen"]
[1.264, "o", "$ idb ui button HOME\r\n"]
[1.475, "o", "[exited 0 after 0.21s]\r\n"]
[1.755, "m", "Check what is where the banner will appear"]
[1.755, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.162, "o", "{\"title\":null,\"enabled\":true,\"help\":null,\"pid\":1654,\"AXUniqueId\":null,\"type\":\"Group\",\"AXValue\":null,\"traits\":[\"Scrollable\"],\"role\":\"AXGroup\",\"content_required\":false,\"frame\":{\"width\":402.00000000000006,\"x\":0,\"height\":874,\"y\":0},\"AXLabel\":null,\"custom_actions\":[],\"subrole\":null,\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\"}\r\n[exited 0 after 0.41s]\r\n"]
[2.163, "m", "Deliver a notification while the app is not running"]
[2.163, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.493, "o", "[exited 0 after 0.33s]\r\n"]
[3.497, "m", "Tap the banner"]
[3.497, "o", "$ idb ui tap 201 90\r\n"]
[3.807, "o", "[exited 0 after 0.31s]\r\n"]
[5.059, "m", "Clear the app's delivered notifications"]
[5.059, "o", "$ idb notification clear com.apple.news\r\n"]
[5.634, "o", "[exited 0 after 0.58s]\r\n"]
[6.193, "m", "List notifications after clearing them"]
[6.193, "o", "$ idb notification list com.apple.news\r\n"]
[6.682, "o", "[exited 0 after 0.49s]\r\n"]
[8.578, "o", ""]
