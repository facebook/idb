{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.286, "o", "[exited 0 after 0.29s]\r\n"]
[1.286, "m", "Go to the home screen"]
[1.286, "o", "$ idb ui button HOME\r\n"]
[1.515, "o", "[exited 0 after 0.23s]\r\n"]
[1.764, "m", "Check what is where the banner will appear"]
[1.764, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.165, "o", "{\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"traits\":[\"Scrollable\"],\"AXValue\":null,\"subrole\":null,\"AXLabel\":null,\"title\":null,\"content_required\":false,\"role_description\":\"Group\",\"AXUniqueId\":null,\"type\":\"Group\",\"custom_actions\":[],\"frame\":{\"y\":0,\"x\":0,\"height\":874,\"width\":402},\"pid\":1324,\"help\":null,\"enabled\":true}\r\n[exited 0 after 0.40s]\r\n"]
[2.166, "m", "Deliver a notification while the app is not running"]
[2.166, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.406, "o", "[exited 0 after 0.24s]\r\n"]
[3.41, "m", "Tap the banner"]
[3.41, "o", "$ idb ui tap 201 90\r\n"]
[3.868, "o", "[exited 0 after 0.46s]\r\n"]
[6.549, "m", "Clear the app's delivered notifications"]
[6.549, "o", "$ idb notification clear com.apple.news\r\n"]
[7.582, "o", "[exited 0 after 1.03s]\r\n"]
[8.858, "m", "List notifications after clearing them"]
[8.858, "o", "$ idb notification list com.apple.news\r\n"]
[9.62, "o", "[exited 0 after 0.76s]\r\n"]
[10.687, "o", ""]
