{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.223, "o", "[exited 0 after 0.22s]\r\n"]
[1.223, "m", "Go to the home screen"]
[1.223, "o", "$ idb ui button HOME\r\n"]
[1.42, "o", "[exited 0 after 0.20s]\r\n"]
[1.651, "m", "Check what is where the banner will appear"]
[1.651, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.398, "o", "{\"AXValue\":null,\"custom_actions\":[],\"type\":\"Group\",\"pid\":1330,\"subrole\":null,\"enabled\":true,\"role_description\":\"Group\",\"frame\":{\"width\":402.00000000000006,\"y\":0,\"height\":874,\"x\":0},\"help\":null,\"AXLabel\":null,\"role\":\"AXGroup\",\"title\":null,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"AXUniqueId\":null,\"content_required\":false}\r\n[exited 0 after 0.75s]\r\n"]
[2.404, "m", "Deliver a notification while the app is not running"]
[2.404, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.706, "o", "[exited 0 after 0.30s]\r\n"]
[3.71, "m", "Tap the banner"]
[3.71, "o", "$ idb ui tap 201 90\r\n"]
[4.015, "o", "[exited 0 after 0.30s]\r\n"]
[5.285, "m", "Clear the app's delivered notifications"]
[5.285, "o", "$ idb notification clear com.apple.news\r\n"]
[6.005, "o", "[exited 0 after 0.72s]\r\n"]
[6.605, "m", "List notifications after clearing them"]
[6.605, "o", "$ idb notification list com.apple.news\r\n"]
[7.139, "o", "[exited 0 after 0.53s]\r\n"]
[8.913, "o", ""]
