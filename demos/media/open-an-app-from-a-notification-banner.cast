{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.278, "o", "[exited 0 after 0.28s]\r\n"]
[1.279, "m", "Go to the home screen"]
[1.279, "o", "$ idb ui button HOME\r\n"]
[1.54, "o", "[exited 0 after 0.26s]\r\n"]
[1.822, "m", "Check what is where the banner will appear"]
[1.822, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.27, "o", "{\"AXValue\":null,\"title\":null,\"frame\":{\"width\":402.00000000000006,\"y\":0,\"height\":874,\"x\":0},\"content_required\":false,\"role\":\"AXGroup\",\"custom_actions\":[],\"AXLabel\":null,\"subrole\":null,\"pid\":4568,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"help\":null,\"enabled\":true,\"AXUniqueId\":null,\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"role_description\":\"Group\"}\r\n[exited 0 after 0.45s]\r\n"]
[2.27, "m", "Deliver a notification while the app is not running"]
[2.27, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.522, "o", "[exited 0 after 0.25s]\r\n"]
[3.525, "m", "Tap the banner"]
[3.525, "o", "$ idb ui tap 201 90\r\n"]
[3.755, "o", "[exited 0 after 0.23s]\r\n"]
[4.682, "m", "Clear the app's delivered notifications"]
[4.682, "o", "$ idb notification clear com.apple.news\r\n"]
[5.21, "o", "[exited 0 after 0.53s]\r\n"]
[6.014, "m", "List notifications after clearing them"]
[6.014, "o", "$ idb notification list com.apple.news\r\n"]
[6.49, "o", "[exited 0 after 0.48s]\r\n"]
[8.445, "o", ""]
