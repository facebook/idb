{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.272, "o", "[exited 0 after 0.27s]\r\n"]
[1.272, "m", "Go to the home screen"]
[1.272, "o", "$ idb ui button HOME\r\n"]
[1.457, "o", "[exited 0 after 0.18s]\r\n"]
[1.69, "m", "Check what is where the banner will appear"]
[1.69, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.191, "o", "{\"AXLabel\":null,\"subrole\":null,\"enabled\":true,\"traits\":[\"Scrollable\"],\"AXUniqueId\":null,\"type\":\"Group\",\"custom_actions\":[],\"AXValue\":null,\"content_required\":false,\"role\":\"AXGroup\",\"frame\":{\"y\":0,\"x\":0,\"height\":874,\"width\":402.00000000000006},\"role_description\":\"Group\",\"pid\":1687,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"help\":null,\"title\":null}\r\n[exited 0 after 0.50s]\r\n"]
[2.192, "m", "Deliver a notification while the app is not running"]
[2.192, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.476, "o", "[exited 0 after 0.28s]\r\n"]
[3.479, "m", "Tap the banner"]
[3.479, "o", "$ idb ui tap 201 90\r\n"]
[3.711, "o", "[exited 0 after 0.23s]\r\n"]
[5.0, "m", "Clear the app's delivered notifications"]
[5.0, "o", "$ idb notification clear com.apple.news\r\n"]
[5.688, "o", "[exited 0 after 0.69s]\r\n"]
[6.146, "m", "List notifications after clearing them"]
[6.146, "o", "$ idb notification list com.apple.news\r\n"]
[7.291, "o", "[exited 0 after 1.14s]\r\n"]
[8.373, "o", ""]
