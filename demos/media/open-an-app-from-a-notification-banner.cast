{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.291, "o", "[exited 0 after 0.29s]\r\n"]
[1.292, "m", "Go to the home screen"]
[1.292, "o", "$ idb ui button HOME\r\n"]
[1.47, "o", "[exited 0 after 0.18s]\r\n"]
[1.754, "m", "Check what is where the banner will appear"]
[1.754, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.141, "o", "{\"AXUniqueId\":null,\"role\":\"AXGroup\",\"content_required\":false,\"traits\":[\"Scrollable\"],\"enabled\":true,\"title\":null,\"frame\":{\"width\":402.00000000000006,\"x\":0,\"y\":0,\"height\":874},\"type\":\"Group\",\"AXLabel\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"help\":null,\"subrole\":null,\"pid\":2546,\"custom_actions\":[],\"role_description\":\"Group\",\"AXValue\":null}\r\n[exited 0 after 0.39s]\r\n"]
[2.141, "m", "Deliver a notification while the app is not running"]
[2.141, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.345, "o", "[exited 0 after 0.20s]\r\n"]
[3.349, "m", "Tap the banner"]
[3.349, "o", "$ idb ui tap 201 90\r\n"]
[3.684, "o", "[exited 0 after 0.33s]\r\n"]
[4.497, "m", "Clear the app's delivered notifications"]
[4.497, "o", "$ idb notification clear com.apple.news\r\n"]
[4.954, "o", "[exited 0 after 0.46s]\r\n"]
[5.469, "m", "List notifications after clearing them"]
[5.469, "o", "$ idb notification list com.apple.news\r\n"]
[5.976, "o", "[exited 0 after 0.51s]\r\n"]
[7.775, "o", ""]
