{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.291, "o", "[exited 0 after 0.29s]\r\n"]
[1.291, "m", "Go to the home screen"]
[1.291, "o", "$ idb ui button HOME\r\n"]
[1.516, "o", "[exited 0 after 0.23s]\r\n"]
[1.751, "m", "Check what is where the banner will appear"]
[1.751, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.096, "o", "{\"role\":\"AXGroup\",\"type\":\"Group\",\"AXValue\":null,\"AXUniqueId\":null,\"custom_actions\":[],\"help\":null,\"title\":null,\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"frame\":{\"width\":402,\"x\":0,\"y\":0,\"height\":874},\"role_description\":\"Group\",\"subrole\":null,\"content_required\":false,\"enabled\":true,\"pid\":1318}\r\n[exited 0 after 0.35s]\r\n"]
[2.097, "m", "Deliver a notification while the app is not running"]
[2.097, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.336, "o", "[exited 0 after 0.24s]\r\n"]
[3.339, "m", "Tap the banner"]
[3.339, "o", "$ idb ui tap 201 90\r\n"]
[3.602, "o", "[exited 0 after 0.26s]\r\n"]
[4.473, "m", "Clear the app's delivered notifications"]
[4.473, "o", "$ idb notification clear com.apple.news\r\n"]
[4.946, "o", "[exited 0 after 0.47s]\r\n"]
[5.494, "m", "List notifications after clearing them"]
[5.494, "o", "$ idb notification list com.apple.news\r\n"]
[6.031, "o", "[exited 0 after 0.54s]\r\n"]
[7.412, "o", ""]
