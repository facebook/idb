{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.32, "o", "[exited 0 after 0.32s]\r\n"]
[1.32, "m", "Go to the home screen"]
[1.32, "o", "$ idb ui button HOME\r\n"]
[1.554, "o", "[exited 0 after 0.23s]\r\n"]
[1.819, "m", "Check what is where the banner will appear"]
[1.819, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.289, "o", "{\"content_required\":false,\"AXLabel\":null,\"pid\":1319,\"custom_actions\":[],\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"frame\":{\"x\":0,\"width\":402,\"y\":0,\"height\":874},\"enabled\":true,\"role\":\"AXGroup\",\"AXValue\":null,\"AXUniqueId\":null,\"type\":\"Group\",\"title\":null,\"subrole\":null,\"help\":null,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.47s]\r\n"]
[2.289, "m", "Deliver a notification while the app is not running"]
[2.289, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.592, "o", "[exited 0 after 0.30s]\r\n"]
[3.594, "m", "Tap the banner"]
[3.594, "o", "$ idb ui tap 201 90\r\n"]
[3.909, "o", "[exited 0 after 0.32s]\r\n"]
[5.007, "m", "Clear the app's delivered notifications"]
[5.007, "o", "$ idb notification clear com.apple.news\r\n"]
[5.796, "o", "[exited 0 after 0.79s]\r\n"]
[6.386, "m", "List notifications after clearing them"]
[6.386, "o", "$ idb notification list com.apple.news\r\n"]
[6.917, "o", "[exited 0 after 0.53s]\r\n"]
[8.782, "o", ""]
