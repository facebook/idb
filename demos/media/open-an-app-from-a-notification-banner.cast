{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.266, "o", "[exited 0 after 0.27s]\r\n"]
[1.266, "m", "Go to the home screen"]
[1.266, "o", "$ idb ui button HOME\r\n"]
[1.455, "o", "[exited 0 after 0.19s]\r\n"]
[1.734, "m", "Check what is where the banner will appear"]
[1.734, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.129, "o", "{\"help\":null,\"frame\":{\"x\":0,\"y\":0,\"width\":402.00000000000006,\"height\":874},\"AXLabel\":null,\"enabled\":true,\"AXUniqueId\":null,\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"subrole\":null,\"content_required\":false,\"AXValue\":null,\"pid\":3146,\"role_description\":\"Group\",\"title\":null,\"role\":\"AXGroup\",\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\"}\r\n[exited 0 after 0.39s]\r\n"]
[2.13, "m", "Deliver a notification while the app is not running"]
[2.13, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.346, "o", "[exited 0 after 0.22s]\r\n"]
[3.349, "m", "Tap the banner"]
[3.349, "o", "$ idb ui tap 201 90\r\n"]
[3.621, "o", "[exited 0 after 0.27s]\r\n"]
[5.843, "m", "Clear the app's delivered notifications"]
[5.843, "o", "$ idb notification clear com.apple.news\r\n"]
[6.776, "o", "[exited 0 after 0.93s]\r\n"]
[7.452, "m", "List notifications after clearing them"]
[7.452, "o", "$ idb notification list com.apple.news\r\n"]
[8.014, "o", "[exited 0 after 0.56s]\r\n"]
[8.788, "o", ""]
