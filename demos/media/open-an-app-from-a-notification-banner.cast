{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.265, "o", "[exited 0 after 0.26s]\r\n"]
[1.265, "m", "Go to the home screen"]
[1.265, "o", "$ idb ui button HOME\r\n"]
[1.469, "o", "[exited 0 after 0.20s]\r\n"]
[1.713, "m", "Check what is where the banner will appear"]
[1.713, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.192, "o", "{\"AXValue\":null,\"frame\":{\"height\":874,\"x\":0,\"width\":402,\"y\":0},\"content_required\":false,\"pid\":1366,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"subrole\":null,\"title\":null,\"AXLabel\":null,\"type\":\"Group\",\"role_description\":\"Group\",\"enabled\":true,\"help\":null,\"AXUniqueId\":null,\"role\":\"AXGroup\",\"custom_actions\":[]}\r\n[exited 0 after 0.48s]\r\n"]
[2.193, "m", "Deliver a notification while the app is not running"]
[2.193, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.495, "o", "[exited 0 after 0.30s]\r\n"]
[3.498, "m", "Tap the banner"]
[3.498, "o", "$ idb ui tap 201 90\r\n"]
[3.88, "o", "[exited 0 after 0.38s]\r\n"]
[4.917, "m", "Clear the app's delivered notifications"]
[4.917, "o", "$ idb notification clear com.apple.news\r\n"]
[5.539, "o", "[exited 0 after 0.62s]\r\n"]
[6.199, "m", "List notifications after clearing them"]
[6.199, "o", "$ idb notification list com.apple.news\r\n"]
[6.722, "o", "[exited 0 after 0.52s]\r\n"]
[9.53, "o", ""]
