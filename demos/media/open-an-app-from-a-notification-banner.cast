{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.207, "o", "[exited 0 after 0.21s]\r\n"]
[1.207, "m", "Go to the home screen"]
[1.207, "o", "$ idb ui button HOME\r\n"]
[1.397, "o", "[exited 0 after 0.19s]\r\n"]
[1.587, "m", "Check what is where the banner will appear"]
[1.587, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.92, "o", "{\"subrole\":null,\"help\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"AXLabel\":null,\"AXUniqueId\":null,\"frame\":{\"y\":0,\"height\":874,\"x\":0,\"width\":402.00000000000006},\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"pid\":19823,\"custom_actions\":[],\"role_description\":\"Group\",\"title\":null,\"enabled\":true,\"role\":\"AXGroup\",\"AXValue\":null,\"content_required\":false}\r\n[exited 0 after 0.33s]\r\n"]
[1.92, "m", "Deliver a notification while the app is not running"]
[1.92, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.091, "o", "[exited 0 after 0.17s]\r\n"]
[3.095, "m", "Tap the banner"]
[3.095, "o", "$ idb ui tap 201 90\r\n"]
[3.308, "o", "[exited 0 after 0.21s]\r\n"]
[4.005, "m", "Clear the app's delivered notifications"]
[4.005, "o", "$ idb notification clear com.apple.news\r\n"]
[4.422, "o", "[exited 0 after 0.42s]\r\n"]
[4.878, "m", "List notifications after clearing them"]
[4.878, "o", "$ idb notification list com.apple.news\r\n"]
[5.374, "o", "[exited 0 after 0.50s]\r\n"]
[6.557, "o", ""]
