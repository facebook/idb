{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.244, "o", "[exited 0 after 0.24s]\r\n"]
[1.244, "m", "Go to the home screen"]
[1.244, "o", "$ idb ui button HOME\r\n"]
[1.427, "o", "[exited 0 after 0.18s]\r\n"]
[1.668, "m", "Check what is where the banner will appear"]
[1.668, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.116, "o", "{\"help\":null,\"enabled\":true,\"AXLabel\":null,\"title\":null,\"subrole\":null,\"content_required\":false,\"pid\":19312,\"frame\":{\"y\":0,\"height\":874,\"x\":0,\"width\":401.99999999999994},\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"AXUniqueId\":null,\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"custom_actions\":[],\"role_description\":\"Group\",\"AXValue\":null}\r\n[exited 0 after 0.45s]\r\n"]
[2.117, "m", "Deliver a notification while the app is not running"]
[2.117, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.385, "o", "[exited 0 after 0.27s]\r\n"]
[3.388, "m", "Tap the banner"]
[3.388, "o", "$ idb ui tap 201 90\r\n"]
[3.562, "o", "[exited 0 after 0.17s]\r\n"]
[4.232, "m", "Clear the app's delivered notifications"]
[4.232, "o", "$ idb notification clear com.apple.news\r\n"]
[4.621, "o", "[exited 0 after 0.39s]\r\n"]
[5.071, "m", "List notifications after clearing them"]
[5.071, "o", "$ idb notification list com.apple.news\r\n"]
[5.536, "o", "[exited 0 after 0.47s]\r\n"]
[6.742, "o", ""]
