{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.226, "o", "[exited 0 after 0.23s]\r\n"]
[1.226, "m", "Go to the home screen"]
[1.226, "o", "$ idb ui button HOME\r\n"]
[1.471, "o", "[exited 0 after 0.25s]\r\n"]
[1.716, "m", "Check what is where the banner will appear"]
[1.716, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.151, "o", "{\"traits\":[\"Scrollable\"],\"subrole\":null,\"help\":null,\"frame\":{\"y\":0,\"width\":402.00000000000006,\"height\":874,\"x\":0},\"AXUniqueId\":null,\"title\":null,\"custom_actions\":[],\"role_description\":\"Group\",\"content_required\":false,\"enabled\":true,\"type\":\"Group\",\"AXLabel\":null,\"AXValue\":null,\"pid\":4082,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"role\":\"AXGroup\"}\r\n[exited 0 after 0.44s]\r\n"]
[2.152, "m", "Deliver a notification while the app is not running"]
[2.152, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.419, "o", "[exited 0 after 0.27s]\r\n"]
[3.425, "m", "Tap the banner"]
[3.425, "o", "$ idb ui tap 201 90\r\n"]
[3.672, "o", "[exited 0 after 0.25s]\r\n"]
[4.43, "m", "Clear the app's delivered notifications"]
[4.43, "o", "$ idb notification clear com.apple.news\r\n"]
[4.92, "o", "[exited 0 after 0.49s]\r\n"]
[5.421, "m", "List notifications after clearing them"]
[5.421, "o", "$ idb notification list com.apple.news\r\n"]
[5.994, "o", "[exited 0 after 0.57s]\r\n"]
[7.483, "o", ""]
