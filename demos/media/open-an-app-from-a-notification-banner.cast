{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.244, "o", "[exited 0 after 0.24s]\r\n"]
[1.244, "m", "Go to the home screen"]
[1.244, "o", "$ idb ui button HOME\r\n"]
[1.444, "o", "[exited 0 after 0.20s]\r\n"]
[1.679, "m", "Check what is where the banner will appear"]
[1.679, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.032, "o", "{\"enabled\":true,\"title\":null,\"frame\":{\"y\":0,\"height\":874,\"x\":0,\"width\":402},\"AXLabel\":null,\"AXValue\":null,\"type\":\"Group\",\"AXUniqueId\":null,\"role_description\":\"Group\",\"role\":\"AXGroup\",\"pid\":2032,\"help\":null,\"content_required\":false,\"custom_actions\":[],\"traits\":[\"Scrollable\"],\"subrole\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\"}\r\n[exited 0 after 0.35s]\r\n"]
[2.032, "m", "Deliver a notification while the app is not running"]
[2.032, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.222, "o", "[exited 0 after 0.19s]\r\n"]
[3.224, "m", "Tap the banner"]
[3.224, "o", "$ idb ui tap 201 90\r\n"]
[3.637, "o", "[exited 0 after 0.41s]\r\n"]
[4.238, "m", "Clear the app's delivered notifications"]
[4.238, "o", "$ idb notification clear com.apple.news\r\n"]
[4.675, "o", "[exited 0 after 0.44s]\r\n"]
[5.119, "m", "List notifications after clearing them"]
[5.119, "o", "$ idb notification list com.apple.news\r\n"]
[5.628, "o", "[exited 0 after 0.51s]\r\n"]
[7.022, "o", ""]
