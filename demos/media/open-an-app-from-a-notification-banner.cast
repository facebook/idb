{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.331, "o", "[exited 0 after 0.33s]\r\n"]
[1.331, "m", "Go to the home screen"]
[1.331, "o", "$ idb ui button HOME\r\n"]
[1.529, "o", "[exited 0 after 0.20s]\r\n"]
[1.78, "m", "Check what is where the banner will appear"]
[1.78, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.389, "o", "{\"pid\":1312,\"role\":\"AXGroup\",\"subrole\":null,\"content_required\":false,\"title\":null,\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"role_description\":\"Group\",\"custom_actions\":[],\"frame\":{\"width\":401.99999999999994,\"y\":0,\"x\":0,\"height\":874},\"traits\":[\"Scrollable\"],\"enabled\":true,\"AXLabel\":null,\"AXUniqueId\":null,\"type\":\"Group\",\"help\":null}\r\n[exited 0 after 0.61s]\r\n"]
[2.39, "m", "Deliver a notification while the app is not running"]
[2.39, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.694, "o", "[exited 0 after 0.30s]\r\n"]
[3.698, "m", "Tap the banner"]
[3.698, "o", "$ idb ui tap 201 90\r\n"]
[4.06, "o", "[exited 0 after 0.36s]\r\n"]
[7.21, "m", "Clear the app's delivered notifications"]
[7.21, "o", "$ idb notification clear com.apple.news\r\n"]
[8.615, "o", "[exited 0 after 1.40s]\r\n"]
[9.501, "m", "List notifications after clearing them"]
[9.501, "o", "$ idb notification list com.apple.news\r\n"]
[10.265, "o", "[exited 0 after 0.76s]\r\n"]
[11.3, "o", ""]
