{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.256, "o", "[exited 0 after 0.26s]\r\n"]
[1.257, "m", "Go to the home screen"]
[1.257, "o", "$ idb ui button HOME\r\n"]
[1.452, "o", "[exited 0 after 0.20s]\r\n"]
[1.753, "m", "Check what is where the banner will appear"]
[1.753, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.11, "o", "{\"AXValue\":null,\"role\":\"AXGroup\",\"AXUniqueId\":null,\"content_required\":false,\"pid\":2949,\"AXLabel\":null,\"title\":null,\"traits\":[\"Scrollable\"],\"frame\":{\"x\":0,\"width\":402.00000000000006,\"height\":874,\"y\":0},\"enabled\":true,\"role_description\":\"Group\",\"type\":\"Group\",\"help\":null,\"custom_actions\":[],\"subrole\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\"}\r\n[exited 0 after 0.36s]\r\n"]
[2.11, "m", "Deliver a notification while the app is not running"]
[2.11, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.433, "o", "[exited 0 after 0.32s]\r\n"]
[3.445, "m", "Tap the banner"]
[3.445, "o", "$ idb ui tap 201 90\r\n"]
[3.705, "o", "[exited 0 after 0.26s]\r\n"]
[4.739, "m", "Clear the app's delivered notifications"]
[4.739, "o", "$ idb notification clear com.apple.news\r\n"]
[5.184, "o", "[exited 0 after 0.45s]\r\n"]
[5.652, "m", "List notifications after clearing them"]
[5.652, "o", "$ idb notification list com.apple.news\r\n"]
[6.106, "o", "[exited 0 after 0.45s]\r\n"]
[7.38, "o", ""]
