{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.256, "o", "[exited 0 after 0.26s]\r\n"]
[1.256, "m", "Go to the home screen"]
[1.256, "o", "$ idb ui button HOME\r\n"]
[1.452, "o", "[exited 0 after 0.20s]\r\n"]
[1.706, "m", "Check what is where the banner will appear"]
[1.706, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.137, "o", "{\"role_description\":\"Group\",\"AXUniqueId\":null,\"help\":null,\"custom_actions\":[],\"traits\":[\"Scrollable\"],\"AXValue\":null,\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"content_required\":false,\"frame\":{\"x\":0,\"y\":0,\"width\":402,\"height\":874},\"enabled\":true,\"type\":\"Group\",\"title\":null,\"AXLabel\":null,\"subrole\":null,\"pid\":1848}\r\n[exited 0 after 0.43s]\r\n"]
[2.137, "m", "Deliver a notification while the app is not running"]
[2.137, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.37, "o", "[exited 0 after 0.23s]\r\n"]
[3.373, "m", "Tap the banner"]
[3.373, "o", "$ idb ui tap 201 90\r\n"]
[4.074, "o", "[exited 0 after 0.70s]\r\n"]
[7.609, "m", "Clear the app's delivered notifications"]
[7.609, "o", "$ idb notification clear com.apple.news\r\n"]
[8.141, "o", "[exited 0 after 0.53s]\r\n"]
[8.582, "m", "List notifications after clearing them"]
[8.582, "o", "$ idb notification list com.apple.news\r\n"]
[8.967, "o", "[exited 0 after 0.38s]\r\n"]
[9.68, "o", ""]
