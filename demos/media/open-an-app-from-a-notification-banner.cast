{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.267, "o", "[exited 0 after 0.27s]\r\n"]
[1.267, "m", "Go to the home screen"]
[1.267, "o", "$ idb ui button HOME\r\n"]
[1.463, "o", "[exited 0 after 0.20s]\r\n"]
[1.705, "m", "Check what is where the banner will appear"]
[1.705, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.251, "o", "{\"pid\":1322,\"AXUniqueId\":null,\"role_description\":\"Group\",\"AXLabel\":null,\"role\":\"AXGroup\",\"title\":null,\"content_required\":false,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"custom_actions\":[],\"enabled\":true,\"help\":null,\"AXValue\":null,\"frame\":{\"width\":402,\"height\":874,\"x\":0,\"y\":0},\"traits\":[\"Scrollable\"],\"subrole\":null,\"type\":\"Group\"}\r\n[exited 0 after 0.55s]\r\n"]
[2.252, "m", "Deliver a notification while the app is not running"]
[2.252, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.555, "o", "[exited 0 after 0.30s]\r\n"]
[3.56, "m", "Tap the banner"]
[3.56, "o", "$ idb ui tap 201 90\r\n"]
[3.846, "o", "[exited 0 after 0.29s]\r\n"]
[5.125, "m", "Clear the app's delivered notifications"]
[5.125, "o", "$ idb notification clear com.apple.news\r\n"]
[5.827, "o", "[exited 0 after 0.70s]\r\n"]
[6.32, "m", "List notifications after clearing them"]
[6.32, "o", "$ idb notification list com.apple.news\r\n"]
[6.826, "o", "[exited 0 after 0.51s]\r\n"]
[8.75, "o", ""]
