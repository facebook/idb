{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.218, "o", "[exited 0 after 0.22s]\r\n"]
[1.218, "m", "Go to the home screen"]
[1.218, "o", "$ idb ui button HOME\r\n"]
[1.375, "o", "[exited 0 after 0.16s]\r\n"]
[1.605, "m", "Check what is where the banner will appear"]
[1.605, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.927, "o", "{\"type\":\"Group\",\"enabled\":true,\"AXUniqueId\":null,\"role_description\":\"Group\",\"custom_actions\":[],\"traits\":[\"Scrollable\"],\"AXLabel\":null,\"content_required\":false,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"title\":null,\"pid\":1282,\"frame\":{\"height\":874,\"x\":0,\"y\":0,\"width\":401.99999999999994},\"role\":\"AXGroup\",\"AXValue\":null,\"subrole\":null,\"help\":null}\r\n[exited 0 after 0.32s]\r\n"]
[1.927, "m", "Deliver a notification while the app is not running"]
[1.927, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.099, "o", "[exited 0 after 0.17s]\r\n"]
[3.102, "m", "Tap the banner"]
[3.102, "o", "$ idb ui tap 201 90\r\n"]
[3.295, "o", "[exited 0 after 0.19s]\r\n"]
[4.043, "m", "Clear the app's delivered notifications"]
[4.043, "o", "$ idb notification clear com.apple.news\r\n"]
[4.495, "o", "[exited 0 after 0.45s]\r\n"]
[4.969, "m", "List notifications after clearing them"]
[4.969, "o", "$ idb notification list com.apple.news\r\n"]
[5.374, "o", "[exited 0 after 0.41s]\r\n"]
[6.76, "o", ""]
