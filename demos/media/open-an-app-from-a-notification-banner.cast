{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.277, "o", "[exited 0 after 0.28s]\r\n"]
[1.277, "m", "Go to the home screen"]
[1.277, "o", "$ idb ui button HOME\r\n"]
[1.461, "o", "[exited 0 after 0.18s]\r\n"]
[1.694, "m", "Check what is where the banner will appear"]
[1.694, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.087, "o", "{\"content_required\":false,\"pid\":1276,\"frame\":{\"width\":402.00000000000006,\"x\":0,\"y\":0,\"height\":874},\"help\":null,\"custom_actions\":[],\"AXUniqueId\":null,\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"AXValue\":null,\"title\":null,\"traits\":[\"Scrollable\"],\"subrole\":null,\"enabled\":true,\"type\":\"Group\",\"AXLabel\":null,\"role\":\"AXGroup\"}\r\n[exited 0 after 0.39s]\r\n"]
[2.087, "m", "Deliver a notification while the app is not running"]
[2.087, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.295, "o", "[exited 0 after 0.21s]\r\n"]
[3.299, "m", "Tap the banner"]
[3.299, "o", "$ idb ui tap 201 90\r\n"]
[3.588, "o", "[exited 0 after 0.29s]\r\n"]
[4.628, "m", "Clear the app's delivered notifications"]
[4.628, "o", "$ idb notification clear com.apple.news\r\n"]
[5.284, "o", "[exited 0 after 0.66s]\r\n"]
[5.784, "m", "List notifications after clearing them"]
[5.784, "o", "$ idb notification list com.apple.news\r\n"]
[6.207, "o", "[exited 0 after 0.42s]\r\n"]
[7.853, "o", ""]
