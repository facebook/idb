{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.291, "o", "[exited 0 after 0.29s]\r\n"]
[1.292, "m", "Go to the home screen"]
[1.292, "o", "$ idb ui button HOME\r\n"]
[1.516, "o", "[exited 0 after 0.22s]\r\n"]
[1.8, "m", "Check what is where the banner will appear"]
[1.8, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.311, "o", "{\"help\":null,\"title\":null,\"role_description\":\"Group\",\"pid\":1459,\"traits\":[\"Scrollable\"],\"custom_actions\":[],\"AXLabel\":null,\"AXUniqueId\":null,\"enabled\":true,\"type\":\"Group\",\"role\":\"AXGroup\",\"AXValue\":null,\"content_required\":false,\"subrole\":null,\"frame\":{\"width\":402,\"x\":0,\"y\":0,\"height\":874},\"AXFrame\":\"{{0, 0}, {402, 874}}\"}\r\n[exited 0 after 0.51s]\r\n"]
[2.312, "m", "Deliver a notification while the app is not running"]
[2.312, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.638, "o", "[exited 0 after 0.33s]\r\n"]
[3.641, "m", "Tap the banner"]
[3.641, "o", "$ idb ui tap 201 90\r\n"]
[3.975, "o", "[exited 0 after 0.33s]\r\n"]
[5.016, "m", "Clear the app's delivered notifications"]
[5.016, "o", "$ idb notification clear com.apple.news\r\n"]
[5.538, "o", "[exited 0 after 0.52s]\r\n"]
[6.206, "m", "List notifications after clearing them"]
[6.206, "o", "$ idb notification list com.apple.news\r\n"]
[6.751, "o", "[exited 0 after 0.55s]\r\n"]
[8.485, "o", ""]
