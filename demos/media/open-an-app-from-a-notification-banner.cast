{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.235, "o", "[exited 0 after 0.24s]\r\n"]
[1.236, "m", "Go to the home screen"]
[1.236, "o", "$ idb ui button HOME\r\n"]
[1.443, "o", "[exited 0 after 0.21s]\r\n"]
[2.41, "m", "Check what is where the banner will appear"]
[2.41, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.632, "o", "{\"traits\":[\"Scrollable\"],\"AXUniqueId\":null,\"AXLabel\":null,\"frame\":{\"x\":0,\"y\":0,\"height\":874,\"width\":401.99999999999994},\"title\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"subrole\":null,\"type\":\"Group\",\"custom_actions\":[],\"AXValue\":null,\"role_description\":\"Group\",\"pid\":1439,\"help\":null,\"role\":\"AXGroup\",\"content_required\":false,\"enabled\":true}\r\n[exited 0 after 0.22s]\r\n"]
[2.632, "m", "Deliver a notification while the app is not running"]
[2.632, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.853, "o", "[exited 0 after 0.22s]\r\n"]
[3.856, "m", "Tap the banner"]
[3.856, "o", "$ idb ui tap 201 90\r\n"]
[4.432, "o", "[exited 0 after 0.58s]\r\n"]
[5.335, "m", "Clear the app's delivered notifications"]
[5.335, "o", "$ idb notification clear com.apple.news\r\n"]
[5.885, "o", "[exited 0 after 0.55s]\r\n"]
[6.335, "m", "List notifications after clearing them"]
[6.335, "o", "$ idb notification list com.apple.news\r\n"]
[7.19, "o", "[exited 0 after 0.86s]\r\n"]
[8.085, "o", ""]
