{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.92, "m", "Grant notification permission without showing a prompt"]
[0.92, "o", "$ idb approve com.apple.news notification\r\n"]
[1.197, "o", "[exited 0 after 0.28s]\r\n"]
[1.197, "m", "Go to the home screen"]
[1.197, "o", "$ idb ui button HOME\r\n"]
[1.363, "o", "[exited 0 after 0.17s]\r\n"]
[1.599, "m", "Check what is where the banner will appear"]
[1.599, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.935, "o", "{\"type\":\"Group\",\"content_required\":false,\"AXUniqueId\":null,\"custom_actions\":[],\"role_description\":\"Group\",\"traits\":[\"Scrollable\"],\"help\":null,\"enabled\":true,\"AXLabel\":null,\"pid\":48463,\"AXValue\":null,\"subrole\":null,\"title\":null,\"frame\":{\"x\":0,\"height\":874,\"width\":401.99999999999994,\"y\":0},\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"role\":\"AXGroup\"}\r\n[exited 0 after 0.34s]\r\n"]
[1.936, "m", "Deliver a notification while the app is not running"]
[1.936, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.125, "o", "[exited 0 after 0.19s]\r\n"]
[3.127, "m", "Tap the banner"]
[3.127, "o", "$ idb ui tap 201 90\r\n"]
[3.374, "o", "[exited 0 after 0.25s]\r\n"]
[4.023, "m", "Clear the app's delivered notifications"]
[4.023, "o", "$ idb notification clear com.apple.news\r\n"]
[4.403, "o", "[exited 0 after 0.38s]\r\n"]
[4.864, "m", "List notifications after clearing them"]
[4.864, "o", "$ idb notification list com.apple.news\r\n"]
[5.284, "o", "[exited 0 after 0.42s]\r\n"]
[6.587, "o", ""]
