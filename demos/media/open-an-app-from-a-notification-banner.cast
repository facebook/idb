{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.886, "m", "Grant notification permission without showing a prompt"]
[0.886, "o", "$ idb approve com.apple.news notification\r\n"]
[1.097, "o", "[exited 0 after 0.21s]\r\n"]
[1.097, "m", "Go to the home screen"]
[1.097, "o", "$ idb ui button HOME\r\n"]
[1.281, "o", "[exited 0 after 0.18s]\r\n"]
[1.52, "m", "Check what is where the banner will appear"]
[1.52, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.985, "o", "{\"custom_actions\":[],\"traits\":[\"Scrollable\"],\"role_description\":\"Group\",\"frame\":{\"y\":0,\"height\":874,\"x\":0,\"width\":402.00000000000006},\"content_required\":false,\"AXValue\":null,\"type\":\"Group\",\"subrole\":null,\"AXUniqueId\":null,\"enabled\":true,\"AXLabel\":null,\"help\":null,\"pid\":4477,\"title\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"role\":\"AXGroup\"}\r\n[exited 0 after 0.47s]\r\n"]
[1.985, "m", "Deliver a notification while the app is not running"]
[1.985, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.265, "o", "[exited 0 after 0.28s]\r\n"]
[3.268, "m", "Tap the banner"]
[3.268, "o", "$ idb ui tap 201 90\r\n"]
[3.533, "o", "[exited 0 after 0.27s]\r\n"]
[4.192, "m", "Clear the app's delivered notifications"]
[4.192, "o", "$ idb notification clear com.apple.news\r\n"]
[4.617, "o", "[exited 0 after 0.42s]\r\n"]
[5.239, "m", "List notifications after clearing them"]
[5.239, "o", "$ idb notification list com.apple.news\r\n"]
[5.684, "o", "[exited 0 after 0.44s]\r\n"]
[6.915, "o", ""]
