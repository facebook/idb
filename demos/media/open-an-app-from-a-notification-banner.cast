{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.237, "o", "[exited 0 after 0.24s]\r\n"]
[1.237, "m", "Go to the home screen"]
[1.237, "o", "$ idb ui button HOME\r\n"]
[1.434, "o", "[exited 0 after 0.20s]\r\n"]
[1.704, "m", "Check what is where the banner will appear"]
[1.704, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.04, "o", "{\"role\":\"AXGroup\",\"traits\":[\"Scrollable\"],\"role_description\":\"Group\",\"frame\":{\"x\":0,\"width\":401.99999999999994,\"height\":874,\"y\":0},\"subrole\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"custom_actions\":[],\"enabled\":true,\"type\":\"Group\",\"pid\":1615,\"AXUniqueId\":null,\"AXLabel\":null,\"AXValue\":null,\"content_required\":false,\"title\":null,\"help\":null}\r\n[exited 0 after 0.34s]\r\n"]
[2.041, "m", "Deliver a notification while the app is not running"]
[2.041, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.24, "o", "[exited 0 after 0.20s]\r\n"]
[3.246, "m", "Tap the banner"]
[3.246, "o", "$ idb ui tap 201 90\r\n"]
[3.53, "o", "[exited 0 after 0.28s]\r\n"]
[4.275, "m", "Clear the app's delivered notifications"]
[4.275, "o", "$ idb notification clear com.apple.news\r\n"]
[4.649, "o", "[exited 0 after 0.37s]\r\n"]
[5.199, "m", "List notifications after clearing them"]
[5.199, "o", "$ idb notification list com.apple.news\r\n"]
[5.665, "o", "[exited 0 after 0.47s]\r\n"]
[7.033, "o", ""]
