{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.283, "o", "[exited 0 after 0.28s]\r\n"]
[1.283, "m", "Go to the home screen"]
[1.283, "o", "$ idb ui button HOME\r\n"]
[1.462, "o", "[exited 0 after 0.18s]\r\n"]
[1.727, "m", "Check what is where the banner will appear"]
[1.727, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.129, "o", "{\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"role_description\":\"Group\",\"content_required\":false,\"traits\":[\"Scrollable\"],\"help\":null,\"type\":\"Group\",\"enabled\":true,\"AXUniqueId\":null,\"custom_actions\":[],\"role\":\"AXGroup\",\"frame\":{\"x\":0,\"width\":402.00000000000006,\"height\":874,\"y\":0},\"AXValue\":null,\"subrole\":null,\"title\":null,\"pid\":1969,\"AXLabel\":null}\r\n[exited 0 after 0.40s]\r\n"]
[2.129, "m", "Deliver a notification while the app is not running"]
[2.129, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.352, "o", "[exited 0 after 0.22s]\r\n"]
[3.357, "m", "Tap the banner"]
[3.357, "o", "$ idb ui tap 201 90\r\n"]
[3.646, "o", "[exited 0 after 0.29s]\r\n"]
[4.447, "m", "Clear the app's delivered notifications"]
[4.447, "o", "$ idb notification clear com.apple.news\r\n"]
[5.005, "o", "[exited 0 after 0.56s]\r\n"]
[5.637, "m", "List notifications after clearing them"]
[5.637, "o", "$ idb notification list com.apple.news\r\n"]
[6.214, "o", "[exited 0 after 0.58s]\r\n"]
[8.112, "o", ""]
