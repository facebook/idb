{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.289, "o", "[exited 0 after 0.29s]\r\n"]
[1.289, "m", "Go to the home screen"]
[1.289, "o", "$ idb ui button HOME\r\n"]
[1.468, "o", "[exited 0 after 0.18s]\r\n"]
[1.728, "m", "Check what is where the banner will appear"]
[1.728, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.145, "o", "{\"help\":null,\"AXValue\":null,\"type\":\"Group\",\"role\":\"AXGroup\",\"frame\":{\"y\":0,\"width\":401.99999999999994,\"height\":874,\"x\":0},\"AXLabel\":null,\"content_required\":false,\"title\":null,\"AXUniqueId\":null,\"role_description\":\"Group\",\"enabled\":true,\"traits\":[\"Scrollable\"],\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"subrole\":null,\"pid\":1306}\r\n[exited 0 after 0.42s]\r\n"]
[2.153, "m", "Deliver a notification while the app is not running"]
[2.153, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.488, "o", "[exited 0 after 0.33s]\r\n"]
[3.508, "m", "Tap the banner"]
[3.508, "o", "$ idb ui tap 201 90\r\n"]
[3.891, "o", "[exited 0 after 0.38s]\r\n"]
[5.352, "m", "Clear the app's delivered notifications"]
[5.352, "o", "$ idb notification clear com.apple.news\r\n"]
[5.867, "o", "[exited 0 after 0.51s]\r\n"]
[6.375, "m", "List notifications after clearing them"]
[6.375, "o", "$ idb notification list com.apple.news\r\n"]
[6.986, "o", "[exited 0 after 0.61s]\r\n"]
[8.772, "o", ""]
