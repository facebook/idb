{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.273, "o", "[exited 0 after 0.27s]\r\n"]
[1.273, "m", "Go to the home screen"]
[1.273, "o", "$ idb ui button HOME\r\n"]
[1.439, "o", "[exited 0 after 0.17s]\r\n"]
[1.656, "m", "Check what is where the banner will appear"]
[1.656, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.97, "o", "{\"AXUniqueId\":null,\"subrole\":null,\"AXValue\":null,\"role_description\":\"Group\",\"pid\":1276,\"frame\":{\"width\":402.00000000000006,\"height\":874,\"y\":0,\"x\":0},\"type\":\"Group\",\"title\":null,\"AXLabel\":null,\"help\":null,\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"enabled\":true,\"traits\":[\"Scrollable\"],\"content_required\":false,\"role\":\"AXGroup\"}\r\n[exited 0 after 0.31s]\r\n"]
[1.97, "m", "Deliver a notification while the app is not running"]
[1.97, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.151, "o", "[exited 0 after 0.18s]\r\n"]
[3.154, "m", "Tap the banner"]
[3.154, "o", "$ idb ui tap 201 90\r\n"]
[3.486, "o", "[exited 0 after 0.33s]\r\n"]
[4.327, "m", "Clear the app's delivered notifications"]
[4.327, "o", "$ idb notification clear com.apple.news\r\n"]
[4.833, "o", "[exited 0 after 0.51s]\r\n"]
[5.403, "m", "List notifications after clearing them"]
[5.403, "o", "$ idb notification list com.apple.news\r\n"]
[5.925, "o", "[exited 0 after 0.52s]\r\n"]
[7.967, "o", ""]
