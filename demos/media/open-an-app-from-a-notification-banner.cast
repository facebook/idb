{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.275, "o", "[exited 0 after 0.27s]\r\n"]
[1.275, "m", "Go to the home screen"]
[1.275, "o", "$ idb ui button HOME\r\n"]
[1.462, "o", "[exited 0 after 0.19s]\r\n"]
[2.124, "m", "Check what is where the banner will appear"]
[2.124, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.396, "o", "{\"AXUniqueId\":null,\"title\":null,\"AXValue\":null,\"subrole\":null,\"traits\":[\"Scrollable\"],\"role\":\"AXGroup\",\"enabled\":true,\"content_required\":false,\"help\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"pid\":2965,\"role_description\":\"Group\",\"type\":\"Group\",\"AXLabel\":null,\"custom_actions\":[],\"frame\":{\"y\":0,\"width\":402.00000000000006,\"x\":0,\"height\":874}}\r\n[exited 0 after 0.27s]\r\n"]
[2.396, "m", "Deliver a notification while the app is not running"]
[2.396, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.81, "o", "[exited 0 after 0.41s]\r\n"]
[3.812, "m", "Tap the banner"]
[3.812, "o", "$ idb ui tap 201 90\r\n"]
[4.093, "o", "[exited 0 after 0.28s]\r\n"]
[5.467, "m", "Clear the app's delivered notifications"]
[5.467, "o", "$ idb notification clear com.apple.news\r\n"]
[6.254, "o", "[exited 0 after 0.79s]\r\n"]
[6.739, "m", "List notifications after clearing them"]
[6.739, "o", "$ idb notification list com.apple.news\r\n"]
[7.928, "o", "[exited 0 after 1.19s]\r\n"]
[9.42, "o", ""]
