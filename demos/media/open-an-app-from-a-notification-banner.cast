{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.268, "o", "[exited 0 after 0.27s]\r\n"]
[1.268, "m", "Go to the home screen"]
[1.268, "o", "$ idb ui button HOME\r\n"]
[1.452, "o", "[exited 0 after 0.18s]\r\n"]
[1.733, "m", "Check what is where the banner will appear"]
[1.733, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.191, "o", "{\"AXValue\":null,\"title\":null,\"role_description\":\"Group\",\"type\":\"Group\",\"AXLabel\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"custom_actions\":[],\"enabled\":true,\"role\":\"AXGroup\",\"content_required\":false,\"AXUniqueId\":null,\"pid\":2924,\"subrole\":null,\"frame\":{\"width\":401.99999999999994,\"height\":874,\"x\":0,\"y\":0},\"help\":null,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.46s]\r\n"]
[2.191, "m", "Deliver a notification while the app is not running"]
[2.191, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.397, "o", "[exited 0 after 0.21s]\r\n"]
[3.403, "m", "Tap the banner"]
[3.403, "o", "$ idb ui tap 201 90\r\n"]
[3.726, "o", "[exited 0 after 0.32s]\r\n"]
[4.523, "m", "Clear the app's delivered notifications"]
[4.523, "o", "$ idb notification clear com.apple.news\r\n"]
[5.049, "o", "[exited 0 after 0.53s]\r\n"]
[5.552, "m", "List notifications after clearing them"]
[5.552, "o", "$ idb notification list com.apple.news\r\n"]
[6.032, "o", "[exited 0 after 0.48s]\r\n"]
[7.223, "o", ""]
