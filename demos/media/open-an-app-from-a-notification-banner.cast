{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.206, "o", "[exited 0 after 0.21s]\r\n"]
[1.206, "m", "Go to the home screen"]
[1.206, "o", "$ idb ui button HOME\r\n"]
[1.378, "o", "[exited 0 after 0.17s]\r\n"]
[1.641, "m", "Check what is where the banner will appear"]
[1.641, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.975, "o", "{\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"pid\":4229,\"frame\":{\"height\":874,\"y\":0,\"x\":0,\"width\":402},\"role_description\":\"Group\",\"enabled\":true,\"AXLabel\":null,\"content_required\":false,\"help\":null,\"AXValue\":null,\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"role\":\"AXGroup\",\"AXUniqueId\":null,\"title\":null,\"custom_actions\":[],\"subrole\":null}\r\n[exited 0 after 0.33s]\r\n"]
[1.975, "m", "Deliver a notification while the app is not running"]
[1.975, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.157, "o", "[exited 0 after 0.18s]\r\n"]
[3.16, "m", "Tap the banner"]
[3.16, "o", "$ idb ui tap 201 90\r\n"]
[3.451, "o", "[exited 0 after 0.29s]\r\n"]
[4.192, "m", "Clear the app's delivered notifications"]
[4.192, "o", "$ idb notification clear com.apple.news\r\n"]
[4.59, "o", "[exited 0 after 0.40s]\r\n"]
[5.069, "m", "List notifications after clearing them"]
[5.069, "o", "$ idb notification list com.apple.news\r\n"]
[5.45, "o", "[exited 0 after 0.38s]\r\n"]
[6.665, "o", ""]
