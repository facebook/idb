{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.31, "o", "[exited 0 after 0.31s]\r\n"]
[1.311, "m", "Go to the home screen"]
[1.311, "o", "$ idb ui button HOME\r\n"]
[1.521, "o", "[exited 0 after 0.21s]\r\n"]
[1.751, "m", "Check what is where the banner will appear"]
[1.751, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.383, "o", "{\"custom_actions\":[],\"content_required\":false,\"AXValue\":null,\"AXUniqueId\":null,\"pid\":1312,\"subrole\":null,\"role\":\"AXGroup\",\"type\":\"Group\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"AXLabel\":null,\"help\":null,\"title\":null,\"frame\":{\"height\":874,\"x\":0,\"y\":0,\"width\":401.99999999999994},\"traits\":[\"Scrollable\"],\"role_description\":\"Group\",\"enabled\":true}\r\n[exited 0 after 0.63s]\r\n"]
[2.383, "m", "Deliver a notification while the app is not running"]
[2.383, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.708, "o", "[exited 0 after 0.32s]\r\n"]
[3.712, "m", "Tap the banner"]
[3.712, "o", "$ idb ui tap 201 90\r\n"]
[3.999, "o", "[exited 0 after 0.29s]\r\n"]
[6.438, "m", "Clear the app's delivered notifications"]
[6.438, "o", "$ idb notification clear com.apple.news\r\n"]
[7.006, "o", "[exited 0 after 0.57s]\r\n"]
[8.132, "m", "List notifications after clearing them"]
[8.132, "o", "$ idb notification list com.apple.news\r\n"]
[8.747, "o", "[exited 0 after 0.61s]\r\n"]
[9.833, "o", ""]
