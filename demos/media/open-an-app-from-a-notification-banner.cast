{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.256, "o", "[exited 0 after 0.26s]\r\n"]
[1.256, "m", "Go to the home screen"]
[1.256, "o", "$ idb ui button HOME\r\n"]
[1.431, "o", "[exited 0 after 0.17s]\r\n"]
[1.668, "m", "Check what is where the banner will appear"]
[1.668, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.051, "o", "{\"AXUniqueId\":null,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"pid\":3184,\"custom_actions\":[],\"type\":\"Group\",\"enabled\":true,\"AXValue\":null,\"AXLabel\":null,\"role_description\":\"Group\",\"role\":\"AXGroup\",\"frame\":{\"y\":0,\"width\":402,\"height\":874,\"x\":0},\"title\":null,\"help\":null,\"subrole\":null,\"content_required\":false}\r\n[exited 0 after 0.38s]\r\n"]
[2.052, "m", "Deliver a notification while the app is not running"]
[2.052, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.297, "o", "[exited 0 after 0.24s]\r\n"]
[3.301, "m", "Tap the banner"]
[3.301, "o", "$ idb ui tap 201 90\r\n"]
[3.538, "o", "[exited 0 after 0.24s]\r\n"]
[4.399, "m", "Clear the app's delivered notifications"]
[4.399, "o", "$ idb notification clear com.apple.news\r\n"]
[4.828, "o", "[exited 0 after 0.43s]\r\n"]
[5.301, "m", "List notifications after clearing them"]
[5.301, "o", "$ idb notification list com.apple.news\r\n"]
[5.887, "o", "[exited 0 after 0.59s]\r\n"]
[7.263, "o", ""]
