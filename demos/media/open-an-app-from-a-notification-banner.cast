{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.342, "o", "[exited 0 after 0.34s]\r\n"]
[1.342, "m", "Go to the home screen"]
[1.342, "o", "$ idb ui button HOME\r\n"]
[1.618, "o", "[exited 0 after 0.28s]\r\n"]
[1.958, "m", "Check what is where the banner will appear"]
[1.958, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.397, "o", "{\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"role\":\"AXGroup\",\"AXUniqueId\":null,\"help\":null,\"traits\":[\"Scrollable\"],\"title\":null,\"content_required\":false,\"frame\":{\"y\":0,\"height\":874,\"x\":0,\"width\":401.99999999999994},\"pid\":1287,\"enabled\":true,\"type\":\"Group\",\"custom_actions\":[],\"AXLabel\":null,\"AXValue\":null,\"subrole\":null}\r\n[exited 0 after 0.44s]\r\n"]
[2.398, "m", "Deliver a notification while the app is not running"]
[2.398, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.687, "o", "[exited 0 after 0.29s]\r\n"]
[3.69, "m", "Tap the banner"]
[3.69, "o", "$ idb ui tap 201 90\r\n"]
[4.332, "o", "[exited 0 after 0.64s]\r\n"]
[6.547, "m", "Clear the app's delivered notifications"]
[6.547, "o", "$ idb notification clear com.apple.news\r\n"]
[8.014, "o", "[exited 0 after 1.47s]\r\n"]
[8.678, "m", "List notifications after clearing them"]
[8.678, "o", "$ idb notification list com.apple.news\r\n"]
[9.241, "o", "[exited 0 after 0.56s]\r\n"]
[10.255, "o", ""]
