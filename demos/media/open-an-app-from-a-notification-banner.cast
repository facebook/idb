{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.902, "m", "Grant notification permission without showing a prompt"]
[0.902, "o", "$ idb approve com.apple.news notification\r\n"]
[1.127, "o", "[exited 0 after 0.22s]\r\n"]
[1.127, "m", "Go to the home screen"]
[1.127, "o", "$ idb ui button HOME\r\n"]
[1.277, "o", "[exited 0 after 0.15s]\r\n"]
[1.495, "m", "Check what is where the banner will appear"]
[1.495, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.873, "o", "{\"enabled\":true,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"subrole\":null,\"AXValue\":null,\"role\":\"AXGroup\",\"pid\":1991,\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"help\":null,\"type\":\"Group\",\"frame\":{\"height\":874,\"x\":0,\"width\":402.00000000000006,\"y\":0},\"AXUniqueId\":null,\"content_required\":false,\"role_description\":\"Group\",\"title\":null,\"custom_actions\":[]}\r\n[exited 0 after 0.38s]\r\n"]
[1.874, "m", "Deliver a notification while the app is not running"]
[1.874, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.067, "o", "[exited 0 after 0.19s]\r\n"]
[3.068, "m", "Tap the banner"]
[3.068, "o", "$ idb ui tap 201 90\r\n"]
[3.345, "o", "[exited 0 after 0.28s]\r\n"]
[4.069, "m", "Clear the app's delivered notifications"]
[4.069, "o", "$ idb notification clear com.apple.news\r\n"]
[4.476, "o", "[exited 0 after 0.41s]\r\n"]
[4.911, "m", "List notifications after clearing them"]
[4.911, "o", "$ idb notification list com.apple.news\r\n"]
[5.416, "o", "[exited 0 after 0.50s]\r\n"]
[6.602, "o", ""]
