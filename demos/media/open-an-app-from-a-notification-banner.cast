{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.299, "o", "[exited 0 after 0.30s]\r\n"]
[1.3, "m", "Go to the home screen"]
[1.3, "o", "$ idb ui button HOME\r\n"]
[1.499, "o", "[exited 0 after 0.20s]\r\n"]
[1.998, "m", "Check what is where the banner will appear"]
[1.998, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.307, "o", "{\"title\":null,\"AXValue\":null,\"type\":\"Group\",\"enabled\":true,\"AXUniqueId\":null,\"content_required\":false,\"role\":\"AXGroup\",\"help\":null,\"custom_actions\":[],\"frame\":{\"width\":401.99999999999994,\"x\":0,\"y\":0,\"height\":874},\"role_description\":\"Group\",\"pid\":3027,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"AXLabel\":null,\"subrole\":null}\r\n[exited 0 after 0.31s]\r\n"]
[2.307, "m", "Deliver a notification while the app is not running"]
[2.307, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.565, "o", "[exited 0 after 0.26s]\r\n"]
[3.568, "m", "Tap the banner"]
[3.568, "o", "$ idb ui tap 201 90\r\n"]
[3.789, "o", "[exited 0 after 0.22s]\r\n"]
[4.718, "m", "Clear the app's delivered notifications"]
[4.718, "o", "$ idb notification clear com.apple.news\r\n"]
[5.696, "o", "[exited 0 after 0.98s]\r\n"]
[6.147, "m", "List notifications after clearing them"]
[6.147, "o", "$ idb notification list com.apple.news\r\n"]
[6.679, "o", "[exited 0 after 0.53s]\r\n"]
[7.617, "o", ""]
