{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.252, "o", "[exited 0 after 0.25s]\r\n"]
[1.252, "m", "Go to the home screen"]
[1.252, "o", "$ idb ui button HOME\r\n"]
[1.434, "o", "[exited 0 after 0.18s]\r\n"]
[1.693, "m", "Check what is where the banner will appear"]
[1.693, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.243, "o", "{\"title\":null,\"AXValue\":null,\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"help\":null,\"frame\":{\"height\":874,\"x\":0,\"width\":401.99999999999994,\"y\":0},\"role\":\"AXGroup\",\"type\":\"Group\",\"enabled\":true,\"AXUniqueId\":null,\"content_required\":false,\"role_description\":\"Group\",\"custom_actions\":[],\"pid\":1294,\"subrole\":null}\r\n[exited 0 after 0.55s]\r\n"]
[2.244, "m", "Deliver a notification while the app is not running"]
[2.244, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.462, "o", "[exited 0 after 0.22s]\r\n"]
[3.466, "m", "Tap the banner"]
[3.466, "o", "$ idb ui tap 201 90\r\n"]
[3.681, "o", "[exited 0 after 0.21s]\r\n"]
[4.464, "m", "Clear the app's delivered notifications"]
[4.464, "o", "$ idb notification clear com.apple.news\r\n"]
[4.895, "o", "[exited 0 after 0.43s]\r\n"]
[5.526, "m", "List notifications after clearing them"]
[5.526, "o", "$ idb notification list com.apple.news\r\n"]
[6.181, "o", "[exited 0 after 0.65s]\r\n"]
[7.717, "o", ""]
