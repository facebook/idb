{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.335, "o", "[exited 0 after 0.34s]\r\n"]
[1.336, "m", "Go to the home screen"]
[1.336, "o", "$ idb ui button HOME\r\n"]
[1.546, "o", "[exited 0 after 0.21s]\r\n"]
[1.864, "m", "Check what is where the banner will appear"]
[1.864, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.361, "o", "{\"enabled\":true,\"help\":null,\"AXValue\":null,\"custom_actions\":[],\"type\":\"Group\",\"AXLabel\":null,\"subrole\":null,\"content_required\":false,\"traits\":[\"Scrollable\"],\"frame\":{\"width\":402.00000000000006,\"height\":874,\"y\":0,\"x\":0},\"role\":\"AXGroup\",\"title\":null,\"AXUniqueId\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"role_description\":\"Group\",\"pid\":5897}\r\n[exited 0 after 0.50s]\r\n"]
[2.362, "m", "Deliver a notification while the app is not running"]
[2.362, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.635, "o", "[exited 0 after 0.27s]\r\n"]
[3.638, "m", "Tap the banner"]
[3.638, "o", "$ idb ui tap 201 90\r\n"]
[3.934, "o", "[exited 0 after 0.30s]\r\n"]
[5.419, "m", "Clear the app's delivered notifications"]
[5.419, "o", "$ idb notification clear com.apple.news\r\n"]
[6.116, "o", "[exited 0 after 0.70s]\r\n"]
[6.715, "m", "List notifications after clearing them"]
[6.715, "o", "$ idb notification list com.apple.news\r\n"]
[7.441, "o", "[exited 0 after 0.73s]\r\n"]
[9.58, "o", ""]
