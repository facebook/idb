{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.319, "o", "[exited 0 after 0.32s]\r\n"]
[1.32, "m", "Go to the home screen"]
[1.32, "o", "$ idb ui button HOME\r\n"]
[1.504, "o", "[exited 0 after 0.18s]\r\n"]
[1.726, "m", "Check what is where the banner will appear"]
[1.726, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.25, "o", "{\"type\":\"Group\",\"help\":null,\"content_required\":false,\"custom_actions\":[],\"AXLabel\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"pid\":1273,\"role\":\"AXGroup\",\"AXValue\":null,\"traits\":[\"Scrollable\"],\"subrole\":null,\"enabled\":true,\"frame\":{\"y\":0,\"x\":0,\"height\":874,\"width\":402},\"role_description\":\"Group\",\"title\":null,\"AXUniqueId\":null}\r\n[exited 0 after 0.52s]\r\n"]
[2.25, "m", "Deliver a notification while the app is not running"]
[2.25, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.541, "o", "[exited 0 after 0.29s]\r\n"]
[3.543, "m", "Tap the banner"]
[3.543, "o", "$ idb ui tap 201 90\r\n"]
[3.775, "o", "[exited 0 after 0.23s]\r\n"]
[4.855, "m", "Clear the app's delivered notifications"]
[4.855, "o", "$ idb notification clear com.apple.news\r\n"]
[5.451, "o", "[exited 0 after 0.60s]\r\n"]
[6.046, "m", "List notifications after clearing them"]
[6.046, "o", "$ idb notification list com.apple.news\r\n"]
[6.59, "o", "[exited 0 after 0.54s]\r\n"]
[8.387, "o", ""]
