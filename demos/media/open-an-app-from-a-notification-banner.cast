{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.217, "o", "[exited 0 after 0.22s]\r\n"]
[1.217, "m", "Go to the home screen"]
[1.217, "o", "$ idb ui button HOME\r\n"]
[1.393, "o", "[exited 0 after 0.18s]\r\n"]
[1.593, "m", "Check what is where the banner will appear"]
[1.593, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.962, "o", "{\"role\":\"AXGroup\",\"custom_actions\":[],\"AXUniqueId\":null,\"subrole\":null,\"content_required\":false,\"pid\":1326,\"help\":null,\"title\":null,\"role_description\":\"Group\",\"AXValue\":null,\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"frame\":{\"y\":0,\"width\":402,\"height\":874,\"x\":0},\"enabled\":true,\"type\":\"Group\",\"AXFrame\":\"{{0, 0}, {402, 874}}\"}\r\n[exited 0 after 0.37s]\r\n"]
[1.962, "m", "Deliver a notification while the app is not running"]
[1.962, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.207, "o", "[exited 0 after 0.24s]\r\n"]
[3.21, "m", "Tap the banner"]
[3.21, "o", "$ idb ui tap 201 90\r\n"]
[3.578, "o", "[exited 0 after 0.37s]\r\n"]
[5.445, "m", "Clear the app's delivered notifications"]
[5.445, "o", "$ idb notification clear com.apple.news\r\n"]
[6.074, "o", "[exited 0 after 0.63s]\r\n"]
[6.643, "m", "List notifications after clearing them"]
[6.643, "o", "$ idb notification list com.apple.news\r\n"]
[7.934, "o", "[exited 0 after 1.29s]\r\n"]
[9.202, "o", ""]
