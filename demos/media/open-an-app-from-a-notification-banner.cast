{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.195, "o", "[exited 0 after 0.19s]\r\n"]
[1.195, "m", "Go to the home screen"]
[1.195, "o", "$ idb ui button HOME\r\n"]
[1.362, "o", "[exited 0 after 0.17s]\r\n"]
[1.623, "m", "Check what is where the banner will appear"]
[1.623, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.935, "o", "{\"subrole\":null,\"pid\":2447,\"AXUniqueId\":null,\"title\":null,\"AXValue\":null,\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"content_required\":false,\"enabled\":true,\"frame\":{\"x\":0,\"width\":402,\"height\":874,\"y\":0},\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"help\":null,\"role_description\":\"Group\",\"AXLabel\":null,\"role\":\"AXGroup\"}\r\n[exited 0 after 0.31s]\r\n"]
[1.935, "m", "Deliver a notification while the app is not running"]
[1.935, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.126, "o", "[exited 0 after 0.19s]\r\n"]
[3.129, "m", "Tap the banner"]
[3.129, "o", "$ idb ui tap 201 90\r\n"]
[3.343, "o", "[exited 0 after 0.21s]\r\n"]
[3.964, "m", "Clear the app's delivered notifications"]
[3.964, "o", "$ idb notification clear com.apple.news\r\n"]
[4.368, "o", "[exited 0 after 0.40s]\r\n"]
[5.072, "m", "List notifications after clearing them"]
[5.072, "o", "$ idb notification list com.apple.news\r\n"]
[5.583, "o", "[exited 0 after 0.51s]\r\n"]
[6.878, "o", ""]
