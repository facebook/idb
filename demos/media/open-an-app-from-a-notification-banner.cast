{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.988, "m", "Grant notification permission without showing a prompt"]
[0.988, "o", "$ idb approve com.apple.news notification\r\n"]
[1.196, "o", "[exited 0 after 0.21s]\r\n"]
[1.197, "m", "Go to the home screen"]
[1.197, "o", "$ idb ui button HOME\r\n"]
[1.36, "o", "[exited 0 after 0.16s]\r\n"]
[1.596, "m", "Check what is where the banner will appear"]
[1.596, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.038, "o", "{\"AXValue\":null,\"AXLabel\":null,\"frame\":{\"height\":874,\"x\":0,\"width\":402.00000000000006,\"y\":0},\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"title\":null,\"enabled\":true,\"custom_actions\":[],\"role\":\"AXGroup\",\"subrole\":null,\"traits\":[\"Scrollable\"],\"help\":null,\"role_description\":\"Group\",\"pid\":1730,\"AXUniqueId\":null,\"content_required\":false,\"type\":\"Group\"}\r\n[exited 0 after 0.44s]\r\n"]
[2.038, "m", "Deliver a notification while the app is not running"]
[2.038, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.283, "o", "[exited 0 after 0.25s]\r\n"]
[3.286, "m", "Tap the banner"]
[3.286, "o", "$ idb ui tap 201 90\r\n"]
[3.482, "o", "[exited 0 after 0.20s]\r\n"]
[4.187, "m", "Clear the app's delivered notifications"]
[4.187, "o", "$ idb notification clear com.apple.news\r\n"]
[4.553, "o", "[exited 0 after 0.37s]\r\n"]
[5.0, "m", "List notifications after clearing them"]
[5.0, "o", "$ idb notification list com.apple.news\r\n"]
[5.525, "o", "[exited 0 after 0.53s]\r\n"]
[6.905, "o", ""]
