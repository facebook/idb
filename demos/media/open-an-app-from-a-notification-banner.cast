{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.967, "m", "Grant notification permission without showing a prompt"]
[0.967, "o", "$ idb approve com.apple.news notification\r\n"]
[1.159, "o", "[exited 0 after 0.19s]\r\n"]
[1.159, "m", "Go to the home screen"]
[1.159, "o", "$ idb ui button HOME\r\n"]
[1.319, "o", "[exited 0 after 0.16s]\r\n"]
[1.538, "m", "Check what is where the banner will appear"]
[1.538, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.888, "o", "{\"custom_actions\":[],\"frame\":{\"x\":0,\"y\":0,\"width\":402.00000000000006,\"height\":874},\"content_required\":false,\"title\":null,\"AXLabel\":null,\"subrole\":null,\"AXUniqueId\":null,\"pid\":1359,\"role\":\"AXGroup\",\"enabled\":true,\"type\":\"Group\",\"help\":null,\"AXValue\":null,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"role_description\":\"Group\"}\r\n[exited 0 after 0.35s]\r\n"]
[1.888, "m", "Deliver a notification while the app is not running"]
[1.888, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.073, "o", "[exited 0 after 0.18s]\r\n"]
[3.076, "m", "Tap the banner"]
[3.076, "o", "$ idb ui tap 201 90\r\n"]
[3.387, "o", "[exited 0 after 0.31s]\r\n"]
[4.233, "m", "Clear the app's delivered notifications"]
[4.233, "o", "$ idb notification clear com.apple.news\r\n"]
[4.83, "o", "[exited 0 after 0.60s]\r\n"]
[5.316, "m", "List notifications after clearing them"]
[5.316, "o", "$ idb notification list com.apple.news\r\n"]
[5.726, "o", "[exited 0 after 0.41s]\r\n"]
[7.048, "o", ""]
