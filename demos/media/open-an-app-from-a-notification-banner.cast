{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.248, "o", "[exited 0 after 0.25s]\r\n"]
[1.249, "m", "Go to the home screen"]
[1.249, "o", "$ idb ui button HOME\r\n"]
[1.451, "o", "[exited 0 after 0.20s]\r\n"]
[2.212, "m", "Check what is where the banner will appear"]
[2.212, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.443, "o", "{\"frame\":{\"height\":874,\"y\":0,\"width\":401.99999999999994,\"x\":0},\"role\":\"AXGroup\",\"AXLabel\":null,\"pid\":2702,\"enabled\":true,\"AXUniqueId\":null,\"help\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"content_required\":false,\"traits\":[\"Scrollable\"],\"custom_actions\":[],\"role_description\":\"Group\",\"type\":\"Group\",\"title\":null,\"AXValue\":null,\"subrole\":null}\r\n[exited 0 after 0.23s]\r\n"]
[2.443, "m", "Deliver a notification while the app is not running"]
[2.443, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.981, "o", "[exited 0 after 0.54s]\r\n"]
[3.984, "m", "Tap the banner"]
[3.984, "o", "$ idb ui tap 201 90\r\n"]
[4.24, "o", "[exited 0 after 0.26s]\r\n"]
[5.167, "m", "Clear the app's delivered notifications"]
[5.167, "o", "$ idb notification clear com.apple.news\r\n"]
[5.62, "o", "[exited 0 after 0.45s]\r\n"]
[6.159, "m", "List notifications after clearing them"]
[6.159, "o", "$ idb notification list com.apple.news\r\n"]
[6.647, "o", "[exited 0 after 0.49s]\r\n"]
[7.838, "o", ""]
