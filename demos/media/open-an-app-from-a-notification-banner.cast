{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.289, "o", "[exited 0 after 0.29s]\r\n"]
[1.289, "m", "Go to the home screen"]
[1.289, "o", "$ idb ui button HOME\r\n"]
[1.498, "o", "[exited 0 after 0.21s]\r\n"]
[1.784, "m", "Check what is where the banner will appear"]
[1.784, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.219, "o", "{\"custom_actions\":[],\"frame\":{\"x\":0,\"width\":402.00000000000006,\"y\":0,\"height\":874},\"content_required\":false,\"help\":null,\"role_description\":\"Group\",\"AXUniqueId\":null,\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"subrole\":null,\"role\":\"AXGroup\",\"title\":null,\"AXValue\":null,\"enabled\":true,\"AXLabel\":null,\"pid\":1746,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\"}\r\n[exited 0 after 0.44s]\r\n"]
[2.22, "m", "Deliver a notification while the app is not running"]
[2.22, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.463, "o", "[exited 0 after 0.24s]\r\n"]
[3.467, "m", "Tap the banner"]
[3.467, "o", "$ idb ui tap 201 90\r\n"]
[3.709, "o", "[exited 0 after 0.24s]\r\n"]
[4.837, "m", "Clear the app's delivered notifications"]
[4.837, "o", "$ idb notification clear com.apple.news\r\n"]
[5.457, "o", "[exited 0 after 0.62s]\r\n"]
[6.019, "m", "List notifications after clearing them"]
[6.019, "o", "$ idb notification list com.apple.news\r\n"]
[6.488, "o", "[exited 0 after 0.47s]\r\n"]
[8.265, "o", ""]
