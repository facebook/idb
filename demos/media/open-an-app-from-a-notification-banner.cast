{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.302, "o", "[exited 0 after 0.30s]\r\n"]
[1.302, "m", "Go to the home screen"]
[1.302, "o", "$ idb ui button HOME\r\n"]
[1.473, "o", "[exited 0 after 0.17s]\r\n"]
[1.709, "m", "Check what is where the banner will appear"]
[1.709, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.089, "o", "{\"title\":null,\"type\":\"Group\",\"enabled\":true,\"AXUniqueId\":null,\"content_required\":false,\"help\":null,\"role\":\"AXGroup\",\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"traits\":[\"Scrollable\"],\"pid\":2143,\"AXLabel\":null,\"frame\":{\"width\":402,\"x\":0,\"height\":874,\"y\":0},\"subrole\":null,\"custom_actions\":[],\"role_description\":\"Group\"}\r\n[exited 0 after 0.38s]\r\n"]
[2.089, "m", "Deliver a notification while the app is not running"]
[2.089, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.29, "o", "[exited 0 after 0.20s]\r\n"]
[3.293, "m", "Tap the banner"]
[3.293, "o", "$ idb ui tap 201 90\r\n"]
[3.724, "o", "[exited 0 after 0.43s]\r\n"]
[4.833, "m", "Clear the app's delivered notifications"]
[4.833, "o", "$ idb notification clear com.apple.news\r\n"]
[5.331, "o", "[exited 0 after 0.50s]\r\n"]
[5.895, "m", "List notifications after clearing them"]
[5.895, "o", "$ idb notification list com.apple.news\r\n"]
[6.37, "o", "[exited 0 after 0.47s]\r\n"]
[7.738, "o", ""]
