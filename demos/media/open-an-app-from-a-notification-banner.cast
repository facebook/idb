{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.268, "o", "[exited 0 after 0.27s]\r\n"]
[1.268, "m", "Go to the home screen"]
[1.268, "o", "$ idb ui button HOME\r\n"]
[1.501, "o", "[exited 0 after 0.23s]\r\n"]
[1.798, "m", "Check what is where the banner will appear"]
[1.798, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.416, "o", "{\"AXLabel\":null,\"subrole\":null,\"pid\":3016,\"role_description\":\"Group\",\"frame\":{\"y\":0,\"x\":0,\"width\":402.00000000000006,\"height\":874},\"enabled\":true,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"content_required\":false,\"AXValue\":null,\"help\":null,\"AXUniqueId\":null,\"custom_actions\":[],\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"role\":\"AXGroup\",\"title\":null}\r\n[exited 0 after 0.62s]\r\n"]
[2.417, "m", "Deliver a notification while the app is not running"]
[2.417, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.697, "o", "[exited 0 after 0.28s]\r\n"]
[3.701, "m", "Tap the banner"]
[3.701, "o", "$ idb ui tap 201 90\r\n"]
[3.943, "o", "[exited 0 after 0.24s]\r\n"]
[5.237, "m", "Clear the app's delivered notifications"]
[5.237, "o", "$ idb notification clear com.apple.news\r\n"]
[6.029, "o", "[exited 0 after 0.79s]\r\n"]
[6.604, "m", "List notifications after clearing them"]
[6.604, "o", "$ idb notification list com.apple.news\r\n"]
[7.122, "o", "[exited 0 after 0.52s]\r\n"]
[9.145, "o", ""]
