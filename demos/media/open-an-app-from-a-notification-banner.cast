{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.246, "o", "[exited 0 after 0.25s]\r\n"]
[1.246, "m", "Go to the home screen"]
[1.246, "o", "$ idb ui button HOME\r\n"]
[1.427, "o", "[exited 0 after 0.18s]\r\n"]
[1.697, "m", "Check what is where the banner will appear"]
[1.697, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.393, "o", "{\"help\":null,\"content_required\":false,\"role_description\":\"Group\",\"traits\":[\"Scrollable\"],\"AXValue\":null,\"pid\":1571,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"type\":\"Group\",\"subrole\":null,\"enabled\":true,\"custom_actions\":[],\"AXLabel\":null,\"frame\":{\"x\":0,\"height\":874,\"width\":402.00000000000006,\"y\":0},\"AXUniqueId\":null,\"title\":null,\"role\":\"AXGroup\"}\r\n[exited 0 after 0.70s]\r\n"]
[2.393, "m", "Deliver a notification while the app is not running"]
[2.393, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.653, "o", "[exited 0 after 0.26s]\r\n"]
[3.657, "m", "Tap the banner"]
[3.657, "o", "$ idb ui tap 201 90\r\n"]
[3.886, "o", "[exited 0 after 0.23s]\r\n"]
[4.666, "m", "Clear the app's delivered notifications"]
[4.666, "o", "$ idb notification clear com.apple.news\r\n"]
[5.206, "o", "[exited 0 after 0.54s]\r\n"]
[5.934, "m", "List notifications after clearing them"]
[5.934, "o", "$ idb notification list com.apple.news\r\n"]
[6.509, "o", "[exited 0 after 0.58s]\r\n"]
[8.275, "o", ""]
