{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.449, "o", "[exited 0 after 0.45s]\r\n"]
[1.45, "m", "Go to the home screen"]
[1.45, "o", "$ idb ui button HOME\r\n"]
[1.736, "o", "[exited 0 after 0.29s]\r\n"]
[2.191, "m", "Check what is where the banner will appear"]
[2.191, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.567, "o", "{\"role\":\"AXGroup\",\"custom_actions\":[],\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"help\":null,\"enabled\":true,\"AXValue\":null,\"pid\":1301,\"frame\":{\"y\":0,\"width\":402.00000000000006,\"height\":874,\"x\":0},\"title\":null,\"subrole\":null,\"content_required\":false,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"AXUniqueId\":null,\"role_description\":\"Group\",\"AXLabel\":null}\r\n[exited 0 after 0.38s]\r\n"]
[2.567, "m", "Deliver a notification while the app is not running"]
[2.567, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.954, "o", "[exited 0 after 0.39s]\r\n"]
[3.959, "m", "Tap the banner"]
[3.959, "o", "$ idb ui tap 201 90\r\n"]
[4.639, "o", "[exited 0 after 0.68s]\r\n"]
[6.23, "m", "Clear the app's delivered notifications"]
[6.23, "o", "$ idb notification clear com.apple.news\r\n"]
[7.041, "o", "[exited 0 after 0.81s]\r\n"]
[7.614, "m", "List notifications after clearing them"]
[7.614, "o", "$ idb notification list com.apple.news\r\n"]
[9.35, "o", "[exited 0 after 1.74s]\r\n"]
[10.652, "o", ""]
