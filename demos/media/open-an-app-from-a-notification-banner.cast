{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.188, "o", "[exited 0 after 0.19s]\r\n"]
[1.188, "m", "Go to the home screen"]
[1.188, "o", "$ idb ui button HOME\r\n"]
[1.37, "o", "[exited 0 after 0.18s]\r\n"]
[1.596, "m", "Check what is where the banner will appear"]
[1.596, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.923, "o", "{\"AXUniqueId\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"AXValue\":null,\"frame\":{\"width\":402.00000000000006,\"x\":0,\"height\":874,\"y\":0},\"type\":\"Group\",\"enabled\":true,\"custom_actions\":[],\"role_description\":\"Group\",\"role\":\"AXGroup\",\"content_required\":false,\"help\":null,\"AXLabel\":null,\"title\":null,\"subrole\":null,\"pid\":2767,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.33s]\r\n"]
[1.923, "m", "Deliver a notification while the app is not running"]
[1.923, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.092, "o", "[exited 0 after 0.17s]\r\n"]
[3.103, "m", "Tap the banner"]
[3.103, "o", "$ idb ui tap 201 90\r\n"]
[3.74, "o", "[exited 0 after 0.64s]\r\n"]
[4.324, "m", "Clear the app's delivered notifications"]
[4.324, "o", "$ idb notification clear com.apple.news\r\n"]
[4.82, "o", "[exited 0 after 0.50s]\r\n"]
[5.324, "m", "List notifications after clearing them"]
[5.324, "o", "$ idb notification list com.apple.news\r\n"]
[5.949, "o", "[exited 0 after 0.63s]\r\n"]
[7.727, "o", ""]
