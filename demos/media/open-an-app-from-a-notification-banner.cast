{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.241, "o", "[exited 0 after 0.24s]\r\n"]
[1.242, "m", "Go to the home screen"]
[1.242, "o", "$ idb ui button HOME\r\n"]
[1.439, "o", "[exited 0 after 0.20s]\r\n"]
[1.738, "m", "Check what is where the banner will appear"]
[1.738, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.078, "o", "{\"title\":null,\"AXValue\":null,\"AXLabel\":null,\"help\":null,\"custom_actions\":[],\"content_required\":false,\"type\":\"Group\",\"subrole\":null,\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"traits\":[\"Scrollable\"],\"enabled\":true,\"pid\":3892,\"role_description\":\"Group\",\"AXUniqueId\":null,\"frame\":{\"height\":874,\"y\":0,\"x\":0,\"width\":401.99999999999994}}\r\n[exited 0 after 0.34s]\r\n"]
[2.078, "m", "Deliver a notification while the app is not running"]
[2.078, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.306, "o", "[exited 0 after 0.23s]\r\n"]
[3.309, "m", "Tap the banner"]
[3.309, "o", "$ idb ui tap 201 90\r\n"]
[3.515, "o", "[exited 0 after 0.21s]\r\n"]
[4.226, "m", "Clear the app's delivered notifications"]
[4.226, "o", "$ idb notification clear com.apple.news\r\n"]
[4.637, "o", "[exited 0 after 0.41s]\r\n"]
[5.091, "m", "List notifications after clearing them"]
[5.091, "o", "$ idb notification list com.apple.news\r\n"]
[5.617, "o", "[exited 0 after 0.53s]\r\n"]
[7.085, "o", ""]
