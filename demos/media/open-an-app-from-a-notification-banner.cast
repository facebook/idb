{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.246, "o", "[exited 0 after 0.25s]\r\n"]
[1.246, "m", "Go to the home screen"]
[1.246, "o", "$ idb ui button HOME\r\n"]
[1.433, "o", "[exited 0 after 0.19s]\r\n"]
[1.721, "m", "Check what is where the banner will appear"]
[1.721, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.31, "o", "{\"help\":null,\"custom_actions\":[],\"content_required\":false,\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"title\":null,\"enabled\":true,\"frame\":{\"height\":874,\"y\":0,\"x\":0,\"width\":402.00000000000006},\"pid\":1319,\"AXUniqueId\":null,\"role\":\"AXGroup\",\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"role_description\":\"Group\",\"AXLabel\":null,\"subrole\":null}\r\n[exited 0 after 0.59s]\r\n"]
[2.31, "m", "Deliver a notification while the app is not running"]
[2.31, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.686, "o", "[exited 0 after 0.38s]\r\n"]
[3.689, "m", "Tap the banner"]
[3.689, "o", "$ idb ui tap 201 90\r\n"]
[3.928, "o", "[exited 0 after 0.24s]\r\n"]
[4.987, "m", "Clear the app's delivered notifications"]
[4.987, "o", "$ idb notification clear com.apple.news\r\n"]
[5.557, "o", "[exited 0 after 0.57s]\r\n"]
[6.039, "m", "List notifications after clearing them"]
[6.039, "o", "$ idb notification list com.apple.news\r\n"]
[6.516, "o", "[exited 0 after 0.48s]\r\n"]
[8.063, "o", ""]
