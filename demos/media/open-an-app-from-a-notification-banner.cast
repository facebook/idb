{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.234, "o", "[exited 0 after 0.23s]\r\n"]
[1.234, "m", "Go to the home screen"]
[1.234, "o", "$ idb ui button HOME\r\n"]
[1.419, "o", "[exited 0 after 0.18s]\r\n"]
[1.642, "m", "Check what is where the banner will appear"]
[1.642, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.002, "o", "{\"subrole\":null,\"custom_actions\":[],\"enabled\":true,\"AXValue\":null,\"frame\":{\"x\":0,\"y\":0,\"height\":874,\"width\":401.99999999999994},\"content_required\":false,\"AXUniqueId\":null,\"pid\":1312,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"role\":\"AXGroup\",\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"title\":null,\"help\":null,\"role_description\":\"Group\"}\r\n[exited 0 after 0.36s]\r\n"]
[2.002, "m", "Deliver a notification while the app is not running"]
[2.002, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.266, "o", "[exited 0 after 0.26s]\r\n"]
[3.269, "m", "Tap the banner"]
[3.269, "o", "$ idb ui tap 201 90\r\n"]
[3.64, "o", "[exited 0 after 0.37s]\r\n"]
[7.224, "m", "Clear the app's delivered notifications"]
[7.224, "o", "$ idb notification clear com.apple.news\r\n"]
[8.026, "o", "[exited 0 after 0.80s]\r\n"]
[8.703, "m", "List notifications after clearing them"]
[8.703, "o", "$ idb notification list com.apple.news\r\n"]
[9.191, "o", "[exited 0 after 0.49s]\r\n"]
[9.968, "o", ""]
