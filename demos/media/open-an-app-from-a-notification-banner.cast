{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.988, "m", "Grant notification permission without showing a prompt"]
[0.988, "o", "$ idb approve com.apple.news notification\r\n"]
[1.191, "o", "[exited 0 after 0.20s]\r\n"]
[1.191, "m", "Go to the home screen"]
[1.191, "o", "$ idb ui button HOME\r\n"]
[1.349, "o", "[exited 0 after 0.16s]\r\n"]
[1.605, "m", "Check what is where the banner will appear"]
[1.605, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.933, "o", "{\"help\":null,\"custom_actions\":[],\"AXValue\":null,\"title\":null,\"type\":\"Group\",\"content_required\":false,\"subrole\":null,\"frame\":{\"width\":401.99999999999994,\"y\":0,\"height\":874,\"x\":0},\"AXLabel\":null,\"enabled\":true,\"pid\":9207,\"traits\":[\"Scrollable\"],\"role_description\":\"Group\",\"AXUniqueId\":null,\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\"}\r\n[exited 0 after 0.33s]\r\n"]
[1.934, "m", "Deliver a notification while the app is not running"]
[1.934, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.122, "o", "[exited 0 after 0.19s]\r\n"]
[3.125, "m", "Tap the banner"]
[3.125, "o", "$ idb ui tap 201 90\r\n"]
[3.34, "o", "[exited 0 after 0.22s]\r\n"]
[3.887, "m", "Clear the app's delivered notifications"]
[3.887, "o", "$ idb notification clear com.apple.news\r\n"]
[4.285, "o", "[exited 0 after 0.40s]\r\n"]
[4.761, "m", "List notifications after clearing them"]
[4.761, "o", "$ idb notification list com.apple.news\r\n"]
[5.282, "o", "[exited 0 after 0.52s]\r\n"]
[6.418, "o", ""]
