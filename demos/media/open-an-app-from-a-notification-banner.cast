{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.992, "m", "Grant notification permission without showing a prompt"]
[0.992, "o", "$ idb approve com.apple.news notification\r\n"]
[1.205, "o", "[exited 0 after 0.21s]\r\n"]
[1.206, "m", "Go to the home screen"]
[1.206, "o", "$ idb ui button HOME\r\n"]
[1.453, "o", "[exited 0 after 0.25s]\r\n"]
[2.166, "m", "Check what is where the banner will appear"]
[2.166, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.616, "o", "{\"title\":null,\"subrole\":null,\"AXValue\":null,\"AXLabel\":null,\"pid\":1868,\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"content_required\":false,\"frame\":{\"height\":874,\"x\":0,\"width\":401.99999999999994,\"y\":0},\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"role\":\"AXGroup\",\"enabled\":true,\"AXUniqueId\":null,\"role_description\":\"Group\",\"help\":null,\"custom_actions\":[]}\r\n[exited 0 after 0.45s]\r\n"]
[2.616, "m", "Deliver a notification while the app is not running"]
[2.616, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.924, "o", "[exited 0 after 0.31s]\r\n"]
[3.928, "m", "Tap the banner"]
[3.928, "o", "$ idb ui tap 201 90\r\n"]
[4.159, "o", "[exited 0 after 0.23s]\r\n"]
[5.369, "m", "Clear the app's delivered notifications"]
[5.369, "o", "$ idb notification clear com.apple.news\r\n"]
[5.852, "o", "[exited 0 after 0.48s]\r\n"]
[6.402, "m", "List notifications after clearing them"]
[6.402, "o", "$ idb notification list com.apple.news\r\n"]
[6.856, "o", "[exited 0 after 0.45s]\r\n"]
[8.575, "o", ""]
