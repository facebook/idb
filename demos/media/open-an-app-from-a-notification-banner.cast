{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.205, "o", "[exited 0 after 0.20s]\r\n"]
[1.205, "m", "Go to the home screen"]
[1.205, "o", "$ idb ui button HOME\r\n"]
[1.373, "o", "[exited 0 after 0.17s]\r\n"]
[1.637, "m", "Check what is where the banner will appear"]
[1.637, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.979, "o", "{\"type\":\"Group\",\"role\":\"AXGroup\",\"title\":null,\"AXUniqueId\":null,\"help\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"traits\":[\"Scrollable\"],\"frame\":{\"x\":0,\"y\":0,\"height\":874,\"width\":402},\"subrole\":null,\"content_required\":false,\"AXLabel\":null,\"pid\":3691,\"custom_actions\":[],\"enabled\":true,\"role_description\":\"Group\",\"AXValue\":null}\r\n[exited 0 after 0.34s]\r\n"]
[1.979, "m", "Deliver a notification while the app is not running"]
[1.979, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.177, "o", "[exited 0 after 0.20s]\r\n"]
[3.181, "m", "Tap the banner"]
[3.181, "o", "$ idb ui tap 201 90\r\n"]
[3.464, "o", "[exited 0 after 0.28s]\r\n"]
[4.193, "m", "Clear the app's delivered notifications"]
[4.193, "o", "$ idb notification clear com.apple.news\r\n"]
[4.638, "o", "[exited 0 after 0.44s]\r\n"]
[5.283, "m", "List notifications after clearing them"]
[5.283, "o", "$ idb notification list com.apple.news\r\n"]
[5.876, "o", "[exited 0 after 0.59s]\r\n"]
[7.303, "o", ""]
