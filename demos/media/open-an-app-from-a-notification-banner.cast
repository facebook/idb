{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.269, "o", "[exited 0 after 0.27s]\r\n"]
[1.269, "m", "Go to the home screen"]
[1.269, "o", "$ idb ui button HOME\r\n"]
[1.49, "o", "[exited 0 after 0.22s]\r\n"]
[1.863, "m", "Check what is where the banner will appear"]
[1.863, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.155, "o", "{\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"enabled\":true,\"AXLabel\":null,\"custom_actions\":[],\"help\":null,\"AXUniqueId\":null,\"pid\":1322,\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"AXValue\":null,\"frame\":{\"y\":0,\"height\":874,\"width\":402,\"x\":0},\"content_required\":false,\"role\":\"AXGroup\",\"role_description\":\"Group\",\"title\":null,\"subrole\":null}\r\n[exited 0 after 0.29s]\r\n"]
[2.155, "m", "Deliver a notification while the app is not running"]
[2.155, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.418, "o", "[exited 0 after 0.26s]\r\n"]
[3.421, "m", "Tap the banner"]
[3.421, "o", "$ idb ui tap 201 90\r\n"]
[3.81, "o", "[exited 0 after 0.39s]\r\n"]
[5.051, "m", "Clear the app's delivered notifications"]
[5.051, "o", "$ idb notification clear com.apple.news\r\n"]
[5.706, "o", "[exited 0 after 0.66s]\r\n"]
[6.282, "m", "List notifications after clearing them"]
[6.282, "o", "$ idb notification list com.apple.news\r\n"]
[7.059, "o", "[exited 0 after 0.78s]\r\n"]
[8.447, "o", ""]
