{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.224, "o", "[exited 0 after 0.22s]\r\n"]
[1.224, "m", "Go to the home screen"]
[1.224, "o", "$ idb ui button HOME\r\n"]
[1.467, "o", "[exited 0 after 0.24s]\r\n"]
[1.852, "m", "Check what is where the banner will appear"]
[1.852, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.14, "o", "{\"role\":\"AXGroup\",\"AXLabel\":null,\"frame\":{\"width\":401.99999999999994,\"x\":0,\"height\":874,\"y\":0},\"role_description\":\"Group\",\"AXUniqueId\":null,\"help\":null,\"custom_actions\":[],\"enabled\":true,\"content_required\":false,\"pid\":1305,\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"subrole\":null,\"title\":null,\"AXValue\":null}\r\n[exited 0 after 0.29s]\r\n"]
[2.14, "m", "Deliver a notification while the app is not running"]
[2.14, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.413, "o", "[exited 0 after 0.27s]\r\n"]
[3.417, "m", "Tap the banner"]
[3.417, "o", "$ idb ui tap 201 90\r\n"]
[3.733, "o", "[exited 0 after 0.32s]\r\n"]
[6.292, "m", "Clear the app's delivered notifications"]
[6.292, "o", "$ idb notification clear com.apple.news\r\n"]
[7.463, "o", "[exited 0 after 1.17s]\r\n"]
[8.309, "m", "List notifications after clearing them"]
[8.309, "o", "$ idb notification list com.apple.news\r\n"]
[9.028, "o", "[exited 0 after 0.72s]\r\n"]
[9.835, "o", ""]
