{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.305, "o", "[exited 0 after 0.30s]\r\n"]
[1.305, "m", "Go to the home screen"]
[1.305, "o", "$ idb ui button HOME\r\n"]
[1.523, "o", "[exited 0 after 0.22s]\r\n"]
[1.861, "m", "Check what is where the banner will appear"]
[1.861, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.27, "o", "{\"traits\":[\"Scrollable\"],\"content_required\":false,\"AXValue\":null,\"AXLabel\":null,\"AXUniqueId\":null,\"help\":null,\"enabled\":true,\"role_description\":\"Group\",\"title\":null,\"pid\":4672,\"frame\":{\"x\":0,\"width\":401.99999999999994,\"height\":874,\"y\":0},\"subrole\":null,\"type\":\"Group\",\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"custom_actions\":[]}\r\n[exited 0 after 0.41s]\r\n"]
[2.271, "m", "Deliver a notification while the app is not running"]
[2.271, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.541, "o", "[exited 0 after 0.27s]\r\n"]
[3.545, "m", "Tap the banner"]
[3.545, "o", "$ idb ui tap 201 90\r\n"]
[3.775, "o", "[exited 0 after 0.23s]\r\n"]
[4.921, "m", "Clear the app's delivered notifications"]
[4.921, "o", "$ idb notification clear com.apple.news\r\n"]
[5.528, "o", "[exited 0 after 0.61s]\r\n"]
[6.109, "m", "List notifications after clearing them"]
[6.109, "o", "$ idb notification list com.apple.news\r\n"]
[6.603, "o", "[exited 0 after 0.49s]\r\n"]
[8.308, "o", ""]
