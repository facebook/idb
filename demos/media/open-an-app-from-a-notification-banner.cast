{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.811, "m", "Grant notification permission without showing a prompt"]
[0.811, "o", "$ idb approve com.apple.news notification\r\n"]
[1.046, "o", "[exited 0 after 0.24s]\r\n"]
[1.046, "m", "Go to the home screen"]
[1.046, "o", "$ idb ui button HOME\r\n"]
[1.199, "o", "[exited 0 after 0.15s]\r\n"]
[1.433, "m", "Check what is where the banner will appear"]
[1.433, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.802, "o", "{\"title\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"AXLabel\":null,\"subrole\":null,\"role_description\":\"Group\",\"help\":null,\"AXValue\":null,\"role\":\"AXGroup\",\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"enabled\":true,\"content_required\":false,\"pid\":9344,\"frame\":{\"width\":402.00000000000006,\"height\":874,\"y\":0,\"x\":0},\"custom_actions\":[],\"AXUniqueId\":null}\r\n[exited 0 after 0.37s]\r\n"]
[1.802, "m", "Deliver a notification while the app is not running"]
[1.802, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[1.98, "o", "[exited 0 after 0.18s]\r\n"]
[2.983, "m", "Tap the banner"]
[2.983, "o", "$ idb ui tap 201 90\r\n"]
[3.229, "o", "[exited 0 after 0.25s]\r\n"]
[3.925, "m", "Clear the app's delivered notifications"]
[3.925, "o", "$ idb notification clear com.apple.news\r\n"]
[4.306, "o", "[exited 0 after 0.38s]\r\n"]
[4.78, "m", "List notifications after clearing them"]
[4.78, "o", "$ idb notification list com.apple.news\r\n"]
[5.211, "o", "[exited 0 after 0.43s]\r\n"]
[6.428, "o", ""]
