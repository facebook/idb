{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.31, "o", "[exited 0 after 0.31s]\r\n"]
[1.31, "m", "Go to the home screen"]
[1.31, "o", "$ idb ui button HOME\r\n"]
[1.602, "o", "[exited 0 after 0.29s]\r\n"]
[2.354, "m", "Check what is where the banner will appear"]
[2.354, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.629, "o", "{\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"enabled\":true,\"custom_actions\":[],\"help\":null,\"title\":null,\"AXValue\":null,\"frame\":{\"x\":0,\"width\":402.00000000000006,\"height\":874,\"y\":0},\"AXLabel\":null,\"role\":\"AXGroup\",\"type\":\"Group\",\"content_required\":false,\"role_description\":\"Group\",\"pid\":1460,\"subrole\":null,\"AXUniqueId\":null,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.28s]\r\n"]
[2.63, "m", "Deliver a notification while the app is not running"]
[2.63, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[3.074, "o", "[exited 0 after 0.44s]\r\n"]
[4.077, "m", "Tap the banner"]
[4.077, "o", "$ idb ui tap 201 90\r\n"]
[4.624, "o", "[exited 0 after 0.55s]\r\n"]
[6.577, "m", "Clear the app's delivered notifications"]
[6.577, "o", "$ idb notification clear com.apple.news\r\n"]
[7.222, "o", "[exited 0 after 0.65s]\r\n"]
[8.684, "m", "List notifications after clearing them"]
[8.684, "o", "$ idb notification list com.apple.news\r\n"]
[9.855, "o", "[exited 0 after 1.17s]\r\n"]
[11.033, "o", ""]
