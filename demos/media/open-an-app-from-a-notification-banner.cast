{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.265, "o", "[exited 0 after 0.27s]\r\n"]
[1.266, "m", "Go to the home screen"]
[1.266, "o", "$ idb ui button HOME\r\n"]
[1.466, "o", "[exited 0 after 0.20s]\r\n"]
[1.733, "m", "Check what is where the banner will appear"]
[1.733, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.118, "o", "{\"traits\":[\"Scrollable\"],\"AXUniqueId\":null,\"title\":null,\"enabled\":true,\"role_description\":\"Group\",\"help\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"type\":\"Group\",\"AXValue\":null,\"subrole\":null,\"custom_actions\":[],\"AXLabel\":null,\"frame\":{\"y\":0,\"width\":402.00000000000006,\"x\":0,\"height\":874},\"role\":\"AXGroup\",\"content_required\":false,\"pid\":1283}\r\n[exited 0 after 0.38s]\r\n"]
[2.118, "m", "Deliver a notification while the app is not running"]
[2.118, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.389, "o", "[exited 0 after 0.27s]\r\n"]
[3.419, "m", "Tap the banner"]
[3.419, "o", "$ idb ui tap 201 90\r\n"]
[3.859, "o", "[exited 0 after 0.44s]\r\n"]
[6.475, "m", "Clear the app's delivered notifications"]
[6.475, "o", "$ idb notification clear com.apple.news\r\n"]
[7.754, "o", "[exited 0 after 1.28s]\r\n"]
[8.562, "m", "List notifications after clearing them"]
[8.562, "o", "$ idb notification list com.apple.news\r\n"]
[9.355, "o", "[exited 0 after 0.79s]\r\n"]
[10.512, "o", ""]
