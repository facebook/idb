{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.941, "m", "Grant notification permission without showing a prompt"]
[0.941, "o", "$ idb approve com.apple.news notification\r\n"]
[1.17, "o", "[exited 0 after 0.23s]\r\n"]
[1.17, "m", "Go to the home screen"]
[1.17, "o", "$ idb ui button HOME\r\n"]
[1.314, "o", "[exited 0 after 0.14s]\r\n"]
[1.547, "m", "Check what is where the banner will appear"]
[1.547, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.941, "o", "{\"content_required\":false,\"traits\":[\"Scrollable\"],\"AXLabel\":null,\"AXUniqueId\":null,\"role\":\"AXGroup\",\"subrole\":null,\"frame\":{\"height\":874,\"x\":0,\"y\":0,\"width\":402},\"enabled\":true,\"type\":\"Group\",\"pid\":1762,\"title\":null,\"role_description\":\"Group\",\"help\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"AXValue\":null,\"custom_actions\":[]}\r\n[exited 0 after 0.39s]\r\n"]
[1.943, "m", "Deliver a notification while the app is not running"]
[1.943, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.124, "o", "[exited 0 after 0.18s]\r\n"]
[3.127, "m", "Tap the banner"]
[3.127, "o", "$ idb ui tap 201 90\r\n"]
[3.464, "o", "[exited 0 after 0.34s]\r\n"]
[4.147, "m", "Clear the app's delivered notifications"]
[4.147, "o", "$ idb notification clear com.apple.news\r\n"]
[4.556, "o", "[exited 0 after 0.41s]\r\n"]
[4.997, "m", "List notifications after clearing them"]
[4.997, "o", "$ idb notification list com.apple.news\r\n"]
[5.476, "o", "[exited 0 after 0.48s]\r\n"]
[6.695, "o", ""]
