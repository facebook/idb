{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.279, "o", "[exited 0 after 0.28s]\r\n"]
[1.279, "m", "Go to the home screen"]
[1.279, "o", "$ idb ui button HOME\r\n"]
[1.435, "o", "[exited 0 after 0.16s]\r\n"]
[1.654, "m", "Check what is where the banner will appear"]
[1.654, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.118, "o", "{\"AXLabel\":null,\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"enabled\":true,\"type\":\"Group\",\"custom_actions\":[],\"help\":null,\"role\":\"AXGroup\",\"subrole\":null,\"content_required\":false,\"pid\":7241,\"AXUniqueId\":null,\"title\":null,\"AXValue\":null,\"traits\":[\"Scrollable\"],\"frame\":{\"x\":0,\"width\":402,\"y\":0,\"height\":874}}\r\n[exited 0 after 0.46s]\r\n"]
[2.119, "m", "Deliver a notification while the app is not running"]
[2.119, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.31, "o", "[exited 0 after 0.19s]\r\n"]
[3.314, "m", "Tap the banner"]
[3.314, "o", "$ idb ui tap 201 90\r\n"]
[3.646, "o", "[exited 0 after 0.33s]\r\n"]
[4.482, "m", "Clear the app's delivered notifications"]
[4.482, "o", "$ idb notification clear com.apple.news\r\n"]
[4.975, "o", "[exited 0 after 0.49s]\r\n"]
[5.549, "m", "List notifications after clearing them"]
[5.549, "o", "$ idb notification list com.apple.news\r\n"]
[5.97, "o", "[exited 0 after 0.42s]\r\n"]
[7.48, "o", ""]
