{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.183, "o", "[exited 0 after 0.18s]\r\n"]
[1.183, "m", "Go to the home screen"]
[1.183, "o", "$ idb ui button HOME\r\n"]
[1.364, "o", "[exited 0 after 0.18s]\r\n"]
[1.576, "m", "Check what is where the banner will appear"]
[1.576, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.961, "o", "{\"title\":null,\"help\":null,\"AXUniqueId\":null,\"AXLabel\":null,\"subrole\":null,\"content_required\":false,\"type\":\"Group\",\"enabled\":true,\"frame\":{\"x\":0,\"width\":401.99999999999994,\"height\":874,\"y\":0},\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"role_description\":\"Group\",\"role\":\"AXGroup\",\"traits\":[\"Scrollable\"],\"pid\":3676,\"AXValue\":null,\"custom_actions\":[]}\r\n[exited 0 after 0.38s]\r\n"]
[1.961, "m", "Deliver a notification while the app is not running"]
[1.961, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.19, "o", "[exited 0 after 0.23s]\r\n"]
[3.193, "m", "Tap the banner"]
[3.193, "o", "$ idb ui tap 201 90\r\n"]
[3.448, "o", "[exited 0 after 0.26s]\r\n"]
[4.196, "m", "Clear the app's delivered notifications"]
[4.196, "o", "$ idb notification clear com.apple.news\r\n"]
[4.622, "o", "[exited 0 after 0.43s]\r\n"]
[5.087, "m", "List notifications after clearing them"]
[5.087, "o", "$ idb notification list com.apple.news\r\n"]
[5.497, "o", "[exited 0 after 0.41s]\r\n"]
[6.877, "o", ""]
