{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.228, "o", "[exited 0 after 0.23s]\r\n"]
[1.23, "m", "Go to the home screen"]
[1.23, "o", "$ idb ui button HOME\r\n"]
[1.442, "o", "[exited 0 after 0.21s]\r\n"]
[1.684, "m", "Check what is where the banner will appear"]
[1.684, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.037, "o", "{\"frame\":{\"height\":874,\"x\":0,\"width\":402,\"y\":0},\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"content_required\":false,\"enabled\":true,\"AXUniqueId\":null,\"role\":\"AXGroup\",\"custom_actions\":[],\"subrole\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"AXValue\":null,\"title\":null,\"pid\":1329,\"help\":null,\"role_description\":\"Group\",\"type\":\"Group\"}\r\n[exited 0 after 0.35s]\r\n"]
[2.038, "m", "Deliver a notification while the app is not running"]
[2.038, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.286, "o", "[exited 0 after 0.25s]\r\n"]
[3.289, "m", "Tap the banner"]
[3.289, "o", "$ idb ui tap 201 90\r\n"]
[3.676, "o", "[exited 0 after 0.39s]\r\n"]
[5.009, "m", "Clear the app's delivered notifications"]
[5.009, "o", "$ idb notification clear com.apple.news\r\n"]
[5.861, "o", "[exited 0 after 0.85s]\r\n"]
[6.456, "m", "List notifications after clearing them"]
[6.456, "o", "$ idb notification list com.apple.news\r\n"]
[7.037, "o", "[exited 0 after 0.58s]\r\n"]
[8.958, "o", ""]
