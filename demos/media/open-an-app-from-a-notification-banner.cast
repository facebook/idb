{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.273, "o", "[exited 0 after 0.27s]\r\n"]
[1.274, "m", "Go to the home screen"]
[1.274, "o", "$ idb ui button HOME\r\n"]
[1.524, "o", "[exited 0 after 0.25s]\r\n"]
[1.8, "m", "Check what is where the banner will appear"]
[1.8, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.274, "o", "{\"role\":\"AXGroup\",\"content_required\":false,\"type\":\"Group\",\"frame\":{\"x\":0,\"y\":0,\"width\":402,\"height\":874},\"pid\":1263,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"custom_actions\":[],\"AXValue\":null,\"title\":null,\"help\":null,\"role_description\":\"Group\",\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"enabled\":true,\"subrole\":null,\"AXUniqueId\":null}\r\n[exited 0 after 0.47s]\r\n"]
[2.274, "m", "Deliver a notification while the app is not running"]
[2.274, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.536, "o", "[exited 0 after 0.26s]\r\n"]
[3.537, "m", "Tap the banner"]
[3.537, "o", "$ idb ui tap 201 90\r\n"]
[3.756, "o", "[exited 0 after 0.22s]\r\n"]
[4.904, "m", "Clear the app's delivered notifications"]
[4.904, "o", "$ idb notification clear com.apple.news\r\n"]
[5.633, "o", "[exited 0 after 0.73s]\r\n"]
[6.105, "m", "List notifications after clearing them"]
[6.105, "o", "$ idb notification list com.apple.news\r\n"]
[7.22, "o", "[exited 0 after 1.12s]\r\n"]
[8.183, "o", ""]
