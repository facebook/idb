{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.213, "o", "[exited 0 after 0.21s]\r\n"]
[1.213, "m", "Go to the home screen"]
[1.213, "o", "$ idb ui button HOME\r\n"]
[1.411, "o", "[exited 0 after 0.20s]\r\n"]
[1.688, "m", "Check what is where the banner will appear"]
[1.688, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.404, "o", "{\"content_required\":false,\"AXLabel\":null,\"role_description\":\"Group\",\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"help\":null,\"AXUniqueId\":null,\"title\":null,\"frame\":{\"y\":0,\"x\":0,\"width\":401.99999999999994,\"height\":874},\"pid\":1752,\"AXValue\":null,\"enabled\":true,\"subrole\":null,\"role\":\"AXGroup\",\"traits\":[\"Scrollable\"],\"type\":\"Group\"}\r\n[exited 0 after 0.72s]\r\n"]
[2.404, "m", "Deliver a notification while the app is not running"]
[2.404, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.735, "o", "[exited 0 after 0.33s]\r\n"]
[3.738, "m", "Tap the banner"]
[3.738, "o", "$ idb ui tap 201 90\r\n"]
[4.015, "o", "[exited 0 after 0.28s]\r\n"]
[4.849, "m", "Clear the app's delivered notifications"]
[4.849, "o", "$ idb notification clear com.apple.news\r\n"]
[5.429, "o", "[exited 0 after 0.58s]\r\n"]
[6.159, "m", "List notifications after clearing them"]
[6.159, "o", "$ idb notification list com.apple.news\r\n"]
[6.635, "o", "[exited 0 after 0.48s]\r\n"]
[8.112, "o", ""]
