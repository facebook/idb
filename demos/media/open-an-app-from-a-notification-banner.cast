{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.26, "o", "[exited 0 after 0.26s]\r\n"]
[1.26, "m", "Go to the home screen"]
[1.26, "o", "$ idb ui button HOME\r\n"]
[1.455, "o", "[exited 0 after 0.19s]\r\n"]
[1.691, "m", "Check what is where the banner will appear"]
[1.691, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.099, "o", "{\"frame\":{\"height\":874,\"y\":0,\"x\":0,\"width\":402},\"AXValue\":null,\"enabled\":true,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"help\":null,\"content_required\":false,\"role_description\":\"Group\",\"AXUniqueId\":null,\"title\":null,\"pid\":1706,\"role\":\"AXGroup\",\"subrole\":null,\"custom_actions\":[],\"type\":\"Group\",\"AXLabel\":null,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.41s]\r\n"]
[2.1, "m", "Deliver a notification while the app is not running"]
[2.1, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.426, "o", "[exited 0 after 0.33s]\r\n"]
[3.429, "m", "Tap the banner"]
[3.429, "o", "$ idb ui tap 201 90\r\n"]
[3.698, "o", "[exited 0 after 0.27s]\r\n"]
[7.251, "m", "Clear the app's delivered notifications"]
[7.251, "o", "$ idb notification clear com.apple.news\r\n"]
[7.962, "o", "[exited 0 after 0.71s]\r\n"]
[8.536, "m", "List notifications after clearing them"]
[8.536, "o", "$ idb notification list com.apple.news\r\n"]
[8.995, "o", "[exited 0 after 0.46s]\r\n"]
[9.797, "o", ""]
