{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.227, "o", "[exited 0 after 0.23s]\r\n"]
[1.227, "m", "Go to the home screen"]
[1.227, "o", "$ idb ui button HOME\r\n"]
[1.393, "o", "[exited 0 after 0.17s]\r\n"]
[1.615, "m", "Check what is where the banner will appear"]
[1.615, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.926, "o", "{\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"AXValue\":null,\"AXUniqueId\":null,\"AXLabel\":null,\"subrole\":null,\"role_description\":\"Group\",\"pid\":2716,\"custom_actions\":[],\"type\":\"Group\",\"title\":null,\"enabled\":true,\"content_required\":false,\"role\":\"AXGroup\",\"help\":null,\"traits\":[\"Scrollable\"],\"frame\":{\"y\":0,\"height\":874,\"x\":0,\"width\":402}}\r\n[exited 0 after 0.31s]\r\n"]
[1.926, "m", "Deliver a notification while the app is not running"]
[1.926, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.115, "o", "[exited 0 after 0.19s]\r\n"]
[3.118, "m", "Tap the banner"]
[3.118, "o", "$ idb ui tap 201 90\r\n"]
[3.384, "o", "[exited 0 after 0.27s]\r\n"]
[4.08, "m", "Clear the app's delivered notifications"]
[4.08, "o", "$ idb notification clear com.apple.news\r\n"]
[4.532, "o", "[exited 0 after 0.45s]\r\n"]
[5.062, "m", "List notifications after clearing them"]
[5.062, "o", "$ idb notification list com.apple.news\r\n"]
[5.54, "o", "[exited 0 after 0.48s]\r\n"]
[6.937, "o", ""]
