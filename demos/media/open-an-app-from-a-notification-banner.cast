{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.292, "o", "[exited 0 after 0.29s]\r\n"]
[1.292, "m", "Go to the home screen"]
[1.292, "o", "$ idb ui button HOME\r\n"]
[1.507, "o", "[exited 0 after 0.21s]\r\n"]
[1.891, "m", "Check what is where the banner will appear"]
[1.891, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.164, "o", "{\"pid\":1286,\"role\":\"AXGroup\",\"help\":null,\"subrole\":null,\"enabled\":true,\"title\":null,\"AXLabel\":null,\"content_required\":false,\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"AXUniqueId\":null,\"frame\":{\"height\":874,\"y\":0,\"x\":0,\"width\":401.99999999999994},\"AXValue\":null,\"role_description\":\"Group\"}\r\n[exited 0 after 0.27s]\r\n"]
[2.164, "m", "Deliver a notification while the app is not running"]
[2.164, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.395, "o", "[exited 0 after 0.23s]\r\n"]
[3.404, "m", "Tap the banner"]
[3.404, "o", "$ idb ui tap 201 90\r\n"]
[4.27, "o", "[exited 0 after 0.87s]\r\n"]
[6.237, "m", "Clear the app's delivered notifications"]
[6.237, "o", "$ idb notification clear com.apple.news\r\n"]
[6.905, "o", "[exited 0 after 0.67s]\r\n"]
[8.274, "m", "List notifications after clearing them"]
[8.274, "o", "$ idb notification list com.apple.news\r\n"]
[8.909, "o", "[exited 0 after 0.63s]\r\n"]
[9.95, "o", ""]
