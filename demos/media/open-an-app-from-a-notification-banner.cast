{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.225, "o", "[exited 0 after 0.23s]\r\n"]
[1.226, "m", "Go to the home screen"]
[1.226, "o", "$ idb ui button HOME\r\n"]
[1.391, "o", "[exited 0 after 0.17s]\r\n"]
[1.605, "m", "Check what is where the banner will appear"]
[1.605, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.044, "o", "{\"role_description\":\"Group\",\"role\":\"AXGroup\",\"subrole\":null,\"traits\":[\"Scrollable\"],\"title\":null,\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"AXValue\":null,\"pid\":1875,\"AXUniqueId\":null,\"AXLabel\":null,\"type\":\"Group\",\"content_required\":false,\"enabled\":true,\"frame\":{\"y\":0,\"height\":874,\"width\":402,\"x\":0},\"help\":null}\r\n[exited 0 after 0.44s]\r\n"]
[2.044, "m", "Deliver a notification while the app is not running"]
[2.044, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.282, "o", "[exited 0 after 0.24s]\r\n"]
[3.283, "m", "Tap the banner"]
[3.283, "o", "$ idb ui tap 201 90\r\n"]
[3.524, "o", "[exited 0 after 0.24s]\r\n"]
[4.277, "m", "Clear the app's delivered notifications"]
[4.277, "o", "$ idb notification clear com.apple.news\r\n"]
[4.726, "o", "[exited 0 after 0.45s]\r\n"]
[5.28, "m", "List notifications after clearing them"]
[5.28, "o", "$ idb notification list com.apple.news\r\n"]
[5.769, "o", "[exited 0 after 0.49s]\r\n"]
[7.088, "o", ""]
