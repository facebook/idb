{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.272, "o", "[exited 0 after 0.27s]\r\n"]
[1.272, "m", "Go to the home screen"]
[1.272, "o", "$ idb ui button HOME\r\n"]
[1.465, "o", "[exited 0 after 0.19s]\r\n"]
[1.736, "m", "Check what is where the banner will appear"]
[1.736, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.184, "o", "{\"title\":null,\"traits\":[\"Scrollable\"],\"pid\":1347,\"content_required\":false,\"enabled\":true,\"frame\":{\"height\":874,\"width\":402.00000000000006,\"x\":0,\"y\":0},\"role\":\"AXGroup\",\"AXUniqueId\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"custom_actions\":[],\"AXValue\":null,\"type\":\"Group\",\"role_description\":\"Group\",\"help\":null,\"AXLabel\":null,\"subrole\":null}\r\n[exited 0 after 0.45s]\r\n"]
[2.184, "m", "Deliver a notification while the app is not running"]
[2.184, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.428, "o", "[exited 0 after 0.24s]\r\n"]
[3.433, "m", "Tap the banner"]
[3.433, "o", "$ idb ui tap 201 90\r\n"]
[3.801, "o", "[exited 0 after 0.37s]\r\n"]
[5.127, "m", "Clear the app's delivered notifications"]
[5.127, "o", "$ idb notification clear com.apple.news\r\n"]
[5.83, "o", "[exited 0 after 0.70s]\r\n"]
[6.441, "m", "List notifications after clearing them"]
[6.441, "o", "$ idb notification list com.apple.news\r\n"]
[6.95, "o", "[exited 0 after 0.51s]\r\n"]
[8.653, "o", ""]
