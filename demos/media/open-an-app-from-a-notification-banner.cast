{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.28, "o", "[exited 0 after 0.28s]\r\n"]
[1.28, "m", "Go to the home screen"]
[1.28, "o", "$ idb ui button HOME\r\n"]
[1.488, "o", "[exited 0 after 0.21s]\r\n"]
[1.701, "m", "Check what is where the banner will appear"]
[1.701, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.058, "o", "{\"role\":\"AXGroup\",\"AXValue\":null,\"subrole\":null,\"pid\":1340,\"role_description\":\"Group\",\"help\":null,\"title\":null,\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"enabled\":true,\"AXUniqueId\":null,\"content_required\":false,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"frame\":{\"height\":874,\"y\":0,\"x\":0,\"width\":401.99999999999994},\"custom_actions\":[]}\r\n[exited 0 after 0.36s]\r\n"]
[2.059, "m", "Deliver a notification while the app is not running"]
[2.059, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.286, "o", "[exited 0 after 0.23s]\r\n"]
[3.289, "m", "Tap the banner"]
[3.289, "o", "$ idb ui tap 201 90\r\n"]
[3.669, "o", "[exited 0 after 0.38s]\r\n"]
[4.567, "m", "Clear the app's delivered notifications"]
[4.567, "o", "$ idb notification clear com.apple.news\r\n"]
[5.236, "o", "[exited 0 after 0.67s]\r\n"]
[6.067, "m", "List notifications after clearing them"]
[6.067, "o", "$ idb notification list com.apple.news\r\n"]
[6.629, "o", "[exited 0 after 0.56s]\r\n"]
[8.827, "o", ""]
