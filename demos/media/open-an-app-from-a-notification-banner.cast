{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.219, "o", "[exited 0 after 0.22s]\r\n"]
[1.219, "m", "Go to the home screen"]
[1.219, "o", "$ idb ui button HOME\r\n"]
[1.399, "o", "[exited 0 after 0.18s]\r\n"]
[1.588, "m", "Check what is where the banner will appear"]
[1.588, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.965, "o", "{\"subrole\":null,\"title\":null,\"AXLabel\":null,\"help\":null,\"enabled\":true,\"AXUniqueId\":null,\"role_description\":\"Group\",\"role\":\"AXGroup\",\"type\":\"Group\",\"content_required\":false,\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"frame\":{\"x\":0,\"width\":401.99999999999994,\"y\":0,\"height\":874},\"pid\":1270,\"traits\":[\"Scrollable\"],\"custom_actions\":[]}\r\n[exited 0 after 0.38s]\r\n"]
[1.965, "m", "Deliver a notification while the app is not running"]
[1.965, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.157, "o", "[exited 0 after 0.19s]\r\n"]
[3.16, "m", "Tap the banner"]
[3.16, "o", "$ idb ui tap 201 90\r\n"]
[3.448, "o", "[exited 0 after 0.29s]\r\n"]
[4.211, "m", "Clear the app's delivered notifications"]
[4.211, "o", "$ idb notification clear com.apple.news\r\n"]
[4.67, "o", "[exited 0 after 0.46s]\r\n"]
[5.184, "m", "List notifications after clearing them"]
[5.184, "o", "$ idb notification list com.apple.news\r\n"]
[5.659, "o", "[exited 0 after 0.48s]\r\n"]
[7.02, "o", ""]
