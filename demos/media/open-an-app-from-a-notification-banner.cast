{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.337, "o", "[exited 0 after 0.34s]\r\n"]
[1.338, "m", "Go to the home screen"]
[1.338, "o", "$ idb ui button HOME\r\n"]
[1.568, "o", "[exited 0 after 0.23s]\r\n"]
[2.235, "m", "Check what is where the banner will appear"]
[2.235, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.535, "o", "{\"AXValue\":null,\"AXLabel\":null,\"pid\":1324,\"content_required\":false,\"role\":\"AXGroup\",\"help\":null,\"role_description\":\"Group\",\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"title\":null,\"enabled\":true,\"frame\":{\"x\":0,\"y\":0,\"height\":874,\"width\":401.99999999999994},\"AXUniqueId\":null,\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"subrole\":null}\r\n[exited 0 after 0.30s]\r\n"]
[2.536, "m", "Deliver a notification while the app is not running"]
[2.536, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[3.036, "o", "[exited 0 after 0.50s]\r\n"]
[4.04, "m", "Tap the banner"]
[4.04, "o", "$ idb ui tap 201 90\r\n"]
[4.495, "o", "[exited 0 after 0.45s]\r\n"]
[5.471, "m", "Clear the app's delivered notifications"]
[5.471, "o", "$ idb notification clear com.apple.news\r\n"]
[6.311, "o", "[exited 0 after 0.84s]\r\n"]
[7.039, "m", "List notifications after clearing them"]
[7.039, "o", "$ idb notification list com.apple.news\r\n"]
[7.643, "o", "[exited 0 after 0.60s]\r\n"]
[9.655, "o", ""]
