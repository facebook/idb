{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.366, "o", "[exited 0 after 0.37s]\r\n"]
[1.366, "m", "Go to the home screen"]
[1.366, "o", "$ idb ui button HOME\r\n"]
[1.576, "o", "[exited 0 after 0.21s]\r\n"]
[1.956, "m", "Check what is where the banner will appear"]
[1.956, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.254, "o", "{\"pid\":4441,\"AXUniqueId\":null,\"AXValue\":null,\"AXLabel\":null,\"type\":\"Group\",\"frame\":{\"width\":402.00000000000006,\"x\":0,\"height\":874,\"y\":0},\"content_required\":false,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"role_description\":\"Group\",\"custom_actions\":[],\"traits\":[\"Scrollable\"],\"title\":null,\"help\":null,\"enabled\":true,\"subrole\":null,\"role\":\"AXGroup\"}\r\n[exited 0 after 0.30s]\r\n"]
[2.254, "m", "Deliver a notification while the app is not running"]
[2.254, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.632, "o", "[exited 0 after 0.38s]\r\n"]
[3.635, "m", "Tap the banner"]
[3.635, "o", "$ idb ui tap 201 90\r\n"]
[3.888, "o", "[exited 0 after 0.25s]\r\n"]
[4.513, "m", "Clear the app's delivered notifications"]
[4.513, "o", "$ idb notification clear com.apple.news\r\n"]
[5.207, "o", "[exited 0 after 0.69s]\r\n"]
[5.759, "m", "List notifications after clearing them"]
[5.759, "o", "$ idb notification list com.apple.news\r\n"]
[6.218, "o", "[exited 0 after 0.46s]\r\n"]
[7.803, "o", ""]
