{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.198, "o", "[exited 0 after 0.20s]\r\n"]
[1.199, "m", "Go to the home screen"]
[1.199, "o", "$ idb ui button HOME\r\n"]
[1.361, "o", "[exited 0 after 0.16s]\r\n"]
[1.623, "m", "Check what is where the banner will appear"]
[1.623, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.169, "o", "{\"title\":null,\"frame\":{\"height\":874,\"width\":402.00000000000006,\"x\":0,\"y\":0},\"AXUniqueId\":null,\"role\":\"AXGroup\",\"enabled\":true,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"AXValue\":null,\"custom_actions\":[],\"help\":null,\"pid\":1838,\"content_required\":false,\"type\":\"Group\",\"role_description\":\"Group\",\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"subrole\":null}\r\n[exited 0 after 0.55s]\r\n"]
[2.169, "m", "Deliver a notification while the app is not running"]
[2.169, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.492, "o", "[exited 0 after 0.32s]\r\n"]
[3.496, "m", "Tap the banner"]
[3.496, "o", "$ idb ui tap 201 90\r\n"]
[3.693, "o", "[exited 0 after 0.20s]\r\n"]
[4.715, "m", "Clear the app's delivered notifications"]
[4.715, "o", "$ idb notification clear com.apple.news\r\n"]
[5.143, "o", "[exited 0 after 0.43s]\r\n"]
[5.587, "m", "List notifications after clearing them"]
[5.587, "o", "$ idb notification list com.apple.news\r\n"]
[5.968, "o", "[exited 0 after 0.38s]\r\n"]
[7.283, "o", ""]
