{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.248, "o", "[exited 0 after 0.25s]\r\n"]
[1.249, "m", "Go to the home screen"]
[1.249, "o", "$ idb ui button HOME\r\n"]
[1.432, "o", "[exited 0 after 0.18s]\r\n"]
[1.72, "m", "Check what is where the banner will appear"]
[1.72, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.106, "o", "{\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"custom_actions\":[],\"AXUniqueId\":null,\"help\":null,\"role_description\":\"Group\",\"AXValue\":null,\"frame\":{\"height\":874,\"x\":0,\"y\":0,\"width\":402},\"enabled\":true,\"subrole\":null,\"type\":\"Group\",\"content_required\":false,\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"role\":\"AXGroup\",\"title\":null,\"pid\":1310}\r\n[exited 0 after 0.39s]\r\n"]
[2.106, "m", "Deliver a notification while the app is not running"]
[2.106, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.333, "o", "[exited 0 after 0.23s]\r\n"]
[3.335, "m", "Tap the banner"]
[3.335, "o", "$ idb ui tap 201 90\r\n"]
[3.536, "o", "[exited 0 after 0.20s]\r\n"]
[4.438, "m", "Clear the app's delivered notifications"]
[4.438, "o", "$ idb notification clear com.apple.news\r\n"]
[4.938, "o", "[exited 0 after 0.50s]\r\n"]
[5.507, "m", "List notifications after clearing them"]
[5.507, "o", "$ idb notification list com.apple.news\r\n"]
[5.882, "o", "[exited 0 after 0.37s]\r\n"]
[7.21, "o", ""]
