{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.28, "o", "[exited 0 after 0.28s]\r\n"]
[1.28, "m", "Go to the home screen"]
[1.28, "o", "$ idb ui button HOME\r\n"]
[1.515, "o", "[exited 0 after 0.23s]\r\n"]
[1.789, "m", "Check what is where the banner will appear"]
[1.789, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.213, "o", "{\"AXValue\":null,\"role_description\":\"Group\",\"role\":\"AXGroup\",\"content_required\":false,\"pid\":1293,\"traits\":[\"Scrollable\"],\"AXLabel\":null,\"enabled\":true,\"AXUniqueId\":null,\"custom_actions\":[],\"title\":null,\"type\":\"Group\",\"help\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"subrole\":null,\"frame\":{\"width\":402,\"x\":0,\"height\":874,\"y\":0}}\r\n[exited 0 after 0.42s]\r\n"]
[2.213, "m", "Deliver a notification while the app is not running"]
[2.213, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.524, "o", "[exited 0 after 0.31s]\r\n"]
[3.531, "m", "Tap the banner"]
[3.531, "o", "$ idb ui tap 201 90\r\n"]
[4.198, "o", "[exited 0 after 0.67s]\r\n"]
[4.995, "m", "Clear the app's delivered notifications"]
[4.995, "o", "$ idb notification clear com.apple.news\r\n"]
[5.825, "o", "[exited 0 after 0.83s]\r\n"]
[6.438, "m", "List notifications after clearing them"]
[6.438, "o", "$ idb notification list com.apple.news\r\n"]
[6.891, "o", "[exited 0 after 0.45s]\r\n"]
[9.437, "o", ""]
