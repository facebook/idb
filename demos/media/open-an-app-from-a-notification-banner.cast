{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.228, "o", "[exited 0 after 0.23s]\r\n"]
[1.229, "m", "Go to the home screen"]
[1.229, "o", "$ idb ui button HOME\r\n"]
[1.394, "o", "[exited 0 after 0.16s]\r\n"]
[1.641, "m", "Check what is where the banner will appear"]
[1.641, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.975, "o", "{\"help\":null,\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"frame\":{\"x\":0,\"y\":0,\"width\":401.99999999999994,\"height\":874},\"traits\":[\"Scrollable\"],\"pid\":7556,\"enabled\":true,\"AXUniqueId\":null,\"content_required\":false,\"type\":\"Group\",\"custom_actions\":[],\"title\":null,\"subrole\":null,\"AXLabel\":null,\"role_description\":\"Group\",\"AXValue\":null}\r\n[exited 0 after 0.33s]\r\n"]
[1.976, "m", "Deliver a notification while the app is not running"]
[1.976, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.178, "o", "[exited 0 after 0.20s]\r\n"]
[3.182, "m", "Tap the banner"]
[3.182, "o", "$ idb ui tap 201 90\r\n"]
[3.443, "o", "[exited 0 after 0.26s]\r\n"]
[4.337, "m", "Clear the app's delivered notifications"]
[4.337, "o", "$ idb notification clear com.apple.news\r\n"]
[4.849, "o", "[exited 0 after 0.51s]\r\n"]
[5.365, "m", "List notifications after clearing them"]
[5.365, "o", "$ idb notification list com.apple.news\r\n"]
[5.775, "o", "[exited 0 after 0.41s]\r\n"]
[7.185, "o", ""]
