{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.227, "o", "[exited 0 after 0.23s]\r\n"]
[1.231, "m", "Go to the home screen"]
[1.231, "o", "$ idb ui button HOME\r\n"]
[1.405, "o", "[exited 0 after 0.17s]\r\n"]
[1.638, "m", "Check what is where the banner will appear"]
[1.638, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.975, "o", "{\"frame\":{\"height\":874,\"y\":0,\"x\":0,\"width\":401.99999999999994},\"type\":\"Group\",\"title\":null,\"role_description\":\"Group\",\"subrole\":null,\"help\":null,\"AXLabel\":null,\"enabled\":true,\"custom_actions\":[],\"traits\":[\"Scrollable\"],\"role\":\"AXGroup\",\"AXUniqueId\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"AXValue\":null,\"pid\":1438,\"content_required\":false}\r\n[exited 0 after 0.34s]\r\n"]
[1.976, "m", "Deliver a notification while the app is not running"]
[1.976, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.185, "o", "[exited 0 after 0.21s]\r\n"]
[3.189, "m", "Tap the banner"]
[3.189, "o", "$ idb ui tap 201 90\r\n"]
[3.495, "o", "[exited 0 after 0.31s]\r\n"]
[4.486, "m", "Clear the app's delivered notifications"]
[4.486, "o", "$ idb notification clear com.apple.news\r\n"]
[5.058, "o", "[exited 0 after 0.57s]\r\n"]
[5.611, "m", "List notifications after clearing them"]
[5.611, "o", "$ idb notification list com.apple.news\r\n"]
[6.06, "o", "[exited 0 after 0.45s]\r\n"]
[7.785, "o", ""]
