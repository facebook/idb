{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.319, "o", "[exited 0 after 0.32s]\r\n"]
[1.319, "m", "Go to the home screen"]
[1.319, "o", "$ idb ui button HOME\r\n"]
[1.569, "o", "[exited 0 after 0.25s]\r\n"]
[1.864, "m", "Check what is where the banner will appear"]
[1.864, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.258, "o", "{\"title\":null,\"subrole\":null,\"content_required\":false,\"enabled\":true,\"AXLabel\":null,\"role_description\":\"Group\",\"help\":null,\"custom_actions\":[],\"AXValue\":null,\"role\":\"AXGroup\",\"frame\":{\"x\":0,\"width\":402.00000000000006,\"height\":874,\"y\":0},\"AXUniqueId\":null,\"pid\":1622,\"type\":\"Group\",\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.39s]\r\n"]
[2.258, "m", "Deliver a notification while the app is not running"]
[2.258, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.56, "o", "[exited 0 after 0.30s]\r\n"]
[3.564, "m", "Tap the banner"]
[3.564, "o", "$ idb ui tap 201 90\r\n"]
[3.804, "o", "[exited 0 after 0.24s]\r\n"]
[4.938, "m", "Clear the app's delivered notifications"]
[4.938, "o", "$ idb notification clear com.apple.news\r\n"]
[5.588, "o", "[exited 0 after 0.65s]\r\n"]
[6.1, "m", "List notifications after clearing them"]
[6.1, "o", "$ idb notification list com.apple.news\r\n"]
[6.622, "o", "[exited 0 after 0.52s]\r\n"]
[8.853, "o", ""]
