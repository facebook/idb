{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.391, "o", "[exited 0 after 0.39s]\r\n"]
[1.391, "m", "Go to the home screen"]
[1.391, "o", "$ idb ui button HOME\r\n"]
[1.617, "o", "[exited 0 after 0.23s]\r\n"]
[1.929, "m", "Check what is where the banner will appear"]
[1.929, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.328, "o", "{\"pid\":2606,\"frame\":{\"x\":0,\"y\":0,\"width\":401.99999999999994,\"height\":874},\"enabled\":true,\"custom_actions\":[],\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"traits\":[\"Scrollable\"],\"content_required\":false,\"help\":null,\"type\":\"Group\",\"role\":\"AXGroup\",\"AXUniqueId\":null,\"subrole\":null,\"AXValue\":null,\"title\":null,\"AXLabel\":null}\r\n[exited 0 after 0.40s]\r\n"]
[2.328, "m", "Deliver a notification while the app is not running"]
[2.328, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.585, "o", "[exited 0 after 0.26s]\r\n"]
[3.588, "m", "Tap the banner"]
[3.588, "o", "$ idb ui tap 201 90\r\n"]
[3.908, "o", "[exited 0 after 0.32s]\r\n"]
[4.795, "m", "Clear the app's delivered notifications"]
[4.795, "o", "$ idb notification clear com.apple.news\r\n"]
[5.297, "o", "[exited 0 after 0.50s]\r\n"]
[5.871, "m", "List notifications after clearing them"]
[5.871, "o", "$ idb notification list com.apple.news\r\n"]
[6.396, "o", "[exited 0 after 0.53s]\r\n"]
[7.965, "o", ""]
