{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.246, "o", "[exited 0 after 0.25s]\r\n"]
[1.246, "m", "Go to the home screen"]
[1.246, "o", "$ idb ui button HOME\r\n"]
[1.456, "o", "[exited 0 after 0.21s]\r\n"]
[2.037, "m", "Check what is where the banner will appear"]
[2.037, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.4, "o", "{\"help\":null,\"traits\":[\"Scrollable\"],\"subrole\":null,\"type\":\"Group\",\"enabled\":true,\"role_description\":\"Group\",\"pid\":1569,\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"title\":null,\"content_required\":false,\"AXLabel\":null,\"AXUniqueId\":null,\"frame\":{\"height\":874,\"width\":402.00000000000006,\"x\":0,\"y\":0},\"custom_actions\":[],\"role\":\"AXGroup\"}\r\n[exited 0 after 0.36s]\r\n"]
[2.401, "m", "Deliver a notification while the app is not running"]
[2.401, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.68, "o", "[exited 0 after 0.28s]\r\n"]
[3.684, "m", "Tap the banner"]
[3.684, "o", "$ idb ui tap 201 90\r\n"]
[3.995, "o", "[exited 0 after 0.31s]\r\n"]
[4.797, "m", "Clear the app's delivered notifications"]
[4.797, "o", "$ idb notification clear com.apple.news\r\n"]
[5.376, "o", "[exited 0 after 0.58s]\r\n"]
[5.935, "m", "List notifications after clearing them"]
[5.935, "o", "$ idb notification list com.apple.news\r\n"]
[6.522, "o", "[exited 0 after 0.59s]\r\n"]
[8.137, "o", ""]
