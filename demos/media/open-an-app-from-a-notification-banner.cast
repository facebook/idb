{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.275, "o", "[exited 0 after 0.27s]\r\n"]
[1.275, "m", "Go to the home screen"]
[1.275, "o", "$ idb ui button HOME\r\n"]
[1.435, "o", "[exited 0 after 0.16s]\r\n"]
[1.717, "m", "Check what is where the banner will appear"]
[1.717, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.1, "o", "{\"role\":\"AXGroup\",\"frame\":{\"width\":402.00000000000006,\"x\":0,\"y\":0,\"height\":874},\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"AXUniqueId\":null,\"pid\":24353,\"subrole\":null,\"type\":\"Group\",\"title\":null,\"AXValue\":null,\"AXLabel\":null,\"role_description\":\"Group\",\"content_required\":false,\"traits\":[\"Scrollable\"],\"custom_actions\":[],\"help\":null,\"enabled\":true}\r\n[exited 0 after 0.38s]\r\n"]
[2.1, "m", "Deliver a notification while the app is not running"]
[2.1, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.268, "o", "[exited 0 after 0.17s]\r\n"]
[3.271, "m", "Tap the banner"]
[3.271, "o", "$ idb ui tap 201 90\r\n"]
[3.542, "o", "[exited 0 after 0.27s]\r\n"]
[4.3, "m", "Clear the app's delivered notifications"]
[4.3, "o", "$ idb notification clear com.apple.news\r\n"]
[4.773, "o", "[exited 0 after 0.47s]\r\n"]
[5.317, "m", "List notifications after clearing them"]
[5.317, "o", "$ idb notification list com.apple.news\r\n"]
[5.731, "o", "[exited 0 after 0.41s]\r\n"]
[7.152, "o", ""]
