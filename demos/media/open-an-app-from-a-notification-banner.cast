{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.242, "o", "[exited 0 after 0.24s]\r\n"]
[1.243, "m", "Go to the home screen"]
[1.243, "o", "$ idb ui button HOME\r\n"]
[1.433, "o", "[exited 0 after 0.19s]\r\n"]
[1.695, "m", "Check what is where the banner will appear"]
[1.695, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.028, "o", "{\"role_description\":\"Group\",\"traits\":[\"Scrollable\"],\"AXValue\":null,\"help\":null,\"AXLabel\":null,\"content_required\":false,\"enabled\":true,\"title\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"pid\":1447,\"AXUniqueId\":null,\"subrole\":null,\"role\":\"AXGroup\",\"type\":\"Group\",\"custom_actions\":[],\"frame\":{\"x\":0,\"width\":401.99999999999994,\"y\":0,\"height\":874}}\r\n[exited 0 after 0.33s]\r\n"]
[2.029, "m", "Deliver a notification while the app is not running"]
[2.029, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.224, "o", "[exited 0 after 0.20s]\r\n"]
[3.227, "m", "Tap the banner"]
[3.227, "o", "$ idb ui tap 201 90\r\n"]
[3.68, "o", "[exited 0 after 0.45s]\r\n"]
[4.492, "m", "Clear the app's delivered notifications"]
[4.492, "o", "$ idb notification clear com.apple.news\r\n"]
[4.954, "o", "[exited 0 after 0.46s]\r\n"]
[5.557, "m", "List notifications after clearing them"]
[5.557, "o", "$ idb notification list com.apple.news\r\n"]
[6.118, "o", "[exited 0 after 0.56s]\r\n"]
[8.137, "o", ""]
