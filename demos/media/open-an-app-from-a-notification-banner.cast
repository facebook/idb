{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.265, "o", "[exited 0 after 0.26s]\r\n"]
[1.265, "m", "Go to the home screen"]
[1.265, "o", "$ idb ui button HOME\r\n"]
[1.498, "o", "[exited 0 after 0.23s]\r\n"]
[2.266, "m", "Check what is where the banner will appear"]
[2.266, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.462, "o", "{\"title\":null,\"AXValue\":null,\"type\":\"Group\",\"content_required\":false,\"AXLabel\":null,\"frame\":{\"height\":874,\"x\":0,\"y\":0,\"width\":401.99999999999994},\"custom_actions\":[],\"traits\":[\"Scrollable\"],\"role_description\":\"Group\",\"AXUniqueId\":null,\"role\":\"AXGroup\",\"enabled\":true,\"help\":null,\"subrole\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"pid\":7019}\r\n[exited 0 after 0.20s]\r\n"]
[2.462, "m", "Deliver a notification while the app is not running"]
[2.462, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.775, "o", "[exited 0 after 0.31s]\r\n"]
[3.784, "m", "Tap the banner"]
[3.784, "o", "$ idb ui tap 201 90\r\n"]
[4.073, "o", "[exited 0 after 0.29s]\r\n"]
[4.824, "m", "Clear the app's delivered notifications"]
[4.824, "o", "$ idb notification clear com.apple.news\r\n"]
[5.251, "o", "[exited 0 after 0.43s]\r\n"]
[5.709, "m", "List notifications after clearing them"]
[5.709, "o", "$ idb notification list com.apple.news\r\n"]
[6.23, "o", "[exited 0 after 0.52s]\r\n"]
[7.487, "o", ""]
