{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.813, "m", "Grant notification permission without showing a prompt"]
[0.813, "o", "$ idb approve com.apple.news notification\r\n"]
[1.076, "o", "[exited 0 after 0.26s]\r\n"]
[1.076, "m", "Go to the home screen"]
[1.076, "o", "$ idb ui button HOME\r\n"]
[1.295, "o", "[exited 0 after 0.22s]\r\n"]
[1.496, "m", "Check what is where the banner will appear"]
[1.496, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.953, "o", "{\"content_required\":false,\"role_description\":\"Group\",\"help\":null,\"AXUniqueId\":null,\"role\":\"AXGroup\",\"custom_actions\":[],\"frame\":{\"y\":0,\"width\":402.00000000000006,\"height\":874,\"x\":0},\"traits\":[\"Scrollable\"],\"enabled\":true,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"AXValue\":null,\"pid\":3146,\"title\":null,\"subrole\":null,\"AXLabel\":null,\"type\":\"Group\"}\r\n[exited 0 after 0.46s]\r\n"]
[1.954, "m", "Deliver a notification while the app is not running"]
[1.954, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.22, "o", "[exited 0 after 0.27s]\r\n"]
[3.224, "m", "Tap the banner"]
[3.224, "o", "$ idb ui tap 201 90\r\n"]
[3.479, "o", "[exited 0 after 0.25s]\r\n"]
[4.274, "m", "Clear the app's delivered notifications"]
[4.274, "o", "$ idb notification clear com.apple.news\r\n"]
[4.784, "o", "[exited 0 after 0.51s]\r\n"]
[5.307, "m", "List notifications after clearing them"]
[5.307, "o", "$ idb notification list com.apple.news\r\n"]
[5.832, "o", "[exited 0 after 0.53s]\r\n"]
[7.218, "o", ""]
