{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.356, "o", "[exited 0 after 0.36s]\r\n"]
[1.357, "m", "Go to the home screen"]
[1.357, "o", "$ idb ui button HOME\r\n"]
[1.586, "o", "[exited 0 after 0.23s]\r\n"]
[2.326, "m", "Check what is where the banner will appear"]
[2.326, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.608, "o", "{\"type\":\"Group\",\"role_description\":\"Group\",\"content_required\":false,\"AXValue\":null,\"traits\":[\"Scrollable\"],\"pid\":1342,\"AXLabel\":null,\"frame\":{\"x\":0,\"y\":0,\"height\":874,\"width\":402},\"custom_actions\":[],\"enabled\":true,\"AXUniqueId\":null,\"subrole\":null,\"help\":null,\"role\":\"AXGroup\",\"title\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\"}\r\n[exited 0 after 0.28s]\r\n"]
[2.608, "m", "Deliver a notification while the app is not running"]
[2.608, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[3.097, "o", "[exited 0 after 0.49s]\r\n"]
[4.099, "m", "Tap the banner"]
[4.099, "o", "$ idb ui tap 201 90\r\n"]
[4.422, "o", "[exited 0 after 0.32s]\r\n"]
[5.538, "m", "Clear the app's delivered notifications"]
[5.538, "o", "$ idb notification clear com.apple.news\r\n"]
[6.131, "o", "[exited 0 after 0.59s]\r\n"]
[6.7, "m", "List notifications after clearing them"]
[6.7, "o", "$ idb notification list com.apple.news\r\n"]
[7.13, "o", "[exited 0 after 0.43s]\r\n"]
[8.988, "o", ""]
