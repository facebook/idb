{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.215, "o", "[exited 0 after 0.22s]\r\n"]
[1.215, "m", "Go to the home screen"]
[1.215, "o", "$ idb ui button HOME\r\n"]
[1.378, "o", "[exited 0 after 0.16s]\r\n"]
[1.607, "m", "Check what is where the banner will appear"]
[1.607, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.995, "o", "{\"type\":\"Group\",\"enabled\":true,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"subrole\":null,\"role\":\"AXGroup\",\"content_required\":false,\"help\":null,\"custom_actions\":[],\"pid\":1730,\"AXLabel\":null,\"frame\":{\"y\":0,\"x\":0,\"width\":402.00000000000006,\"height\":874},\"AXUniqueId\":null,\"AXValue\":null,\"traits\":[\"Scrollable\"],\"title\":null,\"role_description\":\"Group\"}\r\n[exited 0 after 0.39s]\r\n"]
[1.996, "m", "Deliver a notification while the app is not running"]
[1.996, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.197, "o", "[exited 0 after 0.20s]\r\n"]
[3.2, "m", "Tap the banner"]
[3.2, "o", "$ idb ui tap 201 90\r\n"]
[3.966, "o", "[exited 0 after 0.77s]\r\n"]
[5.674, "m", "Clear the app's delivered notifications"]
[5.674, "o", "$ idb notification clear com.apple.news\r\n"]
[6.259, "o", "[exited 0 after 0.58s]\r\n"]
[7.247, "m", "List notifications after clearing them"]
[7.247, "o", "$ idb notification list com.apple.news\r\n"]
[7.888, "o", "[exited 0 after 0.64s]\r\n"]
[8.882, "o", ""]
