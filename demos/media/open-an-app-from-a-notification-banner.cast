{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.308, "o", "[exited 0 after 0.31s]\r\n"]
[1.309, "m", "Go to the home screen"]
[1.309, "o", "$ idb ui button HOME\r\n"]
[1.549, "o", "[exited 0 after 0.24s]\r\n"]
[1.841, "m", "Check what is where the banner will appear"]
[1.841, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.193, "o", "{\"pid\":3188,\"traits\":[\"Scrollable\"],\"subrole\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"enabled\":true,\"title\":null,\"AXValue\":null,\"help\":null,\"AXLabel\":null,\"custom_actions\":[],\"frame\":{\"height\":874,\"width\":402.00000000000006,\"x\":0,\"y\":0},\"content_required\":false,\"type\":\"Group\",\"role_description\":\"Group\",\"role\":\"AXGroup\",\"AXUniqueId\":null}\r\n[exited 0 after 0.35s]\r\n"]
[2.194, "m", "Deliver a notification while the app is not running"]
[2.194, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.399, "o", "[exited 0 after 0.20s]\r\n"]
[3.403, "m", "Tap the banner"]
[3.403, "o", "$ idb ui tap 201 90\r\n"]
[3.694, "o", "[exited 0 after 0.29s]\r\n"]
[4.614, "m", "Clear the app's delivered notifications"]
[4.614, "o", "$ idb notification clear com.apple.news\r\n"]
[5.104, "o", "[exited 0 after 0.49s]\r\n"]
[5.644, "m", "List notifications after clearing them"]
[5.644, "o", "$ idb notification list com.apple.news\r\n"]
[6.094, "o", "[exited 0 after 0.45s]\r\n"]
[7.395, "o", ""]
