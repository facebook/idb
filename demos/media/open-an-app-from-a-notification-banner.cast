{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.232, "o", "[exited 0 after 0.23s]\r\n"]
[1.234, "m", "Go to the home screen"]
[1.234, "o", "$ idb ui button HOME\r\n"]
[1.457, "o", "[exited 0 after 0.22s]\r\n"]
[1.679, "m", "Check what is where the banner will appear"]
[1.679, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.438, "o", "{\"AXLabel\":null,\"pid\":1623,\"traits\":[\"Scrollable\"],\"subrole\":null,\"content_required\":false,\"frame\":{\"x\":0,\"y\":0,\"width\":402.00000000000006,\"height\":874},\"type\":\"Group\",\"enabled\":true,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"role_description\":\"Group\",\"help\":null,\"role\":\"AXGroup\",\"title\":null,\"custom_actions\":[],\"AXUniqueId\":null,\"AXValue\":null}\r\n[exited 0 after 0.76s]\r\n"]
[2.442, "m", "Deliver a notification while the app is not running"]
[2.442, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.818, "o", "[exited 0 after 0.38s]\r\n"]
[3.821, "m", "Tap the banner"]
[3.821, "o", "$ idb ui tap 201 90\r\n"]
[4.065, "o", "[exited 0 after 0.24s]\r\n"]
[5.177, "m", "Clear the app's delivered notifications"]
[5.177, "o", "$ idb notification clear com.apple.news\r\n"]
[5.875, "o", "[exited 0 after 0.70s]\r\n"]
[6.367, "m", "List notifications after clearing them"]
[6.367, "o", "$ idb notification list com.apple.news\r\n"]
[6.757, "o", "[exited 0 after 0.39s]\r\n"]
[8.39, "o", ""]
