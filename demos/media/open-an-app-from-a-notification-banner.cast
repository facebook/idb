{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.328, "o", "[exited 0 after 0.33s]\r\n"]
[1.328, "m", "Go to the home screen"]
[1.328, "o", "$ idb ui button HOME\r\n"]
[1.511, "o", "[exited 0 after 0.18s]\r\n"]
[1.767, "m", "Check what is where the banner will appear"]
[1.767, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.415, "o", "{\"AXUniqueId\":null,\"AXValue\":null,\"title\":null,\"content_required\":false,\"AXLabel\":null,\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"enabled\":true,\"traits\":[\"Scrollable\"],\"role\":\"AXGroup\",\"help\":null,\"pid\":2347,\"type\":\"Group\",\"custom_actions\":[],\"frame\":{\"y\":0,\"x\":0,\"height\":874,\"width\":401.99999999999994},\"subrole\":null}\r\n[exited 0 after 0.65s]\r\n"]
[2.416, "m", "Deliver a notification while the app is not running"]
[2.416, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.759, "o", "[exited 0 after 0.34s]\r\n"]
[3.763, "m", "Tap the banner"]
[3.763, "o", "$ idb ui tap 201 90\r\n"]
[4.014, "o", "[exited 0 after 0.25s]\r\n"]
[4.88, "m", "Clear the app's delivered notifications"]
[4.88, "o", "$ idb notification clear com.apple.news\r\n"]
[5.351, "o", "[exited 0 after 0.47s]\r\n"]
[5.918, "m", "List notifications after clearing them"]
[5.918, "o", "$ idb notification list com.apple.news\r\n"]
[6.394, "o", "[exited 0 after 0.48s]\r\n"]
[7.777, "o", ""]
