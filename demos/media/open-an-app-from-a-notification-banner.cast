{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.287, "o", "[exited 0 after 0.29s]\r\n"]
[1.287, "m", "Go to the home screen"]
[1.287, "o", "$ idb ui button HOME\r\n"]
[1.49, "o", "[exited 0 after 0.20s]\r\n"]
[1.802, "m", "Check what is where the banner will appear"]
[1.802, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.263, "o", "{\"role_description\":\"Group\",\"help\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"enabled\":true,\"content_required\":false,\"subrole\":null,\"traits\":[\"Scrollable\"],\"pid\":19581,\"title\":null,\"role\":\"AXGroup\",\"AXLabel\":null,\"frame\":{\"width\":402,\"x\":0,\"y\":0,\"height\":874},\"AXValue\":null,\"AXUniqueId\":null,\"type\":\"Group\",\"custom_actions\":[]}\r\n[exited 0 after 0.46s]\r\n"]
[2.264, "m", "Deliver a notification while the app is not running"]
[2.264, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.485, "o", "[exited 0 after 0.22s]\r\n"]
[3.489, "m", "Tap the banner"]
[3.489, "o", "$ idb ui tap 201 90\r\n"]
[3.748, "o", "[exited 0 after 0.26s]\r\n"]
[4.809, "m", "Clear the app's delivered notifications"]
[4.809, "o", "$ idb notification clear com.apple.news\r\n"]
[5.302, "o", "[exited 0 after 0.49s]\r\n"]
[5.823, "m", "List notifications after clearing them"]
[5.823, "o", "$ idb notification list com.apple.news\r\n"]
[6.382, "o", "[exited 0 after 0.56s]\r\n"]
[7.845, "o", ""]
