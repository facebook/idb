{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.257, "o", "[exited 0 after 0.26s]\r\n"]
[1.257, "m", "Go to the home screen"]
[1.257, "o", "$ idb ui button HOME\r\n"]
[1.503, "o", "[exited 0 after 0.25s]\r\n"]
[1.777, "m", "Check what is where the banner will appear"]
[1.777, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.203, "o", "{\"custom_actions\":[],\"help\":null,\"role_description\":\"Group\",\"enabled\":true,\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"type\":\"Group\",\"AXLabel\":null,\"AXUniqueId\":null,\"subrole\":null,\"content_required\":false,\"frame\":{\"height\":874,\"x\":0,\"y\":0,\"width\":402.00000000000006},\"pid\":1299,\"traits\":[\"Scrollable\"],\"AXValue\":null,\"title\":null}\r\n[exited 0 after 0.43s]\r\n"]
[2.203, "m", "Deliver a notification while the app is not running"]
[2.203, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.551, "o", "[exited 0 after 0.35s]\r\n"]
[3.555, "m", "Tap the banner"]
[3.555, "o", "$ idb ui tap 201 90\r\n"]
[3.813, "o", "[exited 0 after 0.26s]\r\n"]
[4.977, "m", "Clear the app's delivered notifications"]
[4.977, "o", "$ idb notification clear com.apple.news\r\n"]
[5.5, "o", "[exited 0 after 0.52s]\r\n"]
[6.195, "m", "List notifications after clearing them"]
[6.195, "o", "$ idb notification list com.apple.news\r\n"]
[7.031, "o", "[exited 0 after 0.84s]\r\n"]
[8.178, "o", ""]
