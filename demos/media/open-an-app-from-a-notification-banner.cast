{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.28, "o", "[exited 0 after 0.28s]\r\n"]
[1.281, "m", "Go to the home screen"]
[1.281, "o", "$ idb ui button HOME\r\n"]
[1.473, "o", "[exited 0 after 0.19s]\r\n"]
[1.74, "m", "Check what is where the banner will appear"]
[1.74, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.225, "o", "{\"subrole\":null,\"pid\":2549,\"content_required\":false,\"title\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"role\":\"AXGroup\",\"help\":null,\"role_description\":\"Group\",\"custom_actions\":[],\"frame\":{\"y\":0,\"width\":402,\"height\":874,\"x\":0},\"enabled\":true,\"type\":\"Group\",\"AXUniqueId\":null,\"AXLabel\":null,\"AXValue\":null,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.49s]\r\n"]
[2.225, "m", "Deliver a notification while the app is not running"]
[2.225, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.536, "o", "[exited 0 after 0.31s]\r\n"]
[3.54, "m", "Tap the banner"]
[3.54, "o", "$ idb ui tap 201 90\r\n"]
[3.806, "o", "[exited 0 after 0.27s]\r\n"]
[4.706, "m", "Clear the app's delivered notifications"]
[4.706, "o", "$ idb notification clear com.apple.news\r\n"]
[5.237, "o", "[exited 0 after 0.53s]\r\n"]
[5.823, "m", "List notifications after clearing them"]
[5.823, "o", "$ idb notification list com.apple.news\r\n"]
[6.38, "o", "[exited 0 after 0.56s]\r\n"]
[8.027, "o", ""]
