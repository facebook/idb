{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.906, "m", "Grant notification permission without showing a prompt"]
[0.906, "o", "$ idb approve com.apple.news notification\r\n"]
[1.103, "o", "[exited 0 after 0.20s]\r\n"]
[1.103, "m", "Go to the home screen"]
[1.103, "o", "$ idb ui button HOME\r\n"]
[1.249, "o", "[exited 0 after 0.15s]\r\n"]
[1.488, "m", "Check what is where the banner will appear"]
[1.488, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.857, "o", "{\"title\":null,\"help\":null,\"role\":\"AXGroup\",\"enabled\":true,\"traits\":[\"Scrollable\"],\"custom_actions\":[],\"AXLabel\":null,\"pid\":12657,\"frame\":{\"width\":402,\"height\":874,\"y\":0,\"x\":0},\"role_description\":\"Group\",\"type\":\"Group\",\"AXUniqueId\":null,\"content_required\":false,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"AXValue\":null,\"subrole\":null}\r\n[exited 0 after 0.37s]\r\n"]
[1.857, "m", "Deliver a notification while the app is not running"]
[1.857, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.046, "o", "[exited 0 after 0.19s]\r\n"]
[3.049, "m", "Tap the banner"]
[3.049, "o", "$ idb ui tap 201 90\r\n"]
[3.27, "o", "[exited 0 after 0.22s]\r\n"]
[3.939, "m", "Clear the app's delivered notifications"]
[3.939, "o", "$ idb notification clear com.apple.news\r\n"]
[4.332, "o", "[exited 0 after 0.39s]\r\n"]
[4.774, "m", "List notifications after clearing them"]
[4.774, "o", "$ idb notification list com.apple.news\r\n"]
[5.191, "o", "[exited 0 after 0.42s]\r\n"]
[6.317, "o", ""]
