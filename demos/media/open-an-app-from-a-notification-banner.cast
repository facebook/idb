{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.625, "o", "[exited 0 after 0.63s]\r\n"]
[1.626, "m", "Go to the home screen"]
[1.626, "o", "$ idb ui button HOME\r\n"]
[1.894, "o", "[exited 0 after 0.27s]\r\n"]
[2.347, "m", "Check what is where the banner will appear"]
[2.347, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.667, "o", "{\"pid\":1918,\"custom_actions\":[],\"AXLabel\":null,\"content_required\":false,\"title\":null,\"role\":\"AXGroup\",\"AXUniqueId\":null,\"AXValue\":null,\"traits\":[\"Scrollable\"],\"subrole\":null,\"help\":null,\"frame\":{\"width\":402,\"height\":874,\"y\":0,\"x\":0},\"enabled\":true,\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"type\":\"Group\"}\r\n[exited 0 after 0.32s]\r\n"]
[2.668, "m", "Deliver a notification while the app is not running"]
[2.668, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.895, "o", "[exited 0 after 0.23s]\r\n"]
[3.896, "m", "Tap the banner"]
[3.896, "o", "$ idb ui tap 201 90\r\n"]
[4.199, "o", "[exited 0 after 0.30s]\r\n"]
[5.16, "m", "Clear the app's delivered notifications"]
[5.16, "o", "$ idb notification clear com.apple.news\r\n"]
[5.66, "o", "[exited 0 after 0.50s]\r\n"]
[6.23, "m", "List notifications after clearing them"]
[6.23, "o", "$ idb notification list com.apple.news\r\n"]
[6.759, "o", "[exited 0 after 0.53s]\r\n"]
[8.368, "o", ""]
