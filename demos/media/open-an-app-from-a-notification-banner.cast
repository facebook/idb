{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.237, "o", "[exited 0 after 0.24s]\r\n"]
[1.237, "m", "Go to the home screen"]
[1.237, "o", "$ idb ui button HOME\r\n"]
[1.449, "o", "[exited 0 after 0.21s]\r\n"]
[1.714, "m", "Check what is where the banner will appear"]
[1.714, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.033, "o", "{\"role_description\":\"Group\",\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"title\":null,\"role\":\"AXGroup\",\"subrole\":null,\"AXValue\":null,\"help\":null,\"AXUniqueId\":null,\"frame\":{\"y\":0,\"height\":874,\"width\":402.00000000000006,\"x\":0},\"enabled\":true,\"content_required\":false,\"pid\":1332,\"custom_actions\":[],\"AXLabel\":null}\r\n[exited 0 after 0.32s]\r\n"]
[2.033, "m", "Deliver a notification while the app is not running"]
[2.033, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.245, "o", "[exited 0 after 0.21s]\r\n"]
[3.247, "m", "Tap the banner"]
[3.247, "o", "$ idb ui tap 201 90\r\n"]
[3.495, "o", "[exited 0 after 0.25s]\r\n"]
[4.287, "m", "Clear the app's delivered notifications"]
[4.287, "o", "$ idb notification clear com.apple.news\r\n"]
[4.822, "o", "[exited 0 after 0.53s]\r\n"]
[5.346, "m", "List notifications after clearing them"]
[5.346, "o", "$ idb notification list com.apple.news\r\n"]
[5.756, "o", "[exited 0 after 0.41s]\r\n"]
[7.268, "o", ""]
