{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.248, "o", "[exited 0 after 0.25s]\r\n"]
[1.249, "m", "Go to the home screen"]
[1.249, "o", "$ idb ui button HOME\r\n"]
[1.452, "o", "[exited 0 after 0.20s]\r\n"]
[1.738, "m", "Check what is where the banner will appear"]
[1.738, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.111, "o", "{\"role_description\":\"Group\",\"traits\":[\"Scrollable\"],\"AXUniqueId\":null,\"custom_actions\":[],\"type\":\"Group\",\"pid\":1481,\"title\":null,\"subrole\":null,\"role\":\"AXGroup\",\"frame\":{\"y\":0,\"height\":874,\"x\":0,\"width\":401.99999999999994},\"help\":null,\"content_required\":false,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"enabled\":true,\"AXLabel\":null,\"AXValue\":null}\r\n[exited 0 after 0.37s]\r\n"]
[2.111, "m", "Deliver a notification while the app is not running"]
[2.111, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.31, "o", "[exited 0 after 0.20s]\r\n"]
[3.313, "m", "Tap the banner"]
[3.313, "o", "$ idb ui tap 201 90\r\n"]
[3.592, "o", "[exited 0 after 0.28s]\r\n"]
[4.498, "m", "Clear the app's delivered notifications"]
[4.498, "o", "$ idb notification clear com.apple.news\r\n"]
[5.018, "o", "[exited 0 after 0.52s]\r\n"]
[5.537, "m", "List notifications after clearing them"]
[5.537, "o", "$ idb notification list com.apple.news\r\n"]
[6.057, "o", "[exited 0 after 0.52s]\r\n"]
[7.022, "o", ""]
