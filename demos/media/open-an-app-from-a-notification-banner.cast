{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.228, "o", "[exited 0 after 0.23s]\r\n"]
[1.229, "m", "Go to the home screen"]
[1.229, "o", "$ idb ui button HOME\r\n"]
[1.421, "o", "[exited 0 after 0.19s]\r\n"]
[1.65, "m", "Check what is where the banner will appear"]
[1.65, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.032, "o", "{\"help\":null,\"role_description\":\"Group\",\"title\":null,\"enabled\":true,\"subrole\":null,\"custom_actions\":[],\"AXValue\":null,\"frame\":{\"height\":874,\"x\":0,\"y\":0,\"width\":402.00000000000006},\"content_required\":false,\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"type\":\"Group\",\"pid\":1524,\"traits\":[\"Scrollable\"],\"AXUniqueId\":null,\"AXLabel\":null}\r\n[exited 0 after 0.38s]\r\n"]
[2.032, "m", "Deliver a notification while the app is not running"]
[2.032, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.269, "o", "[exited 0 after 0.24s]\r\n"]
[3.274, "m", "Tap the banner"]
[3.274, "o", "$ idb ui tap 201 90\r\n"]
[3.552, "o", "[exited 0 after 0.28s]\r\n"]
[4.463, "m", "Clear the app's delivered notifications"]
[4.463, "o", "$ idb notification clear com.apple.news\r\n"]
[5.063, "o", "[exited 0 after 0.60s]\r\n"]
[5.6, "m", "List notifications after clearing them"]
[5.6, "o", "$ idb notification list com.apple.news\r\n"]
[6.19, "o", "[exited 0 after 0.59s]\r\n"]
[7.242, "o", ""]
