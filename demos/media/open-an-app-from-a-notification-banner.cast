{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.223, "o", "[exited 0 after 0.22s]\r\n"]
[1.223, "m", "Go to the home screen"]
[1.223, "o", "$ idb ui button HOME\r\n"]
[1.429, "o", "[exited 0 after 0.21s]\r\n"]
[1.655, "m", "Check what is where the banner will appear"]
[1.655, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.038, "o", "{\"help\":null,\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"AXValue\":null,\"frame\":{\"x\":0,\"width\":401.99999999999994,\"y\":0,\"height\":874},\"role_description\":\"Group\",\"subrole\":null,\"content_required\":false,\"AXLabel\":null,\"role\":\"AXGroup\",\"type\":\"Group\",\"enabled\":true,\"AXUniqueId\":null,\"pid\":6356,\"title\":null,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.38s]\r\n"]
[2.038, "m", "Deliver a notification while the app is not running"]
[2.038, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.259, "o", "[exited 0 after 0.22s]\r\n"]
[3.262, "m", "Tap the banner"]
[3.262, "o", "$ idb ui tap 201 90\r\n"]
[3.574, "o", "[exited 0 after 0.31s]\r\n"]
[5.034, "m", "Clear the app's delivered notifications"]
[5.034, "o", "$ idb notification clear com.apple.news\r\n"]
[5.553, "o", "[exited 0 after 0.52s]\r\n"]
[6.061, "m", "List notifications after clearing them"]
[6.061, "o", "$ idb notification list com.apple.news\r\n"]
[6.711, "o", "[exited 0 after 0.65s]\r\n"]
[8.162, "o", ""]
