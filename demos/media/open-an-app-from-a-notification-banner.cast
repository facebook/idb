{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.234, "o", "[exited 0 after 0.23s]\r\n"]
[1.235, "m", "Go to the home screen"]
[1.235, "o", "$ idb ui button HOME\r\n"]
[1.407, "o", "[exited 0 after 0.17s]\r\n"]
[1.615, "m", "Check what is where the banner will appear"]
[1.615, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.944, "o", "{\"traits\":[\"Scrollable\"],\"content_required\":false,\"pid\":1331,\"AXValue\":null,\"help\":null,\"custom_actions\":[],\"role\":\"AXGroup\",\"AXLabel\":null,\"title\":null,\"subrole\":null,\"AXUniqueId\":null,\"type\":\"Group\",\"frame\":{\"height\":874,\"y\":0,\"width\":401.99999999999994,\"x\":0},\"enabled\":true,\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\"}\r\n[exited 0 after 0.33s]\r\n"]
[1.944, "m", "Deliver a notification while the app is not running"]
[1.944, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.127, "o", "[exited 0 after 0.18s]\r\n"]
[3.129, "m", "Tap the banner"]
[3.129, "o", "$ idb ui tap 201 90\r\n"]
[3.408, "o", "[exited 0 after 0.28s]\r\n"]
[4.082, "m", "Clear the app's delivered notifications"]
[4.082, "o", "$ idb notification clear com.apple.news\r\n"]
[4.681, "o", "[exited 0 after 0.60s]\r\n"]
[5.48, "m", "List notifications after clearing them"]
[5.48, "o", "$ idb notification list com.apple.news\r\n"]
[6.053, "o", "[exited 0 after 0.57s]\r\n"]
[7.715, "o", ""]
