{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.352, "o", "[exited 0 after 0.35s]\r\n"]
[1.352, "m", "Go to the home screen"]
[1.352, "o", "$ idb ui button HOME\r\n"]
[1.634, "o", "[exited 0 after 0.28s]\r\n"]
[2.435, "m", "Check what is where the banner will appear"]
[2.435, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.69, "o", "{\"enabled\":true,\"custom_actions\":[],\"frame\":{\"y\":0,\"height\":874,\"x\":0,\"width\":402.00000000000006},\"title\":null,\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"role_description\":\"Group\",\"content_required\":false,\"AXLabel\":null,\"subrole\":null,\"AXUniqueId\":null,\"pid\":1468,\"AXValue\":null,\"help\":null,\"type\":\"Group\",\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.25s]\r\n"]
[2.69, "m", "Deliver a notification while the app is not running"]
[2.69, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.978, "o", "[exited 0 after 0.29s]\r\n"]
[3.983, "m", "Tap the banner"]
[3.983, "o", "$ idb ui tap 201 90\r\n"]
[4.274, "o", "[exited 0 after 0.29s]\r\n"]
[5.538, "m", "Clear the app's delivered notifications"]
[5.538, "o", "$ idb notification clear com.apple.news\r\n"]
[6.223, "o", "[exited 0 after 0.68s]\r\n"]
[6.843, "m", "List notifications after clearing them"]
[6.843, "o", "$ idb notification list com.apple.news\r\n"]
[7.366, "o", "[exited 0 after 0.52s]\r\n"]
[9.392, "o", ""]
