{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.311, "o", "[exited 0 after 0.31s]\r\n"]
[1.311, "m", "Go to the home screen"]
[1.311, "o", "$ idb ui button HOME\r\n"]
[1.572, "o", "[exited 0 after 0.26s]\r\n"]
[2.395, "m", "Check what is where the banner will appear"]
[2.395, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.687, "o", "{\"frame\":{\"height\":874,\"y\":0,\"x\":0,\"width\":401.99999999999994},\"help\":null,\"content_required\":false,\"AXLabel\":null,\"title\":null,\"enabled\":true,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"role\":\"AXGroup\",\"AXValue\":null,\"pid\":1318,\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"AXUniqueId\":null,\"subrole\":null,\"role_description\":\"Group\",\"custom_actions\":[]}\r\n[exited 0 after 0.29s]\r\n"]
[2.688, "m", "Deliver a notification while the app is not running"]
[2.688, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[3.005, "o", "[exited 0 after 0.32s]\r\n"]
[4.009, "m", "Tap the banner"]
[4.009, "o", "$ idb ui tap 201 90\r\n"]
[4.349, "o", "[exited 0 after 0.34s]\r\n"]
[8.286, "m", "Clear the app's delivered notifications"]
[8.286, "o", "$ idb notification clear com.apple.news\r\n"]
[9.246, "o", "[exited 0 after 0.96s]\r\n"]
[10.09, "m", "List notifications after clearing them"]
[10.09, "o", "$ idb notification list com.apple.news\r\n"]
[10.702, "o", "[exited 0 after 0.61s]\r\n"]
[11.975, "o", ""]
