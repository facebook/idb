{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.194, "o", "[exited 0 after 0.19s]\r\n"]
[1.194, "m", "Go to the home screen"]
[1.194, "o", "$ idb ui button HOME\r\n"]
[1.367, "o", "[exited 0 after 0.17s]\r\n"]
[1.602, "m", "Check what is where the banner will appear"]
[1.602, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.974, "o", "{\"enabled\":true,\"AXValue\":null,\"custom_actions\":[],\"type\":\"Group\",\"frame\":{\"height\":874,\"y\":0,\"width\":402.00000000000006,\"x\":0},\"help\":null,\"title\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"subrole\":null,\"AXUniqueId\":null,\"role\":\"AXGroup\",\"pid\":1854,\"traits\":[\"Scrollable\"],\"content_required\":false,\"role_description\":\"Group\",\"AXLabel\":null}\r\n[exited 0 after 0.37s]\r\n"]
[1.974, "m", "Deliver a notification while the app is not running"]
[1.974, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.197, "o", "[exited 0 after 0.22s]\r\n"]
[3.2, "m", "Tap the banner"]
[3.2, "o", "$ idb ui tap 201 90\r\n"]
[3.5, "o", "[exited 0 after 0.30s]\r\n"]
[4.278, "m", "Clear the app's delivered notifications"]
[4.278, "o", "$ idb notification clear com.apple.news\r\n"]
[4.734, "o", "[exited 0 after 0.46s]\r\n"]
[5.407, "m", "List notifications after clearing them"]
[5.407, "o", "$ idb notification list com.apple.news\r\n"]
[5.848, "o", "[exited 0 after 0.44s]\r\n"]
[7.323, "o", ""]
