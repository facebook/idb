{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.252, "o", "[exited 0 after 0.25s]\r\n"]
[1.252, "m", "Go to the home screen"]
[1.252, "o", "$ idb ui button HOME\r\n"]
[1.499, "o", "[exited 0 after 0.25s]\r\n"]
[2.465, "m", "Check what is where the banner will appear"]
[2.465, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.812, "o", "{\"AXValue\":null,\"AXUniqueId\":null,\"frame\":{\"x\":0,\"y\":0,\"width\":402,\"height\":874},\"AXLabel\":null,\"help\":null,\"pid\":1296,\"traits\":[\"Scrollable\"],\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"title\":null,\"subrole\":null,\"enabled\":true,\"content_required\":false,\"role\":\"AXGroup\",\"type\":\"Group\",\"role_description\":\"Group\"}\r\n[exited 0 after 0.35s]\r\n"]
[2.813, "m", "Deliver a notification while the app is not running"]
[2.813, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[3.076, "o", "[exited 0 after 0.26s]\r\n"]
[4.08, "m", "Tap the banner"]
[4.08, "o", "$ idb ui tap 201 90\r\n"]
[4.558, "o", "[exited 0 after 0.48s]\r\n"]
[6.049, "m", "Clear the app's delivered notifications"]
[6.049, "o", "$ idb notification clear com.apple.news\r\n"]
[6.865, "o", "[exited 0 after 0.82s]\r\n"]
[7.392, "m", "List notifications after clearing them"]
[7.392, "o", "$ idb notification list com.apple.news\r\n"]
[7.849, "o", "[exited 0 after 0.46s]\r\n"]
[9.522, "o", ""]
