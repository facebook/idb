{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.27, "o", "[exited 0 after 0.27s]\r\n"]
[1.27, "m", "Go to the home screen"]
[1.27, "o", "$ idb ui button HOME\r\n"]
[1.469, "o", "[exited 0 after 0.20s]\r\n"]
[1.702, "m", "Check what is where the banner will appear"]
[1.702, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.113, "o", "{\"enabled\":true,\"custom_actions\":[],\"pid\":1550,\"traits\":[\"Scrollable\"],\"AXLabel\":null,\"help\":null,\"content_required\":false,\"frame\":{\"y\":0,\"width\":402,\"height\":874,\"x\":0},\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"role_description\":\"Group\",\"AXUniqueId\":null,\"AXValue\":null,\"title\":null,\"type\":\"Group\",\"subrole\":null}\r\n[exited 0 after 0.41s]\r\n"]
[2.114, "m", "Deliver a notification while the app is not running"]
[2.114, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.36, "o", "[exited 0 after 0.25s]\r\n"]
[3.362, "m", "Tap the banner"]
[3.362, "o", "$ idb ui tap 201 90\r\n"]
[3.919, "o", "[exited 0 after 0.56s]\r\n"]
[4.974, "m", "Clear the app's delivered notifications"]
[4.974, "o", "$ idb notification clear com.apple.news\r\n"]
[5.548, "o", "[exited 0 after 0.57s]\r\n"]
[6.123, "m", "List notifications after clearing them"]
[6.123, "o", "$ idb notification list com.apple.news\r\n"]
[6.583, "o", "[exited 0 after 0.46s]\r\n"]
[8.218, "o", ""]
