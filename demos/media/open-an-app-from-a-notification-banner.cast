{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.228, "o", "[exited 0 after 0.23s]\r\n"]
[1.228, "m", "Go to the home screen"]
[1.228, "o", "$ idb ui button HOME\r\n"]
[1.407, "o", "[exited 0 after 0.18s]\r\n"]
[1.639, "m", "Check what is where the banner will appear"]
[1.639, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.995, "o", "{\"subrole\":null,\"frame\":{\"height\":874,\"x\":0,\"y\":0,\"width\":402.00000000000006},\"traits\":[\"Scrollable\"],\"content_required\":false,\"custom_actions\":[],\"title\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"role_description\":\"Group\",\"help\":null,\"pid\":1478,\"AXUniqueId\":null,\"AXLabel\":null,\"role\":\"AXGroup\",\"type\":\"Group\",\"AXValue\":null,\"enabled\":true}\r\n[exited 0 after 0.36s]\r\n"]
[1.995, "m", "Deliver a notification while the app is not running"]
[1.995, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.208, "o", "[exited 0 after 0.21s]\r\n"]
[3.212, "m", "Tap the banner"]
[3.212, "o", "$ idb ui tap 201 90\r\n"]
[3.974, "o", "[exited 0 after 0.76s]\r\n"]
[5.782, "m", "Clear the app's delivered notifications"]
[5.782, "o", "$ idb notification clear com.apple.news\r\n"]
[6.32, "o", "[exited 0 after 0.54s]\r\n"]
[7.347, "m", "List notifications after clearing them"]
[7.347, "o", "$ idb notification list com.apple.news\r\n"]
[8.04, "o", "[exited 0 after 0.69s]\r\n"]
[9.132, "o", ""]
