{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.264, "o", "[exited 0 after 0.26s]\r\n"]
[1.264, "m", "Go to the home screen"]
[1.264, "o", "$ idb ui button HOME\r\n"]
[1.441, "o", "[exited 0 after 0.18s]\r\n"]
[1.686, "m", "Check what is where the banner will appear"]
[1.686, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.131, "o", "{\"custom_actions\":[],\"enabled\":true,\"role_description\":\"Group\",\"pid\":1713,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"subrole\":null,\"role\":\"AXGroup\",\"AXUniqueId\":null,\"help\":null,\"AXValue\":null,\"content_required\":false,\"title\":null,\"frame\":{\"width\":402.00000000000006,\"height\":874,\"y\":0,\"x\":0},\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"AXLabel\":null}\r\n[exited 0 after 0.44s]\r\n"]
[2.131, "m", "Deliver a notification while the app is not running"]
[2.131, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.382, "o", "[exited 0 after 0.25s]\r\n"]
[3.385, "m", "Tap the banner"]
[3.385, "o", "$ idb ui tap 201 90\r\n"]
[3.641, "o", "[exited 0 after 0.26s]\r\n"]
[5.981, "m", "Clear the app's delivered notifications"]
[5.981, "o", "$ idb notification clear com.apple.news\r\n"]
[7.285, "o", "[exited 0 after 1.30s]\r\n"]
[8.035, "m", "List notifications after clearing them"]
[8.035, "o", "$ idb notification list com.apple.news\r\n"]
[8.667, "o", "[exited 0 after 0.63s]\r\n"]
[9.64, "o", ""]
