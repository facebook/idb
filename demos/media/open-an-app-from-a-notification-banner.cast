{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.254, "o", "[exited 0 after 0.25s]\r\n"]
[1.255, "m", "Go to the home screen"]
[1.255, "o", "$ idb ui button HOME\r\n"]
[1.455, "o", "[exited 0 after 0.20s]\r\n"]
[1.695, "m", "Check what is where the banner will appear"]
[1.695, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.159, "o", "{\"subrole\":null,\"traits\":[\"Scrollable\"],\"AXLabel\":null,\"title\":null,\"pid\":2129,\"frame\":{\"width\":401.99999999999994,\"y\":0,\"x\":0,\"height\":874},\"AXValue\":null,\"custom_actions\":[],\"type\":\"Group\",\"role_description\":\"Group\",\"AXUniqueId\":null,\"enabled\":true,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"role\":\"AXGroup\",\"help\":null,\"content_required\":false}\r\n[exited 0 after 0.46s]\r\n"]
[2.16, "m", "Deliver a notification while the app is not running"]
[2.16, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.467, "o", "[exited 0 after 0.31s]\r\n"]
[3.47, "m", "Tap the banner"]
[3.47, "o", "$ idb ui tap 201 90\r\n"]
[3.706, "o", "[exited 0 after 0.24s]\r\n"]
[5.09, "m", "Clear the app's delivered notifications"]
[5.09, "o", "$ idb notification clear com.apple.news\r\n"]
[5.763, "o", "[exited 0 after 0.67s]\r\n"]
[6.245, "m", "List notifications after clearing them"]
[6.245, "o", "$ idb notification list com.apple.news\r\n"]
[7.315, "o", "[exited 0 after 1.07s]\r\n"]
[8.633, "o", ""]
