{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.386, "o", "[exited 0 after 0.39s]\r\n"]
[1.386, "m", "Go to the home screen"]
[1.386, "o", "$ idb ui button HOME\r\n"]
[1.584, "o", "[exited 0 after 0.20s]\r\n"]
[1.849, "m", "Check what is where the banner will appear"]
[1.849, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.244, "o", "{\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"role\":\"AXGroup\",\"enabled\":true,\"frame\":{\"y\":0,\"width\":401.99999999999994,\"x\":0,\"height\":874},\"AXLabel\":null,\"AXUniqueId\":null,\"subrole\":null,\"traits\":[\"Scrollable\"],\"title\":null,\"pid\":2886,\"type\":\"Group\",\"custom_actions\":[],\"content_required\":false,\"role_description\":\"Group\",\"help\":null}\r\n[exited 0 after 0.40s]\r\n"]
[2.25, "m", "Deliver a notification while the app is not running"]
[2.25, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.491, "o", "[exited 0 after 0.24s]\r\n"]
[3.494, "m", "Tap the banner"]
[3.494, "o", "$ idb ui tap 201 90\r\n"]
[3.788, "o", "[exited 0 after 0.29s]\r\n"]
[4.883, "m", "Clear the app's delivered notifications"]
[4.883, "o", "$ idb notification clear com.apple.news\r\n"]
[5.431, "o", "[exited 0 after 0.55s]\r\n"]
[5.923, "m", "List notifications after clearing them"]
[5.923, "o", "$ idb notification list com.apple.news\r\n"]
[6.346, "o", "[exited 0 after 0.42s]\r\n"]
[8.402, "o", ""]
