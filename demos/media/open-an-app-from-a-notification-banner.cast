{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.349, "o", "[exited 0 after 0.35s]\r\n"]
[1.35, "m", "Go to the home screen"]
[1.35, "o", "$ idb ui button HOME\r\n"]
[1.593, "o", "[exited 0 after 0.24s]\r\n"]
[2.035, "m", "Check what is where the banner will appear"]
[2.035, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.42, "o", "{\"enabled\":true,\"pid\":1945,\"role\":\"AXGroup\",\"type\":\"Group\",\"role_description\":\"Group\",\"traits\":[\"Scrollable\"],\"frame\":{\"width\":402.00000000000006,\"height\":874,\"y\":0,\"x\":0},\"AXValue\":null,\"title\":null,\"AXLabel\":null,\"custom_actions\":[],\"AXUniqueId\":null,\"help\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"subrole\":null,\"content_required\":false}\r\n[exited 0 after 0.38s]\r\n"]
[2.42, "m", "Deliver a notification while the app is not running"]
[2.42, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.691, "o", "[exited 0 after 0.27s]\r\n"]
[3.695, "m", "Tap the banner"]
[3.695, "o", "$ idb ui tap 201 90\r\n"]
[4.098, "o", "[exited 0 after 0.40s]\r\n"]
[4.859, "m", "Clear the app's delivered notifications"]
[4.859, "o", "$ idb notification clear com.apple.news\r\n"]
[5.454, "o", "[exited 0 after 0.60s]\r\n"]
[6.233, "m", "List notifications after clearing them"]
[6.233, "o", "$ idb notification list com.apple.news\r\n"]
[6.74, "o", "[exited 0 after 0.51s]\r\n"]
[8.105, "o", ""]
