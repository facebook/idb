{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.297, "o", "[exited 0 after 0.30s]\r\n"]
[1.297, "m", "Go to the home screen"]
[1.297, "o", "$ idb ui button HOME\r\n"]
[1.528, "o", "[exited 0 after 0.23s]\r\n"]
[1.786, "m", "Check what is where the banner will appear"]
[1.786, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.232, "o", "{\"role\":\"AXGroup\",\"AXUniqueId\":null,\"enabled\":true,\"subrole\":null,\"help\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"content_required\":false,\"custom_actions\":[],\"traits\":[\"Scrollable\"],\"title\":null,\"AXValue\":null,\"pid\":1305,\"role_description\":\"Group\",\"type\":\"Group\",\"frame\":{\"x\":0,\"y\":0,\"width\":402,\"height\":874},\"AXLabel\":null}\r\n[exited 0 after 0.45s]\r\n"]
[2.232, "m", "Deliver a notification while the app is not running"]
[2.232, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.489, "o", "[exited 0 after 0.26s]\r\n"]
[3.493, "m", "Tap the banner"]
[3.493, "o", "$ idb ui tap 201 90\r\n"]
[3.988, "o", "[exited 0 after 0.50s]\r\n"]
[5.141, "m", "Clear the app's delivered notifications"]
[5.141, "o", "$ idb notification clear com.apple.news\r\n"]
[5.671, "o", "[exited 0 after 0.53s]\r\n"]
[6.231, "m", "List notifications after clearing them"]
[6.231, "o", "$ idb notification list com.apple.news\r\n"]
[6.803, "o", "[exited 0 after 0.57s]\r\n"]
[9.018, "o", ""]
