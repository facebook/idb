{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.957, "m", "Grant notification permission without showing a prompt"]
[0.957, "o", "$ idb approve com.apple.news notification\r\n"]
[1.23, "o", "[exited 0 after 0.27s]\r\n"]
[1.23, "m", "Go to the home screen"]
[1.23, "o", "$ idb ui button HOME\r\n"]
[1.409, "o", "[exited 0 after 0.18s]\r\n"]
[1.65, "m", "Check what is where the banner will appear"]
[1.65, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.304, "o", "{\"frame\":{\"width\":401.99999999999994,\"y\":0,\"height\":874,\"x\":0},\"type\":\"Group\",\"subrole\":null,\"enabled\":true,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"custom_actions\":[],\"AXUniqueId\":null,\"content_required\":false,\"role_description\":\"Group\",\"traits\":[\"Scrollable\"],\"AXValue\":null,\"help\":null,\"pid\":9478,\"AXLabel\":null,\"role\":\"AXGroup\",\"title\":null}\r\n[exited 0 after 0.65s]\r\n"]
[2.304, "m", "Deliver a notification while the app is not running"]
[2.304, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.52, "o", "[exited 0 after 0.22s]\r\n"]
[3.522, "m", "Tap the banner"]
[3.522, "o", "$ idb ui tap 201 90\r\n"]
[3.698, "o", "[exited 0 after 0.18s]\r\n"]
[4.29, "m", "Clear the app's delivered notifications"]
[4.29, "o", "$ idb notification clear com.apple.news\r\n"]
[4.71, "o", "[exited 0 after 0.42s]\r\n"]
[5.13, "m", "List notifications after clearing them"]
[5.13, "o", "$ idb notification list com.apple.news\r\n"]
[5.592, "o", "[exited 0 after 0.46s]\r\n"]
[6.833, "o", ""]
