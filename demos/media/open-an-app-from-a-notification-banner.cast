{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.208, "o", "[exited 0 after 0.21s]\r\n"]
[1.209, "m", "Go to the home screen"]
[1.209, "o", "$ idb ui button HOME\r\n"]
[1.408, "o", "[exited 0 after 0.20s]\r\n"]
[1.648, "m", "Check what is where the banner will appear"]
[1.648, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.265, "o", "{\"custom_actions\":[],\"enabled\":true,\"role\":\"AXGroup\",\"subrole\":null,\"pid\":3645,\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"AXUniqueId\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"AXLabel\":null,\"title\":null,\"role_description\":\"Group\",\"content_required\":false,\"frame\":{\"y\":0,\"x\":0,\"height\":874,\"width\":402.00000000000006},\"AXValue\":null,\"help\":null}\r\n[exited 0 after 0.62s]\r\n"]
[2.265, "m", "Deliver a notification while the app is not running"]
[2.265, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.485, "o", "[exited 0 after 0.22s]\r\n"]
[3.489, "m", "Tap the banner"]
[3.489, "o", "$ idb ui tap 201 90\r\n"]
[3.7, "o", "[exited 0 after 0.21s]\r\n"]
[4.31, "m", "Clear the app's delivered notifications"]
[4.31, "o", "$ idb notification clear com.apple.news\r\n"]
[4.878, "o", "[exited 0 after 0.57s]\r\n"]
[5.398, "m", "List notifications after clearing them"]
[5.398, "o", "$ idb notification list com.apple.news\r\n"]
[6.062, "o", "[exited 0 after 0.66s]\r\n"]
[7.535, "o", ""]
