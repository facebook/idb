{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.313, "o", "[exited 0 after 0.31s]\r\n"]
[1.313, "m", "Go to the home screen"]
[1.313, "o", "$ idb ui button HOME\r\n"]
[1.534, "o", "[exited 0 after 0.22s]\r\n"]
[2.225, "m", "Check what is where the banner will appear"]
[2.225, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.473, "o", "{\"content_required\":false,\"frame\":{\"height\":874,\"x\":0,\"y\":0,\"width\":401.99999999999994},\"role\":\"AXGroup\",\"title\":null,\"help\":null,\"AXUniqueId\":null,\"AXLabel\":null,\"enabled\":true,\"AXValue\":null,\"custom_actions\":[],\"role_description\":\"Group\",\"subrole\":null,\"pid\":2647,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"type\":\"Group\"}\r\n[exited 0 after 0.25s]\r\n"]
[2.473, "m", "Deliver a notification while the app is not running"]
[2.473, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.771, "o", "[exited 0 after 0.30s]\r\n"]
[3.775, "m", "Tap the banner"]
[3.775, "o", "$ idb ui tap 201 90\r\n"]
[4.025, "o", "[exited 0 after 0.25s]\r\n"]
[5.004, "m", "Clear the app's delivered notifications"]
[5.004, "o", "$ idb notification clear com.apple.news\r\n"]
[5.587, "o", "[exited 0 after 0.58s]\r\n"]
[6.132, "m", "List notifications after clearing them"]
[6.132, "o", "$ idb notification list com.apple.news\r\n"]
[6.556, "o", "[exited 0 after 0.42s]\r\n"]
[8.807, "o", ""]
