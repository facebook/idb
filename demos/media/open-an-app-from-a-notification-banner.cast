{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.23, "o", "[exited 0 after 0.23s]\r\n"]
[1.23, "m", "Go to the home screen"]
[1.23, "o", "$ idb ui button HOME\r\n"]
[1.444, "o", "[exited 0 after 0.21s]\r\n"]
[1.872, "m", "Check what is where the banner will appear"]
[1.872, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.194, "o", "{\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"frame\":{\"width\":402,\"height\":874,\"x\":0,\"y\":0},\"title\":null,\"pid\":2925,\"role_description\":\"Group\",\"AXUniqueId\":null,\"content_required\":false,\"AXLabel\":null,\"enabled\":true,\"AXValue\":null,\"traits\":[\"Scrollable\"],\"help\":null,\"subrole\":null,\"custom_actions\":[],\"type\":\"Group\",\"role\":\"AXGroup\"}\r\n[exited 0 after 0.32s]\r\n"]
[2.195, "m", "Deliver a notification while the app is not running"]
[2.195, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.426, "o", "[exited 0 after 0.23s]\r\n"]
[3.429, "m", "Tap the banner"]
[3.429, "o", "$ idb ui tap 201 90\r\n"]
[3.873, "o", "[exited 0 after 0.44s]\r\n"]
[5.023, "m", "Clear the app's delivered notifications"]
[5.023, "o", "$ idb notification clear com.apple.news\r\n"]
[5.651, "o", "[exited 0 after 0.63s]\r\n"]
[6.16, "m", "List notifications after clearing them"]
[6.16, "o", "$ idb notification list com.apple.news\r\n"]
[6.607, "o", "[exited 0 after 0.45s]\r\n"]
[8.562, "o", ""]
