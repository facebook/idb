{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Scroll a list and verify the result", "version": 2, "width": 80}
[1.0, "m", "Scroll down from the General row"]
[1.0, "o", "$ idb ui scroll down com.apple.settings.general --match-key AXUniqueId\r\n"]
[3.801, "o", "[exited 0 after 2.80s]\r\n"]
[4.747, "m", "Scroll back up from a visible row"]
[4.747, "o", "$ idb ui scroll up com.apple.settings.passcodeAndBiometrics --match-key AXUniqueId\r\n"]
[6.191, "o", "[exited 0 after 1.44s]\r\n"]
