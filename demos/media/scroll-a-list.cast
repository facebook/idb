{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Scroll a list and verify the result", "version": 2, "width": 80}
[1.0, "m", "Scroll down from the General row"]
[1.0, "o", "$ idb ui scroll down com.facebook.idb.replhost.row.general --match-key AXUniqueId\r\n"]
[2.114, "o", "[exited 0 after 1.11s]\r\n"]
[3.319, "m", "Scroll back up from a visible row"]
[3.319, "o", "$ idb ui scroll up com.facebook.idb.replhost.row.row-19 --match-key AXUniqueId\r\n"]
[4.338, "o", "[exited 0 after 1.02s]\r\n"]
[8.55, "o", ""]
